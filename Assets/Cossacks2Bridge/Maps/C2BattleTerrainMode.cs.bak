            public string SourcePath = "";
            public string TexturePathKey = "";
            public string TextureNameKey = "";
            public bool UseBumpMap;
            public string BumpSourcePath = "";
            public string BumpTexturePathKey = "";
            public string BumpTextureNameKey = "";
            public float BumpDegree = 1.0f;
            public float PBumpDegree = 1.0f;
            public float BumpContrast = 0.6f;
            public float BumpBrightness = 1.0f;
            public bool BumpLookupTried;
            public Texture2D ResolvedBumpTexture;
            public string ResolvedBumpDebug = "";
            public string GeneratedNormalCacheKey = "";
            public Texture2D GeneratedNormalTexture;
            public int Mapping;
            public float UScale = 1.0f;
            public float VScale = 1.0f;
            public float UShift = 0.0f;
            public float VShift = 0.0f;
        }

        private static string GetChunkInventory(Dictionary<string, int> counts, Dictionary<string, int> payloadBytes, string tag)
        {
            if (counts == null || payloadBytes == null) return tag + "=0/0";
            counts.TryGetValue(tag, out int count);
            payloadBytes.TryGetValue(tag, out int bytes);
            return count + "/" + bytes;
        }

        private static string BuildTplChunkDetail(byte[] payload, int maxTH)
        {
            if (payload == null || payload.Length == 0) return "missing";
            if (TryResolveTplChunkPayloadEnd(payload, 0, payload.Length, maxTH, out long actualEnd, out int legacyPayloadLen, out bool claimedMatchesLegacy, out bool claimedMatchesActual, out string info))
            {
                string mode = claimedMatchesActual ? "actual" : (claimedMatchesLegacy ? "legacy" : "mixed");
                return $"{mode}; bytes={payload.Length}; {info}";
            }
            return $"bytes={payload.Length}; parse=failed; head={BuildHexHead(payload, 16)}";
        }

        private static string BuildChunkProbe(byte[] payload)
        {
            if (payload == null || payload.Length == 0) return "missing";
            return $"bytes={payload.Length} hash={ComputeFnv1a32(payload):X8} head={BuildHexHead(payload, 16)}";
        }

        private static string BuildScalarChunkProbe(byte[] payload)
        {
            if (payload == null || payload.Length == 0) return "missing";
            if (payload.Length >= 4)
            {
                int value = ReadInt32LE(payload, 0);
                return $"bytes={payload.Length} int={value} hash={ComputeFnv1a32(payload):X8} head={BuildHexHead(payload, 16)}";
            }
            return BuildChunkProbe(payload);
        }


        private static bool IsScalarZeroChunk(byte[] payload)
        {
            return payload != null && payload.Length >= 4 && ReadInt32LE(payload, 0) == 0;
        }

        private static bool HasResolvableTplPayload(byte[] payload, int maxTH)
        {
            if (payload == null || payload.Length == 0) return false;
            return TryResolveTplChunkPayloadEnd(payload, 0, payload.Length, maxTH, out _, out _, out _, out _, out _);
        }

        private static string BuildCountGuessProbe(byte[] payload)
        {
            if (payload == null || payload.Length == 0) return "missing";

            int i0 = payload.Length >= 4 ? ReadInt32LE(payload, 0) : 0;
            int i1 = payload.Length >= 8 ? ReadInt32LE(payload, 4) : 0;
            int i2 = payload.Length >= 12 ? ReadInt32LE(payload, 8) : 0;
            int i3 = payload.Length >= 16 ? ReadInt32LE(payload, 12) : 0;

            bool plausible = i0 >= 0 && i0 <= Math.Max(payload.Length * 4, 65536);
            string guess = plausible ? i0.ToString() : "?";

            return $"bytes={payload.Length} countGuess={guess} ints={i0},{i1},{i2},{i3} hash={ComputeFnv1a32(payload):X8}";
        }

        private static string BuildTplAreaSample(byte[] payload, int maxTH)
        {
            if (payload == null || payload.Length == 0) return "missing";
            if (!TryResolveTplChunkPayloadEnd(payload, 0, payload.Length, maxTH, out _, out _, out bool claimedMatchesLegacy, out bool claimedMatchesActual, out string info))
                return $"parse=failed; head={BuildHexHead(payload, 16)}";

            string mode = claimedMatchesActual ? "actual" : (claimedMatchesLegacy ? "legacy" : "mixed");

            int cursor = 0;
            int areaCount = ReadInt32LE(payload, cursor);
            cursor += 4;

            int sampleCount = Mathf.Clamp(areaCount, 0, 3);
            var sb = new StringBuilder();
            for (int i = 0; i < sampleCount; i++)
            {
                if (cursor + 6 > payload.Length) break;

                ushort a = ReadUInt16LE(payload, cursor);
                ushort b = ReadUInt16LE(payload, cursor + 2);
                ushort linkCount = ReadUInt16LE(payload, cursor + 4);
                cursor += 6;

                if (i > 0) sb.Append(" | ");
                sb.Append(a).Append(',').Append(b).Append(',').Append(linkCount);

                long linkBytes = (long)linkCount * 8L;
                if (cursor + linkBytes > payload.Length) break;
                cursor += checked((int)linkBytes);
            }

            string samples = sb.Length > 0 ? sb.ToString() : "<none>";
            return $"{mode}; {info}; samples={samples}";
        }

        private static string BuildTplTopRefProbe(byte[] payload, int maxTH)
        {
            if (payload == null || payload.Length == 0) return "missing";
            if (!TryResolveTplChunkPayloadEnd(payload, 0, payload.Length, maxTH, out _, out _, out bool claimedMatchesLegacy, out bool claimedMatchesActual, out _))
                return $"parse=failed; head={BuildHexHead(payload, 16)}";

            string mode = claimedMatchesActual ? "actual" : (claimedMatchesLegacy ? "legacy" : "mixed");
            if (!TryReadTplTopRef(payload, maxTH, out int areaCount, out int topLx, out ushort[] topRefs, out string error))
                return $"{mode}; {error}";

            int total = topRefs?.Length ?? 0;
            int zero = 0;
            int nonZero = 0;
            int maxRef = 0;
            int invalidGtAreaCount = 0;
            var distinct = new HashSet<int>();
            var sb = new StringBuilder();
            int sampleBudget = 4;
            for (int i = 0; i < total; i++)
            {
                int val = topRefs[i];
                if (val == 0)
                {
                    zero++;
                    continue;
                }
                nonZero++;
                if (val > maxRef) maxRef = val;
                if (val > areaCount) invalidGtAreaCount++;
                distinct.Add(val);
                if (sampleBudget > 0)
                {
                    int x = i % topLx;
                    int y = i / topLx;
                    if (sb.Length > 0) sb.Append(" | ");
                    sb.Append(x).Append(',').Append(y).Append("->").Append(val);
                    sampleBudget--;
                }
            }

            string samples = sb.Length > 0 ? sb.ToString() : "<none>";
            string baseGuess = maxRef == areaCount ? "one-based-likely" : (maxRef == Math.Max(0, areaCount - 1) ? "zero-based-likely" : "unknown");
            return $"{mode}; topLx={topLx}; cells={total}; areaCount={areaCount}; zero={zero}; nonZero={nonZero}; distinctNonZero={distinct.Count}; maxRef={maxRef}; invalidGtAreas={invalidGtAreaCount}; baseGuess={baseGuess}; samples={samples}";
        }

        private static string BuildTplAreaRefProbe(byte[] payload, int maxTH)
        {
            if (payload == null || payload.Length == 0) return "missing";
            if (!TryReadTplTopRef(payload, maxTH, out int areaCount, out _, out ushort[] topRefs, out string error))
                return error;

            if (areaCount <= 0 || topRefs == null || topRefs.Length == 0)
                return $"areaCount={areaCount}; refs=empty";

            int referencedOneBased = 0;
            int referencedZeroBased = 0;
            var oneBased = new bool[Math.Max(1, areaCount + 1)];
            var zeroBased = new bool[Math.Max(1, areaCount)];
            int outOfRangeOneBased = 0;
            int outOfRangeZeroBased = 0;

            for (int i = 0; i < topRefs.Length; i++)
            {
                int val = topRefs[i];
                if (val > 0)
                {
                    if (val <= areaCount)
                    {
                        if (!oneBased[val])
                        {
                            oneBased[val] = true;
                            referencedOneBased++;
                        }
                    }
                    else
                    {
                        outOfRangeOneBased++;
                    }
                }

                if (val >= 0)
                {
                    if (val < areaCount)
                    {
                        if (!zeroBased[val])
                        {
                            zeroBased[val] = true;
                            referencedZeroBased++;
                        }
                    }
                    else
                    {
                        outOfRangeZeroBased++;
                    }
                }
            }

            int unrefOneBased = Math.Max(0, areaCount - referencedOneBased);
            int unrefZeroBased = Math.Max(0, areaCount - referencedZeroBased);
            string guess = referencedOneBased >= referencedZeroBased ? "one-based-better" : "zero-based-better";
            return $"areas={areaCount}; refOneBased={referencedOneBased}; unrefOneBased={unrefOneBased}; oorOneBased={outOfRangeOneBased}; refZeroBased={referencedZeroBased}; unrefZeroBased={unrefZeroBased}; oorZeroBased={outOfRangeZeroBased}; guess={guess}";
        }

        private static string BuildTplNormalizedTopRefProbe(byte[] payload, int maxTH)
        {
            if (payload == null || payload.Length == 0) return "missing";
            if (!TryReadTplTopRef(payload, maxTH, out int areaCount, out int topLx, out ushort[] topRefs, out string error))
                return error;

            const int sentinel = 0xFFFF;
            int total = topRefs?.Length ?? 0;
            int empty = 0;
            int valid = 0;
            int invalid = 0;
            int distinctValid = 0;
            var seen = new bool[Math.Max(1, areaCount)];
            var sb = new StringBuilder();
            int sampleBudget = 4;

            for (int i = 0; i < total; i++)
            {
                int raw = topRefs[i];
                if (raw == sentinel)
                {
                    empty++;
                    continue;
                }

                if (raw >= 0 && raw < areaCount)
                {
                    valid++;
                    if (!seen[raw])
                    {
                        seen[raw] = true;
                        distinctValid++;
                    }
                    if (sampleBudget > 0)
                    {
                        int x = i % topLx;
                        int y = i / topLx;
                        if (sb.Length > 0) sb.Append(" | ");
                        sb.Append(x).Append(',').Append(y).Append("->").Append(raw);
                        sampleBudget--;
                    }
                }
                else
                {
                    invalid++;
                }
            }

            int unref = Math.Max(0, areaCount - distinctValid);
            string samples = sb.Length > 0 ? sb.ToString() : "<none>";
            return $"areas={areaCount}; topLx={topLx}; cells={total}; sentinel=65535; base=zero-based; empty={empty}; valid={valid}; invalid={invalid}; distinctValid={distinctValid}; unref={unref}; samples={samples}";
        }

        private static string BuildTplAreaCoverageProbe(byte[] payload, int maxTH)
        {
            if (payload == null || payload.Length == 0) return "missing";
            if (!TryReadTplTopRef(payload, maxTH, out int areaCount, out int topLx, out ushort[] topRefs, out string error))
                return error;

            if (areaCount <= 0 || topRefs == null || topRefs.Length == 0)
                return $"areas={areaCount}; coverage=empty";

            const int sentinel = 0xFFFF;
            int[] counts = new int[Math.Max(1, areaCount)];
            int[] firstIdx = new int[Math.Max(1, areaCount)];
            for (int i = 0; i < firstIdx.Length; i++) firstIdx[i] = -1;
            int invalid = 0;
            int empty = 0;

            for (int i = 0; i < topRefs.Length; i++)
            {
                int raw = topRefs[i];
                if (raw == sentinel)
                {
                    empty++;
                    continue;
                }
                if (raw >= 0 && raw < areaCount)
                {
                    counts[raw]++;
                    if (firstIdx[raw] < 0) firstIdx[raw] = i;
                }
                else
                {
                    invalid++;
                }
            }

            var top = Enumerable.Range(0, areaCount)
                .Where(i => counts[i] > 0)
                .OrderByDescending(i => counts[i])
                .ThenBy(i => i)
                .Take(3)
                .ToArray();

            var sb = new StringBuilder();
            for (int n = 0; n < top.Length; n++)
            {
                int area = top[n];
                int idx = firstIdx[area];
                int x = idx >= 0 ? idx % topLx : -1;
                int y = idx >= 0 ? idx / topLx : -1;
                if (n > 0) sb.Append(" | ");
                sb.Append(area).Append(':').Append(counts[area]).Append('@').Append(x).Append(',').Append(y);
            }

            string topAreas = sb.Length > 0 ? sb.ToString() : "<none>";
            int covered = counts.Count(c => c > 0);
            return $"areas={areaCount}; base=zero-based; covered={covered}; empty={empty}; invalid={invalid}; top={topAreas}";
        }

        private static string BuildTplAreaAnchorProbe(byte[] payload, int maxTH)
        {
            if (payload == null || payload.Length == 0) return "missing";
            if (!TryReadTplTopRef(payload, maxTH, out int areaCount, out int topLx, out ushort[] topRefs, out string error))
                return error;

            if (areaCount <= 0 || topRefs == null || topRefs.Length == 0)
                return $"areas={areaCount}; anchors=empty";

            if (!TryReadTplAreaHeaders(payload, out ushort[] ax, out ushort[] ay, out ushort[] linkCounts, out ushort[] q0, out ushort[] q1, out ushort[] q2, out ushort[] q3, out error))
                return error;

            const int sentinel = 0xFFFF;
            int[] minX = new int[Math.Max(1, areaCount)];
            int[] minY = new int[Math.Max(1, areaCount)];
            int[] maxX = new int[Math.Max(1, areaCount)];
            int[] maxY = new int[Math.Max(1, areaCount)];
            int[] counts = new int[Math.Max(1, areaCount)];
            for (int i = 0; i < areaCount; i++)
            {
                minX[i] = int.MaxValue;
                minY[i] = int.MaxValue;
                maxX[i] = int.MinValue;
                maxY[i] = int.MinValue;
            }

            int invalid = 0;
            for (int idx = 0; idx < topRefs.Length; idx++)
            {
                int raw = topRefs[idx];
                if (raw == sentinel)
                    continue;
                if (raw < 0 || raw >= areaCount)
                {
                    invalid++;
                    continue;
                }
                int x = idx % topLx;
                int y = idx / topLx;
                if (x < minX[raw]) minX[raw] = x;
                if (y < minY[raw]) minY[raw] = y;
                if (x > maxX[raw]) maxX[raw] = x;
                if (y > maxY[raw]) maxY[raw] = y;
                counts[raw]++;
            }

            int anchorInBounds = 0;
            int anchorInsideOwnBox = 0;
            for (int i = 0; i < areaCount; i++)
            {
                if (ax[i] < topLx && ay[i] < topLx)
                    anchorInBounds++;
                if (counts[i] > 0 && ax[i] >= minX[i] && ax[i] <= maxX[i] && ay[i] >= minY[i] && ay[i] <= maxY[i])
                    anchorInsideOwnBox++;
            }

            var top = Enumerable.Range(0, areaCount)
                .Where(i => counts[i] > 0)
                .OrderByDescending(i => counts[i])
                .ThenBy(i => i)
                .Take(3)
                .ToArray();

            var sb = new StringBuilder();
            for (int n = 0; n < top.Length; n++)
            {
                int area = top[n];
                if (n > 0) sb.Append(" | ");
                sb.Append(area)
                    .Append('@').Append(ax[area]).Append(',').Append(ay[area])
                    .Append(" box=").Append(minX[area]).Append(',').Append(minY[area]).Append('-').Append(maxX[area]).Append(',').Append(maxY[area])
                    .Append(" cells=").Append(counts[area])
                    .Append(" lc=").Append(linkCounts[area])
                    .Append(" q=").Append(q0[area]).Append(',').Append(q1[area]).Append(',').Append(q2[area]).Append(',').Append(q3[area]);
            }

            int covered = counts.Count(c => c > 0);
            string topAreas = sb.Length > 0 ? sb.ToString() : "<none>";
            return $"areas={areaCount}; base=zero-based; covered={covered}; invalid={invalid}; anchorInBounds={anchorInBounds}; anchorInsideOwnBox={anchorInsideOwnBox}; top={topAreas}";
        }

        private static string BuildTplLinkQuadProbe(byte[] payload, int maxTH)
        {
            if (payload == null || payload.Length == 0) return "missing";
            if (!TryReadTplTopRef(payload, maxTH, out int areaCount, out _, out _, out string error))
                return error;
            if (!TryReadTplAreaHeaders(payload, out _, out _, out ushort[] linkCounts, out ushort[] q0, out ushort[] q1, out ushort[] q2, out ushort[] q3, out error))
                return error;

            int totalLinks = 0;
            int[] inRange = new int[4];
            int[] sent = new int[4];
            int[] zero = new int[4];
            int[] max = new int[4];
            for (int i = 0; i < linkCounts.Length; i++)
            {
                int lc = linkCounts[i];
                if (lc <= 0)
                    continue;
                totalLinks += lc;
                ushort[] vals = { q0[i], q1[i], q2[i], q3[i] };
                for (int k = 0; k < 4; k++)
                {
                    int v = vals[k];
                    if (v > max[k]) max[k] = v;
                    if (v == 0xFFFF) sent[k]++;
                    if (v == 0) zero[k]++;
                    if (v >= 0 && v < areaCount) inRange[k]++;
                }
            }

            int best = 0;
            for (int k = 1; k < 4; k++)
                if (inRange[k] > inRange[best]) best = k;

            return $"areas={areaCount}; links={totalLinks}; q0=inRange={inRange[0]} sent={sent[0]} zero={zero[0]} max={max[0]} q1=inRange={inRange[1]} sent={sent[1]} zero={zero[1]} max={max[1]} q2=inRange={inRange[2]} sent={sent[2]} zero={zero[2]} max={max[2]} q3=inRange={inRange[3]} sent={sent[3]} zero={zero[3]} max={max[3]} targetGuess=q{best}";
        }


        private static string BuildTplNormalizedGraphProbe(byte[] payload, int maxTH)
        {
            if (payload == null || payload.Length == 0) return "missing";
            if (!TryReadTplTopRef(payload, maxTH, out int areaCount, out _, out _, out string error))
                return error;
            if (!TryReadTplAreaLinks(payload, out ushort[] ax, out ushort[] ay, out ushort[] linkCounts, out ushort[][] q0, out ushort[][] q1, out ushort[][] q2, out ushort[][] q3, out error))
                return error;

            const int sentinel = 0xFFFF;
            var adjacency = new HashSet<int>[Math.Max(1, areaCount)];
            var targetSeen = new bool[Math.Max(1, areaCount)];
            int[] rawValidPerArea = new int[Math.Max(1, areaCount)];
            int[] firstValidTarget = new int[Math.Max(1, areaCount)];
            for (int i = 0; i < firstValidTarget.Length; i++) firstValidTarget[i] = -1;
            for (int i = 0; i < adjacency.Length; i++) adjacency[i] = new HashSet<int>();

            int totalLinks = 0;
            int validTargets = 0;
            int emptyTargets = 0;
            int invalidTargets = 0;
            int selfLinks = 0;
            int duplicateTargets = 0;

            for (int area = 0; area < areaCount; area++)
            {
                ushort[] tq2 = q2[area];
                if (tq2 == null || tq2.Length == 0)
                    continue;

                totalLinks += tq2.Length;
                for (int i = 0; i < tq2.Length; i++)
                {
                    int target = tq2[i];
                    if (target == sentinel)
                    {
                        emptyTargets++;
                        continue;
                    }

                    if (target < 0 || target >= areaCount)
                    {
                        invalidTargets++;
                        continue;
                    }

                    validTargets++;
                    rawValidPerArea[area]++;
                    if (firstValidTarget[area] < 0) firstValidTarget[area] = target;
                    if (target == area) selfLinks++;
                    if (targetSeen[target] == false) targetSeen[target] = true;
                    if (!adjacency[area].Add(target))
                        duplicateTargets++;
                }
            }

            int activeSources = 0;
            int uniqueDirected = 0;
            int coveredTargets = 0;
            for (int i = 0; i < areaCount; i++)
            {
                if (adjacency[i].Count > 0) activeSources++;
                uniqueDirected += adjacency[i].Count;
                if (targetSeen[i]) coveredTargets++;
            }

            int reciprocalDirected = 0;
            int reciprocalPairs = 0;
            for (int a = 0; a < areaCount; a++)
            {
                foreach (int b in adjacency[a])
                {
                    if (b >= 0 && b < areaCount && adjacency[b].Contains(a))
                    {
                        reciprocalDirected++;
                        if (a < b) reciprocalPairs++;
                    }
                }
            }

            var top = Enumerable.Range(0, areaCount)
                .Where(i => adjacency[i].Count > 0)
                .OrderByDescending(i => adjacency[i].Count)
                .ThenByDescending(i => rawValidPerArea[i])
                .ThenBy(i => i)
                .Take(3)
                .ToArray();

            var sb = new StringBuilder();
            for (int n = 0; n < top.Length; n++)
            {
                int area = top[n];
                if (n > 0) sb.Append(" | ");
                sb.Append(area)
                    .Append('@').Append(ax[area]).Append(',').Append(ay[area])
                    .Append(":deg=").Append(adjacency[area].Count)
                    .Append("/raw=").Append(rawValidPerArea[area]);
                if (firstValidTarget[area] >= 0)
                    sb.Append("->").Append(firstValidTarget[area]);
            }

            string topAreas = sb.Length > 0 ? sb.ToString() : "<none>";
            return $"areas={areaCount}; base=zero-based; targetField=q2; totalLinks={totalLinks}; validTargets={validTargets}; emptyTargets={emptyTargets}; invalidTargets={invalidTargets}; selfLinks={selfLinks}; duplicateTargets={duplicateTargets}; activeSources={activeSources}; coveredTargets={coveredTargets}; uniqueDirected={uniqueDirected}; reciprocalDirected={reciprocalDirected}; reciprocalPairs={reciprocalPairs}; top={topAreas}";
        }

        private static string BuildTplEdgeSampleProbe(byte[] payload, int maxTH)
        {
            if (payload == null || payload.Length == 0) return "missing";
            if (!TryReadTplAreaLinks(payload, out ushort[] ax, out ushort[] ay, out ushort[] linkCounts, out ushort[][] q0, out ushort[][] q1, out ushort[][] q2, out ushort[][] q3, out string error))
                return error;

            int areaCount = ax?.Length ?? 0;
            if (areaCount <= 0)
                return "areas=0; samples=<none>";

            var candidates = Enumerable.Range(0, areaCount)
                .Where(i => linkCounts[i] > 0)
                .OrderByDescending(i => linkCounts[i])
                .ThenBy(i => i)
                .Take(3)
                .ToArray();

            var sb = new StringBuilder();
            for (int n = 0; n < candidates.Length; n++)
            {
                int area = candidates[n];
                if (n > 0) sb.Append(" | ");
                sb.Append(area)
                    .Append('@').Append(ax[area]).Append(',').Append(ay[area])
                    .Append(" lc=").Append(linkCounts[area])
                    .Append(" edges=");

                int emitted = 0;
                for (int i = 0; i < q2[area].Length && emitted < 3; i++)
                {
                    int target = q2[area][i];
                    if (target == 0xFFFF || target < 0 || target >= areaCount)
                        continue;

                    if (emitted > 0) sb.Append(" ; ");
                    sb.Append(target)
                        .Append("[")
                        .Append(q0[area][i]).Append(',')
                        .Append(q1[area][i]).Append(',')
                        .Append(q2[area][i]).Append(',')
                        .Append(q3[area][i]).Append(']');
                    emitted++;
                }

                if (emitted == 0)
                    sb.Append("<no-valid-q2>");
            }

            return $"areas={areaCount}; targetField=q2; topLinkAreas={sb}";
        }


private static string BuildTplSemanticCompare(byte[] payload, DecodedRoadNet roadNet)
{
    if (payload == null || payload.Length == 0) return "missing";
    if (roadNet == null || roadNet.Nodes == null || roadNet.Nodes.Count == 0) return "no-rne2";
    if (!TryReadTplAreaLinks(payload, out ushort[] ax, out ushort[] ay, out ushort[] linkCounts, out ushort[][] q0, out ushort[][] q1, out ushort[][] q2, out ushort[][] q3, out string error))
        return error;

    long total = 0;
    long q2Road = 0;
    long q3Zero = 0;
    long xyExact = 0;
    long onRoadExact = 0;
    long mixedXY = 0;
    long q0MatchesRoadId = 0;
    long q1MatchesRoadId = 0;
    long q0MatchesWaypoint = 0;
    long q1MatchesWaypoint = 0;
    long q0NearTargetX = 0;
    long q1NearTargetY = 0;
    int targetMax = roadNet.Nodes.Count;

    for (int area = 0; area < q2.Length; area++)
    {
        ushort[] arr2 = q2[area];
        if (arr2 == null) continue;
        for (int i = 0; i < arr2.Length; i++)
        {
            int target = arr2[i];
            if (target < 0 || target >= targetMax) continue;
            total++;
            q2Road++;
            if (q3[area][i] == 0) q3Zero++;
            RoadKnot rk = roadNet.Nodes[target];
            int v0 = q0[area][i];
            int v1 = q1[area][i];
            if (v0 == rk.X && v1 == rk.Y) xyExact++;
            if (rk.HasOnRoad && v0 == rk.XOnRoad && v1 == rk.YOnRoad) onRoadExact++;
            if (rk.HasOnRoad && ((v0 == rk.X && v1 == rk.YOnRoad) || (v0 == rk.XOnRoad && v1 == rk.Y))) mixedXY++;
            if (Math.Abs(v0 - rk.X) <= 64) q0NearTargetX++;
            if (Math.Abs(v1 - rk.Y) <= 64) q1NearTargetY++;
            for (int k = 0; k < Math.Min(rk.NLinks, Rne2MaxLink); k++)
            {
                if (v0 == rk.RoadID[k]) q0MatchesRoadId++;
                if (v1 == rk.RoadID[k]) q1MatchesRoadId++;
                if (v0 == rk.WayPointToPointIndex[k]) q0MatchesWaypoint++;
                if (v1 == rk.WayPointToPointIndex[k]) q1MatchesWaypoint++;
            }
        }
    }

    string guess = GuessTplSemanticMode(total, xyExact, onRoadExact, mixedXY, q0MatchesRoadId, q1MatchesRoadId, q0MatchesWaypoint, q1MatchesWaypoint, q3Zero, q0NearTargetX, q1NearTargetY);
    return $"areas={ax.Length}; roadKnots={roadNet.Nodes.Count}; totalRoadTargets={total}; q2Road={q2Road}; q3Zero={q3Zero}; xyExact={xyExact}; onRoadExact={onRoadExact}; mixed={mixedXY}; q0RoadId={q0MatchesRoadId}; q1RoadId={q1MatchesRoadId}; q0Wp={q0MatchesWaypoint}; q1Wp={q1MatchesWaypoint}; q0NearX={q0NearTargetX}; q1NearY={q1NearTargetY}; guess={guess}";
}

private static string GuessTplSemanticMode(long total, long xyExact, long onRoadExact, long mixedXY, long q0RoadId, long q1RoadId, long q0Wp, long q1Wp, long q3Zero, long q0NearX, long q1NearY)
{
    if (total <= 0) return "no-road-targets";
    if (onRoadExact * 4 >= total * 3) return "q0q1=target-onRoad-xy; q2=roadId; q3=zero";
    if (xyExact * 4 >= total * 3) return "q0q1=target-xy; q2=roadId; q3=zero";
    if (mixedXY * 4 >= total * 3) return "q0q1=mixed-target/onRoad-xy; q2=roadId; q3=zero";
    if ((q0NearX * 4 >= total * 3 || q1NearY * 4 >= total * 3) && q3Zero * 4 >= total * 3) return "q0q1=coordinate-like; q2=roadId; q3=zero";
    if ((q0RoadId > total / 4 || q1RoadId > total / 4) && q3Zero * 4 >= total * 3) return "q0/q1 contain roadId-like data; q2=roadId; q3=zero";
    if ((q0Wp > total / 4 || q1Wp > total / 4) && q3Zero * 4 >= total * 3) return "q0/q1 contain waypoint-like data; q2=roadId; q3=zero";
    return "q2=roadId-strong; q0q1-unknown-coord-like; q3=zero-like";
}

private static string BuildTplSemanticSamples(byte[] payload, DecodedRoadNet roadNet)
{
    if (payload == null || payload.Length == 0) return "missing";
    if (roadNet == null || roadNet.Nodes == null || roadNet.Nodes.Count == 0) return "no-rne2";
    if (!TryReadTplAreaLinks(payload, out ushort[] ax, out ushort[] ay, out ushort[] linkCounts, out ushort[][] q0, out ushort[][] q1, out ushort[][] q2, out ushort[][] q3, out string error))
        return error;

    int areaCount = ax != null ? ax.Length : 0;
    if (areaCount <= 0) return "areas=0";
    var areas = Enumerable.Range(0, areaCount)
        .Where(i => linkCounts[i] > 0)
        .OrderByDescending(i => linkCounts[i])
        .ThenBy(i => i)
        .Take(3)
        .ToArray();
    if (areas.Length == 0) return $"areas={areaCount}; samples=<none>";

    var sb = new StringBuilder();
    foreach (int area in areas)
    {
        if (sb.Length > 0) sb.Append(" | ");
        sb.Append('a').Append(area).Append('@').Append(ax[area]).Append(',').Append(ay[area]).Append(" lc=").Append(linkCounts[area]).Append(" edges=");
        int emitted = 0;
        for (int i = 0; i < q2[area].Length && emitted < 3; i++)
        {
            int target = q2[area][i];
            if (target < 0 || target >= roadNet.Nodes.Count) continue;
            RoadKnot rk = roadNet.Nodes[target];
            if (emitted > 0) sb.Append(" ; ");
            sb.Append("r").Append(target)
              .Append(" q=").Append(q0[area][i]).Append(',').Append(q1[area][i]).Append(',').Append(q2[area][i]).Append(',').Append(q3[area][i])
              .Append(" tgt=").Append(rk.X).Append(',').Append(rk.Y);
            if (rk.HasOnRoad)
                sb.Append(" on=").Append(rk.XOnRoad).Append(',').Append(rk.YOnRoad);
            emitted++;
        }
        if (emitted == 0) sb.Append("<no-road-q2>");
    }
    return $"areas={areaCount}; samples={sb}";
}

private static string BuildLoc2DecodeSummary(byte[] payload, DecodedRoadNet net)
{
    if (payload == null || payload.Length < 8) return $"bytes={(payload != null ? payload.Length : 0)}; missing";

    int head0 = ReadInt32LE(payload, 0);
    int head1 = payload.Length >= 8 ? ReadInt32LE(payload, 4) : 0;
    int wpMax = GetMaxWaypointIndex(net);
    int wpUnique = GetUniqueWaypointCount(net);
    int stride, headerSkip, recCount, chosenHeader;
    string layout = GuessLoc2Layout(payload, head0, head1, out stride, out headerSkip, out recCount, out chosenHeader);
    int fieldCount = stride > 0 ? Math.Max(1, stride / 2) : 0;
    return $"bytes={payload.Length}; head0={head0}; head1={head1}; guess={layout}; chosenHeader={chosenHeader}; recCount={recCount}; stride={stride}; headerSkip={headerSkip}; fieldCount={fieldCount}; wpMax={wpMax}; wpUnique={wpUnique}; wpCoveredByHead0={(head0 > 0 && wpMax <= head0 ? 1 : 0)}";
}

private static string BuildLoc2WaypointRelation(byte[] payload, DecodedRoadNet net)
{
    if (payload == null || payload.Length < 8) return "missing";
    int head0 = ReadInt32LE(payload, 0);
    int head1 = payload.Length >= 8 ? ReadInt32LE(payload, 4) : 0;
    int stride, headerSkip, recCount, chosenHeader;
    string layout = GuessLoc2Layout(payload, head0, head1, out stride, out headerSkip, out recCount, out chosenHeader);
    if (stride <= 0 || recCount <= 0 || headerSkip < 0 || headerSkip + recCount * stride > payload.Length)
        return $"guess={layout}; unresolved";

    int fieldCount = Math.Max(1, stride / 2);
    int inspectFields = Math.Min(fieldCount, 5);
    int[] minVals = Enumerable.Repeat(int.MaxValue, inspectFields).ToArray();
    int[] maxVals = Enumerable.Repeat(int.MinValue, inspectFields).ToArray();
    int[] wpHits = new int[inspectFields];
    int[] knotHits = new int[inspectFields];
    int[] zeroHits = new int[inspectFields];
    var usedWp = BuildWaypointSet(net);
    int knotCount = net != null ? net.NodeCount : 0;

    int baseOffset = headerSkip;
    for (int i = 0; i < recCount; i++)
    {
        int recOff = baseOffset + i * stride;
        for (int f = 0; f < inspectFields; f++)
        {
            int fieldOff = recOff + f * 2;
            if (fieldOff + 1 >= payload.Length) break;
            int v = ReadUInt16LE(payload, fieldOff);
            if (v < minVals[f]) minVals[f] = v;
            if (v > maxVals[f]) maxVals[f] = v;
            if (v == 0) zeroHits[f]++;
            if (usedWp.Contains((ushort)v)) wpHits[f]++;
            if (v >= 0 && v < knotCount) knotHits[f]++;
        }
    }

    int bestWpField = 0;
    for (int f = 1; f < inspectFields; f++)
        if (wpHits[f] > wpHits[bestWpField]) bestWpField = f;
    int bestKnotField = 0;
    for (int f = 1; f < inspectFields; f++)
        if (knotHits[f] > knotHits[bestKnotField]) bestKnotField = f;

    var sb = new StringBuilder();
    sb.Append($"guess={layout}; recCount={recCount}; stride={stride}; headerSkip={headerSkip}; ");
    sb.Append($"bestWp=f{bestWpField}({wpHits[bestWpField]}); bestRoad=f{bestKnotField}({knotHits[bestKnotField]}); ");
    sb.Append("fields=");
    for (int f = 0; f < inspectFields; f++)
    {
        if (f > 0) sb.Append(" | ");
        sb.Append($"f{f}:min={minVals[f]},max={maxVals[f]},wp={wpHits[f]},road={knotHits[f]},zero={zeroHits[f]}");
    }
    sb.Append("; samples=");
    int samples = Math.Min(3, recCount);
    for (int i = 0; i < samples; i++)
    {
        if (i > 0) sb.Append(" | ");
        int recOff = baseOffset + i * stride;
        sb.Append($"r{i}=");
        for (int f = 0; f < inspectFields; f++)
        {
            if (f > 0) sb.Append(',');
            int fieldOff = recOff + f * 2;
            int v = fieldOff + 1 < payload.Length ? ReadUInt16LE(payload, fieldOff) : -1;
            sb.Append(v);
        }
    }
    return sb.ToString();
}


private static string BuildRoadGraphSummary(ParsedMap map)
{
    if (map == null || map.DecodedRne2 == null || map.DecodedRne2.Nodes == null) return "missing";

    var net = map.DecodedRne2;
    int nodes = net.Nodes.Count;
    int directed = 0;
    int zeroDeg = 0;
    int maxDeg = 0;
    var roadIds = new HashSet<int>();
    var waypoints = new HashSet<int>();
    for (int i = 0; i < nodes; i++)
    {
        var node = net.Nodes[i];
        int deg = Math.Clamp(node.NLinks, 0, Rne2MaxLink);
        directed += deg;
        if (deg == 0) zeroDeg++;
        if (deg > maxDeg) maxDeg = deg;
        for (int q = 0; q < deg; q++)
        {
            if (node.RoadID[q] != 0) roadIds.Add(node.RoadID[q]);
            if (node.WayPointToPointIndex[q] != 0) waypoints.Add(node.WayPointToPointIndex[q]);
        }
    }

    int tpl0Refs = CountTplRoadDirectRefs(map.Chunk0TPL, net.NodeCount);
    int tpl1Refs = CountTplRoadDirectRefs(map.Chunk1TPL, net.NodeCount);
    int tpl2Refs = CountTplRoadDirectRefs(map.Chunk2TPL, net.NodeCount);
    int tpl0Areas = CountTplAreasWithLinks(map.Chunk0TPL);
    int tpl1Areas = CountTplAreasWithLinks(map.Chunk1TPL);
    int tpl2Areas = CountTplAreasWithLinks(map.Chunk2TPL);

    return $"nodes={nodes}; directed={directed}; zeroDeg={zeroDeg}; maxDeg={maxDeg}; uniqueRoadIds={roadIds.Count}; uniqueWaypoints={waypoints.Count}; tplRoadRefs=0TPL:{tpl0Refs},1TPL:{tpl1Refs},2TPL:{tpl2Refs}; tplAreasWithLinks=0TPL:{tpl0Areas},1TPL:{tpl1Areas},2TPL:{tpl2Areas}";
}

private static string BuildRoadOverlaySummary(ParsedMap map)
{
    if (map == null || map.DecodedRne2 == null || map.DecodedRne2.Nodes == null) return "missing";
    var net = map.DecodedRne2;
    int nodes = net.Nodes.Count;
    int segments = 0;
    int minX = int.MaxValue, minY = int.MaxValue, maxX = int.MinValue, maxY = int.MinValue;
    for (int i = 0; i < nodes; i++)
    {
        var node = net.Nodes[i];
        int deg = Math.Clamp(node.NLinks, 0, Rne2MaxLink);
        for (int q = 0; q < deg; q++)
        {
            int t = node.Links[q];
            if (t >= i && t >= 0 && t < nodes) segments++;
        }
        if (node.X < minX) minX = node.X;
        if (node.Y < minY) minY = node.Y;
        if (node.X > maxX) maxX = node.X;
        if (node.Y > maxY) maxY = node.Y;
    }
    if (nodes == 0) { minX = minY = maxX = maxY = 0; }
    return $"mode=debug-quad-mesh; enabled={(EnableRoadDebugOverlay ? 1 : 0)}; nodes={nodes}; undirectedSegments={segments}; bounds={minX},{minY}-{maxX},{maxY}; next=stage10-road-surface";
}

private static int CountTplRoadDirectRefs(byte[] payload, int roadKnots)
{
    if (payload == null || payload.Length == 0 || roadKnots <= 0) return 0;
    if (!TryReadTplAreaLinks(payload, out _, out _, out _, out _, out _, out ushort[][] q2, out _, out _)) return 0;
    int hits = 0;
    if (q2 == null) return 0;
    foreach (var arr in q2)
    {
        if (arr == null) continue;
        foreach (ushort v in arr)
        {
            if (v < roadKnots) hits++;
        }
    }
    return hits;
}

private static int CountTplAreasWithLinks(byte[] payload)
{
    if (payload == null || payload.Length == 0) return 0;
    if (!TryReadTplAreaHeaders(payload, out _, out _, out ushort[] linkCounts, out _, out _, out _, out _, out _)) return 0;
    int count = 0;
    if (linkCounts == null) return 0;
    for (int i = 0; i < linkCounts.Length; i++)
        if (linkCounts[i] > 0) count++;
    return count;
}

private static string GuessLoc2Layout(byte[] payload, int head0, int head1, out int stride, out int headerSkip, out int recCount, out int chosenHeader)
{
    stride = 0;
    headerSkip = -1;
    recCount = 0;
    chosenHeader = 0;
    if (payload == null || payload.Length <= 0) return "missing";

    int[] countCandidates = { head0, head1 };
    int[] strideCandidates = { 10, 8, 12, 16, 20, 24 };
    string bestName = "unresolved";
    int bestScore = int.MinValue;
    foreach (int count in countCandidates)
    {
        if (count <= 0 || count > 100000) continue;
        foreach (int s in strideCandidates)
        {
            int remain = payload.Length - count * s;
            if (remain < 0) continue;
            int score = 0;
            if (remain % 4 == 0) score += 4;
            if (remain >= 0 && remain <= 4096) score += 8;
            if (remain >= 8) score += 2;
            if (s == 10) score += 3;
            if (count == head0) score += 3;
            if (count == head1) score += 1;
            if (score > bestScore)
            {
                bestScore = score;
                stride = s;
                headerSkip = remain;
                recCount = count;
                chosenHeader = count;
                bestName = $"count{(count == head0 ? 0 : 1)}-stride{s}";
            }
        }
    }
    return bestName;
}

private static HashSet<ushort> BuildWaypointSet(DecodedRoadNet net)
{
    var set = new HashSet<ushort>();
    if (net == null) return set;
    foreach (var node in net.Nodes)
    {
        if (node?.WayPointToPointIndex == null) continue;
        int degree = Math.Min(Math.Max(node.NLinks, 0), Math.Min(Rne2MaxLink, node.WayPointToPointIndex.Length));
        for (int i = 0; i < degree; i++)
        {
            ushort v = node.WayPointToPointIndex[i];
            if (v != 0) set.Add(v);
        }
    }
    return set;
}

private static int GetUniqueWaypointCount(DecodedRoadNet net)
{
    return BuildWaypointSet(net).Count;
}

private static int GetMaxWaypointIndex(DecodedRoadNet net)
{
    if (net == null) return 0;
    int max = 0;
    foreach (var node in net.Nodes)
    {
        if (node?.WayPointToPointIndex == null) continue;
        int degree = Math.Min(Math.Max(node.NLinks, 0), Math.Min(Rne2MaxLink, node.WayPointToPointIndex.Length));
        for (int i = 0; i < degree; i++)
        {
            int v = node.WayPointToPointIndex[i];
            if (v > max) max = v;
        }
    }
    return max;
}

private static string BuildTextChunkSummary(byte[] payload, string chunkName)
{
    if (payload == null || payload.Length == 0) return "missing";
    if (payload.Length < 4) return $"bytes={payload.Length}; too-short";

    int claimed = BitConverter.ToInt32(payload, 0);
    int available = Math.Max(0, payload.Length - 4);
    int used = claimed > 0 && claimed <= available ? claimed : available;
    if (used > available) used = available;

    string text = DecodeLooseAscii(payload, 4, used);
    int trimmedBytes = used;
    while (trimmedBytes > 0 && payload[4 + trimmedBytes - 1] == 0) trimmedBytes--;
    int lineCount = 0;
    int angleCount = 0;
    for (int i = 0; i < text.Length; i++)
    {
        char c = text[i];
        if (c == '\n') lineCount++;
        if (c == '<') angleCount++;
    }
    if (text.Length > 0) lineCount++;

    string tags = ExtractLooseTags(text, 5);
    string head = BuildTextHeadSample(text, 72);
    bool xmlLike = angleCount >= 2 && text.IndexOf('>') >= 0;
    bool lenMatch = claimed == available || claimed == trimmedBytes;
    return $"bytes={payload.Length}; claimed={claimed}; used={used}; trimmed={trimmedBytes}; lenMatch={(lenMatch ? 1 : 0)}; xmlLike={(xmlLike ? 1 : 0)}; lines={lineCount}; angles={angleCount}; tags={tags}; head={head}";
}

private static string DecodeLooseAscii(byte[] payload, int start, int count)
{
    if (payload == null || count <= 0 || start < 0 || start >= payload.Length) return string.Empty;
    count = Math.Min(count, payload.Length - start);
    var sb = new StringBuilder(count);
    for (int i = 0; i < count; i++)
    {
        byte b = payload[start + i];
        if (b == 0) continue;
        if (b == 9 || b == 10 || b == 13)
        {
            sb.Append((char)b);
        }
        else if (b >= 32 && b < 127)
        {
            sb.Append((char)b);
        }
        else
        {
            sb.Append(' ');
        }
    }
    return sb.ToString();
}

private static string ExtractLooseTags(string text, int maxTags)
{
    if (string.IsNullOrEmpty(text)) return "none";
    var tags = new List<string>();
    var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    for (int i = 0; i < text.Length - 1 && tags.Count < maxTags; i++)
    {
        if (text[i] != '<') continue;
        int j = i + 1;
        while (j < text.Length && (text[j] == '/' || text[j] == '!' || text[j] == '?' || char.IsWhiteSpace(text[j]))) j++;
        int k = j;
        while (k < text.Length)
        {
            char c = text[k];
            if (!(char.IsLetterOrDigit(c) || c == '_' || c == '-')) break;
            k++;
        }
        if (k <= j) continue;
        string tag = text.Substring(j, k - j);
        if (seen.Add(tag)) tags.Add(tag);
        i = k - 1;
    }
    return tags.Count > 0 ? string.Join("|", tags) : "none";
}

private static string BuildTextHeadSample(string text, int maxChars)
{
    if (string.IsNullOrEmpty(text)) return "<empty>";
    var sb = new StringBuilder();
    for (int i = 0; i < text.Length && sb.Length < maxChars; i++)
    {
        char c = text[i];
        if (c == '\r' || c == '\n' || c == '\t') c = ' ';
        if (char.IsControl(c)) continue;
        sb.Append(c);
    }
    string s = sb.ToString().Trim();
    return string.IsNullOrEmpty(s) ? "<blank>" : s;
}

        private static bool TryReadTplAreaLinks(byte[] payload, out ushort[] ax, out ushort[] ay, out ushort[] linkCounts, out ushort[][] q0, out ushort[][] q1, out ushort[][] q2, out ushort[][] q3, out string error)
        {
            ax = Array.Empty<ushort>();
            ay = Array.Empty<ushort>();
            linkCounts = Array.Empty<ushort>();
            q0 = Array.Empty<ushort[]>();
            q1 = Array.Empty<ushort[]>();
            q2 = Array.Empty<ushort[]>();
            q3 = Array.Empty<ushort[]>();
            error = "";

            if (payload == null || payload.Length < 4)
            {
                error = "missing";
                return false;
            }

            int cursor = 0;
            int areaCount = ReadInt32LE(payload, cursor);
            cursor += 4;
            if (areaCount < 0)
            {
                error = "negative areaCount";
                return false;
            }

            ax = new ushort[areaCount];
            ay = new ushort[areaCount];
            linkCounts = new ushort[areaCount];
            q0 = new ushort[areaCount][];
            q1 = new ushort[areaCount][];
            q2 = new ushort[areaCount][];
            q3 = new ushort[areaCount][];

            for (int area = 0; area < areaCount; area++)
            {
                if (cursor + 6 > payload.Length)
                {
                    error = $"area header overflow at {area}";
                    return false;
                }

                ax[area] = ReadUInt16LE(payload, cursor + 0);
                ay[area] = ReadUInt16LE(payload, cursor + 2);
                ushort lc = ReadUInt16LE(payload, cursor + 4);
                linkCounts[area] = lc;
                cursor += 6;

                long linkBytes = (long)lc * 8L;
                if (cursor + linkBytes > payload.Length)
                {
                    error = $"link array overflow at area={area}";
                    return false;
                }

                q0[area] = new ushort[lc];
                q1[area] = new ushort[lc];
                q2[area] = new ushort[lc];
                q3[area] = new ushort[lc];
                for (int i = 0; i < lc; i++)
                {
                    q0[area][i] = ReadUInt16LE(payload, cursor + i * 8 + 0);
                    q1[area][i] = ReadUInt16LE(payload, cursor + i * 8 + 2);
                    q2[area][i] = ReadUInt16LE(payload, cursor + i * 8 + 4);
                    q3[area][i] = ReadUInt16LE(payload, cursor + i * 8 + 6);
                }
                cursor += checked((int)linkBytes);
            }

            return true;
        }

        private static bool TryReadTplAreaHeaders(byte[] payload, out ushort[] ax, out ushort[] ay, out ushort[] linkCounts, out ushort[] firstQ0, out ushort[] firstQ1, out ushort[] firstQ2, out ushort[] firstQ3, out string error)
        {
            ax = Array.Empty<ushort>();
            ay = Array.Empty<ushort>();
            linkCounts = Array.Empty<ushort>();
            firstQ0 = Array.Empty<ushort>();
            firstQ1 = Array.Empty<ushort>();
            firstQ2 = Array.Empty<ushort>();
            firstQ3 = Array.Empty<ushort>();
            error = "";

            if (payload == null || payload.Length < 4)
            {
                error = "missing";
                return false;
            }

            int cursor = 0;
            int areaCount = ReadInt32LE(payload, cursor);
            cursor += 4;
            if (areaCount < 0)
            {
                error = "negative areaCount";
                return false;
            }

            ax = new ushort[areaCount];
            ay = new ushort[areaCount];
            linkCounts = new ushort[areaCount];
            firstQ0 = new ushort[areaCount];
            firstQ1 = new ushort[areaCount];
            firstQ2 = new ushort[areaCount];
            firstQ3 = new ushort[areaCount];

            for (int i = 0; i < areaCount; i++)
            {
                if (cursor + 6 > payload.Length)
                {
                    error = $"area header overflow at {i}";
                    return false;
                }
                ax[i] = ReadUInt16LE(payload, cursor);
                ay[i] = ReadUInt16LE(payload, cursor + 2);
                ushort lc = ReadUInt16LE(payload, cursor + 4);
                linkCounts[i] = lc;
                cursor += 6;

                long linkBytes = (long)lc * 8L;
                if (cursor + linkBytes > payload.Length)
                {
                    error = $"link array overflow at area={i}";
                    return false;
                }
                if (lc > 0 && cursor + 8 <= payload.Length)
                {
                    firstQ0[i] = ReadUInt16LE(payload, cursor + 0);
                    firstQ1[i] = ReadUInt16LE(payload, cursor + 2);
                    firstQ2[i] = ReadUInt16LE(payload, cursor + 4);
                    firstQ3[i] = ReadUInt16LE(payload, cursor + 6);
                }
                cursor += checked((int)linkBytes);
            }
            return true;
        }

        private static bool TryReadTplTopRef(byte[] payload, int maxTH, out int areaCount, out int topLx, out ushort[] topRefs, out string error)
        {
            areaCount = 0;
            topLx = 0;
            topRefs = null;
            error = "";

            if (payload == null || payload.Length == 0)
            {
                error = "missing";
                return false;
            }

            if (!TryResolveTplChunkPayloadEnd(payload, 0, payload.Length, maxTH, out _, out _, out _, out _, out _))
            {
                error = "resolve-failed";
                return false;
            }

            int cursor = 0;
            areaCount = ReadInt32LE(payload, cursor);
            cursor += 4;
            if (areaCount < 0)
            {
                error = "negative areaCount";
                return false;
            }

            for (int i = 0; i < areaCount; i++)
            {
                if (cursor + 6 > payload.Length)
                {
                    error = $"area header overflow at {i}";
                    return false;
                }
                ushort linkCount = ReadUInt16LE(payload, cursor + 4);
                cursor += 6;
                long linkBytes = (long)linkCount * 8L;
                if (cursor + linkBytes > payload.Length)
                {
                    error = $"link array overflow at area={i}";
                    return false;
                }
                cursor += checked((int)linkBytes);
            }

            topLx = maxTH > 1 ? (maxTH >> 1) : 0;
            if (topLx <= 0)
            {
                error = "invalid topLx";
                return false;
            }

            int cellCount = checked(topLx * topLx);
            int topRefBytes = checked(cellCount * 2);
            if (cursor + topRefBytes > payload.Length)
            {
                error = "topRef overflow";
                return false;
            }

            topRefs = new ushort[cellCount];
            for (int i = 0; i < cellCount; i++)
                topRefs[i] = ReadUInt16LE(payload, cursor + i * 2);

            return true;
        }

        private static string BuildHexHead(byte[] payload, int maxBytes)
        {
            if (payload == null || payload.Length == 0) return "<empty>";
            int count = Mathf.Clamp(maxBytes, 0, payload.Length);
            if (count <= 0) return "<empty>";
            var sb = new StringBuilder(count * 3);
            for (int i = 0; i < count; i++)
            {
                if (i > 0) sb.Append(' ');
                sb.Append(payload[i].ToString("X2"));
            }
            return sb.ToString();
        }

        private static uint ComputeFnv1a32(byte[] payload)
        {
            unchecked
            {
                uint hash = 2166136261u;
                if (payload == null) return hash;
                for (int i = 0; i < payload.Length; i++)
                {
                    hash ^= payload[i];
                    hash *= 16777619u;
                }
                return hash;
            }
        }


