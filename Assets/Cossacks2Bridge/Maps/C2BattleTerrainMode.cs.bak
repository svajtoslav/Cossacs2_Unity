        {
            public int[] GroundUsage = new int[64];
            public byte[] TexCrossing = new byte[64 * 64];
            public FactureInfoEntry[] Factures = Array.Empty<FactureInfoEntry>();
            public GroundTextureEntry[] GTex = CreateDefaultGroundTextureTable();
            public short[] RandomTable;
            public bool GTexInitialized;
            public string Info = "";
        }

