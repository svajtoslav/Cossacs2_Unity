        public static void OpenFromBattles(Cossacks2Bridge.UnityAdapters.MenuBootstrap bootstrap)
        {
            if (bootstrap == null)
            {
                Debug.LogWarning("[C2:MAP] MenuBootstrap is null, cannot open terrain mode.");
                return;
            }

            // LoadSave.cpp SetLight(0,20,30) is applied by the external map-load entry path before terrain opens.

            var oldRoot = GameObject.Find(RootName);
            if (oldRoot != null)
                SafeDestroy(oldRoot);

            var go = new GameObject(RootName);
            var mode = go.AddComponent<C2BattleTerrainMode>();
            mode.InitializeSafe(bootstrap);
        }

        private void InitializeSafe(Cossacks2Bridge.UnityAdapters.MenuBootstrap bootstrap)
        {
            try
            {
                Initialize(bootstrap);
            }
            catch (Exception ex)
            {
                Debug.LogError("[C2:MAP] Unhandled terrain-mode exception:\n" + ex);
                try
                {
                    BuildErrorOverlay("Ошибка terrain-view:\n" + ex.GetType().Name + "\n" + ex.Message);
                }
                catch (Exception ex2)
                {
                    Debug.LogError("[C2:MAP] Failed to show error overlay:\n" + ex2);
                }
            }
        }

        private void Initialize(Cossacks2Bridge.UnityAdapters.MenuBootstrap bootstrap)
        {
            _bootstrap = bootstrap;
            _yaw = CameraYaw;
            _pitch = CameraPitch;
            _terrainDebugMode = Mathf.Clamp(InitialTerrainDebugMode, 1, 7);

            if (!TryResolveSelectedMapPath(out _mapRelativePath, out _selectedId, out string resolveError))
            {
                Debug.LogWarning("[C2:MAP] Resolve failed: " + resolveError);
                BuildErrorOverlay("Не удалось определить карту.\n" + resolveError);
                return;
            }

            Debug.Log($"[C2:MAP] Selected map id='{_selectedId}' path='{_mapRelativePath}'");

            if (!TryParseMap(_bootstrap.Fs, _mapRelativePath, out _map, out string parseError))
            {
                Debug.LogWarning("[C2:MAP] Parse failed: " + parseError);
                BuildErrorOverlay("Ошибка чтения карты:\n" + parseError);
                return;
            }

            Debug.Log($"[C2:MAP] Parsed map: mode={(_map.IsMeshSurface ? "HSEM" : "SURF")} grid={_map.VertInLine}x{_map.MaxTH} bounds={_map.MinMapX},{_map.MinMapY}..{_map.MaxMapX},{_map.MaxMapY}");
            Debug.Log("[C2:MAP] terrainData " + BuildTerrainDataDiagnostics(_map));
            Debug.Log("[C2:MAP] terrainExpect " + BuildTerrainExpectedDiagnostics(_map));

            _preparedTerrainMesh = BuildTerrainMesh(_map);
            if (_preparedTerrainMesh == null)
            {
                BuildErrorOverlay("Не удалось построить mesh terrain.");
                return;
            }

            Debug.Log($"[C2:MAP] Prepared mesh '{_preparedTerrainMesh.name}' verts={_preparedTerrainMesh.vertexCount} tris={_preparedTerrainMesh.triangles.Length / 3}");
            Debug.Log("[C2:MAP] meshDiag " + BuildTerrainMeshDiagnostics(_map, _preparedTerrainMesh));

            DestroyUiAndOldMode(gameObject);

            BuildWorld(_selectedId, _preparedTerrainMesh);
        }

        private static void DestroyUiAndOldMode(GameObject keepRoot = null)
        {
            foreach (Canvas c in UnityEngine.Object.FindObjectsByType<Canvas>(FindObjectsSortMode.None))
            {
                if (c == null) continue;
                if (c.gameObject.name.StartsWith("C2_", StringComparison.OrdinalIgnoreCase))
                    SafeDestroy(c.gameObject);
            }

            foreach (Camera c in UnityEngine.Object.FindObjectsByType<Camera>(FindObjectsSortMode.None))
            {
                if (c == null) continue;
                if (c.gameObject.name == CameraName)
                    SafeDestroy(c.gameObject);
            }

            foreach (Light l in UnityEngine.Object.FindObjectsByType<Light>(FindObjectsSortMode.None))
            {
                if (l == null) continue;
                if (l.gameObject.name == LightName)
                    SafeDestroy(l.gameObject);
            }

            var oldRoot = GameObject.Find(RootName);
            if (oldRoot != null && oldRoot != keepRoot)
                SafeDestroy(oldRoot);
        }

        private static void SafeDestroy(UnityEngine.Object obj)
        {
            if (obj == null) return;
            if (Application.isPlaying) UnityEngine.Object.Destroy(obj);
            else UnityEngine.Object.DestroyImmediate(obj);
        }

        private bool TryResolveSelectedMapPath(out string relativePath, out string selectedId, out string error)
        {
            relativePath = "";
            selectedId = MenuActionSink.SingleBattlesSelectedId ?? "";
            error = "";

            if (MenuActionSink.SingleBattlesShowLoad)
            {
                error = "Режим \"Загрузить\" пока не поддержан для terrain-view.";
                return false;
            }

            bool showBattles = MenuActionSink.SingleBattlesShowBattles;
            string relDir = showBattles ? @"Missions\Battles" : @"Missions\Skirmish";

            if (string.IsNullOrWhiteSpace(selectedId))
            {
                string absDir0 = _bootstrap.Fs.ResolvePath(relDir);
                if (Directory.Exists(absDir0))
                {
                    var first = Directory.GetFiles(absDir0, "*.m3d")
                        .OrderBy(Path.GetFileNameWithoutExtension, StringComparer.OrdinalIgnoreCase)
                        .FirstOrDefault();
                    if (!string.IsNullOrWhiteSpace(first))
                        selectedId = Path.GetFileNameWithoutExtension(first);
                }
            }

            if (string.IsNullOrWhiteSpace(selectedId))
                selectedId = showBattles ? "Battle1" : "Skirmish1";

            string direct = relDir + @"\" + selectedId + ".m3d";
            if (_bootstrap.Fs.Exists(direct))
            {
                relativePath = direct;
                return true;
            }

            string absDir = _bootstrap.Fs.ResolvePath(relDir);
            if (!Directory.Exists(absDir))
            {
                error = "Каталог не найден: " + absDir;
                return false;
            }

            string selectedIdLocal = selectedId;
            string hit = Directory.GetFiles(absDir, "*.m3d")
                .FirstOrDefault(f => string.Equals(Path.GetFileNameWithoutExtension(f), selectedIdLocal, StringComparison.OrdinalIgnoreCase));

            if (string.IsNullOrWhiteSpace(hit))
            {
                error = "Файл карты не найден: " + direct;
                return false;
            }

            relativePath = relDir + @"\" + Path.GetFileName(hit);
            selectedId = Path.GetFileNameWithoutExtension(hit);
            return true;
        }

        private void BuildWorld(string selectedId, Mesh terrainMesh)
        {
            CreateCamera();
            CreateLight();
            CreateTerrainObject(selectedId, terrainMesh);
            InitializeStrictIsoCameraStateLikeOriginal(forceCenter: true);
            InitializeFreeCameraStateFromTerrainBounds();
            _freeCameraMode = false;
            ApplyActiveBattleCameraMode(forceLog: true);
            UpdateCameraTransform();
            Debug.Log("[C2:CAM] startupStrictInit=True mode=strict-with-free-on-insert");
        }

        private void CreateCamera()
        {
            _strictIsoCamera = CreateBattleCameraInstance(StrictIsoCameraName, 1000.0f, true);
            _freeCamera = CreateBattleCameraInstance(FreeCameraName, 1001.0f, false);
            _freeCameraMode = false;
            ApplyActiveBattleCameraMode(forceLog: true);
        }

        private Camera CreateBattleCameraInstance(string name, float depth, bool strictIso)
        {
            var go = new GameObject(name);
            go.transform.SetParent(transform, false);
            var cam = go.AddComponent<Camera>();
            cam.clearFlags = CameraClearFlags.SolidColor;
            cam.backgroundColor = new Color32(24, 28, 34, 255);
            cam.nearClipPlane = strictIso ? 10.0f : 0.1f;
            cam.farClipPlane = 1000000.0f;
            cam.depth = depth;
            cam.fieldOfView = strictIso ? 20.0f : 35.0f;
            cam.enabled = false;
            return cam;
        }

        private void ApplyActiveBattleCameraMode(bool forceLog)
        {
            bool freeActive = _freeCameraMode && _freeCamera != null;
            if (_strictIsoCamera != null)
                _strictIsoCamera.enabled = !freeActive;
            if (_freeCamera != null)
                _freeCamera.enabled = freeActive;
            _camera = freeActive ? _freeCamera : _strictIsoCamera;

            if (forceLog)
                Debug.Log($"[C2:CAM] mode={(freeActive ? "free-fly" : "strict-iso")} active={(_camera != null ? _camera.name : "<null>")}");
        }

        private void ToggleBattleCameraModeLikeOriginal()
        {
            if (_freeCamera == null)
                return;

            if (!_freeCameraStateInitialized)
                InitializeFreeCameraStateFromTerrainBounds();

            _freeCameraMode = !_freeCameraMode;
            ApplyActiveBattleCameraMode(forceLog: true);
            UpdateCameraTransform();
            UpdateRuntimeHud(true);
        }

        private void CreateLight()
        {
            var go = new GameObject(LightName);
            _light = go.AddComponent<Light>();
            _light.type = LightType.Directional;
            _light.color = new Color32(255, 248, 235, 255);
            _light.intensity = 0.58f;
            go.transform.rotation = Quaternion.Euler(52.0f, -32.0f, 0.0f);

            RenderSettings.ambientMode = AmbientMode.Flat;
            RenderSettings.ambientLight = new Color(0.20f, 0.21f, 0.22f, 1.0f);
            RenderSettings.ambientIntensity = 0.85f;
        }

        private void CreateTerrainObject(string selectedId, Mesh terrainMesh)
        {
            ReleaseTerrainRuntimeOwnedObjects();

            _strictRuntimeTerrainEnabled = true;
            _experimentalArrayPathEnabled = false;
            _factureEnabled = false;
            _terrainDebugMode = 1;

            _terrainGo = new GameObject("Terrain_" + selectedId);
            _terrainGo.transform.SetParent(transform, false);

            if (!TryCreateStrictRuntimeTerrain(selectedId, terrainMesh, _terrainGo.transform, out Material firstMaterial, out string buildInfo))
                throw new InvalidOperationException("Failed to create stripped strict-runtime terrain: " + buildInfo);

            _terrainMaterial = firstMaterial;
            _lastTerrainBuildInfo = buildInfo ?? "";
            Debug.Log($"[C2:REN] terrainMode=strict-runtime-active {_lastTerrainBuildInfo}");
            Debug.Log($"[C2:REN] terrainShader={_terrainMaterial?.shader?.name ?? "<null>"} mainTex={GetMaterialTextureDebugName(_terrainMaterial)}");
            Debug.Log($"[C2:REN] shaderSupported={_terrainMaterial?.shader?.isSupported ?? false} passCount={_terrainMaterial?.passCount ?? -1} rp={DescribeCurrentRenderPipeline()}");
            Debug.Log($"[C2:REN] terrainPipeline path=strict-runtime-active-stripped; proceduralWhitePath=runtime-deleted; fallback=deleted; water=deleted; waterPlugin=deleted; waterPanel=deleted; bounds=deleted; roads=deleted; overlay=deleted; textures=deleted");
            Debug.Log($"[C2:REN] terrainPos={_terrainGo.transform.position} terrainRot={_terrainGo.transform.rotation.eulerAngles} terrainScale={_terrainGo.transform.localScale}");
            Debug.Log($"[C2:AXIS] worldZSign={WorldZSign:0}; isMeshSurface={(_map != null && _map.IsMeshSurface ? 1 : 0)}");
        }

        


        


        private static Shader FindBestStrictRuntimeFlatMeshShaderLikeOriginal()
        {
            return Shader.Find("Sprites/Default")
                ?? Shader.Find("Unlit/Texture")
                ?? Shader.Find("Universal Render Pipeline/Unlit")
                ?? Shader.Find("Standard");
        }



        private void ReleaseTerrainRuntimeOwnedObjects()
        {

            if (_terrainRuntimeOwnedObjects.Count > 0)
            {
                for (int i = _terrainRuntimeOwnedObjects.Count - 1; i >= 0; i--)
                {
                    UnityEngine.Object obj = _terrainRuntimeOwnedObjects[i];
                    if (obj != null)
                        SafeDestroy(obj);
                }
                _terrainRuntimeOwnedObjects.Clear();
            }
            _terrainMaterial = null;
        }



        private sealed class TerrainRuntimeTriangleBuffer
        {
            public readonly List<Vector3> Vertices = new List<Vector3>(4096);
            public readonly List<int> Indices = new List<int>(4096);
            public readonly List<Color32> Colors = new List<Color32>(4096);
            public readonly List<Vector2> Uv0 = new List<Vector2>(4096);
            public readonly List<Vector2> Uv1 = new List<Vector2>(4096);
            public readonly List<Vector2> Uv2 = new List<Vector2>(4096);
            public readonly List<Vector4> Uv3 = new List<Vector4>(4096);
            public readonly List<Vector4> Tangents = new List<Vector4>(4096);

            public int TriangleCount => Indices.Count / 3;

            public void AddTriangle(
                Vector3 p0, Vector3 p1, Vector3 p2,
                Vector2 uv00, Vector2 uv01, Vector2 uv02,
                Vector2 uv10, Vector2 uv11, Vector2 uv12,
                Vector2 uv20, Vector2 uv21, Vector2 uv22,
                Vector4 layers,
                Color32 c0, Color32 c1, Color32 c2,
                Vector4 t0, Vector4 t1, Vector4 t2)
            {
                int baseIndex = Vertices.Count;
                Vertices.Add(p0);
                Vertices.Add(p1);
                Vertices.Add(p2);
                Indices.Add(baseIndex + 0);
                Indices.Add(baseIndex + 1);
                Indices.Add(baseIndex + 2);
                Uv0.Add(uv00);
                Uv0.Add(uv10);
                Uv0.Add(uv20);
                Uv1.Add(uv01);
                Uv1.Add(uv11);
                Uv1.Add(uv21);
                Uv2.Add(uv02);
                Uv2.Add(uv12);
                Uv2.Add(uv22);
                Uv3.Add(layers);
                Uv3.Add(layers);
                Uv3.Add(layers);
                Colors.Add(c0);
                Colors.Add(c1);
                Colors.Add(c2);
                Tangents.Add(t0);
                Tangents.Add(t1);
                Tangents.Add(t2);
            }

            public Mesh BuildMesh(string name)
            {
                var mesh = new Mesh();
                mesh.name = name;
                mesh.indexFormat = IndexFormat.UInt32;
                mesh.SetVertices(Vertices);
                mesh.SetTriangles(Indices, 0, true);
                mesh.SetColors(Colors);
                mesh.SetUVs(0, Uv0);
                mesh.SetUVs(1, Uv1);
                mesh.SetUVs(2, Uv2);
                mesh.SetUVs(3, Uv3);
                mesh.SetTangents(Tangents);
                mesh.RecalculateBounds();
                mesh.RecalculateNormals();
                return mesh;
            }
        }


        private sealed class GArrayBufferLikeOriginal
        {
            private Vector3[] _positionsLikeOriginal = new Vector3[0];
            private Vector2[] _uv0LikeOriginal = new Vector2[0];
            private uint[] _packedDiffuseLikeOriginal = new uint[0];
            private int _vertexCountLikeOriginal;

            public int VertexCountLikeOriginal => _vertexCountLikeOriginal;
            public int TriangleCount => _vertexCountLikeOriginal / 3;

            public IReadOnlyList<Vector3> PositionsLikeOriginal => _positionsLikeOriginal;
            public IReadOnlyList<Vector2> Uv0LikeOriginal => _uv0LikeOriginal;
            public IReadOnlyList<uint> PackedDiffuseArrayLikeOriginal => _packedDiffuseLikeOriginal;

            private void EnsureVertexCapacityLikeOriginal(int required)
            {
                if (_positionsLikeOriginal.Length >= required)
                    return;

                int newCap = _positionsLikeOriginal.Length > 0 ? _positionsLikeOriginal.Length : 256;
                while (newCap < required)
                    newCap <<= 1;

                Array.Resize(ref _positionsLikeOriginal, newCap);
                Array.Resize(ref _uv0LikeOriginal, newCap);
                Array.Resize(ref _packedDiffuseLikeOriginal, newCap);
            }

            public void AddTriangle(Vector3 p0, Vector3 p1, Vector3 p2, Vector2 uv0, Vector2 uv1, Vector2 uv2, uint d0, uint d1, uint d2)
            {
                int baseIndex = _vertexCountLikeOriginal;
                EnsureVertexCapacityLikeOriginal(baseIndex + 3);

                _positionsLikeOriginal[baseIndex + 0] = p0;
                _positionsLikeOriginal[baseIndex + 1] = p1;
                _positionsLikeOriginal[baseIndex + 2] = p2;
                _uv0LikeOriginal[baseIndex + 0] = uv0;
                _uv0LikeOriginal[baseIndex + 1] = uv1;
                _uv0LikeOriginal[baseIndex + 2] = uv2;
                _packedDiffuseLikeOriginal[baseIndex + 0] = d0;
                _packedDiffuseLikeOriginal[baseIndex + 1] = d1;
                _packedDiffuseLikeOriginal[baseIndex + 2] = d2;

                _vertexCountLikeOriginal += 3;
            }

            public void AddTriangleLikeOriginal(VertexTnL2LikeOriginal v0, VertexTnL2LikeOriginal v1, VertexTnL2LikeOriginal v2)
            {
                AddTriangle(
                    new Vector3(v0.X, v0.Y, v0.Z),
                    new Vector3(v1.X, v1.Y, v1.Z),
                    new Vector3(v2.X, v2.Y, v2.Z),
                    new Vector2(v0.U, v0.V),
                    new Vector2(v1.U, v1.V),
                    new Vector2(v2.U, v2.V),
                    v0.Diffuse,
                    v1.Diffuse,
                    v2.Diffuse);
            }

            public C2SurfaceDrawCall BuildSurfaceDrawCallLikeOriginal(string name, Func<uint, uint> remapPackedDiffuseLikeOriginal = null)
            {
                var builder = new C2SurfaceMeshBuilder();
                for (int i = 0; i < _vertexCountLikeOriginal; i += 3)
                {
                    builder.AddTriangleLikeOriginal(
                        MakeVertexLikeOriginal(i + 0, remapPackedDiffuseLikeOriginal),
                        MakeVertexLikeOriginal(i + 1, remapPackedDiffuseLikeOriginal),
                        MakeVertexLikeOriginal(i + 2, remapPackedDiffuseLikeOriginal));
                }

                return new C2SurfaceDrawCall(name, builder);
            }

            public VertexTnL2LikeOriginal[] BuildVertexArrayLikeOriginal(Func<uint, uint> remapPackedDiffuseLikeOriginal = null)
            {
                var arr = new VertexTnL2LikeOriginal[_vertexCountLikeOriginal];
                for (int i = 0; i < _vertexCountLikeOriginal; i++)
                    arr[i] = MakeVertexLikeOriginal(i, remapPackedDiffuseLikeOriginal);
                return arr;
            }

            private VertexTnL2LikeOriginal MakeVertexLikeOriginal(int index, Func<uint, uint> remapPackedDiffuseLikeOriginal)
            {
                Vector3 p = index < _vertexCountLikeOriginal ? _positionsLikeOriginal[index] : Vector3.zero;
                Vector2 uv = index < _vertexCountLikeOriginal ? _uv0LikeOriginal[index] : Vector2.zero;
                uint packed = index < _vertexCountLikeOriginal ? _packedDiffuseLikeOriginal[index] : 0xFFFFFFFFu;
                if (remapPackedDiffuseLikeOriginal != null)
                    packed = remapPackedDiffuseLikeOriginal(packed);
                return new VertexTnL2LikeOriginal(
                    p.x,
                    p.y,
                    p.z,
                    1.0f,
                    packed,
                    uv.x,
                    uv.y,
                    0.0f,
                    0.0f);
            }

            public Mesh BuildMesh(string name)
            {
                var mesh = new Mesh();
                mesh.name = name;
                mesh.indexFormat = _vertexCountLikeOriginal > 65535 ? UnityEngine.Rendering.IndexFormat.UInt32 : UnityEngine.Rendering.IndexFormat.UInt16;

                if (_vertexCountLikeOriginal <= 0)
                {
                    mesh.Clear();
                    return mesh;
                }

                var pos = new List<Vector3>(_vertexCountLikeOriginal);
                var uv0 = new List<Vector2>(_vertexCountLikeOriginal);
                var colors = new List<Color32>(_vertexCountLikeOriginal);
                var uv2 = new List<Vector4>(_vertexCountLikeOriginal);
                var indices = new int[_vertexCountLikeOriginal];

                for (int i = 0; i < _vertexCountLikeOriginal; i++)
                {
                    pos.Add(_positionsLikeOriginal[i]);
                    uv0.Add(_uv0LikeOriginal[i]);
                    colors.Add(VertexTnL2LikeOriginal.UnpackDiffuseLikeOriginal(_packedDiffuseLikeOriginal[i]));
                    uv2.Add(new Vector4(1.0f, 0.0f, 0.0f, 0.0f));
                    indices[i] = i;
                }

                mesh.SetVertices(pos);
                mesh.SetTriangles(indices, 0, true);
                mesh.SetUVs(0, uv0);
                mesh.SetColors(colors);
                mesh.SetUVs(2, uv2);
                mesh.RecalculateBounds();
                return mesh;
            }
        }

        

        private sealed class STriangDirectBufferLikeOriginal
        {
            private VertexTnL2LikeOriginal[] _verticesLikeOriginal = new VertexTnL2LikeOriginal[0];
            private int _vertexCountLikeOriginal;

            public int VertexCountLikeOriginal => _vertexCountLikeOriginal;
            public int TriangleCountLikeOriginal => _vertexCountLikeOriginal / 3;

            private void EnsureVertexCapacityLikeOriginal(int requiredVertices)
            {
                if (_verticesLikeOriginal.Length >= requiredVertices)
                    return;

                int newCap = _verticesLikeOriginal.Length > 0 ? _verticesLikeOriginal.Length : 256;
                while (newCap < requiredVertices)
                    newCap <<= 1;

                Array.Resize(ref _verticesLikeOriginal, newCap);
            }

            public void AddTriangleLikeOriginal(VertexTnL2LikeOriginal v0, VertexTnL2LikeOriginal v1, VertexTnL2LikeOriginal v2)
            {
                int baseIndex = _vertexCountLikeOriginal;
                EnsureVertexCapacityLikeOriginal(baseIndex + 3);
                _verticesLikeOriginal[baseIndex + 0] = v0;
                _verticesLikeOriginal[baseIndex + 1] = v1;
                _verticesLikeOriginal[baseIndex + 2] = v2;
                _vertexCountLikeOriginal += 3;
            }

            public VertexTnL2LikeOriginal[] BuildVertexArrayLikeOriginal()
            {
                var arr = new VertexTnL2LikeOriginal[_vertexCountLikeOriginal];
                if (_vertexCountLikeOriginal > 0)
                    Array.Copy(_verticesLikeOriginal, 0, arr, 0, _vertexCountLikeOriginal);
                return arr;
            }
        }

        private sealed class GroundVertexStageLikeOriginal
        {
            private VertexTnL2LikeOriginal[] _verticesLikeOriginal = new VertexTnL2LikeOriginal[0];
            private int[] _bucketByTriangleLikeOriginal = new int[0];
            private int _vertexCountLikeOriginal;

            public int VertexCountLikeOriginal => _vertexCountLikeOriginal;
            public int TriangleCountLikeOriginal => _vertexCountLikeOriginal / 3;

            private void EnsureTriangleCapacityLikeOriginal(int requiredTriangles)
            {
                if (_bucketByTriangleLikeOriginal.Length >= requiredTriangles)
                    return;

                int newCap = _bucketByTriangleLikeOriginal.Length > 0 ? _bucketByTriangleLikeOriginal.Length : 256;
                while (newCap < requiredTriangles)
                    newCap <<= 1;

                Array.Resize(ref _bucketByTriangleLikeOriginal, newCap);
            }

            private void EnsureVertexCapacityLikeOriginal(int requiredVertices)
            {
                if (_verticesLikeOriginal.Length >= requiredVertices)
                    return;

                int newCap = _verticesLikeOriginal.Length > 0 ? _verticesLikeOriginal.Length : 256;
                while (newCap < requiredVertices)
                    newCap <<= 1;

                Array.Resize(ref _verticesLikeOriginal, newCap);
            }

            public void AddTriangleLikeOriginal(int bucketId, VertexTnL2LikeOriginal v0, VertexTnL2LikeOriginal v1, VertexTnL2LikeOriginal v2)
            {
                int triIndex = TriangleCountLikeOriginal;
                int baseIndex = _vertexCountLikeOriginal;
                EnsureTriangleCapacityLikeOriginal(triIndex + 1);
                EnsureVertexCapacityLikeOriginal(baseIndex + 3);

                _bucketByTriangleLikeOriginal[triIndex] = bucketId;
                _verticesLikeOriginal[baseIndex + 0] = v0;
                _verticesLikeOriginal[baseIndex + 1] = v1;
                _verticesLikeOriginal[baseIndex + 2] = v2;
                _vertexCountLikeOriginal += 3;
            }

            public int GetBucketIdLikeOriginal(int triangleIndex)
            {
                if (triangleIndex < 0 || triangleIndex >= TriangleCountLikeOriginal)
                    return -1;
                return _bucketByTriangleLikeOriginal[triangleIndex];
            }

            public void CopyTriangleToLikeOriginal(int triangleIndex, GArrayBufferLikeOriginal dst)
            {
                if (dst == null || triangleIndex < 0 || triangleIndex >= TriangleCountLikeOriginal)
                    return;

                int baseIndex = triangleIndex * 3;
                dst.AddTriangleLikeOriginal(
                    _verticesLikeOriginal[baseIndex + 0],
                    _verticesLikeOriginal[baseIndex + 1],
                    _verticesLikeOriginal[baseIndex + 2]);
            }
        }

private sealed class VertexStreamLikeOriginal
        {
            public Material Material;
            public Mesh RuntimeMeshLikeOriginal;
            public VertexTnL2LikeOriginal[] VertexPtrLikeOriginal;
            public int VertexCountLikeOriginal;
            public int SubmitFirstVertexLikeOriginal;
            public int SubmitVertexCountLikeOriginal;
            public int SubmitSubMeshIndexLikeOriginal = -1;
            public int FactureIdLikeOriginal = -1;
            public bool Dot3LikeOriginal;
        }

        private sealed class SubMeshSubmitRangeLikeOriginal
        {
            public int FirstVertexLikeOriginal;
            public int VertexCountLikeOriginal;
            public int[] IndicesLikeOriginal;
        }

        private sealed class BaseMeshLikeOriginal
        {
            public string Name;
            public int VertexFormatLikeOriginal;
            public VertexStreamLikeOriginal ImmediateStreamLikeOriginal;
            public VertexStreamLikeOriginal[] GArrayLikeOriginal;
            public int[] NInGarrLikeOriginal;
            public int[] MaxInGarrLikeOriginal;
            public bool PreferDot3LikeOriginal;
            public bool UsesVertexPtrLikeOriginal;
            public Mesh RuntimeMeshLikeOriginal;
            public Mesh SharedRuntimeMeshLikeOriginal;
            public Material RuntimeMaterialLikeOriginal;
            public VertexTnL2LikeOriginal[] VertexPtrLikeOriginal;
            public VertexTnL2LikeOriginal[] SharedVertexPtrLikeOriginal;
            public List<SubMeshSubmitRangeLikeOriginal> SharedSubmitRangesLikeOriginal;
            public int ActiveSubmitFirstVertexLikeOriginal;
            public int ActiveSubmitVertexCountLikeOriginal;
            public int ActiveSubMeshIndexLikeOriginal = -1;
            public int NVertLikeOriginal;
            public int NIndLikeOriginal;
            public int NPriLikeOriginal;
            public int BoundFactureIdLikeOriginal = -1;
            public bool BoundDot3LikeOriginal;

            public VertexStreamLikeOriginal ResolveStreamLikeOriginal(int factureId)
            {
                if (GArrayLikeOriginal == null)
                    return ImmediateStreamLikeOriginal;
                if (factureId < 0 || factureId >= GArrayLikeOriginal.Length)
                    return ImmediateStreamLikeOriginal;
                return GArrayLikeOriginal[factureId];
            }

            public void SetVertexPtrLikeOriginal(VertexTnL2LikeOriginal[] vertexPtr)
            {
                VertexPtrLikeOriginal = vertexPtr;
            }

            public void SetNVertLikeOriginal(int nVert)
            {
                NVertLikeOriginal = nVert;
            }

            public void SetNIndLikeOriginal(int nInd)
            {
                NIndLikeOriginal = nInd;
            }

            public void SetNPriLikeOriginal(int nPri)
            {
                NPriLikeOriginal = nPri;
            }

            public bool BindImmediateStreamLikeOriginal()
            {
                return BindStreamLikeOriginal(ImmediateStreamLikeOriginal);
            }

            public bool SetVertexPtrFromGArrayLikeOriginal(int factureId)
            {
                return BindStreamLikeOriginal(ResolveStreamLikeOriginal(factureId));
            }

            public int ResolveActiveSubMeshFromRangeLikeOriginal()
            {
                if (SharedSubmitRangesLikeOriginal == null || SharedSubmitRangesLikeOriginal.Count == 0)
                    return ActiveSubMeshIndexLikeOriginal;

                int activeFirst = Mathf.Max(0, ActiveSubmitFirstVertexLikeOriginal);
                int activeCount = Mathf.Max(0, ActiveSubmitVertexCountLikeOriginal);
                if (activeCount <= 0)
                    return ActiveSubMeshIndexLikeOriginal;

                for (int i = 0; i < SharedSubmitRangesLikeOriginal.Count; i++)
                {
                    SubMeshSubmitRangeLikeOriginal range = SharedSubmitRangesLikeOriginal[i];
                    if (range == null)
                        continue;
                    if (range.FirstVertexLikeOriginal == activeFirst && range.VertexCountLikeOriginal == activeCount)
                        return i;
                }

                return ActiveSubMeshIndexLikeOriginal;
            }

            private bool BindStreamLikeOriginal(VertexStreamLikeOriginal stream)
            {
                Mesh runtimeMesh = SharedRuntimeMeshLikeOriginal != null ? SharedRuntimeMeshLikeOriginal : (stream != null ? stream.RuntimeMeshLikeOriginal : null);
                if (stream == null || runtimeMesh == null)
                    return false;

                RuntimeMaterialLikeOriginal = stream.Material;
                RuntimeMeshLikeOriginal = runtimeMesh;
                SetVertexPtrLikeOriginal(SharedVertexPtrLikeOriginal ?? stream.VertexPtrLikeOriginal);

                int submitVertexCount = stream.SubmitVertexCountLikeOriginal > 0 ? stream.SubmitVertexCountLikeOriginal : stream.VertexCountLikeOriginal;
                int submitFirstVertex = Mathf.Max(0, stream.SubmitFirstVertexLikeOriginal);

                ActiveSubmitFirstVertexLikeOriginal = submitFirstVertex;
                ActiveSubmitVertexCountLikeOriginal = submitVertexCount;
                ActiveSubMeshIndexLikeOriginal = SharedRuntimeMeshLikeOriginal != null && SharedSubmitRangesLikeOriginal != null && SharedSubmitRangesLikeOriginal.Count > 0
                    ? -1
                    : stream.SubmitSubMeshIndexLikeOriginal;
                SetNVertLikeOriginal(submitVertexCount);
                SetNIndLikeOriginal(submitVertexCount);
                SetNPriLikeOriginal(submitVertexCount / 3);
                BoundFactureIdLikeOriginal = stream.FactureIdLikeOriginal;
                BoundDot3LikeOriginal = stream.Dot3LikeOriginal;
                return true;
            }
        }


private VertexStreamLikeOriginal CreateFactureVertexStreamLikeOriginal(
            string name,
            GArrayBufferLikeOriginal buffer,
            Shader shader,
            Texture mainTex,
            Texture normalTex,
            int renderQueue,
            float bumpContrast,
            float bumpBrightness,
            Func<uint, uint> remapPackedDiffuseLikeOriginal)
        {
            if (buffer == null || buffer.TriangleCount <= 0 || shader == null || mainTex == null)
                return null;

            Material mat = new Material(shader);
            mat.name = name + "_mat";
            if (mat.HasProperty("_MainTex"))
                mat.SetTexture("_MainTex", mainTex);
            if (normalTex != null && mat.HasProperty("_NormalTex"))
                mat.SetTexture("_NormalTex", normalTex);
            if (mat.HasProperty("_BumpContrast"))
                mat.SetFloat("_BumpContrast", bumpContrast);
            if (mat.HasProperty("_BumpBrightness"))
                mat.SetFloat("_BumpBrightness", bumpBrightness);
            if (mat.HasProperty("_C2UseStrictTnL"))
                mat.SetFloat("_C2UseStrictTnL", 1.0f);
            mat.renderQueue = renderQueue;
            _terrainRuntimeOwnedObjects.Add(mat);

            VertexTnL2LikeOriginal[] vertexPtr = buffer.BuildVertexArrayLikeOriginal(remapPackedDiffuseLikeOriginal);
            int vertexCount = vertexPtr != null ? vertexPtr.Length : 0;
            if (vertexCount <= 0)
                return null;

            Mesh runtimeMesh = CreateRuntimeMeshFromVertexPtrLikeOriginal(name + "_runtime", vertexPtr, vertexCount);
            if (runtimeMesh == null)
                return null;

            return new VertexStreamLikeOriginal
            {
                Material = mat,
                RuntimeMeshLikeOriginal = runtimeMesh,
                VertexPtrLikeOriginal = vertexPtr,
                VertexCountLikeOriginal = vertexCount,
                SubmitFirstVertexLikeOriginal = 0,
                SubmitVertexCountLikeOriginal = vertexCount
            };
        }

        private VertexStreamLikeOriginal CreateBaseMeshVertexStreamLikeOriginal(
            string name,
            C2SurfaceMeshBuilder builder,
            Shader shader,
            Texture mainTex,
            Texture crossTex,
            int renderQueue,
            Camera activeCamera,
            Vector2Int viewport)
        {
            if (builder == null || builder.TriangleCount <= 0 || builder.VertexCountLikeOriginal <= 0 || shader == null || mainTex == null)
                return null;

            Material mat = new Material(shader);
            mat.name = name + "_mat";
            if (mat.HasProperty("_MainTex"))
                mat.SetTexture("_MainTex", mainTex);
            if (crossTex != null && mat.HasProperty("_CrossTex"))
                mat.SetTexture("_CrossTex", crossTex);
            if (mat.HasProperty("_C2UseStrictTnL"))
                mat.SetFloat("_C2UseStrictTnL", 1.0f);
            mat.SetVector("_C2Viewport", new Vector4(Mathf.Max(1, viewport.x), Mathf.Max(1, viewport.y), 0.0f, 0.0f));
            mat.renderQueue = renderQueue;
            _terrainRuntimeOwnedObjects.Add(mat);

            VertexTnL2LikeOriginal[] vertexPtr = builder.VertexData.ToArray();
            Mesh runtimeMesh = CreateRuntimeMeshFromVertexPtrLikeOriginal(name + "_runtime", vertexPtr, vertexPtr.Length);
            if (runtimeMesh == null)
                return null;

            return new VertexStreamLikeOriginal
            {
                Material = mat,
                RuntimeMeshLikeOriginal = runtimeMesh,
                VertexPtrLikeOriginal = vertexPtr,
                VertexCountLikeOriginal = vertexPtr.Length,
                SubmitFirstVertexLikeOriginal = 0,
                SubmitVertexCountLikeOriginal = vertexPtr.Length,
                FactureIdLikeOriginal = -1,
                Dot3LikeOriginal = false
            };
        }

