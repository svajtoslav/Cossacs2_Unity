        private sealed class ParsedMap
        {
            public string SourcePath = "";
            public int VertInLine;
            public int MaxTH;
            public int MinMapX;
            public int MinMapY;
            public int MaxMapX;
            public int MaxMapY;
            public int TileWidth;
            public int TileHeight;
            public short[] Heights;
            public short[] Options;
            public byte[] XYShift;
            public byte[] TilePrimary;
            public byte[] TilePrimaryOpt;
            public byte[] TileSecondary;
            public byte[] TileSecondaryOpt;
            public byte[] TileSecondaryWeight;
            public byte[] FactureMap;
            public byte[] FactureWeight;
            public int Sea2PayloadBytes;
            public int Sea2NonZeroCount;
            public C2WaterData Water;
            public bool IsMeshSurface;
            public Vector3[] MeshVertices;
            public int[] MeshIndices;
            public Color32[] MeshColors;
            public byte[] MeshShadow;
            public byte[] MeshFacture;
            public Vector3[] MeshNormals;
            public byte[] ChunkTRE2;
            public byte[] ChunkUNI3;
            public byte[] ChunkGSPR;
            public byte[] ChunkZON2;
            public byte[] ChunkMOPT;
            public byte[] ChunkRNE2;
            public byte[] ChunkFOR2;
            public byte[] ChunkLOC2;
            public byte[] Chunk0TPL;
            public byte[] Chunk1TPL;
            public byte[] Chunk2TPL;
            public DecodedRoadNet DecodedRne2;

            public short GetVertexHeight(int col, int row)
            {
                if (Heights == null || Heights.Length == 0) return 0;
                if (VertInLine <= 0 || MaxTH <= 0) return 0;

                col = Mathf.Clamp(col, 0, VertInLine - 1);
                row = Mathf.Clamp(row, 0, MaxTH - 1);

                int idx = row * VertInLine + col;
                if (idx < 0 || idx >= Heights.Length) return 0;
                return Heights[idx];
            }
        }
    }
}
