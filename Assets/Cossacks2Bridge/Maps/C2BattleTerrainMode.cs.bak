            public float Z;
            public float Rhw;
            public Color32 Diffuse;
            public Vector4 MainUvRect;
            public Vector4 StoneUvRect;
        }

        private sealed class StonePoolRecordLikeOriginal
        {
            public int Vertex;
            public int ScreenX;
            public int ScreenY;
            public float Z;
            public float Rhw;
            public Color32 Diffuse;
            public int StoneTex;
        }

        




        private bool TryCreateStrictRuntimeTerrain(string selectedId, Mesh terrainMesh, Transform parent, out Material firstMaterial, out string info)
        {
            firstMaterial = null;
            info = "";

            if (_map == null)
            {
                info = "strictRuntime map=null";
                return false;
            }

            if (_map.IsMeshSurface)
            {
                info = "strictRuntime old-surface-only; mesh-surface fallback";
                return false;
            }

            GroundTextureCatalog catalog = null;
            string catalogInfo = "textures=deleted";
            GroundRuntimeConfig runtimeCfg = GetOrCreateGroundRuntimeConfig(out string runtimeInfo);
            short[] randoma = GetRandomTableLikeOriginal(runtimeCfg);
            SeedStrictCRandLikeOriginal(1);

            int tileWidth = Math.Max(1, _map.TileWidth > 0 ? _map.TileWidth : _map.VertInLine);
            int tileHeight = Math.Max(1, _map.TileHeight > 0 ? _map.TileHeight : _map.MaxTH);
            int expected = tileWidth * tileHeight;
            if (_map.TilePrimary == null || _map.TilePrimary.Length < expected)
            {
                info = $"strictRuntime TilePrimary missing/short len={(_map.TilePrimary != null ? _map.TilePrimary.Length : 0)} expected={expected}";
                return false;
            }

            bool includeSecondary = false;
            bool includeFacture = false;
            string renderPath = "geometry-only-strict-runtime";
            string groundArrayInfo = "groundArray=deleted";
            string factureArrayInfo = "facture=deleted";
            var groundLayerById = new Dictionary<int, int>(256);
            for (int groundId = 0; groundId < 256; groundId++)
                groundLayerById[groundId] = 0;

            List<int> cols = BuildSampledIndices(_map.VertInLine, Math.Max(1, OldSurfaceStep));
            List<int> rows = BuildSampledIndices(_map.MaxTH, Math.Max(1, OldSurfaceStep));
            int sampledCols = cols.Count;
            int sampledRows = rows.Count;
            Vector3[] terrainVerts = terrainMesh != null ? terrainMesh.vertices : null;
            if (terrainVerts == null || terrainVerts.Length != sampledCols * sampledRows)
            {
                info = $"strictRuntime sampled mesh mismatch verts={(terrainVerts != null ? terrainVerts.Length : 0)} expected={sampledCols * sampledRows}";
                return false;
            }

            var sTriangBufferLikeOriginal = new STriangDirectBufferLikeOriginal();
            var gArrayLikeOriginal = new VertexStreamLikeOriginal[256];
            var nInGarrLikeOriginal = new int[256];
            var maxInGarrLikeOriginal = new int[256];
            var groundStageLikeOriginal = new GroundVertexStageLikeOriginal();
            GArrayBufferLikeOriginal[] factPlainById = new GArrayBufferLikeOriginal[256];
            GArrayBufferLikeOriginal[] factBumpById = new GArrayBufferLikeOriginal[256];
            int baseTriCount = 0;
            int secTriCount = 0;
            int factTriCount = 0;
            int factPlainTriCount = 0;
            int factBumpTriCount = 0;
            int groundBatchCount = 0;

            for (int ry = 0; ry < sampledRows - 1; ry++)
            {
                for (int cx = 0; cx < sampledCols - 1; cx++)
                {
                    int mapCol = cols[cx];
                    int v00 = rows[ry] * _map.VertInLine + cols[cx];
                    int v10 = rows[ry] * _map.VertInLine + cols[cx + 1];
                    int v01 = rows[ry + 1] * _map.VertInLine + cols[cx];
                    int v11 = rows[ry + 1] * _map.VertInLine + cols[cx + 1];

                    int d00 = ry * sampledCols + cx;
                    int d10 = ry * sampledCols + (cx + 1);
                    int d01 = (ry + 1) * sampledCols + cx;
                    int d11 = (ry + 1) * sampledCols + (cx + 1);

                    Vector3 p00 = terrainVerts[d00];
                    Vector3 p10 = terrainVerts[d10];
                    Vector3 p01 = terrainVerts[d01];
                    Vector3 p11 = terrainVerts[d11];

                    AppendStrictSurfaceCellLikeOriginal(sTriangBufferLikeOriginal, groundStageLikeOriginal, runtimeCfg, groundLayerById, randoma,
                        mapCol, v00, v10, v01, v11, p00, p10, p01, p11,
                        includeSecondary,
                        ref baseTriCount,
                        ref secTriCount);

                    if (includeFacture)
                    {
                        if ((mapCol & 1) != 0)
                        {
                            factTriCount += AddStrictFactureTrianglesBatched(factPlainById, factBumpById, runtimeCfg, catalog, 0, v00, v10, v01, p00, p10, p01, out int addedPlain0, out int addedBump0);
                            factPlainTriCount += addedPlain0;
                            factBumpTriCount += addedBump0;
                            factTriCount += AddStrictFactureTrianglesBatched(factPlainById, factBumpById, runtimeCfg, catalog, 1, v01, v10, v11, p01, p10, p11, out int addedPlain1, out int addedBump1);
                            factPlainTriCount += addedPlain1;
                            factBumpTriCount += addedBump1;
                        }
                        else
                        {
                            factTriCount += AddStrictFactureTrianglesBatched(factPlainById, factBumpById, runtimeCfg, catalog, 2, v00, v10, v11, p00, p10, p11, out int addedPlain2, out int addedBump2);
                            factPlainTriCount += addedPlain2;
                            factBumpTriCount += addedBump2;
                            factTriCount += AddStrictFactureTrianglesBatched(factPlainById, factBumpById, runtimeCfg, catalog, 3, v00, v11, v01, p00, p11, p01, out int addedPlain3, out int addedBump3);
                            factPlainTriCount += addedPlain3;
                            factBumpTriCount += addedBump3;
                        }
                    }
                }
            }

            Camera activeCamera = GetActiveBattleCameraLikeOriginal();
            Vector2Int viewport = activeCamera != null
                ? new Vector2Int(Mathf.Max(1, activeCamera.pixelWidth), Mathf.Max(1, activeCamera.pixelHeight))
                : new Vector2Int(Mathf.Max(1, Screen.width), Mathf.Max(1, Screen.height));
            groundBatchCount = 0;

            Shader surfaceShader = FindBestStrictRuntimeFlatMeshShaderLikeOriginal();
            Texture2D flatWhiteTex = Texture2D.whiteTexture;
            if (surfaceShader == null || flatWhiteTex == null)
            {
                info = $"strictRuntime stripped shader/resources missing surface={(surfaceShader != null ? 1 : 0)} whiteTex={(flatWhiteTex != null ? 1 : 0)}";
                return false;
            }
            bool hasAnyFactureBufferLikeOriginal = false;


            BaseMeshLikeOriginal STriangLikeOriginal = null;
            if (sTriangBufferLikeOriginal.TriangleCount > 0)
            {
                VertexStreamLikeOriginal stStreamLikeOriginal = CreateBaseMeshVertexStreamLikeOriginal(
                    selectedId + "_strict_surface_direct",
                    sTriangBufferLikeOriginal,
                    surfaceShader,
                    flatWhiteTex,
                    null,
                    2000,
                    activeCamera,
                    viewport);
                if (stStreamLikeOriginal != null)
                {
                    STriangLikeOriginal = new BaseMeshLikeOriginal
                    {
                        Name = "STriang",
                        VertexFormatLikeOriginal = 2,
                        ImmediateStreamLikeOriginal = stStreamLikeOriginal,
                        UsesVertexPtrLikeOriginal = true
                    };
                    STriangLikeOriginal.BindImmediateStreamLikeOriginal();
                    if (stStreamLikeOriginal.Material != null)
                    {
                        if (stStreamLikeOriginal.Material.HasProperty("_Color"))
                            stStreamLikeOriginal.Material.SetColor("_Color", new Color(0.74f, 0.74f, 0.74f, 1.0f));
                        if (stStreamLikeOriginal.Material.HasProperty("_BaseColor"))
                            stStreamLikeOriginal.Material.SetColor("_BaseColor", new Color(0.74f, 0.74f, 0.74f, 1.0f));
                    }
                    if (firstMaterial == null)
                        firstMaterial = stStreamLikeOriginal.Material;
                }
            }

            bool hasAnyGArrayLikeOriginal = BuildGroundGArrayFromStageLikeOriginal(
                selectedId,
                surfaceShader,
                flatWhiteTex,
                groundStageLikeOriginal,
                gArrayLikeOriginal,
                nInGarrLikeOriginal,
                maxInGarrLikeOriginal);
            groundBatchCount = 0;
            for (int i = 0; i < gArrayLikeOriginal.Length; i++)
            {
                if (gArrayLikeOriginal[i] != null)
                    groundBatchCount++;
            }
            groundArrayInfo = hasAnyGArrayLikeOriginal ? ("groundArray=built-from-strict-surface; buckets=" + groundBatchCount.ToString()) : "groundArray=deleted";

            BaseMeshLikeOriginal GroundMeshLikeOriginal = null;
            if (hasAnyGArrayLikeOriginal)
            {
                GroundMeshLikeOriginal = new BaseMeshLikeOriginal
                {
                    Name = "GroundMesh",
                    VertexFormatLikeOriginal = 1,
                    GArrayLikeOriginal = gArrayLikeOriginal,
                    NInGarrLikeOriginal = nInGarrLikeOriginal,
                    MaxInGarrLikeOriginal = maxInGarrLikeOriginal,
                    UsesVertexPtrLikeOriginal = true
                };

                if (!ConfigureGroundMeshSharedRuntimeLikeOriginal(GroundMeshLikeOriginal, selectedId + "_strict_ground_shared"))
                    GroundMeshLikeOriginal = null;
            }

            if (STriangLikeOriginal != null || GroundMeshLikeOriginal != null)
            {
                GameObject factureHost = new GameObject("IRSLikeOriginal");
                factureHost.transform.SetParent(parent, false);
                var immediateRenderer = factureHost.AddComponent<IRSLikeOriginalRenderer>();
                immediateRenderer.STriangLikeOriginal = STriangLikeOriginal;
                immediateRenderer.GroundMeshLikeOriginal = GroundMeshLikeOriginal;
                immediateRenderer.ExpectedCameraLikeOriginal = activeCamera;
            }

            info = $"terrainTextureInfo=renderPath={renderPath}; surfaceBackend=irs-draw-basemesh-setvertexptr-like; factureBackend=deleted; drawOrder=STriang-GroundMesh; constructionOrder=stage-pass-direct-sttriang-gvg-tidx-postpass-garray-like-original; textures=deleted; water=deleted; roads=deleted; bounds=deleted; overlay=deleted; stonePath=deleted; groundSharedRuntime={(GroundMeshLikeOriginal != null ? 1 : 0)}; groundSubmitMode={(GroundMeshLikeOriginal != null ? "submesh-slice-range" : "deleted")}; surfaceTris={sTriangBufferLikeOriginal.TriangleCount} stage1Tris={baseTriCount} stage2Tris={secTriCount} groundBatches={groundBatchCount} stoneQuads=0 factureTris=0 facturePlainTris=0 factureDot3Tris=0 facturePlainBatches=0 factureDot3Batches=0; {factureArrayInfo}; {groundArrayInfo}; {catalogInfo}; {runtimeInfo}";
            return firstMaterial != null;
        }

private static byte GetArrayByteSafe(byte[] data, int index, byte fallback)
        {
            if (data == null || index < 0 || index >= data.Length)
                return fallback;
            return data[index];
        }

        private static byte GetArrayByteSafe(byte[] data, int index, int fallback)
        {
            byte safe = (byte)Mathf.Clamp(fallback, 0, 255);
            if (data == null || index < 0 || index >= data.Length)
                return safe;
            return data[index];
        }

        private static Color32 MakeWeightColor(float w0, float w1, float w2)
        {
            return new Color(Mathf.Clamp01(w0), Mathf.Clamp01(w1), Mathf.Clamp01(w2), 1.0f);
        }

        private void CreateStrictRuntimeChild(Transform parent, string name, Mesh mesh, Material mat)
        {
            var go = new GameObject(name);
            go.transform.SetParent(parent, false);
            var mf = go.AddComponent<MeshFilter>();
            var mr = go.AddComponent<MeshRenderer>();
            mf.sharedMesh = mesh;
            mr.sharedMaterial = mat;
            mr.shadowCastingMode = ShadowCastingMode.Off;
            mr.receiveShadows = false;
            mr.lightProbeUsage = UnityEngine.Rendering.LightProbeUsage.Off;
            mr.reflectionProbeUsage = UnityEngine.Rendering.ReflectionProbeUsage.Off;
        }

        private static void CollapseSortedUnique(int t0, int t1, int t2, out int l0, out int l1, out int l2)
        {
            l0 = t0;
            l1 = t1;
            l2 = t2;
            if (l1 == l0) l1 = -1;
            if (l2 == l0 || l2 == l1) l2 = -1;
        }

        private void AppendStrictSurfaceCellLikeOriginal(STriangDirectBufferLikeOriginal sTriangBufferLikeOriginal, GroundVertexStageLikeOriginal groundStageLikeOriginal, GroundRuntimeConfig runtimeCfg, Dictionary<int, int> groundLayerById, short[] randoma,
            int mapCol,
            int v00, int v10, int v01, int v11,
            Vector3 p00, Vector3 p10, Vector3 p01, Vector3 p11,
            bool includeSecondary,
            ref int baseTriCount,
            ref int secTriCount)
        {
            bool stage1PlainMode = IsStrictSurfaceStage1PlainModeLikeOriginal(v00, v10, v01, v11);

            if ((mapCol & 1) != 0)
            {
                int t1 = _map.TilePrimary[v00] & 0xFF;
                int t2 = _map.TilePrimary[v10] & 0xFF;
                int t3 = _map.TilePrimary[v01] & 0xFF;
                int t4 = _map.TilePrimary[v11] & 0xFF;

                int tMin1 = t1, tAve1 = t2, tMax1 = t3;
                Sort3LikeOriginal(ref tMin1, ref tAve1, ref tMax1);
                int tMin2 = t3, tAve2 = t2, tMax2 = t4;
                Sort3LikeOriginal(ref tMin2, ref tAve2, ref tMax2);

                baseTriCount += EmitStrictSurfacePassLikeOriginal(sTriangBufferLikeOriginal, groundStageLikeOriginal, runtimeCfg, groundLayerById, randoma, 0, 0,
                    v00, v10, v01, v11, p00, p10, p01,
                    t1, t2, t3, tMin1,
                    255, 255, 255,
                    255, 255, 255,
                    stage1PlainMode);
                baseTriCount += EmitStrictSurfacePassLikeOriginal(sTriangBufferLikeOriginal, groundStageLikeOriginal, runtimeCfg, groundLayerById, randoma, 1, 0,
                    v00, v10, v01, v11, p01, p10, p11,
                    t3, t2, t4, tMin2,
                    255, 255, 255,
                    255, 255, 255,
                    stage1PlainMode);

                if (tAve1 != tMin1)
                {
                    int fa = t1 == tAve1 ? 255 : 0;
                    int fb = t2 == tAve1 ? 255 : 0;
                    int fc = t3 == tAve1 ? 255 : 0;
                    baseTriCount += EmitStrictSurfacePassLikeOriginal(sTriangBufferLikeOriginal, groundStageLikeOriginal, runtimeCfg, groundLayerById, randoma, 0, 1,
                        v00, v10, v01, v11, p00, p10, p01,
                        t1, t2, t3, tAve1,
                        fa, fb, fc,
                        fa, fb, fc,
                        stage1PlainMode);
                }
                if (tMax1 != tMin1 && tMax1 != tAve1)
                {
                    int fa = t1 == tMax1 ? 255 : 0;
                    int fb = t2 == tMax1 ? 255 : 0;
                    int fc = t3 == tMax1 ? 255 : 0;
                    baseTriCount += EmitStrictSurfacePassLikeOriginal(sTriangBufferLikeOriginal, groundStageLikeOriginal, runtimeCfg, groundLayerById, randoma, 0, 2,
                        v00, v10, v01, v11, p00, p10, p01,
                        t1, t2, t3, tMax1,
                        fa, fb, fc,
                        fa, fb, fc,
                        stage1PlainMode);
                }
                if (tAve2 != tMin2)
                {
                    int fa = t3 == tAve2 ? 255 : 0;
                    int fb = t2 == tAve2 ? 255 : 0;
                    int fc = t4 == tAve2 ? 255 : 0;
                    baseTriCount += EmitStrictSurfacePassLikeOriginal(sTriangBufferLikeOriginal, groundStageLikeOriginal, runtimeCfg, groundLayerById, randoma, 1, 1,
                        v00, v10, v01, v11, p01, p10, p11,
                        t3, t2, t4, tAve2,
                        fa, fb, fc,
                        fa, fb, fc,
                        stage1PlainMode);
                }
                if (tMax2 != tMin2 && tMax2 != tAve2)
                {
                    int fa = t3 == tMax2 ? 255 : 0;
                    int fb = t2 == tMax2 ? 255 : 0;
                    int fc = t4 == tMax2 ? 255 : 0;
                    baseTriCount += EmitStrictSurfacePassLikeOriginal(sTriangBufferLikeOriginal, groundStageLikeOriginal, runtimeCfg, groundLayerById, randoma, 1, 2,
                        v00, v10, v01, v11, p01, p10, p11,
                        t3, t2, t4, tMax2,
                        fa, fb, fc,
                        fa, fb, fc,
                        stage1PlainMode);
                }

                if (includeSecondary)
                {
                    int s1 = GetArrayByteSafe(_map.TileSecondary, v00, _map.TilePrimary[v00]) & 0xFF;
                    int s2 = GetArrayByteSafe(_map.TileSecondary, v10, _map.TilePrimary[v10]) & 0xFF;
                    int s3 = GetArrayByteSafe(_map.TileSecondary, v01, _map.TilePrimary[v01]) & 0xFF;
                    int s4 = GetArrayByteSafe(_map.TileSecondary, v11, _map.TilePrimary[v11]) & 0xFF;
                    int w1 = ScaleSecondaryWeightLikeOriginal(GetArrayByteSafe(_map.TileSecondaryWeight, v00, 0));
                    int w2 = ScaleSecondaryWeightLikeOriginal(GetArrayByteSafe(_map.TileSecondaryWeight, v10, 0));
                    int w3 = ScaleSecondaryWeightLikeOriginal(GetArrayByteSafe(_map.TileSecondaryWeight, v01, 0));
                    int w4 = ScaleSecondaryWeightLikeOriginal(GetArrayByteSafe(_map.TileSecondaryWeight, v11, 0));

                    int sMin1 = s1, sAve1 = s2, sMax1 = s3;
                    Sort3LikeOriginal(ref sMin1, ref sAve1, ref sMax1);
                    int sMin2 = s3, sAve2 = s2, sMax2 = s4;
                    Sort3LikeOriginal(ref sMin2, ref sAve2, ref sMax2);

                    secTriCount += EmitStrictSurfacePassLikeOriginal(sTriangBufferLikeOriginal, groundStageLikeOriginal, runtimeCfg, groundLayerById, randoma, 0, 0,
                        v00, v10, v01, v11, p00, p10, p01,
                        s1, s2, s3, sMin1,
                        w1, w2, w3,
                        s1 == sMin1 ? w1 : 0, s2 == sMin1 ? w2 : 0, s3 == sMin1 ? w3 : 0,
                        true);
                    secTriCount += EmitStrictSurfacePassLikeOriginal(sTriangBufferLikeOriginal, groundStageLikeOriginal, runtimeCfg, groundLayerById, randoma, 1, 0,
                        v00, v10, v01, v11, p01, p10, p11,
                        s3, s2, s4, sMin2,
                        w3, w2, w4,
                        s3 == sMin2 ? w3 : 0, s2 == sMin2 ? w2 : 0, s4 == sMin2 ? w4 : 0,
                        true);

                    if (sAve1 != sMin1)
                    {
                        int fa = s1 == sAve1 ? w1 : 0;
                        int fb = s2 == sAve1 ? w2 : 0;
                        int fc = s3 == sAve1 ? w3 : 0;
                        secTriCount += EmitStrictSurfacePassLikeOriginal(sTriangBufferLikeOriginal, groundStageLikeOriginal, runtimeCfg, groundLayerById, randoma, 0, 1,
                            v00, v10, v01, v11, p00, p10, p01,
                            s1, s2, s3, sAve1,
                            fa, fb, fc,
                            fa, fb, fc,
                            true);
                    }
                    if (sMax1 != sMin1 && sMax1 != sAve1)
                    {
                        int fa = s1 == sMax1 ? w1 : 0;
                        int fb = s2 == sMax1 ? w2 : 0;
                        int fc = s3 == sMax1 ? w3 : 0;
                        secTriCount += EmitStrictSurfacePassLikeOriginal(sTriangBufferLikeOriginal, groundStageLikeOriginal, runtimeCfg, groundLayerById, randoma, 0, 2,
                            v00, v10, v01, v11, p00, p10, p01,
                            s1, s2, s3, sMax1,
                            fa, fb, fc,
                            fa, fb, fc,
                            true);
                    }
                    if (sAve2 != sMin2)
                    {
                        int fa = s3 == sAve2 ? w3 : 0;
                        int fb = s2 == sAve2 ? w2 : 0;
                        int fc = s4 == sAve2 ? w4 : 0;
                        secTriCount += EmitStrictSurfacePassLikeOriginal(sTriangBufferLikeOriginal, groundStageLikeOriginal, runtimeCfg, groundLayerById, randoma, 1, 1,
                            v00, v10, v01, v11, p01, p10, p11,
                            s3, s2, s4, sAve2,
                            fa, fb, fc,
                            fa, fb, fc,
                            true);
                    }
                    if (sMax2 != sMin2 && sMax2 != sAve2)
                    {
                        int fa = s3 == sMax2 ? w3 : 0;
                        int fb = s2 == sMax2 ? w2 : 0;
                        int fc = s4 == sMax2 ? w4 : 0;
                        secTriCount += EmitStrictSurfacePassLikeOriginal(sTriangBufferLikeOriginal, groundStageLikeOriginal, runtimeCfg, groundLayerById, randoma, 1, 2,
                            v00, v10, v01, v11, p01, p10, p11,
                            s3, s2, s4, sMax2,
                            fa, fb, fc,
                            fa, fb, fc,
                            true);
                    }
                }
            }
            else
            {
                int t1 = _map.TilePrimary[v00] & 0xFF;
                int t2 = _map.TilePrimary[v10] & 0xFF;
                int t3 = _map.TilePrimary[v01] & 0xFF;
                int t4 = _map.TilePrimary[v11] & 0xFF;

                int tMin1 = t1, tAve1 = t2, tMax1 = t4;
                Sort3LikeOriginal(ref tMin1, ref tAve1, ref tMax1);
                int tMin2 = t1, tAve2 = t4, tMax2 = t3;
                Sort3LikeOriginal(ref tMin2, ref tAve2, ref tMax2);

                baseTriCount += EmitStrictSurfacePassLikeOriginal(sTriangBufferLikeOriginal, groundStageLikeOriginal, runtimeCfg, groundLayerById, randoma, 2, 0,
                    v00, v10, v01, v11, p00, p10, p11,
                    t1, t2, t4, tMin1,
                    255, 255, 255,
                    255, 255, 255,
                    stage1PlainMode);
                baseTriCount += EmitStrictSurfacePassLikeOriginal(sTriangBufferLikeOriginal, groundStageLikeOriginal, runtimeCfg, groundLayerById, randoma, 3, 0,
                    v00, v10, v01, v11, p00, p11, p01,
                    t1, t4, t3, tMin2,
                    255, 255, 255,
                    255, 255, 255,
                    stage1PlainMode);

                if (tAve1 != tMin1)
                {
                    int fa = t1 == tAve1 ? 255 : 0;
                    int fb = t2 == tAve1 ? 255 : 0;
                    int fc = t4 == tAve1 ? 255 : 0;
                    baseTriCount += EmitStrictSurfacePassLikeOriginal(sTriangBufferLikeOriginal, groundStageLikeOriginal, runtimeCfg, groundLayerById, randoma, 2, 1,
                        v00, v10, v01, v11, p00, p10, p11,
                        t1, t2, t4, tAve1,
                        fa, fb, fc,
                        fa, fb, fc,
                        stage1PlainMode);
                }
                if (tMax1 != tMin1 && tMax1 != tAve1)
                {
                    int fa = t1 == tMax1 ? 255 : 0;
                    int fb = t2 == tMax1 ? 255 : 0;
                    int fc = t4 == tMax1 ? 255 : 0;
                    baseTriCount += EmitStrictSurfacePassLikeOriginal(sTriangBufferLikeOriginal, groundStageLikeOriginal, runtimeCfg, groundLayerById, randoma, 2, 2,
                        v00, v10, v01, v11, p00, p10, p11,
                        t1, t2, t4, tMax1,
                        fa, fb, fc,
                        fa, fb, fc,
                        stage1PlainMode);
                }
                if (tAve2 != tMin2)
                {
                    int fa = t1 == tAve2 ? 255 : 0;
                    int fb = t4 == tAve2 ? 255 : 0;
                    int fc = t3 == tAve2 ? 255 : 0;
                    baseTriCount += EmitStrictSurfacePassLikeOriginal(sTriangBufferLikeOriginal, groundStageLikeOriginal, runtimeCfg, groundLayerById, randoma, 3, 1,
                        v00, v10, v01, v11, p00, p11, p01,
                        t1, t4, t3, tAve2,
                        fa, fb, fc,
                        fa, fb, fc,
                        stage1PlainMode);
                }
                if (tMax2 != tMin2 && tMax2 != tAve2)
                {
                    int fa = t1 == tMax2 ? 255 : 0;
                    int fb = t4 == tMax2 ? 255 : 0;
                    int fc = t3 == tMax2 ? 255 : 0;
                    baseTriCount += EmitStrictSurfacePassLikeOriginal(sTriangBufferLikeOriginal, groundStageLikeOriginal, runtimeCfg, groundLayerById, randoma, 3, 2,
                        v00, v10, v01, v11, p00, p11, p01,
                        t1, t4, t3, tMax2,
                        fa, fb, fc,
                        fa, fb, fc,
                        stage1PlainMode);
                }

                if (includeSecondary)
                {
                    int s1 = GetArrayByteSafe(_map.TileSecondary, v00, _map.TilePrimary[v00]) & 0xFF;
                    int s2 = GetArrayByteSafe(_map.TileSecondary, v10, _map.TilePrimary[v10]) & 0xFF;
                    int s3 = GetArrayByteSafe(_map.TileSecondary, v01, _map.TilePrimary[v01]) & 0xFF;
                    int s4 = GetArrayByteSafe(_map.TileSecondary, v11, _map.TilePrimary[v11]) & 0xFF;
                    int w1 = ScaleSecondaryWeightLikeOriginal(GetArrayByteSafe(_map.TileSecondaryWeight, v00, 0));
                    int w2 = ScaleSecondaryWeightLikeOriginal(GetArrayByteSafe(_map.TileSecondaryWeight, v10, 0));
                    int w3 = ScaleSecondaryWeightLikeOriginal(GetArrayByteSafe(_map.TileSecondaryWeight, v01, 0));
                    int w4 = ScaleSecondaryWeightLikeOriginal(GetArrayByteSafe(_map.TileSecondaryWeight, v11, 0));

                    int sMin1 = s1, sAve1 = s2, sMax1 = s4;
                    Sort3LikeOriginal(ref sMin1, ref sAve1, ref sMax1);
                    int sMin2 = s1, sAve2 = s4, sMax2 = s3;
                    Sort3LikeOriginal(ref sMin2, ref sAve2, ref sMax2);

                    secTriCount += EmitStrictSurfacePassLikeOriginal(sTriangBufferLikeOriginal, groundStageLikeOriginal, runtimeCfg, groundLayerById, randoma, 2, 0,
                        v00, v10, v01, v11, p00, p10, p11,
                        s1, s2, s4, sMin1,
                        w1, w2, w4,
                        s1 == sMin1 ? w1 : 0, s2 == sMin1 ? w2 : 0, s4 == sMin1 ? w4 : 0,
                        true);
                    secTriCount += EmitStrictSurfacePassLikeOriginal(sTriangBufferLikeOriginal, groundStageLikeOriginal, runtimeCfg, groundLayerById, randoma, 3, 0,
                        v00, v10, v01, v11, p00, p11, p01,
                        s1, s4, s3, sMin2,
                        w1, w4, w3,
                        s1 == sMin2 ? w1 : 0, s4 == sMin2 ? w4 : 0, s3 == sMin2 ? w3 : 0,
                        true);

                    if (sAve1 != sMin1)
                    {
                        int fa = s1 == sAve1 ? w1 : 0;
                        int fb = s2 == sAve1 ? w2 : 0;
                        int fc = s4 == sAve1 ? w4 : 0;
                        secTriCount += EmitStrictSurfacePassLikeOriginal(sTriangBufferLikeOriginal, groundStageLikeOriginal, runtimeCfg, groundLayerById, randoma, 2, 1,
                            v00, v10, v01, v11, p00, p10, p11,
                            s1, s2, s4, sAve1,
                            fa, fb, fc,
                            fa, fb, fc,
                            true);
                    }
                    if (sMax1 != sMin1 && sMax1 != sAve1)
                    {
                        int fa = s1 == sMax1 ? w1 : 0;
                        int fb = s2 == sMax1 ? w2 : 0;
                        int fc = s4 == sMax1 ? w4 : 0;
                        secTriCount += EmitStrictSurfacePassLikeOriginal(sTriangBufferLikeOriginal, groundStageLikeOriginal, runtimeCfg, groundLayerById, randoma, 2, 2,
                            v00, v10, v01, v11, p00, p10, p11,
                            s1, s2, s4, sMax1,
                            fa, fb, fc,
                            fa, fb, fc,
                            true);
                    }
                    if (sAve2 != sMin2)
                    {
                        int fa = s1 == sAve2 ? w1 : 0;
                        int fb = s4 == sAve2 ? w4 : 0;
                        int fc = s3 == sAve2 ? w3 : 0;
                        secTriCount += EmitStrictSurfacePassLikeOriginal(sTriangBufferLikeOriginal, groundStageLikeOriginal, runtimeCfg, groundLayerById, randoma, 3, 1,
                            v00, v10, v01, v11, p00, p11, p01,
                            s1, s4, s3, sAve2,
                            fa, fb, fc,
                            fa, fb, fc,
                            true);
                    }
                    if (sMax2 != sMin2 && sMax2 != sAve2)
                    {
                        int fa = s1 == sMax2 ? w1 : 0;
                        int fb = s4 == sMax2 ? w4 : 0;
                        int fc = s3 == sMax2 ? w3 : 0;
                        secTriCount += EmitStrictSurfacePassLikeOriginal(sTriangBufferLikeOriginal, groundStageLikeOriginal, runtimeCfg, groundLayerById, randoma, 3, 2,
                            v00, v10, v01, v11, p00, p11, p01,
                            s1, s4, s3, sMax2,
                            fa, fb, fc,
                            fa, fb, fc,
                            true);
                    }
                }
            }
        }

        private bool IsStrictSurfaceStage1PlainModeLikeOriginal(int v00, int v10, int v01, int v11)
        {
            byte w1 = GetArrayByteSafe(_map.TileSecondaryWeight, v00, 0);
            byte w2 = GetArrayByteSafe(_map.TileSecondaryWeight, v10, 0);
            byte w3 = GetArrayByteSafe(_map.TileSecondaryWeight, v01, 0);
            byte w4 = GetArrayByteSafe(_map.TileSecondaryWeight, v11, 0);
            return w1 > 80 || w2 > 80 || w3 > 80 || w4 > 80;
        }

        private int EmitStrictSurfacePassLikeOriginal(STriangDirectBufferLikeOriginal sTriangBufferLikeOriginal, GroundVertexStageLikeOriginal groundStageLikeOriginal, GroundRuntimeConfig runtimeCfg, Dictionary<int, int> groundLayerById, short[] randoma, int triKind, int passRank,
            int v00, int v10, int v01, int v11,
            Vector3 p0, Vector3 p1, Vector3 p2,
            int ta, int tb, int tc, int candidateId,
            int crossA, int crossB, int crossC,
            int finalA, int finalB, int finalC,
            bool plainMode)
        {
            if (!groundLayerById.TryGetValue(candidateId, out _))
                return 0;
            if (finalA <= 0 && finalB <= 0 && finalC <= 0)
                return 0;

            GetTriPassAtlasUvLikeOriginal(candidateId, triKind, passRank, randoma, v00, v10, v01, v11, out Vector2 uv0, out Vector2 uv1, out Vector2 uv2);
            GetStrictSurfaceTriangleVertexIdsLikeOriginal(triKind, v00, v10, v01, v11, out int triA, out int triB, out int triC);

            Camera activeCamera = GetActiveBattleCameraLikeOriginal();
            Vector2Int viewport = activeCamera != null
                ? new Vector2Int(Mathf.Max(1, activeCamera.pixelWidth), Mathf.Max(1, activeCamera.pixelHeight))
                : new Vector2Int(Mathf.Max(1, Screen.width), Mathf.Max(1, Screen.height));

            Vector3 screenPos0 = GetStrictSurfaceScreenPosLikeOriginal(activeCamera, viewport, p0, triA);
            Vector3 screenPos1 = GetStrictSurfaceScreenPosLikeOriginal(activeCamera, viewport, p1, triB);
            Vector3 screenPos2 = GetStrictSurfaceScreenPosLikeOriginal(activeCamera, viewport, p2, triC);

            var sv0 = BuildStrictSurfaceVertexLikeOriginal(screenPos0, triA, finalA, uv0, Vector2.zero);
            var sv1 = BuildStrictSurfaceVertexLikeOriginal(screenPos1, triB, finalB, uv1, Vector2.zero);
            var sv2 = BuildStrictSurfaceVertexLikeOriginal(screenPos2, triC, finalC, uv2, Vector2.zero);

            if (passRank > 0)
            {
                if (ta != candidateId) sv0 = WithStrictDiffuseLikeOriginal(sv0, ApplyStrictDwLMinLikeOriginal(sv0.Diffuse, triA));
                if (tb != candidateId) sv1 = WithStrictDiffuseLikeOriginal(sv1, ApplyStrictDwLMinLikeOriginal(sv1.Diffuse, triB));
                if (tc != candidateId) sv2 = WithStrictDiffuseLikeOriginal(sv2, ApplyStrictDwLMinLikeOriginal(sv2.Diffuse, triC));
            }

            bool prevPlainModeLikeOriginal = PLAINMODELikeOriginal;
            PLAINMODELikeOriginal = plainMode;
            if (triKind == 2)
            {
                int vr = passRank == 0 ? v00 : (passRank == 1 ? v01 : v11);
                int gTex = passRank == 0 ? candidateId : (passRank == 1 ? ta : candidateId);
                int cTex = passRank == 0 ? candidateId : (passRank == 1 ? candidateId : tb);
                NormalizeVertexTexLLikeOriginal(_map, runtimeCfg, randoma, ref sv0, ref sv1, ref sv2, gTex, cTex, plainMode, vr);
            }
            else
            {
                int vr = passRank == 0 ? v10 : (passRank == 1 ? v10 : v01);
                int gTex = passRank == 0 ? candidateId : (passRank == 1 ? ta : tb);
                int cTex = passRank == 0 ? candidateId : candidateId;
                NormalizeVertexTexRLikeOriginal(_map, runtimeCfg, randoma, ref sv0, ref sv1, ref sv2, gTex, cTex, plainMode, vr);
            }
            PLAINMODELikeOriginal = prevPlainModeLikeOriginal;

            AddSTriangTriangleLikeOriginal(sTriangBufferLikeOriginal, sv0, sv1, sv2);
            AddGroundTriangleToStageLikeOriginal(groundStageLikeOriginal, candidateId, sv0, sv1, sv2);
            return 1;
        }

        private VertexTnL2LikeOriginal BuildStrictSurfaceVertexLikeOriginal(Vector3 screenPos, int vertexId, int alpha, Vector2 uv0, Vector2 uv1)
        {
            float rhw = GetStrictSurfaceRhwLikeOriginal(vertexId);
            float z = GetStrictSurfaceZLikeOriginal(screenPos.y);

            return new VertexTnL2LikeOriginal(
                screenPos.x,
                screenPos.y,
                z,
                rhw,
                BuildStrictSurfaceDiffuseLikeOriginal(vertexId, alpha),
                uv0.x,
                uv0.y,
                uv1.x,
                uv1.y);
        }

        private Vector3 GetStrictSurfaceScreenPosLikeOriginal(Camera activeCamera, Vector2Int viewport, Vector3 worldPos, int vertexId)
        {
            Vector3 screenPos = ProjectWorldToSurfaceScreenLikeOriginal(activeCamera, viewport, worldPos, vertexId);
            screenPos.x += GetXShiftLikeOriginal(vertexId);
            screenPos.y += GetYShiftLikeOriginal(vertexId);
            return screenPos;
        }

        private Vector3 ProjectWorldToSurfaceScreenLikeOriginal(Camera activeCamera, Vector2Int viewport, Vector3 worldPos, int vertexId)
        {
            float hScale = Mathf.Abs(HorizontalScale) > 0.0001f ? Mathf.Abs(HorizontalScale) : 1.0f;
            float vScale = Mathf.Abs(VerticalScale) > 0.0001f ? Mathf.Abs(VerticalScale) : 1.0f;

            if (_map == null || _map.VertInLine <= 0 || vertexId < 0)
            {
                float fallbackHeight = worldPos.y / vScale;
                return new Vector3(worldPos.x / hScale, worldPos.z / hScale - fallbackHeight, fallbackHeight);
            }

            int vx = vertexId % _map.VertInLine;
            int vy = vertexId / _map.VertInLine;

            // Factures3D.cpp DrawTriStrip builds STriang directly in raster space:
            //   x = x + (vx - MapX) * 32 + GETXSHIFT(V)
            //   y = y + BaseY(vx,vy) - (THMAP(V) >> ScShift) - Gy + GETYSHIFT(V)
            // with ScShift=0 for the retail/full-resolution path, so:
            //   TQuant=32, HQuant=16, SQuant=8, Gy=(MapY<<4).
            const float tQuant = 32.0f;
            const float hQuant = 16.0f;
            const float sQuant = 8.0f;

            float baseX = (vx - _strictMapX) * tQuant;
            float baseY = vy * hQuant + (((vx & 1) != 0) ? -sQuant : 0.0f);
            float heightRaster = worldPos.y / vScale;
            float gy = _strictMapY * hQuant;

            float screenX = baseX;
            float screenY = baseY - gy - heightRaster;

            return new Vector3(screenX, screenY, heightRaster);
        }

        private static float GetStrictSurfaceRhwLikeOriginal(int vertexId)
        {
            // Factures3D.cpp in this source archive routes w through GetRHW(V), and GetRHW(V) currently returns 1.0f.
            return 1.0f;
        }

        private static float GetStrictSurfaceZLikeOriginal(float screenYLikeOriginal)
        {
            return 0.5f - screenYLikeOriginal / 3000.0f;
        }

        private static int GetMaxPointIndexLikeOriginal(ParsedMap map)
        {
            if (map == null)
                return 0;

            // Original engine uses MaxPointIndex == (MaxTH + 1) * MaxTH for THMap / XYShift / texture maps.
            if (map.MaxTH > 0)
                return checked((map.MaxTH + 1) * map.MaxTH);

            if (map.VertInLine > 0 && map.MaxTH > 0)
                return checked(map.VertInLine * map.MaxTH);

            if (map.Heights != null && map.Heights.Length > 0)
                return map.Heights.Length;

            return 0;
        }

        private static void EnsureMapXyShiftLikeOriginal(ParsedMap map)
        {
            if (map == null)
                return;

            int expected = GetMaxPointIndexLikeOriginal(map);
            if (expected <= 0)
                return;

            if (map.XYShift != null && map.XYShift.Length >= expected)
                return;

            // Original retail path does not read XYShift from SURF/TILE/FMAPP chunks.
            // LoadSave.cpp calls SetupXYShift(), and SetupXYShift() allocates (MaxTH + 1) * MaxTH bytes
            // and clears them to 0x88. With GETXSHIFT/GETYSHIFT this decodes to zero shift everywhere
            // until some later editor/gameplay path mutates XYShift in memory.
            map.XYShift = Enumerable.Repeat((byte)0x88, expected).ToArray();
        }

        private int GetXShiftLikeOriginal(int vertex)
        {
            return GetXShiftLikeOriginal(_map, vertex);
        }

        private int GetYShiftLikeOriginal(int vertex)
        {
            return GetYShiftLikeOriginal(_map, vertex);
        }

        private static int GetXShiftLikeOriginal(ParsedMap map, int vertex)
        {
            EnsureMapXyShiftLikeOriginal(map);
            if (map == null || map.XYShift == null || vertex < 0 || vertex >= map.XYShift.Length)
                return 0;
            return (map.XYShift[vertex] & 0x0F) - 8;
        }

        private static int GetYShiftLikeOriginal(ParsedMap map, int vertex)
        {
            EnsureMapXyShiftLikeOriginal(map);
            if (map == null || map.XYShift == null || vertex < 0 || vertex >= map.XYShift.Length)
                return 0;
            return ((map.XYShift[vertex] >> 4) & 0x0F) - 8;
        }

        private static uint SetStrictPackedAlphaLikeOriginal(uint diffuse, int alpha)
        {
            return (diffuse & 0x00FFFFFFu) | ((uint)(byte)Mathf.Clamp(alpha, 0, 255) << 24);
        }

        private static uint ApplyStrictDwLMinLikeOriginal(uint diffuse, int idx)
        {
            GetDW_LMinLikeOriginal(ref diffuse, idx);
            return diffuse;
        }

        private static int _strictCRandStateLikeOriginal = 1;
        private static bool PLAINMODELikeOriginal = false;

        private static void SeedStrictCRandLikeOriginal(int seed)
        {
            _strictCRandStateLikeOriginal = seed != 0 ? seed : 1;
        }

        private static int RandLikeOriginal()
        {
            unchecked
            {
                _strictCRandStateLikeOriginal = _strictCRandStateLikeOriginal * 214013 + 2531011;
            }
            return (_strictCRandStateLikeOriginal >> 16) & 0x7FFF;
        }

        private int _GetHiLikeOriginal(int i)
        {
            if (_map == null || _map.Heights == null || _map.Heights.Length == 0)
                return 0;
            if (i < 0 || i >= _map.Heights.Length)
                return 0;
            return _map.Heights[i];
        }

        private int GetLighting3D0LikeOriginal()
        {
            int dy = 0;
            int dx = 0;
            int dz = StrictSurfaceTriUnitLikeOriginal + StrictSurfaceTriUnitLikeOriginal + StrictSurfaceTriUnitLikeOriginal + StrictSurfaceTriUnitLikeOriginal;
            int lig = C2GlobalLighting.LightDZ;
            if (lig < 150) lig = 150;
            if (lig > 250) lig = 250;
            return lig;
        }

        private int GetLighting3DVLikeOriginal(int dx, int dy, int dz)
        {
            double denom = Math.Sqrt((double)dx * dx + (double)dy * dy + (double)dz * dz);
            if (denom < 1.0)
                denom = 1.0;
            int lig = (int)((dx * C2GlobalLighting.LightDX + dy * C2GlobalLighting.LightDY + dz * C2GlobalLighting.LightDZ) / denom);
            if (lig < 120) lig = 120;
            if (lig > 250) lig = 250;
            return lig;
        }

        private void ScanLightOffsetLikeOriginal(int X0, int Y0)
        {
            if (_map == null || _strictSurfaceLightMap == null)
                return;

            int DD = 10;
            int HMax = 0;
            int ofs = X0 + Y0 * _map.VertInLine;
            int HP = 0;
            int H = 0;
            while (X0 >= 0 && Y0 >= 0)
            {
                HP = H;
                int x = ofs % _map.VertInLine;
                int y = ofs / _map.VertInLine;
                y = (x & 1) != 0 ? (y << 5) - 16 : (y << 5);
                x = x << 5;
                H = GetStrictTotalHeightLikeOriginal(x, y);
                if (H > HMax) HMax = H;
                int DH = HMax - H;
                if (DH > 0)
                {
                    DH *= 2 + Math.Abs(HP - H) / 2;
                    if (DH > 100) DH = 100;
                    _strictSurfaceLightMap[ofs] = (byte)(255 - DH);
                }
                else
                {
                    _strictSurfaceLightMap[ofs] = 255;
                }
                if ((X0 & 1) != 0)
                {
                    ofs -= _map.VertInLine + 1;
                    Y0--;
                }
                else
                {
                    ofs--;
                }
                X0--;
                HMax -= DD;
            }
        }

        private void CreateLightMapLikeOriginal()
        {
            if (_map == null || _map.VertInLine <= 0 || _map.MaxTH <= 0)
            {
                _strictSurfaceLightMap = null;
                return;
            }

            int size = _map.VertInLine * _map.MaxTH;
            byte[] TempL = new byte[size];
            if (_strictSurfaceLightMap == null || _strictSurfaceLightMap.Length != size)
                _strictSurfaceLightMap = new byte[size];
            for (int i = 0; i < size; i++)
                TempL[i] = 255;

            for (int y = _map.MaxTH - 1; y > 0; y--)
                ScanLightOffsetLikeOriginal(_map.VertInLine - 1, y);
            for (int x = 0; x < _map.VertInLine - 1; x++)
                ScanLightOffsetLikeOriginal(x, _map.MaxTH - 1);

            for (int t = 0; t < 1; t++)
            {
                int ofs = 0;
                for (int iy = 0; iy < _map.MaxTH; iy++)
                {
                    for (int ix = 0; ix < _map.VertInLine; ix++)
                    {
                        if (ix > 0 && iy > 0 && ix < _map.VertInLine - 3 && iy < _map.MaxTH - 3)
                        {
                            if ((ix & 1) != 0)
                            {
                                TempL[ofs] = (byte)((
                                    (int)_strictSurfaceLightMap[ofs + _map.VertInLine] +
                                    (int)_strictSurfaceLightMap[ofs] +
                                    (int)_strictSurfaceLightMap[ofs - 1] +
                                    (int)_strictSurfaceLightMap[ofs + 1] +
                                    (int)_strictSurfaceLightMap[ofs - _map.VertInLine - 1] +
                                    (int)_strictSurfaceLightMap[ofs - _map.VertInLine] +
                                    (int)_strictSurfaceLightMap[ofs - _map.VertInLine + 1]) / 7);
                            }
                            else
                            {
                                TempL[ofs] = (byte)((
                                    (int)_strictSurfaceLightMap[ofs - _map.VertInLine] +
                                    (int)_strictSurfaceLightMap[ofs] +
                                    (int)_strictSurfaceLightMap[ofs - 1] +
                                    (int)_strictSurfaceLightMap[ofs + 1] +
                                    (int)_strictSurfaceLightMap[ofs + _map.VertInLine - 1] +
                                    (int)_strictSurfaceLightMap[ofs + _map.VertInLine] +
                                    (int)_strictSurfaceLightMap[ofs + _map.VertInLine + 1]) / 7);
                            }
                        }
                        ofs++;
                    }
                }
                Buffer.BlockCopy(TempL, 0, _strictSurfaceLightMap, 0, size);
            }
        }

        private int GetLighting3DLikeOriginal(int i)
        {
            if (_map == null || _map.Heights == null || _map.Heights.Length == 0 || _map.VertInLine <= 0)
                return 128;

            EnsureStrictSurfaceLightMapLikeOriginal();

            int h1, h2, h3, h4, h5, h6;
            int H0 = _GetHiLikeOriginal(i);
            int vp = i % _map.VertInLine;
            if ((vp & 1) == 0)
            {
                h1 = _GetHiLikeOriginal(i + _map.VertInLine);
                h2 = _GetHiLikeOriginal(i + _map.VertInLine + 1);
                h3 = _GetHiLikeOriginal(i + 1);
                h4 = _GetHiLikeOriginal(i - _map.VertInLine);
                h5 = _GetHiLikeOriginal(i - 1);
                h6 = _GetHiLikeOriginal(i + _map.VertInLine - 1);
            }
            else
            {
                h1 = _GetHiLikeOriginal(i + _map.VertInLine);
                h2 = _GetHiLikeOriginal(i + 1);
                h3 = _GetHiLikeOriginal(i - _map.VertInLine + 1);
                h4 = _GetHiLikeOriginal(i - _map.VertInLine);
                h5 = _GetHiLikeOriginal(i - _map.VertInLine - 1);
                h6 = _GetHiLikeOriginal(i - 1);
            }
            int dy = h4 - h1;
            int dx = (h2 - h5 + h3 - h6) >> 1;
            int dz = StrictSurfaceTriUnitLikeOriginal + StrictSurfaceTriUnitLikeOriginal + StrictSurfaceTriUnitLikeOriginal + StrictSurfaceTriUnitLikeOriginal;
            int lig = GetLighting3DVLikeOriginal(dx, dy, dz);
            if (_strictSurfaceLightMap != null)
            {
                int maxPointIndex = _map.Heights.Length;
                int L0;
                if (i >= _map.VertInLine * 2 && i < maxPointIndex - 4) L0 = _strictSurfaceLightMap[i - _map.VertInLine];
                else L0 = 0;
                if (L0 < lig) lig = L0 - ((255 - lig) / 5);
            }
            if (C2GlobalLighting.TL0 == -1)
                C2GlobalLighting.TL0 = GetLighting3D0LikeOriginal();
            lig = (lig << 7) / Mathf.Max(1, C2GlobalLighting.TL0);
            if (lig < 0) lig = 0;
            if (lig > 255) lig = 255;
            return lig;
        }

        private uint GetDW_LightLikeOriginal(int idx)
        {
            uint L = (uint)GetLighting3DLikeOriginal(idx);
            const uint middle = 0xFF808080u;
            if (L < 128u)
            {
                int W = (int)((128u - L) * 4u);
                if (W > 255) W = 255;
                return MixDWORDLikeOriginal(VertexTnL2LikeOriginal.PackDiffuseLikeOriginal(_strictSurfaceShadowColor), middle, W, 255 - W);
            }
            else
            {
                int W = (int)((L - 128u) * 4u);
                if (W > 255) W = 255;
                return MixDWORDLikeOriginal(VertexTnL2LikeOriginal.PackDiffuseLikeOriginal(_strictSurfaceSunColor), middle, W, 255 - W);
            }
        }

        private static void GetDW_LMinLikeOriginal(ref uint v, int idx)
        {
            uint alp = 0u;
            v &= 0x00FFFFFFu;
            v |= (alp << 24);
        }

        private uint GetStrictDwLightLikeOriginal(int idx)
        {
            return GetDW_LightLikeOriginal(idx);
        }

        private static VertexTnL2LikeOriginal WithStrictUv2LikeOriginal(VertexTnL2LikeOriginal src, Vector2 uv2)
        {
            return new VertexTnL2LikeOriginal(src.X, src.Y, src.Z, src.W, src.Diffuse, src.U, src.V, uv2.x, uv2.y);
        }

        private static VertexTnL2LikeOriginal WithStrictDiffuseLikeOriginal(VertexTnL2LikeOriginal src, uint diffuse)
        {
            return new VertexTnL2LikeOriginal(src.X, src.Y, src.Z, src.W, diffuse, src.U, src.V, src.U2, src.V2);
        }

        private static void NormalizeVertexTexRLikeOriginal(ParsedMap map, GroundRuntimeConfig runtimeCfg, short[] randoma,
            ref VertexTnL2LikeOriginal v1, ref VertexTnL2LikeOriginal v2, ref VertexTnL2LikeOriginal v3,
            int gTex, int cTex, bool plain, int vr)
        {
            bool c1 = ((v1.Diffuse >> 24) & 0xFF) > 200;
            bool c2 = ((v2.Diffuse >> 24) & 0xFF) > 200;
            bool c3 = ((v3.Diffuse >> 24) & 0xFF) > 200;
            int t1 = map != null && map.TilePrimary != null && vr >= 0 && vr < map.TilePrimary.Length ? (map.TilePrimary[vr] & 0xFF) : 0;
            int t2 = map != null && map.TileSecondary != null && vr >= 0 && vr < map.TileSecondary.Length ? (map.TileSecondary[vr] & 0xFF) : 0;
            int crs = 0;
            if (runtimeCfg != null && runtimeCfg.TexCrossing != null && t1 >= 0 && t1 < 64 && t2 >= 0 && t2 < 64)
                crs = runtimeCfg.TexCrossing[t1 + t2 * 64];

            if (c1 && c2 && c3 && !PLAINMODELikeOriginal)
            {
                v1 = WithStrictUv2LikeOriginal(v1, Vector2.zero);
                v2 = WithStrictUv2LikeOriginal(v2, Vector2.zero);
                v3 = WithStrictUv2LikeOriginal(v3, Vector2.zero);
            }
            else
            {
                float x0 = (64.0f + 128.0f * (crs & 1) - 32.0f + (RandLikeOriginal() & 63)) / 256.0f;
                float y0 = (64.0f + 128.0f * ((crs >> 1) & 1) - 32.0f + (RandLikeOriginal() & 63)) / 256.0f;
                v1 = WithStrictUv2LikeOriginal(v1, new Vector2(x0, y0));
                v2 = WithStrictUv2LikeOriginal(v2, new Vector2(x0 + ((v2.X - v1.X) / 256.0f), y0 + ((v2.Y - v1.Y) / 256.0f)));
                v3 = WithStrictUv2LikeOriginal(v3, new Vector2(x0 + ((v3.X - v1.X) / 256.0f), y0 + ((v3.Y - v1.Y) / 256.0f)));
            }
        }

        private static void NormalizeVertexTexLLikeOriginal(ParsedMap map, GroundRuntimeConfig runtimeCfg, short[] randoma,
            ref VertexTnL2LikeOriginal v1, ref VertexTnL2LikeOriginal v2, ref VertexTnL2LikeOriginal v3,
            int gTex, int cTex, bool plain, int vr)
        {
            bool c1 = ((v1.Diffuse >> 24) & 0xFF) > 200;
            bool c2 = ((v2.Diffuse >> 24) & 0xFF) > 200;
            bool c3 = ((v3.Diffuse >> 24) & 0xFF) > 200;
            int t1 = map != null && map.TilePrimary != null && vr >= 0 && vr < map.TilePrimary.Length ? (map.TilePrimary[vr] & 0xFF) : 0;
            int t2 = map != null && map.TileSecondary != null && vr >= 0 && vr < map.TileSecondary.Length ? (map.TileSecondary[vr] & 0xFF) : 0;
            int crs = 0;
            if (runtimeCfg != null && runtimeCfg.TexCrossing != null && t1 >= 0 && t1 < 64 && t2 >= 0 && t2 < 64)
                crs = runtimeCfg.TexCrossing[t1 + t2 * 64];

            if (c1 && c2 && c3 && !PLAINMODELikeOriginal)
            {
                v1 = WithStrictUv2LikeOriginal(v1, Vector2.zero);
                v2 = WithStrictUv2LikeOriginal(v2, Vector2.zero);
                v3 = WithStrictUv2LikeOriginal(v3, Vector2.zero);
            }
            else
            {
                float x0 = (64.0f + 128.0f * (crs & 1) - 32.0f + (RandLikeOriginal() & 63)) / 256.0f;
                float y0 = (64.0f + 128.0f * ((crs >> 1) & 1) - 32.0f + (RandLikeOriginal() & 63)) / 256.0f;
                v1 = WithStrictUv2LikeOriginal(v1, new Vector2(x0, y0));
                v2 = WithStrictUv2LikeOriginal(v2, new Vector2(x0 + ((v2.X - v1.X) / 256.0f), y0 + ((v2.Y - v1.Y) / 256.0f)));
                v3 = WithStrictUv2LikeOriginal(v3, new Vector2(x0 + ((v3.X - v1.X) / 256.0f), y0 + ((v3.Y - v1.Y) / 256.0f)));
            }
        }

        private uint BuildStrictSurfaceDiffuseLikeOriginal(int vertex, int alpha)
        {
            return SetStrictPackedAlphaLikeOriginal(GetStrictDwLightLikeOriginal(vertex), alpha);
        }

        private Color32 GetStrictSurfaceLightColorLikeOriginal(int vertex)
        {
            int l = GetLighting3DLikeOriginal(vertex);
            Color32 middle = new Color32(128, 128, 128, 255);
            EnsureStrictSurfaceLightingStateLikeOriginal();
            if (l < 128)
            {
                int w = (128 - l) * 4;
                if (w > 255) w = 255;
                return MixColor32LikeOriginal(_strictSurfaceShadowColor, middle, w, 255 - w);
            }
            else
            {
                int w = (l - 128) * 4;
                if (w > 255) w = 255;
                return MixColor32LikeOriginal(_strictSurfaceSunColor, middle, w, 255 - w);
            }
        }

        private List<StoneSpriteRecordLikeOriginal> BuildStrictStoneSpritesLikeOriginal(GroundRuntimeConfig runtimeCfg, short[] randoma, Camera activeCamera, Vector2Int viewport)
        {
            List<StonePoolRecordLikeOriginal> pool = BuildStrictStonePoolLikeOriginal(runtimeCfg, randoma, activeCamera, viewport);
            if (pool == null || pool.Count == 0)
                return null;

            var sprites = new List<StoneSpriteRecordLikeOriginal>(pool.Count * 8);
            for (int j = 0; j < pool.Count; j++)
            {
                StonePoolRecordLikeOriginal src = pool[j];
                Vector4 mainRect = BuildStoneAtlasRectLikeOriginal(src.StoneTex & 15);
                uint randState = BuildStoneRandSeedLikeOriginal(randoma, src.Vertex, j);

                for (int p = 0; p < 8; p++)
                {
                    int xc = src.ScreenX;
                    int yc = src.ScreenY;
                    if (p != 0)
                    {
                        xc += (int)(NextStoneRandLikeOriginal(ref randState) & 31u) - 15;
                        yc += (int)(NextStoneRandLikeOriginal(ref randState) & 15u) - 12 + p + p + p;
                    }

                    int sid = (int)(NextStoneRandLikeOriginal(ref randState) & 15u);
                    Vector4 stoneRect = BuildStoneAtlasRectLikeOriginal(sid);
                    sprites.Add(new StoneSpriteRecordLikeOriginal
                    {
                        ScreenX = xc,
                        ScreenY = yc,
                        Z = src.Z,
                        Rhw = src.Rhw,
                        Diffuse = src.Diffuse,
                        MainUvRect = mainRect,
                        StoneUvRect = stoneRect
                    });
                }
            }

            return sprites;
        }

        private List<StonePoolRecordLikeOriginal> BuildStrictStonePoolLikeOriginal(GroundRuntimeConfig runtimeCfg, short[] randoma, Camera activeCamera, Vector2Int viewport)
        {
            if (_map == null || _map.Heights == null)
                return null;

            int totalVerts = Math.Min(_map.Heights.Length, _map.VertInLine * _map.MaxTH);
            var pool = new List<StonePoolRecordLikeOriginal>(512);
            for (int v = 0; v < totalVerts; v++)
            {
                if (!CheckVertexForStoneLikeOriginal(v))
                    continue;

                Vector2 rasterPos = GetStonePoolRasterPosLikeOriginal(_map, v);
                int mapX = GetTriXLikeOriginal(_map, v);
                int mapY = GetTriYLikeOriginal(_map, v);
                int stoneTex = GetNearestStoneTexLikeOriginal(mapX, mapY) & 15;

                int sx = Mathf.RoundToInt(rasterPos.x);
                int sy = Mathf.RoundToInt(rasterPos.y);
                pool.Add(new StonePoolRecordLikeOriginal
                {
                    Vertex = v,
                    ScreenX = sx,
                    ScreenY = sy,
                    Z = GetStrictSurfaceZLikeOriginal(sy),
                    Rhw = GetStrictSurfaceRhwLikeOriginal(v),
                    Diffuse = VertexTnL2LikeOriginal.UnpackDiffuseLikeOriginal(BuildStrictSurfaceDiffuseLikeOriginal(v, 255)),
                    StoneTex = stoneTex
                });
            }

            return pool;
        }

        private static uint BuildStoneRandSeedLikeOriginal(short[] randoma, int vertex, int recordIndex)
        {
            uint s0 = (uint)(GetVValueLikeOriginal(randoma, vertex, 149) & 0x7FFF);
            uint s1 = (uint)(GetVValueLikeOriginal(randoma, vertex, 151) & 0x7FFF);
            uint s2 = (uint)(recordIndex & 0xFFFF);
            uint seed = (s0 << 17) ^ (s1 << 1) ^ s2 ^ 0xA511E9B3u;
            return seed != 0u ? seed : 1u;
        }

        private static uint NextStoneRandLikeOriginal(ref uint state)
        {
            state = 214013u * state + 2531011u;
            return (state >> 16) & 0x7FFFu;
        }

        private static Vector4 BuildStoneAtlasRectLikeOriginal(int atlasIndex)
        {
            float u = (atlasIndex & 3) * 0.25f;
            float v = ((atlasIndex >> 2) & 3) * 0.25f;
            return new Vector4(u, v, 0.25f, 0.25f);
        }

        private static Vector2 GetStonePoolRasterPosLikeOriginal(ParsedMap map, int vertex)
        {
            float x = GetTriXLikeOriginal(map, vertex) + GetXShiftLikeOriginal(map, vertex);
            float y = GetPsyLikeOriginal(map, vertex) + GetYShiftLikeOriginal(map, vertex);
            return new Vector2(x, y);
        }

        private Mesh CreateStrictStoneSharedQuadMeshLikeOriginal(string name)
        {
            var mesh = new Mesh();
            mesh.name = name;
            mesh.indexFormat = IndexFormat.UInt16;
            mesh.SetVertices(new List<Vector3>
            {
                new Vector3(-1.0f, -1.0f, 0.0f),
                new Vector3( 1.0f, -1.0f, 0.0f),
                new Vector3(-1.0f,  1.0f, 0.0f),
                new Vector3( 1.0f,  1.0f, 0.0f),
            });
            mesh.SetTriangles(new[] { 0, 1, 2, 2, 1, 3 }, 0, true);
            mesh.SetUVs(0, new List<Vector2>
            {
                new Vector2(0.0f, 0.0f),
                new Vector2(1.0f, 0.0f),
                new Vector2(0.0f, 1.0f),
                new Vector2(1.0f, 1.0f),
            });
            mesh.RecalculateBounds();
            return mesh;
        }

        private bool CheckVertexForStoneLikeOriginal(int vertex)
        {
            if (_map == null || _map.TilePrimary == null || _map.Heights == null || vertex < 0 || vertex >= _map.Heights.Length)
                return false;

            int vx = vertex % _map.VertInLine;
            int vy = vertex / _map.VertInLine;
            if (vx <= 2 || vy <= 2)
                return false;

            float wx = vx << 5;
            float wy = (vy << 5) - (((vx & 1) != 0) ? 16.0f : 0.0f);
            Vector3 n = ComputeSurfaceNormalLikeOriginal(_map, wx, wy);
            if (Mathf.Abs(n.x) > Mathf.Abs(n.y))
                return false;

            int t = GetStoneBaseTexLikeOriginal(vertex);
            int tu = GetStoneBaseTexLikeOriginal(vertex - _map.VertInLine);
            return CheckTexForStonesLikeOriginal(t) && !CheckTexForStonesLikeOriginal(tu);
        }

        private static bool CheckTexForStonesLikeOriginal(int tex)
        {
            return tex == 10;
        }

        private int GetStoneBaseTexLikeOriginal(int vertex)
        {
            if (_map == null || _map.TilePrimary == null || vertex < 0 || vertex >= _map.TilePrimary.Length)
                return 0;
            return _map.TilePrimary[vertex] & 0xFF;
        }

        private int GetNearestStoneTexLikeOriginal(int x, int y)
        {
            if (_map == null || _map.TilePrimary == null)
                return 8;

            int tx = x >> 5;
            int ty = y >> 5;
            for (int radius = 0; radius < 20; radius++)
            {
                for (int dy = -radius; dy <= radius; dy++)
                {
                    for (int dx = -radius; dx <= radius; dx++)
                    {
                        if (Mathf.Abs(dx) != radius && Mathf.Abs(dy) != radius)
                            continue;

                        int sx = tx + dx;
                        int sy = ty + dy;
                        if (sx < 0 || sy < 0 || sx >= _map.VertInLine || sy >= _map.MaxTH)
                            continue;

                        int ofs = sx + sy * _map.VertInLine;
                        int t = _map.TilePrimary[ofs] & 0xFF;
                        int secWeight = (_map.TileSecondaryWeight != null && ofs < _map.TileSecondaryWeight.Length) ? (_map.TileSecondaryWeight[ofs] & 0xFF) : 0;
                        if (secWeight > 127 && _map.TileSecondary != null && ofs < _map.TileSecondary.Length)
                            t = _map.TileSecondary[ofs] & 0xFF;
                        return t;
                    }
                }
            }
            return 8;
        }

        private Vector3 GetWorldVertexPosLikeOriginal(int vertex)
        {
            if (_map == null || _map.Heights == null || vertex < 0 || vertex >= _map.Heights.Length)
                return Vector3.zero;

            int vx = vertex % _map.VertInLine;
            int vy = vertex / _map.VertInLine;
            float x = vx * 32.0f * HorizontalScale;
            float z = (vy * 32.0f + (((vx & 1) != 0) ? -16.0f : 0.0f)) * HorizontalScale * WorldZSign;
            float y = _map.Heights[vertex] * VerticalScale;
            return new Vector3(x, y, z);
        }

        private void EnsureStrictSurfaceLightingStateLikeOriginal()
        {
            if (_strictSurfaceLightingStateLoaded)
                return;

            _strictSurfaceLightingStateLoaded = true;
            _strictSurfaceSunColor = new Color32(128, 128, 128, 255);
            _strictSurfaceShadowColor = new Color32(128, 128, 128, 255);

            var fs = _bootstrap != null ? _bootstrap.Fs : null;
            if (fs != null)
            {
                string settingsPath = fs.Exists("EngineSettings.xml") ? "EngineSettings.xml" : (fs.Exists("enginesettings.xml") ? "enginesettings.xml" : null);
                if (!string.IsNullOrWhiteSpace(settingsPath))
                {
                    try
                    {
                        string xml = fs.ReadAllText(settingsPath);
                        if (!string.IsNullOrWhiteSpace(xml))
                        {
                            var doc = XDocument.Parse(xml);
                            XElement root = doc.Root;
                            if (root != null)
                            {
                                XElement shadowEl = root.Element("ShadowsColor");
                                XElement sunEl = root.Element("SunColor");
                                if (shadowEl != null)
                                    _strictSurfaceShadowColor = ParseArgbColorLikeOriginal(shadowEl.Value, _strictSurfaceShadowColor);
                                if (sunEl != null)
                                    _strictSurfaceSunColor = ParseArgbColorLikeOriginal(sunEl.Value, _strictSurfaceSunColor);
                            }
                        }
                    }
                    catch { }
                }
            }

            _strictSurfaceLightMap = null;
            _strictSurfaceLightMapReady = false;
        }

        public static void SetStrictSurfaceGlobalLightLikeOriginal(int ldx, int ldy, int ldz)
        {
            C2GlobalLighting.SetLightLikeOriginal(ldx, ldy, ldz);
        }

        private static Color32 ParseArgbColorLikeOriginal(string hex, Color32 fallback)
        {
            try
            {
                string s = hex.Trim();
                if (s.StartsWith("0x", StringComparison.OrdinalIgnoreCase))
                    s = s.Substring(2);
                uint v = Convert.ToUInt32(s, 16);
                byte a = (byte)((v >> 24) & 0xFF);
                byte r = (byte)((v >> 16) & 0xFF);
                byte g = (byte)((v >> 8) & 0xFF);
                byte b = (byte)(v & 0xFF);
                return new Color32(r, g, b, a);
            }
            catch
            {
                return fallback;
            }
        }

        private int GetStrictLightingValueLikeOriginal(int vertex)
        {
            return GetLighting3DLikeOriginal(vertex);
        }

        private static Color32 MixColor32LikeOriginal(Color32 a, Color32 b, int wa, int wb)
        {
            wa = Mathf.Clamp(wa, 0, 255);
            wb = Mathf.Clamp(wb, 0, 255);
            int r = ((a.r * wa) + (b.r * wb)) >> 8;
            int g = ((a.g * wa) + (b.g * wb)) >> 8;
            int bl = ((a.b * wa) + (b.b * wb)) >> 8;
            int al = ((a.a * wa) + (b.a * wb)) >> 8;
            return new Color32((byte)Mathf.Clamp(r, 0, 255), (byte)Mathf.Clamp(g, 0, 255), (byte)Mathf.Clamp(bl, 0, 255), (byte)Mathf.Clamp(al, 0, 255));
        }

        private void EnsureStrictSurfaceLightMapLikeOriginal()
        {
            if (_strictSurfaceLightMapReady)
                return;
            _strictSurfaceLightMapReady = true;
            CreateLightMapLikeOriginal();
        }

        private int GetStrictTotalHeightLikeOriginal(int x, int y)
        {
            if (_map == null || _map.Heights == null || _map.Heights.Length == 0)
                return 0;
            int maxX = Mathf.Max(0, (_map.VertInLine - 1) * 32);
            int maxY = Mathf.Max(0, (_map.MaxTH - 1) * 32 + 32);
            if (x < 0) x = 0;
            if (y < 0) y = 0;
            if (x > maxX) x = maxX;
            if (y > maxY) y = maxY;
            return GetInterpolatedHeightLikeOriginal(_map, x, y);
        }

        private static uint MixDWORDLikeOriginal(uint a, uint b, int wa, int wb)
        {
            wa = Mathf.Clamp(wa, 0, 255);
            wb = Mathf.Clamp(wb, 0, 255);

            int aa = (int)((a >> 24) & 0xFF);
            int ar = (int)((a >> 16) & 0xFF);
            int ag = (int)((a >> 8) & 0xFF);
            int ab = (int)(a & 0xFF);

            int ba = (int)((b >> 24) & 0xFF);
            int br = (int)((b >> 16) & 0xFF);
            int bg = (int)((b >> 8) & 0xFF);
            int bb = (int)(b & 0xFF);

            uint oa = (uint)Mathf.Clamp(((aa * wa) + (ba * wb)) >> 8, 0, 255);
            uint orr = (uint)Mathf.Clamp(((ar * wa) + (br * wb)) >> 8, 0, 255);
            uint og = (uint)Mathf.Clamp(((ag * wa) + (bg * wb)) >> 8, 0, 255);
            uint ob = (uint)Mathf.Clamp(((ab * wa) + (bb * wb)) >> 8, 0, 255);
            return (oa << 24) | (orr << 16) | (og << 8) | ob;
        }

        private int GetStrictHeightVertexLikeOriginal(int vertex)
        {
            if (_map == null || _map.Heights == null || _map.Heights.Length == 0)
                return 0;
            if (vertex < 0 || vertex >= _map.Heights.Length)
                return 0;
            return _map.Heights[vertex];
        }

        private static float GetBaseUAtlasLikeOriginal(int tex)
        {
            return (tex & 7) / 8.0f + (1.0f / 512.0f);
        }

        private static float GetBaseVAtlasLikeOriginal(int tex)
        {
            return (tex / 8) / 8.0f + (1.0f / 512.0f);
        }

        private static void GetTriPassAtlasUvLikeOriginal(int texId, int triKind, int passRank, short[] randoma, int v00, int v10, int v01, int v11, out Vector2 uv0, out Vector2 uv1, out Vector2 uv2)
        {
            const float tq = 32.0f / 512.0f;
            const float hq = 16.0f / 512.0f;
            float baseU = GetBaseUAtlasLikeOriginal(texId);
            float baseV = GetBaseVAtlasLikeOriginal(texId);
            int seedUVertex;
            int seedURset;
            int seedVVertex;
            int seedVRset;
            bool rightShape;
            switch (triKind)
            {
                case 0:
                    rightShape = false;
                    if (passRank == 0) { seedUVertex = v00; seedURset = 71; seedVVertex = v00; seedVRset = 77; }
                    else if (passRank == 1) { seedUVertex = v11; seedURset = 93; seedVVertex = v11; seedVRset = 97; }
                    else { seedUVertex = v10; seedURset = 77; seedVVertex = v00; seedVRset = 67; }
                    break;
                case 1:
                    rightShape = true;
                    if (passRank == 0) { seedUVertex = v10; seedURset = 73; seedVVertex = v00; seedVRset = 79; }
                    else if (passRank == 1) { seedUVertex = v00; seedURset = 63; seedVVertex = v10; seedVRset = 97; }
                    else { seedUVertex = v00; seedURset = 93; seedVVertex = v00; seedVRset = 61; }
                    break;
                case 2:
                    rightShape = true;
                    if (passRank == 0) { seedUVertex = v00; seedURset = 47; seedVVertex = v00; seedVRset = 49; }
                    else if (passRank == 1) { seedUVertex = v00; seedURset = 171; seedVVertex = v00; seedVRset = 371; }
                    else { seedUVertex = v00; seedURset = 711; seedVVertex = v00; seedVRset = 211; }
                    break;
                default:
                    rightShape = false;
                    if (passRank == 0) { seedUVertex = v00; seedURset = 111; seedVVertex = v00; seedVRset = 113; }
                    else if (passRank == 1) { seedUVertex = v00; seedURset = 79; seedVVertex = v00; seedVRset = 39; }
                    else { seedUVertex = v00; seedURset = 29; seedVVertex = v00; seedVRset = 37; }
                    break;
            }
            float u0 = baseU + ((float)(GetVValueLikeOriginal(randoma, seedUVertex, seedURset) & 31)) / 512.0f;
            float v0 = baseV + ((float)(GetVValueLikeOriginal(randoma, seedVVertex, seedVRset) % 28)) / 512.0f;
            if (rightShape)
            {
                uv0 = new Vector2(u0, v0 + hq);
                uv1 = new Vector2(u0 + tq, v0);
                uv2 = new Vector2(u0 + tq, v0 + tq);
            }
            else
            {
                uv0 = new Vector2(u0, v0);
                uv1 = new Vector2(u0 + tq, v0 + hq);
                uv2 = new Vector2(u0, v0 + tq);
            }
        }

        private static void GetStrictSurfaceTriangleVertexIdsLikeOriginal(int triKind, int v00, int v10, int v01, int v11, out int a, out int b, out int c)
        {
            switch (triKind)
            {
                case 0: a = v00; b = v10; c = v01; break;
                case 1: a = v01; b = v10; c = v11; break;
                case 2: a = v00; b = v10; c = v11; break;
                default: a = v00; b = v11; c = v01; break;
            }
        }

        private static int GetStrictSurfaceCrossVrLikeOriginal(int triKind, int passRank, int v00, int v10, int v01, int v11)
        {
            switch (triKind)
            {
                case 0:
                    return passRank == 0 ? v00 : (passRank == 1 ? v01 : v11);
                case 1:
                    return passRank == 0 ? v10 : (passRank == 1 ? v10 : v01);
                case 2:
                    return passRank == 0 ? v10 : (passRank == 1 ? v11 : v10);
                default:
                    return passRank == 0 ? v11 : (passRank == 1 ? v10 : v01);
            }
        }

        private static bool BuildCrossingUvLikeOriginal(ParsedMap map, GroundRuntimeConfig runtimeCfg, short[] randoma,
            int va, int vb, int vc,
            int a0, int a1, int a2,
            int vr, bool plainMode,
            Vector3 emittedScreenPos0, Vector3 emittedScreenPos1, Vector3 emittedScreenPos2,
            out Vector2 uv0, out Vector2 uv1, out Vector2 uv2)
        {
            bool c0 = a0 > 200;
            bool c1 = a1 > 200;
            bool c2 = a2 > 200;
            if (c0 && c1 && c2 && !plainMode)
            {
                uv0 = Vector2.zero;
                uv1 = Vector2.zero;
                uv2 = Vector2.zero;
                return false;
            }

            int groundTex = map != null && map.TilePrimary != null && vr >= 0 && vr < map.TilePrimary.Length ? (map.TilePrimary[vr] & 0xFF) : 0;
            int crossTex = map != null && map.TileSecondary != null && vr >= 0 && vr < map.TileSecondary.Length ? (map.TileSecondary[vr] & 0xFF) : 0;
            int crs = 0;
            if (runtimeCfg != null && runtimeCfg.TexCrossing != null && groundTex >= 0 && groundTex < 64 && crossTex >= 0 && crossTex < 64)
                crs = runtimeCfg.TexCrossing[groundTex + crossTex * 64];

            float x0 = (64.0f + 128.0f * (crs & 1) - 32.0f + (RandLikeOriginal() & 63)) / 256.0f;
            float y0 = (64.0f + 128.0f * ((crs >> 1) & 1) - 32.0f + (RandLikeOriginal() & 63)) / 256.0f;

            Vector2 v1 = new Vector2(emittedScreenPos0.x, emittedScreenPos0.y);
            Vector2 v2 = new Vector2(emittedScreenPos1.x, emittedScreenPos1.y);
            Vector2 v3 = new Vector2(emittedScreenPos2.x, emittedScreenPos2.y);

            uv0 = new Vector2(x0, y0);
            uv1 = new Vector2(x0 + ((v2.x - v1.x) / 256.0f), y0 + ((v2.y - v1.y) / 256.0f));
            uv2 = new Vector2(x0 + ((v3.x - v1.x) / 256.0f), y0 + ((v3.y - v1.y) / 256.0f));
            return true;
        }

        private static int AddStrictStage1Triangle(TerrainRuntimeTriangleBuffer dst, Dictionary<int, int> groundLayerById, short[] randoma, int triKind,
            int v00, int v10, int v01, int v11,
            Vector3 p0, Vector3 p1, Vector3 p2,
            int ta, int tb, int tc)
        {
            int tMin = ta;
            int tAve = tb;
            int tMax = tc;
            Sort3LikeOriginal(ref tMin, ref tAve, ref tMax);
            CollapseSortedUnique(tMin, tAve, tMax, out int l0Id, out int l1Id, out int l2Id);
            if (!groundLayerById.TryGetValue(l0Id, out int l0)) return 0;
            int l1 = (l1Id >= 0 && groundLayerById.TryGetValue(l1Id, out int tmp1)) ? tmp1 : l0;
            int l2 = (l2Id >= 0 && groundLayerById.TryGetValue(l2Id, out int tmp2)) ? tmp2 : l1;

            GetTriPassUvLikeOriginal(triKind, 0, randoma, v00, v10, v01, v11, out Vector2 p0uv0, out Vector2 p1uv0, out Vector2 p2uv0);
            GetTriPassUvLikeOriginal(triKind, 1, randoma, v00, v10, v01, v11, out Vector2 p0uv1, out Vector2 p1uv1, out Vector2 p2uv1);
            GetTriPassUvLikeOriginal(triKind, 2, randoma, v00, v10, v01, v11, out Vector2 p0uv2, out Vector2 p1uv2, out Vector2 p2uv2);

            Color32 c0 = MakeWeightColor(ta == l0Id ? 1f : 0f, l1Id >= 0 && ta == l1Id ? 1f : 0f, l2Id >= 0 && ta == l2Id ? 1f : 0f);
            Color32 c1 = MakeWeightColor(tb == l0Id ? 1f : 0f, l1Id >= 0 && tb == l1Id ? 1f : 0f, l2Id >= 0 && tb == l2Id ? 1f : 0f);
            Color32 c2 = MakeWeightColor(tc == l0Id ? 1f : 0f, l1Id >= 0 && tc == l1Id ? 1f : 0f, l2Id >= 0 && tc == l2Id ? 1f : 0f);
            Vector4 layers = new Vector4(l0, l1, l2, 0f);
            Vector4 tang = Vector4.zero;
            dst.AddTriangle(p0, p1, p2, p0uv0, p0uv1, p0uv2, p1uv0, p1uv1, p1uv2, p2uv0, p2uv1, p2uv2, layers, c0, c1, c2, tang, tang, tang);
            return 1;
        }

        private static int AddStrictStage2Triangle(TerrainRuntimeTriangleBuffer dst, GroundRuntimeConfig runtimeCfg, Dictionary<int, int> groundLayerById, short[] randoma, int triKind,
            int v00, int v10, int v01, int v11,
            Vector3 p0, Vector3 p1, Vector3 p2,
            int ba, int bb, int bc,
            int sa, int sb, int sc,
            int wa, int wb, int wc,
            Vector2 cellUv0, Vector2 cellUv1, Vector2 cellUv2)
        {
            int sMin = sa;
            int sAve = sb;
            int sMax = sc;
            Sort3LikeOriginal(ref sMin, ref sAve, ref sMax);
            CollapseSortedUnique(sMin, sAve, sMax, out int l0Id, out int l1Id, out int l2Id);
            if (l0Id < 0) return 0;
            if (!groundLayerById.TryGetValue(l0Id, out int l0)) return 0;
            int l1 = (l1Id >= 0 && groundLayerById.TryGetValue(l1Id, out int tmp1)) ? tmp1 : l0;
            int l2 = (l2Id >= 0 && groundLayerById.TryGetValue(l2Id, out int tmp2)) ? tmp2 : l1;

            float vw0 = (sa != ba && l0Id >= 0 && sa == l0Id) ? (wa / 255.0f) : 0.0f;
            float vw1 = (sa != ba && l1Id >= 0 && sa == l1Id) ? (wa / 255.0f) : 0.0f;
            float vw2 = (sa != ba && l2Id >= 0 && sa == l2Id) ? (wa / 255.0f) : 0.0f;
            float ww0 = (sb != bb && l0Id >= 0 && sb == l0Id) ? (wb / 255.0f) : 0.0f;
            float ww1 = (sb != bb && l1Id >= 0 && sb == l1Id) ? (wb / 255.0f) : 0.0f;
            float ww2 = (sb != bb && l2Id >= 0 && sb == l2Id) ? (wb / 255.0f) : 0.0f;
            float xu0 = (sc != bc && l0Id >= 0 && sc == l0Id) ? (wc / 255.0f) : 0.0f;
            float xu1 = (sc != bc && l1Id >= 0 && sc == l1Id) ? (wc / 255.0f) : 0.0f;
            float xu2 = (sc != bc && l2Id >= 0 && sc == l2Id) ? (wc / 255.0f) : 0.0f;
            if (vw0 + vw1 + vw2 + ww0 + ww1 + ww2 + xu0 + xu1 + xu2 <= 1e-6f)
                return 0;

            GetTriPassUvLikeOriginal(triKind, 0, randoma, v00, v10, v01, v11, out Vector2 p0uv0, out Vector2 p1uv0, out Vector2 p2uv0);
            GetTriPassUvLikeOriginal(triKind, 1, randoma, v00, v10, v01, v11, out Vector2 p0uv1, out Vector2 p1uv1, out Vector2 p2uv1);
            GetTriPassUvLikeOriginal(triKind, 2, randoma, v00, v10, v01, v11, out Vector2 p0uv2, out Vector2 p1uv2, out Vector2 p2uv2);

            int crossType = 0;
            if (runtimeCfg != null && runtimeCfg.TexCrossing != null && ba >= 0 && ba < 64 && sa >= 0 && sa < 64)
                crossType = runtimeCfg.TexCrossing[ba + sa * 64];

            Vector4 layers = new Vector4(l0, l1, l2, 0f);
            dst.AddTriangle(
                p0, p1, p2,
                p0uv0, p0uv1, p0uv2,
                p1uv0, p1uv1, p1uv2,
                p2uv0, p2uv1, p2uv2,
                layers,
                MakeWeightColor(vw0, vw1, vw2),
                MakeWeightColor(ww0, ww1, ww2),
                MakeWeightColor(xu0, xu1, xu2),
                new Vector4(cellUv0.x, cellUv0.y, crossType, 1f),
                new Vector4(cellUv1.x, cellUv1.y, crossType, 1f),
                new Vector4(cellUv2.x, cellUv2.y, crossType, 1f));
            return 1;
        }

        private int AddStrictFactureTrianglesBatched(GArrayBufferLikeOriginal[] plainById, GArrayBufferLikeOriginal[] bumpById, GroundRuntimeConfig runtimeCfg, GroundTextureCatalog catalog, int triKind,
            int a, int b, int c,
            Vector3 p0, Vector3 p1, Vector3 p2,
            out int addedPlain,
            out int addedBump)
        {
            addedPlain = 0;
            addedBump = 0;
            if (_map == null || _map.FactureMap == null || _map.FactureWeight == null)
                return 0;

            int wa = (a < _map.FactureWeight.Length) ? _map.FactureWeight[a] : 0;
            int wb = (b < _map.FactureWeight.Length) ? _map.FactureWeight[b] : 0;
            int wc = (c < _map.FactureWeight.Length) ? _map.FactureWeight[c] : 0;
            if (wa == 0 && wb == 0 && wc == 0)
                return 0;

            int fa = (a < _map.FactureMap.Length) ? (_map.FactureMap[a] & 0xFF) : 0;
            int fb = (b < _map.FactureMap.Length) ? (_map.FactureMap[b] & 0xFF) : 0;
            int fc = (c < _map.FactureMap.Length) ? (_map.FactureMap[c] & 0xFF) : 0;
            int f1 = ComputeOriginalFactureTIdx(_map, runtimeCfg, a, fa);
            int f2 = ComputeOriginalFactureTIdx(_map, runtimeCfg, b, fb);
            int f3 = ComputeOriginalFactureTIdx(_map, runtimeCfg, c, fc);

            int total = 0;
            total += EmitStrictFactureTriangleForTIdx(plainById, bumpById, runtimeCfg, catalog, f1, a, b, c, wa, wb, wc, f1, f2, f3, p0, p1, p2, ref addedPlain, ref addedBump);
            if (wb != 0 && f2 != f1)
                total += EmitStrictFactureTriangleForTIdx(plainById, bumpById, runtimeCfg, catalog, f2, a, b, c, wa, wb, wc, f1, f2, f3, p0, p1, p2, ref addedPlain, ref addedBump);
            if (wc != 0 && f3 != f1 && f3 != f2)
                total += EmitStrictFactureTriangleForTIdx(plainById, bumpById, runtimeCfg, catalog, f3, a, b, c, wa, wb, wc, f1, f2, f3, p0, p1, p2, ref addedPlain, ref addedBump);
            return total;
        }

        private int EmitStrictFactureTriangleForTIdx(GArrayBufferLikeOriginal[] plainById, GArrayBufferLikeOriginal[] bumpById, GroundRuntimeConfig runtimeCfg, GroundTextureCatalog catalog,
            int candidateTIdx,
            int a, int b, int c,
            int wa, int wb, int wc,
            int f1, int f2, int f3,
            Vector3 p0, Vector3 p1, Vector3 p2,
            ref int addedPlain,
            ref int addedBump)
        {
            int factId = candidateTIdx & 255;
            FactureInfoEntry fe = (runtimeCfg != null && runtimeCfg.Factures != null && factId >= 0 && factId < runtimeCfg.Factures.Length) ? runtimeCfg.Factures[factId] : null;
            Texture2D factTex = ResolveTextureForFactureId(catalog, runtimeCfg, factId);
            if (factTex == null)
                return 0;

            if (!TryGetFactureUvDiffuseLikeOriginal(runtimeCfg, a, candidateTIdx, out Vector2 ua, out int maxWa, out uint diffA)) return 0;
            if (!TryGetFactureUvDiffuseLikeOriginal(runtimeCfg, b, candidateTIdx, out Vector2 ub, out int maxWb, out uint diffB)) return 0;
            if (!TryGetFactureUvDiffuseLikeOriginal(runtimeCfg, c, candidateTIdx, out Vector2 uc, out int maxWc, out uint diffC)) return 0;

            if (f1 != candidateTIdx) maxWa = 0;
            if (f2 != candidateTIdx) maxWb = 0;
            if (f3 != candidateTIdx) maxWc = 0;
            if (wa < maxWa) maxWa = wa;
            if (wb < maxWb) maxWb = wb;
            if (wc < maxWc) maxWc = wc;
            if (maxWa == 0 && maxWb == 0 && maxWc == 0)
                return 0;

            bool useBump = fe != null && fe.UseBumpMap && ResolveBumpTextureForFactureId(catalog, runtimeCfg, factId) != null;
            GArrayBufferLikeOriginal buffer = GetOrCreateFactureTriangleBuffer(useBump ? bumpById : plainById, factId);
            if (buffer == null)
                return 0;

            uint d0;
            uint d1;
            uint d2;
            if (useBump)
            {
                d0 = SetStrictPackedAlphaLikeOriginal(diffA, maxWa);
                d1 = SetStrictPackedAlphaLikeOriginal(diffB, maxWb);
                d2 = SetStrictPackedAlphaLikeOriginal(diffC, maxWc);
                addedBump++;
            }
            else
            {
                d0 = SetStrictPackedAlphaLikeOriginal(diffA, maxWa);
                d1 = SetStrictPackedAlphaLikeOriginal(diffB, maxWb);
                d2 = SetStrictPackedAlphaLikeOriginal(diffC, maxWc);
                addedPlain++;
            }

            buffer.AddTriangle(p0, p1, p2, ua, ub, uc, d0, d1, d2);
            return 1;
        }

        private static GArrayBufferLikeOriginal GetOrCreateFactureTriangleBuffer(GArrayBufferLikeOriginal[] arr, int factId)
        {
            if (arr == null || factId < 0 || factId >= arr.Length)
                return null;
            GArrayBufferLikeOriginal buffer = arr[factId];
            if (buffer == null)
            {
                buffer = new GArrayBufferLikeOriginal();
                arr[factId] = buffer;
            }
            return buffer;
        }


        private static Vector3 GetGameLightDirLikeOriginal()
        {
            if (!C2GlobalLighting.IsInitialized)
                C2GlobalLighting.SetLightLikeOriginal(0, 20, 30);

            Vector3 dir = new Vector3(
                C2GlobalLighting.LightDX / 256.0f,
                C2GlobalLighting.LightDY / 256.0f,
                C2GlobalLighting.LightDZ / 256.0f);

            if (dir.sqrMagnitude < 1e-12f)
                dir = new Vector3(0.0f, 0.0f, 1.0f);
            else
                dir.Normalize();

            return dir;
        }

        private static Vector3 ToTangentSpaceLikeOriginal(Vector3 v, Vector3 n, Vector3 t)
        {
            Vector3 nn = n.sqrMagnitude > 1e-12f ? n.normalized : Vector3.forward;
            Vector3 tt = t.sqrMagnitude > 1e-12f ? t.normalized : Vector3.right;
            Vector3 b = Vector3.Cross(nn, tt);
            if (b.sqrMagnitude < 1e-12f)
            {
                tt = Mathf.Abs(nn.y) < 0.99f ? Vector3.up : Vector3.right;
                b = Vector3.Cross(nn, tt);
            }
            b.Normalize();
            tt = Vector3.Cross(b, nn);
            if (tt.sqrMagnitude < 1e-12f)
                tt = Vector3.right;
            tt.Normalize();

            // res *= toTS
            return new Vector3(
                Vector3.Dot(v, tt),
                Vector3.Dot(v, b),
                Vector3.Dot(v, nn));
        }

        private static Color32 VectorToColorLikeOriginal(Vector3 v)
        {
            int r = Mathf.Clamp((int)(127.0f * v.x + 128.0f), 0, 255);
            int g = Mathf.Clamp((int)(127.0f * v.y + 128.0f), 0, 255);
            int b = Mathf.Clamp((int)(127.0f * v.z + 128.0f), 0, 255);
            return new Color32((byte)r, (byte)g, (byte)b, 255);
        }

        private Color32 GetBumpDiffuseForVertexLikeOriginal(int vertex, float contrast, float bright)
        {
            if (_map == null || _map.VertInLine <= 0)
                return new Color32(128, 128, 255, 255);

            int vx = vertex % _map.VertInLine;
            int vy = vertex / _map.VertInLine;
            float x = vx << 5;
            float y = (vy << 5) - (((vx & 1) != 0) ? 16.0f : 0.0f);

            Vector3 v = GetSurfaceNLikeOriginal(_map, x, y);
            if (v.sqrMagnitude < 1e-12f)
                v = Vector3.forward;
            v.Normalize();

            Vector3 ldir = -GetGameLightDirLikeOriginal();
            float dotp = Vector3.Dot(ldir, v);
            if (dotp < 0.0f)
                ldir = Vector3.zero;

            Vector3 vn = v;
            float pr1 = dotp < 0.0f ? contrast : contrast * (1.0f - 2.0f * dotp);
            if (pr1 < 0.0f)
                pr1 = 0.0f;
            vn *= pr1;

            ldir += vn;
            float n = ldir.magnitude;
            if (n > bright && n > 1e-12f)
            {
                ldir *= bright;
                ldir /= n;
            }

            return VectorToColorLikeOriginal(ToTangentSpaceLikeOriginal(ldir, v, new Vector3(1.0f, 0.0f, 0.0f)));
        }

        private uint RemapFacturePackedDiffuseToDot3LikeOriginal(uint packed, float contrast, float bright)
        {
            int vertex = (int)(packed & 0x00FFFFFFu);
            int alpha = (int)((packed >> 24) & 0xFF);
            Color32 bump = GetBumpDiffuseForVertexLikeOriginal(vertex, contrast, bright);
            return VertexTnL2LikeOriginal.PackDiffuseLikeOriginal(new Color32(bump.r, bump.g, bump.b, (byte)alpha));
        }

        private void CreateRoadSurfaceObject(string selectedId)
        {
            if (!EnableRoadSurfaceLayer)
            {
                Debug.Log("[C2:ROAD] render mode=stage10-road-surface; enabled=0; reason=disabled-by-setting");
                return;
            }

            if (_map == null || _map.DecodedRne2 == null || _map.DecodedRne2.Nodes == null || _map.DecodedRne2.Nodes.Count == 0)
            {
                Debug.Log("[C2:ROAD] render mode=stage10-road-surface; enabled=0; reason=no-road-data");
                return;
            }

            List<RoadRenderPart> parts = TryBuildOriginalRoadRender(out string buildInfo);
            if (parts == null || parts.Count == 0)
            {
                Debug.LogWarning("[C2:ROAD] render mode=stage10-road-surface; enabled=0; reason=parity-build-failed; " + buildInfo);
                return;
            }

            _roadSurfaceGo = new GameObject("RoadLayer_" + selectedId);
            _roadSurfaceGo.transform.SetParent(transform, false);
            _roadSurfaceGo.transform.localPosition = Vector3.zero;

            _roadSurfaceMaterial = null;
            int created = 0;
            foreach (RoadRenderPart part in parts)
            {
                if (part == null || part.Mesh == null)
                    continue;

                Material createdMat;
                CreateRoadTexturedPart(_roadSurfaceGo.transform, selectedId, part, out createdMat);
                if (_roadSurfaceMaterial == null && createdMat != null)
                    _roadSurfaceMaterial = createdMat;
                if (createdMat != null)
                    created++;
            }

            if (created == 0)
            {
                Debug.LogWarning("[C2:ROAD] render mode=stage10-road-surface; enabled=0; reason=no-renderable-parts; " + buildInfo);
                SafeDestroy(_roadSurfaceGo);
                _roadSurfaceGo = null;
                return;
            }

            Debug.Log($"[C2:ROAD] render mode=stage10-road-surface; enabled=1; parts={created}; {buildInfo}");
        }

        private void CreateRoadSurfacePart(Transform parent, Mesh mesh, string name, Color color, int renderQueue, out Material material)
        {
            material = null;
            var go = new GameObject(name);
            go.transform.SetParent(parent, false);
            go.transform.localPosition = Vector3.zero;
            var mf = go.AddComponent<MeshFilter>();
            var mr = go.AddComponent<MeshRenderer>();
            mf.sharedMesh = mesh;

            Shader shader = FindBestRoadSurfaceShader();
            if (shader == null)
            {
                shader = FindBestColorShader();
            }
            if (shader == null)
            {
                Debug.LogWarning("[C2:ROAD] render mode=stage10-road-surface; enabled=0; reason=no-road-shader");
                return;
            }

            material = new Material(shader);
            material.name = name + "_mat";
            ConfigureRoadSurfaceMaterial(material, color, renderQueue);
            mr.sharedMaterial = material;
        }

        private static Shader FindBestRoadSurfaceShader()
        {
            string[] names =
            {
                "Universal Render Pipeline/Simple Lit",
                "Universal Render Pipeline/Unlit",
                "Legacy Shaders/Transparent/Diffuse",
                "Unlit/Transparent",
                "Sprites/Default"
            };

            foreach (string n in names)
            {
                Shader s = Shader.Find(n);
                if (s != null)
                    return s;
            }
            return null;
        }

        private static void ConfigureRoadSurfaceMaterial(Material mat, Color color, int renderQueue)
        {
            if (mat == null)
                return;
            if (mat.HasProperty("_BaseColor"))
                mat.SetColor("_BaseColor", color);
            if (mat.HasProperty("_Color"))
                mat.SetColor("_Color", color);
            if (mat.HasProperty("_Surface"))
                mat.SetFloat("_Surface", 1.0f);
            if (mat.HasProperty("_Blend"))
                mat.SetFloat("_Blend", 0.0f);
            if (mat.HasProperty("_ZWrite"))
                mat.SetFloat("_ZWrite", 0.0f);
            if (mat.HasProperty("_AlphaClip"))
                mat.SetFloat("_AlphaClip", 0.0f);
            if (mat.HasProperty("_Cull"))
                mat.SetFloat("_Cull", 0.0f);
            if (mat.HasProperty("_Smoothness"))
                mat.SetFloat("_Smoothness", 0.0f);
            if (mat.HasProperty("_SpecColor"))
                mat.SetColor("_SpecColor", new Color(0f,0f,0f,0f));
            mat.renderQueue = renderQueue;
        }


        private void CreateRoadOverlayObject(string selectedId)
        {
            if (!EnableRoadDebugOverlay)
            {
                Debug.Log("[C2:ROAD] visual mode=debug-quad-mesh; enabled=0; reason=disabled-by-stage10-default");
                return;
            }

            if (_map == null || _map.DecodedRne2 == null || _map.DecodedRne2.Nodes == null || _map.DecodedRne2.Nodes.Count == 0)
            {
                Debug.Log("[C2:ROAD] visual mode=debug-quad-mesh; enabled=0; reason=no-road-data");
                return;
            }

            Mesh overlayMesh = TryBuildRoadOverlayMesh(_map, out string buildInfo);
            if (overlayMesh == null)
            {
                Debug.LogWarning("[C2:ROAD] visual mode=debug-quad-mesh; enabled=0; reason=mesh-build-failed; " + buildInfo);
                return;
            }

            _roadOverlayGo = new GameObject("RoadOverlay_" + selectedId);
            _roadOverlayGo.transform.SetParent(transform, false);
            _roadOverlayGo.transform.localPosition = Vector3.zero;

            var mf = _roadOverlayGo.AddComponent<MeshFilter>();
            var mr = _roadOverlayGo.AddComponent<MeshRenderer>();
            mf.sharedMesh = overlayMesh;

            Shader shader = FindBestColorShader();
            if (shader == null)
            {
                Debug.LogWarning("[C2:ROAD] visual mode=debug-quad-mesh; enabled=0; reason=no-color-shader");
                SafeDestroy(_roadOverlayGo);
                _roadOverlayGo = null;
                return;
            }

            _roadOverlayMaterial = new Material(shader);
            _roadOverlayMaterial.name = selectedId + "_road_debug_overlay_mat";
            _roadOverlayMaterial.renderQueue = 3100;
            if (_roadOverlayMaterial.HasProperty("_BaseColor"))
                _roadOverlayMaterial.SetColor("_BaseColor", new Color(1.0f, 0.22f, 0.04f, 0.88f));
            if (_roadOverlayMaterial.HasProperty("_Color"))
                _roadOverlayMaterial.SetColor("_Color", new Color(1.0f, 0.22f, 0.04f, 0.88f));
            mr.sharedMaterial = _roadOverlayMaterial;

            Debug.Log("[C2:ROAD] visual " + buildInfo);
        }

        private Mesh TryBuildRoadOverlayMesh(ParsedMap map, out string info)
        {
            return TryBuildRoadStripMesh(map, RoadDebugOverlayWidth, RoadDebugOverlayLift, "RoadOverlay", out info);
        }

        private Mesh TryBuildRoadStripMesh(ParsedMap map, float width, float lift, string meshSuffix, out string info)
        {
            info = "missing";
            if (map == null || map.DecodedRne2 == null || map.DecodedRne2.Nodes == null || map.DecodedRne2.Nodes.Count == 0)
            {
                info = "reason=no-road-data";
                return null;
            }

            var verts = new List<Vector3>();
            var tris = new List<int>();
            var uvs = new List<Vector2>();
            int segments = 0;
            int skippedShort = 0;
            float halfWidth = Mathf.Max(1.0f, width) * 0.5f;
            var nodes = map.DecodedRne2.Nodes;

            for (int i = 0; i < nodes.Count; i++)
            {
                RoadKnot a = nodes[i];
                int degree = Math.Clamp(a.NLinks, 0, Rne2MaxLink);
                Vector3 aw = RoadCoordToWorld(a.X, a.Y, lift);
                for (int k = 0; k < degree; k++)
                {
                    int t = a.Links[k];
                    if (t < 0 || t >= nodes.Count || t <= i)
                        continue;

                    RoadKnot b = nodes[t];
                    Vector3 bw = RoadCoordToWorld(b.X, b.Y, lift);
                    Vector3 flat = new Vector3(bw.x - aw.x, 0f, bw.z - aw.z);
                    float len = flat.magnitude;
                    if (len < 0.001f)
                    {
                        skippedShort++;
                        continue;
                    }

                    Vector3 dir = flat / len;
                    Vector3 right = new Vector3(-dir.z, 0f, dir.x) * halfWidth;

                    int baseIndex = verts.Count;
                    verts.Add(aw - right);
                    verts.Add(aw + right);
                    verts.Add(bw + right);
                    verts.Add(bw - right);
                    uvs.Add(new Vector2(0f, 0f));
                    uvs.Add(new Vector2(1f, 0f));
                    uvs.Add(new Vector2(1f, 1f));
                    uvs.Add(new Vector2(0f, 1f));
                    tris.Add(baseIndex + 0);
                    tris.Add(baseIndex + 2);
                    tris.Add(baseIndex + 1);
                    tris.Add(baseIndex + 0);
                    tris.Add(baseIndex + 3);
                    tris.Add(baseIndex + 2);
                    segments++;
                }
            }

            if (segments == 0 || verts.Count == 0)
            {
                info = $"reason=no-valid-segments; nodes={nodes.Count}; skippedShort={skippedShort}";
                return null;
            }

            var mesh = new Mesh();
            mesh.name = string.IsNullOrEmpty(_selectedId) ? meshSuffix : (_selectedId + "_" + meshSuffix);
            if (verts.Count > 65000)
                mesh.indexFormat = UnityEngine.Rendering.IndexFormat.UInt32;
            mesh.SetVertices(verts);
            mesh.SetTriangles(tris, 0, true);
            mesh.SetUVs(0, uvs);
            mesh.RecalculateBounds();
            info = $"nodes={nodes.Count}; segments={segments}; verts={verts.Count}; tris={tris.Count / 3}; width={width:0.##}; lift={lift:0.##}; skippedShort={skippedShort}";
            return mesh;
        }


        private List<RoadRenderPart> TryBuildOriginalRoadRender(out string info)
        {
            info = "missing";
            if (_map == null || _map.DecodedRne2 == null || _map.DecodedRne2.Nodes == null || _map.DecodedRne2.Nodes.Count == 0)
            {
                info = "reason=no-road-data";
                return null;
            }

            Cossacks2Bridge.Core.CoreFileSystem fs = _bootstrap != null ? _bootstrap.Fs : null;
            List<RoadVisualDesc> descs = LoadRoadVisualDescs(fs, _map.DecodedRne2, out string descInfo);
            if (descs == null || descs.Count == 0)
            {
                info = "reason=no-road-descriptors; " + descInfo;
                return null;
            }

            BuiltRoadSystem built = BuildOriginalRoadSystem(_map.DecodedRne2, descs, out string buildInfo);
            if (built == null || built.Roads.Count == 0)
            {
                info = descInfo + "; " + buildInfo;
                return null;
            }

            List<RoadRenderPart> parts = BuildRoadRenderParts(built, descs, out string meshInfo);
            info = descInfo + "; " + buildInfo + "; " + meshInfo;
            return parts;
        }

        private void CreateRoadTexturedPart(Transform parent, string selectedId, RoadRenderPart part, out Material material)
        {
            material = null;
            if (parent == null || part == null || part.Mesh == null)
                return;

            var go = new GameObject($"{selectedId}_road_type_{part.TypeId}");
            go.transform.SetParent(parent, false);
            go.transform.localPosition = Vector3.zero;

            var mf = go.AddComponent<MeshFilter>();
            var mr = go.AddComponent<MeshRenderer>();
            mf.sharedMesh = part.Mesh;

            Shader shader = FindBestRoadTexturedShader();
            if (shader == null)
            {
                Debug.LogWarning($"[C2:ROAD] part type={part.TypeId}; reason=no-road-texture-shader");
                return;
            }

            material = new Material(shader);
            material.name = $"{selectedId}_road_type_{part.TypeId}_mat";
            ConfigureRoadTexturedMaterial(material, part.Texture, part.RenderQueue);
            mr.sharedMaterial = material;

            if (part.HasBump && part.BumpTexture != null)
                CreateRoadBumpOverlay(go.transform, selectedId, part);

            Debug.Log($"[C2:ROAD] part type={part.TypeId} roadName={part.RoadName} roads={part.RoadCount} verts={part.Mesh.vertexCount} tris={(part.Mesh.triangles != null ? part.Mesh.triangles.Length / 3 : 0)} tex={part.TextureKey} texState={(part.Texture != null ? (part.Texture.width + "x" + part.Texture.height) : "missing")} bump={part.HasBump} bumpTex={(part.BumpTexture != null ? part.BumpTexture.name : "missing")} queue={part.RenderQueue}");
        }

        private static Shader FindBestRoadTexturedShader()
        {
            string[] names =
            {
                "Cossacks2Bridge/Road",
                "Sprites/Default",
                "Legacy Shaders/Particles/Alpha Blended",
                "Particles/Standard Unlit",
                "Universal Render Pipeline/Particles/Unlit",
                "Universal Render Pipeline/Unlit",
                "Unlit/Transparent"
            };

            foreach (string n in names)
            {
                Shader s = Shader.Find(n);
                if (s != null)
                    return s;
            }
            return null;
        }

        private static Shader FindBestRoadBumpShader()
        {
            string[] names =
            {
                "Cossacks2Bridge/RoadBump2",
                "Unlit/Transparent"
            };

            foreach (string n in names)
            {
                Shader s = Shader.Find(n);
                if (s != null)
                    return s;
            }
            return null;
        }

        private void CreateRoadBumpOverlay(Transform parent, string selectedId, RoadRenderPart part)
        {
            if (parent == null || part == null || part.Mesh == null || part.BumpTexture == null)
                return;

            Shader shader = FindBestRoadBumpShader();
            if (shader == null)
                return;

            Camera activeCamera = _strictIsoCamera != null ? _strictIsoCamera : (_camera != null ? _camera : Camera.main);
            Vector2Int viewport = new Vector2Int(Mathf.Max(1, Screen.width), Mathf.Max(1, Screen.height));
            int createdPasses = 0;

            for (int q = 0; q < 8; q++)
            {
                Mesh passMesh = BuildRoadBumpPassMeshLikeOriginal(part, q, activeCamera, viewport, out bool drawThisPass);
                if (passMesh == null || !drawThisPass)
                    continue;

                var go = new GameObject($"{selectedId}_road_type_{part.TypeId}_bump_{q}");
                go.transform.SetParent(parent, false);
                go.transform.localPosition = Vector3.zero;

                var mf = go.AddComponent<MeshFilter>();
                var mr = go.AddComponent<MeshRenderer>();
                mf.sharedMesh = passMesh;

                var mat = new Material(shader);
                mat.name = $"{selectedId}_road_type_{part.TypeId}_bump_mat_{q}";
                ConfigureRoadBumpMaterial(mat, part.BumpTexture, part.RenderQueue + 1 + q, part);
                mr.sharedMaterial = mat;
                createdPasses++;
            }

            Debug.Log($"[C2:ROAD] bump overlay type={part.TypeId} roadName={part.RoadName} passes={createdPasses} bumpTex={(part.BumpTexture != null ? part.BumpTexture.name : "missing")}");
        }

        private static void ConfigureRoadTexturedMaterial(Material mat, Texture texture, int renderQueue)
        {
            if (mat == null)
                return;

            if (texture != null)
            {
                if (mat.HasProperty("_MainTex"))
                    mat.SetTexture("_MainTex", texture);
                if (mat.HasProperty("_BaseMap"))
                    mat.SetTexture("_BaseMap", texture);
            }

            if (mat.HasProperty("_BaseColor"))
                mat.SetColor("_BaseColor", Color.white);
            if (mat.HasProperty("_Color"))
                mat.SetColor("_Color", Color.white);
            if (mat.HasProperty("_Surface"))
                mat.SetFloat("_Surface", 1.0f);
            if (mat.HasProperty("_Blend"))
                mat.SetFloat("_Blend", 0.0f);
            if (mat.HasProperty("_Cull"))
                mat.SetFloat("_Cull", 0.0f);
            if (mat.HasProperty("_ZWrite"))
                mat.SetFloat("_ZWrite", 0.0f);
            if (mat.HasProperty("_AlphaClip"))
                mat.SetFloat("_AlphaClip", 0.0f);
            if (mat.HasProperty("_Smoothness"))
                mat.SetFloat("_Smoothness", 0.0f);
            if (mat.HasProperty("_SpecColor"))
                mat.SetColor("_SpecColor", new Color(0f, 0f, 0f, 0f));

            mat.renderQueue = renderQueue;
        }

        private static void ConfigureRoadBumpMaterial(Material mat, Texture texture, int renderQueue, RoadRenderPart part)
        {
            if (mat == null)
                return;

            if (texture != null)
            {
                if (mat.HasProperty("_MainTex"))
                    mat.SetTexture("_MainTex", texture);
                if (mat.HasProperty("_BaseMap"))
                    mat.SetTexture("_BaseMap", texture);
            }

            if (mat.HasProperty("_BaseColor"))
                mat.SetColor("_BaseColor", Color.white);
            if (mat.HasProperty("_Color"))
                mat.SetColor("_Color", Color.white);
            if (mat.HasProperty("_Cull"))
                mat.SetFloat("_Cull", 0.0f);
            if (mat.HasProperty("_ZWrite"))
                mat.SetFloat("_ZWrite", 0.0f);
            if (mat.HasProperty("_AlphaClip"))
                mat.SetFloat("_AlphaClip", 0.0f);
            if (part != null)
            {
                if (mat.HasProperty("_BumpY1"))
                    mat.SetVector("_BumpY1", new UnityEngine.Vector4(part.B1_Y1, part.B1_Y2, 0.0f, 0.0f));
                if (mat.HasProperty("_BumpY2"))
                    mat.SetVector("_BumpY2", new UnityEngine.Vector4(part.B2_Y1, part.B2_Y2, 0.0f, 0.0f));
            }

            mat.renderQueue = renderQueue;
        }

        private Mesh BuildRoadBumpPassMeshLikeOriginal(RoadRenderPart part, int passIndex, Camera activeCamera, Vector2Int viewport, out bool drawThisPass)
        {
            drawThisPass = false;
            if (part == null || part.Mesh == null)
                return null;

            Vector3[] srcVerts = part.Mesh.vertices;
            int[] srcTris = part.Mesh.triangles;
            if (srcVerts == null || srcVerts.Length == 0 || srcTris == null || srcTris.Length == 0)
                return null;

            var srcUvsList = new List<Vector2>();
            part.Mesh.GetUVs(0, srcUvsList);
            Vector2[] srcUvs = (srcUvsList != null && srcUvsList.Count == srcVerts.Length) ? srcUvsList.ToArray() : part.Mesh.uv;
            if (srcUvs == null || srcUvs.Length != srcVerts.Length)
                srcUvs = new Vector2[srcVerts.Length];

            var srcUvs2List = new List<Vector2>();
            part.Mesh.GetUVs(1, srcUvs2List);
            Vector2[] srcUvs2 = (srcUvs2List != null && srcUvs2List.Count == srcVerts.Length) ? srcUvs2List.ToArray() : null;
            if (srcUvs2 == null || srcUvs2.Length != srcVerts.Length)
                srcUvs2 = (Vector2[])srcUvs.Clone();

            Color32[] srcColors = part.Mesh.colors32;
            if (srcColors == null || srcColors.Length != srcVerts.Length)
            {
                srcColors = new Color32[srcVerts.Length];
                for (int i = 0; i < srcColors.Length; i++)
                    srcColors[i] = new Color32(255, 255, 255, 255);
            }

            Vector2[] dstUvs = (Vector2[])srcUvs.Clone();
            Vector2[] dstUvs2 = (Vector2[])srcUvs2.Clone();
            Color32[] dstColors = (Color32[])srcColors.Clone();

            int[] idxS = { 2, 1, 0, 3, 2, 1, 0, 3 };
            int[] dirS = { -1, 1, 1, 1, 1, -1, -1, -1 };
            int idx = idxS[Mathf.Clamp(passIndex, 0, 7)];
            int dir = dirS[Mathf.Clamp(passIndex, 0, 7)];
            float vLeft = idx * 0.25f + 0.125f - dir * 0.125f;
            float vRight = idx * 0.25f + 0.125f + dir * 0.125f;

            foreach (RoadMeshRange range in part.MeshRanges)
            {
                int start = range.StartVertex;
                int pointCount = range.PointCount;
                if (start < 0 || pointCount < 2 || start + pointCount * 2 > srcVerts.Length)
                    continue;

                for (int i = 0; i < pointCount; i++)
                {
                    int li = start + i * 2;
                    int ri = li + 1;

                    Vector3 sl = ProjectWorldToSurfaceScreenLikeOriginal(activeCamera, viewport, srcVerts[li], li);
                    Vector3 sr = ProjectWorldToSurfaceScreenLikeOriginal(activeCamera, viewport, srcVerts[ri], ri);

                    int DX = Mathf.RoundToInt(sr.x - sl.x);
                    int DY = Mathf.RoundToInt(sr.y - sl.y);
                    sbyte angl = (sbyte)Mathf.RoundToInt(Mathf.Atan2(DY * 2.0f, DX) * 128.0f / Mathf.PI);
                    sbyte da = (sbyte)(angl - (passIndex << 5));
                    int mpl = 32 - Mathf.Abs((int)da);
                    if (mpl < 0)
                        mpl = 0;
                    mpl <<= 5;
                    if (mpl > 255)
                        mpl = 255;
                    if (mpl > 0)
                        drawThisPass = true;

                    Vector2 uvL = dstUvs[li];
                    Vector2 uvR = dstUvs[ri];
                    uvL.y = vLeft;
                    uvR.y = vRight;
                    dstUvs[li] = uvL;
                    dstUvs[ri] = uvR;

                    Vector2 uv2L = dstUvs2[li];
                    Vector2 uv2R = dstUvs2[ri];
                    uv2L.y = vLeft;
                    uv2R.y = vRight;
                    dstUvs2[li] = uv2L;
                    dstUvs2[ri] = uv2R;

                    int a10 = srcColors[li].a;
                    int a20 = srcColors[ri].a;
                    int a1 = 0xFF - ClampByte((a10 * mpl) / 256);
                    int a2 = 0xFF - ClampByte((a20 * mpl) / 256);
                    byte aa1 = (byte)a1;
                    byte aa2 = (byte)a2;
                    dstColors[li] = new Color32(aa1, aa1, aa1, aa1);
                    dstColors[ri] = new Color32(aa2, aa2, aa2, aa2);
                }
            }

            if (!drawThisPass)
                return null;

            var mesh = new Mesh();
            mesh.name = $"{part.Mesh.name}_bump_pass_{passIndex}";
            mesh.indexFormat = part.Mesh.indexFormat;
            mesh.SetVertices(srcVerts);
            mesh.SetUVs(0, new List<Vector2>(dstUvs));
            mesh.SetUVs(1, new List<Vector2>(dstUvs2));
            mesh.SetColors(dstColors);
            mesh.SetTriangles(srcTris, 0, true);
            mesh.bounds = part.Mesh.bounds;
            return mesh;
        }

        private List<RoadVisualDesc> LoadRoadVisualDescs(Cossacks2Bridge.Core.CoreFileSystem fs, DecodedRoadNet net, out string info)
        {
            string path = "";
            string source = "fallback";
            var descs = new List<RoadVisualDesc>();

            if (fs != null)
            {
                string candidate = fs.ResolvePath("Roads.dat");
                if (!string.IsNullOrWhiteSpace(candidate) && File.Exists(candidate))
                {
                    path = candidate;
                    source = "Roads.dat";
                    try
                    {
                        ParseRoadsDat(path, fs, descs);
                    }
                    catch (Exception ex)
                    {
                        Debug.LogWarning("[C2:ROAD] Roads.dat parse failed: " + ex.Message);
                        descs.Clear();
                        source = "fallback-after-parse-fail";
                    }
                }
            }

            if (descs.Count == 0)
                BuildFallbackRoadVisualDescs(net, descs);

            for (int i = 0; i < descs.Count; i++)
            {
                descs[i].TypeId = i;
                if (descs[i].Texture == null)
                    descs[i].Texture = BuildRoadPlaceholderTexture(descs[i]);
            }

            int loadedTextures = descs.Count(x => x.Texture != null);
            int bumpReady = descs.Count(x => x.BumpTexture != null);
            string groups = string.Join(",", descs.Take(12).Select(x => $"{x.TypeId}:{x.RoadName}/w{x.RWidth}/tex={(x.Texture != null ? 1 : 0)}"));
            info = $"descriptorSource={source} path={(string.IsNullOrWhiteSpace(path) ? "<none>" : path)} descs={descs.Count} texReady={loadedTextures} bumpReady={bumpReady} sample={groups}";
            return descs;
        }

        private void ParseRoadsDat(string path, Cossacks2Bridge.Core.CoreFileSystem fs, List<RoadVisualDesc> dest)
        {
            string[] lines = File.ReadAllLines(path, Encoding.GetEncoding(1251));
            RoadVisualDesc last = null;

            foreach (string rawLine in lines)
            {
                string line = rawLine;
                int commentPos = line.IndexOf(';');
                if (commentPos >= 0)
                    line = line.Substring(0, commentPos);
                line = line.Trim();
                if (string.IsNullOrWhiteSpace(line))
                    continue;

                string[] tokens = line.Split((char[])null, StringSplitOptions.RemoveEmptyEntries);
                if (tokens.Length == 0)
                    continue;

                string head = tokens[0];
                if (string.Equals(head, "$EX", StringComparison.OrdinalIgnoreCase))
                {
                    if (last == null || tokens.Length < 6)
                        continue;
                    var clone = last.Clone();
                    clone.MapTextureID = ParseRoadInt(tokens[1], clone.MapTextureID);
                    clone.TexRMin = ParseRoadInt(tokens[2], clone.TexRMin);
                    clone.TexRMax = ParseRoadInt(tokens[3], clone.TexRMax);
                    clone.TexSmoothness = ParseRoadInt(tokens[4], clone.TexSmoothness);
                    clone.FactureID = ParseRoadInt(tokens[5], clone.FactureID);
                    dest.Add(clone);
                    last = clone;
                    continue;
                }

                if (string.Equals(head, "$PHYS", StringComparison.OrdinalIgnoreCase))
                {
                    if (last == null || tokens.Length < 4)
                        continue;
                    last.Speed = (short)ParseRoadInt(tokens[1], last.Speed);
                    last.Tiring = (short)ParseRoadInt(tokens[2], last.Tiring);
                    last.Priory = (short)ParseRoadInt(tokens[3], last.Priory);
                    continue;
                }

                if (string.Equals(head, "$BUMP", StringComparison.OrdinalIgnoreCase))
                {
                    if (last == null || tokens.Length < 6)
                        continue;
                    last.BumpTexturePath = tokens[1];
                    last.B1_Y1 = ParseRoadInt(tokens[2], 0);
                    last.B1_Y2 = ParseRoadInt(tokens[3], 0);
                    last.B2_Y1 = ParseRoadInt(tokens[4], 0);
                    last.B2_Y2 = ParseRoadInt(tokens[5], 0);
                    last.BumpTexture = TryLoadExternalRoadTexture(fs, last.BumpTexturePath);
                    continue;
                }

                if (string.Equals(head, "$PREVIEW", StringComparison.OrdinalIgnoreCase))
                {
                    if (last == null || tokens.Length < 3)
                        continue;
                    last.RoadPreviewPath = tokens[1];
                    last.RoadPreviewSpr = ParseRoadInt(tokens[2], 0);
                    continue;
                }

                if (tokens.Length < 16)
                    continue;

                var desc = new RoadVisualDesc();
                desc.RoadName = tokens[0];
                desc.TexturePath = tokens[1];
                desc.TexSizeX = ParseRoadInt(tokens[2], 256);
                desc.TexSizeY = ParseRoadInt(tokens[3], 256);
                desc.ColorY0 = ParseRoadInt(tokens[4], 0);
                desc.ColorY1 = ParseRoadInt(tokens[5], desc.TexSizeY);
                desc.ReliefY0 = ParseRoadInt(tokens[6], 0);
                desc.ReliefY1 = ParseRoadInt(tokens[7], desc.TexSizeY);
                desc.RWidth = ParseRoadInt(tokens[8], Mathf.RoundToInt(RoadSurfaceWidth));
                desc.RScaleX = ParseRoadInt(tokens[9], 100);
                desc.AlphaFrequency = Mathf.Max(1, ParseRoadInt(tokens[10], 1));
                desc.AFactor = ParseRoadInt(tokens[11], 255);
                desc.AFactorMin = ParseRoadInt(tokens[12], desc.AFactor);
                desc.RFactor = ParseRoadInt(tokens[13], 255);
                desc.GFactor = ParseRoadInt(tokens[14], 255);
                desc.BFactor = ParseRoadInt(tokens[15], 255);
                desc.Diffuse = new Color32((byte)Mathf.Clamp(desc.RFactor, 0, 255), (byte)Mathf.Clamp(desc.GFactor, 0, 255), (byte)Mathf.Clamp(desc.BFactor, 0, 255), (byte)Mathf.Clamp(desc.AFactor, 0, 255));
                desc.Texture = TryLoadExternalRoadTexture(fs, desc.TexturePath);
                dest.Add(desc);
                last = desc;
            }

            int nextGroup = 0;
            for (int i = 0; i < dest.Count; i++)
            {
                RoadVisualDesc d = dest[i];
                d.GroupFirstID = -1;
                for (int q = 0; q < i; q++)
                {
                    if (string.Equals(dest[q].RoadName, d.RoadName, StringComparison.OrdinalIgnoreCase))
                    {
                        d.GroupFirstID = dest[q].GroupFirstID >= 0 ? dest[q].GroupFirstID : q;
                        d.GroupID = dest[q].GroupID;
                        break;
                    }
                }

                if (d.GroupFirstID < 0)
                {
                    d.GroupFirstID = i;
                    d.GroupID = nextGroup++;
                }
            }
        }

        private void BuildFallbackRoadVisualDescs(DecodedRoadNet net, List<RoadVisualDesc> dest)
        {
            var types = new HashSet<int>();
            if (net != null && net.Nodes != null)
            {
                foreach (RoadKnot node in net.Nodes)
                {
                    int deg = Math.Clamp(node.NLinks, 0, Rne2MaxLink);
                    for (int i = 0; i < deg; i++)
                        types.Add(node.LinkType[i]);
                }
            }

            if (types.Count == 0)
                types.Add(0);

            foreach (int type in types.OrderBy(x => x))
            {
                var d = new RoadVisualDesc();
                d.TypeId = type;
                d.RoadName = "type" + type.ToString(CultureInfo.InvariantCulture);
                d.TexturePath = "";
                d.TexSizeX = 256;
                d.TexSizeY = 256;
                d.ReliefY0 = 64;
                d.ReliefY1 = 192;
                d.RWidth = Mathf.Max(12, Mathf.RoundToInt(RoadSurfaceWidth) - type * 2);
                d.RScaleX = 100;
                d.AlphaFrequency = 1 + (type % 3);
                d.AFactor = 180;
                d.AFactorMin = 110;
                d.RFactor = 180;
                d.GFactor = 150;
                d.BFactor = 116;
                d.GroupFirstID = type;
                d.GroupID = type;
                d.Texture = BuildRoadPlaceholderTexture(d);
                d.Diffuse = new Color32((byte)d.RFactor, (byte)d.GFactor, (byte)d.BFactor, (byte)d.AFactor);
                dest.Add(d);
            }
        }

        private Texture2D TryLoadExternalRoadTexture(Cossacks2Bridge.Core.CoreFileSystem fs, string gameRelativePath)
        {
            if (fs == null || string.IsNullOrWhiteSpace(gameRelativePath))
                return null;

            foreach (string resourcePath in EnumerateRoadResourceCandidates(gameRelativePath))
            {
                Texture2D resourceTex = TryLoadTextureByExactResourcePathLikeOriginal(resourcePath);
                if (resourceTex != null)
                    return resourceTex;
            }

            foreach (string candidate in EnumerateRoadTextureCandidates(fs, gameRelativePath))
            {
                try
                {
                    if (!File.Exists(candidate))
                        continue;

                    byte[] raw = File.ReadAllBytes(candidate);
                    string ext = Path.GetExtension(candidate).ToLowerInvariant();
                    Texture2D tex = DecodeRoadTexture(raw, ext, candidate);
                    if (tex != null)
                    {
                        tex.name = NormalizeRoadTextureKey(gameRelativePath);
                        tex.wrapMode = TextureWrapMode.Repeat;
                        tex.filterMode = FilterMode.Point;
                        return tex;
                    }
                }
                catch (Exception ex)
                {
                    Debug.LogWarning($"[C2:ROAD] texture load fail path={candidate} err={ex.Message}");
                }
            }

            return null;
        }

        private IEnumerable<string> EnumerateRoadResourceCandidates(string gameRelativePath)
        {
            string normalized = gameRelativePath.Trim().Replace('\\', '/');
            string fileName = Path.GetFileName(normalized);
            if (!string.IsNullOrWhiteSpace(normalized))
            {
                yield return normalized;
                yield return "textures/" + normalized;
                yield return "Textures/" + normalized;
            }
            if (!string.IsNullOrWhiteSpace(fileName) && !string.Equals(fileName, normalized, StringComparison.OrdinalIgnoreCase))
            {
                yield return fileName;
                yield return "textures/" + fileName;
                yield return "Textures/" + fileName;
            }
        }

        private IEnumerable<string> EnumerateRoadTextureCandidates(Cossacks2Bridge.Core.CoreFileSystem fs, string gameRelativePath)
        {
            string normalized = gameRelativePath.Trim().Replace('/', Path.DirectorySeparatorChar).Replace('\\', Path.DirectorySeparatorChar);
            string fileName = Path.GetFileName(normalized);
            string ext = Path.GetExtension(normalized);

            string[] bases =
            {
                normalized,
                Path.Combine("textures", normalized),
                Path.Combine("Textures", normalized),
                fileName,
                Path.Combine("textures", fileName),
                Path.Combine("Textures", fileName)
            };

            var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            string[] exts = string.IsNullOrWhiteSpace(ext) ? new[] { ".bmp", ".tga", ".png", ".jpg", ".jpeg" } : new[] { "" };
            foreach (string b in bases)
            {
                if (string.IsNullOrWhiteSpace(b))
                    continue;
                foreach (string e in exts)
                {
                    string rel = b + e;
                    if (!seen.Add(rel))
                        continue;
                    yield return fs.ResolvePath(rel);
                }
            }
        }

        private Texture2D DecodeRoadTexture(byte[] raw, string ext, string path)
        {
            if (raw == null || raw.Length == 0)
                return null;

            switch (ext)
            {
                case ".png":
                case ".jpg":
                case ".jpeg":
                    {
                        var tex = new Texture2D(2, 2, TextureFormat.RGBA32, true, false);
                        if (!tex.LoadImage(raw, false))
                        {
                            UnityEngine.Object.Destroy(tex);
                            return null;
                        }
                        return tex;
                    }
                case ".bmp":
                    return DecodeBmpTexture(raw, path);
                case ".tga":
                    return DecodeTgaTexture(raw, path);
                default:
                    {
                        var tex = new Texture2D(2, 2, TextureFormat.RGBA32, true, false);
                        if (!tex.LoadImage(raw, false))
                        {
                            UnityEngine.Object.Destroy(tex);
                            return null;
                        }
                        return tex;
                    }
            }
        }

        private Texture2D DecodeBmpTexture(byte[] raw, string path)
        {
            if (raw.Length < 54 || raw[0] != (byte)'B' || raw[1] != (byte)'M')
                return null;

            int pixelOffset = ReadInt32LE(raw, 10);
            int width = ReadInt32LE(raw, 18);
            int height = ReadInt32LE(raw, 22);
            int bpp = ReadUInt16LE(raw, 28);
            int compression = ReadInt32LE(raw, 30);
            if (width <= 0 || height == 0 || compression != 0)
                return null;
            if (bpp != 24 && bpp != 32)
                return null;

            bool flip = height > 0;
            int absH = Math.Abs(height);
            int stride = ((width * bpp + 31) / 32) * 4;
            if (pixelOffset < 0 || pixelOffset + stride * absH > raw.Length)
                return null;

            Color32[] pixels = new Color32[width * absH];
            for (int y = 0; y < absH; y++)
            {
                int srcY = flip ? (absH - 1 - y) : y;
                int row = pixelOffset + srcY * stride;
                for (int x = 0; x < width; x++)
                {
                    int p = row + x * (bpp / 8);
                    byte b = raw[p + 0];
                    byte g = raw[p + 1];
                    byte r = raw[p + 2];
                    byte a = bpp == 32 ? raw[p + 3] : (byte)255;
                    pixels[y * width + x] = new Color32(r, g, b, a);
                }
            }

            var tex = new Texture2D(width, absH, TextureFormat.RGBA32, true, false);
            tex.SetPixels32(pixels);
            tex.Apply(true, false);
            return tex;
        }

        private Texture2D DecodeTgaTexture(byte[] raw, string path)
        {
            if (raw.Length < 18)
                return null;

            int idLen = raw[0];
            int colorMapType = raw[1];
            int imageType = raw[2];
            if (colorMapType != 0 || imageType != 2)
                return null;

            int width = raw[12] | (raw[13] << 8);
            int height = raw[14] | (raw[15] << 8);
            int bpp = raw[16];
            int desc = raw[17];
            if (width <= 0 || height <= 0)
                return null;
            if (bpp != 24 && bpp != 32)
                return null;

            int header = 18 + idLen;
            int bytesPerPixel = bpp / 8;
            int expected = width * height * bytesPerPixel;
            if (header + expected > raw.Length)
                return null;

            bool topOrigin = (desc & 0x20) != 0;
            Color32[] pixels = new Color32[width * height];
            int pos = header;
            for (int y = 0; y < height; y++)
            {
                int dstY = topOrigin ? (height - 1 - y) : y;
                for (int x = 0; x < width; x++)
                {
                    byte b = raw[pos++];
                    byte g = raw[pos++];
                    byte r = raw[pos++];
                    byte a = bytesPerPixel == 4 ? raw[pos++] : (byte)255;
                    pixels[dstY * width + x] = new Color32(r, g, b, a);
                }
            }

            var tex = new Texture2D(width, height, TextureFormat.RGBA32, true, false);
            tex.SetPixels32(pixels);
            tex.Apply(true, false);
            return tex;
        }

        private Texture2D BuildRoadPlaceholderTexture(RoadVisualDesc desc)
        {
            int width = 256;
            int height = 256;
            var tex = new Texture2D(width, height, TextureFormat.RGBA32, true, false);
            Color32[] pixels = new Color32[width * height];
            byte baseR = (byte)Mathf.Clamp(desc != null ? desc.RFactor : 160, 0, 255);
            byte baseG = (byte)Mathf.Clamp(desc != null ? desc.GFactor : 128, 0, 255);
            byte baseB = (byte)Mathf.Clamp(desc != null ? desc.BFactor : 96, 0, 255);

            for (int y = 0; y < height; y++)
            {
                float fy = y / (float)(height - 1);
                float center = Mathf.Abs(fy - 0.5f) * 2.0f;
                float edge = Mathf.SmoothStep(1.0f, 0.0f, center);
                for (int x = 0; x < width; x++)
                {
                    int idx = y * width + x;
                    int noise = (x * 17 + y * 31 + ((desc != null ? desc.TypeId : 0) * 97)) & 31;
                    byte r = (byte)Mathf.Clamp(baseR + noise - 8, 0, 255);
                    byte g = (byte)Mathf.Clamp(baseG + noise - 8, 0, 255);
                    byte b = (byte)Mathf.Clamp(baseB + noise - 8, 0, 255);
                    byte a = (byte)Mathf.Clamp(120 + edge * 110.0f, 0, 255);
                    pixels[idx] = new Color32(r, g, b, a);
                }
            }

            tex.SetPixels32(pixels);
            tex.Apply(true, false);
            tex.wrapMode = TextureWrapMode.Repeat;
            tex.filterMode = FilterMode.Bilinear;
            tex.name = "road_placeholder_" + (desc != null ? desc.RoadName : "default");
            return tex;
        }

        private BuiltRoadSystem BuildOriginalRoadSystem(DecodedRoadNet net, List<RoadVisualDesc> descs, out string info)
        {
            var built = new BuiltRoadSystem();
            if (net == null || net.Nodes == null || net.Nodes.Count == 0)
            {
                info = "reason=missing-net";
                return built;
            }

            int nKnots = net.Nodes.Count;
            for (int i = 0; i < nKnots; i++)
            {
                RoadKnot source = net.Nodes[i];
                if (source.Hidden != 0)
                {
                    built.HiddenNodes++;
                    continue;
                }

                int nl = Math.Clamp(source.NLinks, 0, Rne2MaxLink);
                var sorted = new List<RoadAngleLink>(nl);
                int x0 = source.X;
                int y0 = source.Y;

                for (int j = 0; j < nl; j++)
                {
                    int targetIdx = source.Links[j];
                    if (targetIdx < 0 || targetIdx >= nKnots)
                        continue;

                    byte type = source.LinkType[j];
                    RoadVisualDesc desc = ResolveRoadVisualDesc(descs, type, built);
                    RoadKnot target = net.Nodes[targetIdx];

                    if (targetIdx > i && target.Hidden == 0)
                    {
                        int dx = source.X - target.X;
                        int dy = source.Y - target.Y;
                        int nn = Mathf.Max(1, Mathf.RoundToInt(Mathf.Sqrt(dx * dx + dy * dy)));
                        int w = Mathf.Max(1, desc.RWidth / 2);
                        int ox = dx * w / nn;
                        int oy = dy * w / nn;

                        var anchors = new List<Vector2Int>(2)
                        {
                            new Vector2Int(source.X - ox, source.Y - oy),
                            new Vector2Int(target.X + ox, target.Y + oy)
                        };

                        if (TryCreateRoadInstance(desc, anchors, 0, out BuiltRoadInstance road))
                        {
                            built.Roads.Add(road);
                            built.BaseSegments++;
                        }
                    }

                    sorted.Add(new RoadAngleLink
                    {
                        Target = targetIdx,
                        Angle = QuantizeRoadAngle(target.X - x0, (target.Y - y0) / 2),
                        RoadType = type
                    });
                }

                if (sorted.Count <= 1)
                    continue;

                for (int p = 0; p < sorted.Count; p++)
                {
                    int rMinDA = 1024;
                    int lMinDA = -1024;
                    for (int j = 0; j < sorted.Count; j++)
                    {
                        if (p == j)
                            continue;
                        int da = WrapSignedByte(sorted[j].Angle - sorted[p].Angle);
                        int dal = da < 0 ? da : -256 + da;
                        int dar = da > 0 ? da : 256 + da;
                        if (dar < rMinDA) rMinDA = dar;
                        if (dal > lMinDA) lMinDA = dal;
                    }

                    rMinDA = WrapSignedByte(rMinDA);
                    lMinDA = WrapSignedByte(lMinDA);

                    for (int j = 0; j < sorted.Count; j++)
                    {
                        RoadVisualDesc descJ = ResolveRoadVisualDesc(descs, sorted[j].RoadType, built);
                        RoadVisualDesc descP = ResolveRoadVisualDesc(descs, sorted[p].RoadType, built);
                        int w1 = Mathf.Max(1, descJ.RWidth);
                        int w2 = Mathf.Max(1, descP.RWidth);
                        if (!((w1 == w2 && p > j) || w1 < w2))
                            continue;

                        int da = WrapSignedByte(sorted[j].Angle - sorted[p].Angle);
                        int x = x0;
                        int y = y0;
                        RoadKnot n1 = net.Nodes[sorted[j].Target];
                        RoadKnot n2 = net.Nodes[sorted[p].Target];

                        int x1 = n1.X;
                        int y1 = n1.Y;
                        int x2 = n2.X;
                        int y2 = n2.Y;

                        int w = w1 * 2;
                        int dd = 20;
                        if (Math.Abs(da) < 64) dd = 20 + 64 - Math.Abs(da);
                        if (dd > 40) dd = 40;
                        if (Math.Abs(da) < 64) w = (w * dd) / 20;

                        int n1Len = Mathf.Max(1, Mathf.RoundToInt(Mathf.Sqrt((x1 - x) * (x1 - x) + (y1 - y) * (y1 - y))));
                        int n2Len = Mathf.Max(1, Mathf.RoundToInt(Mathf.Sqrt((x2 - x) * (x2 - x) + (y2 - y) * (y2 - y))));
                        if (w > n1Len) w = n1Len;
                        if (w > n2Len) w = n2Len;

                        x1 = x + ((x1 - x) * w) / n1Len;
                        y1 = y + ((y1 - y) * w) / n1Len;
                        x2 = x + ((x2 - x) * w) / n2Len;
                        y2 = y + ((y2 - y) * w) / n2Len;

                        var anchors = new List<Vector2Int>(5)
                        {
                            new Vector2Int(x1, y1),
                            new Vector2Int((x1 + x) / 2, (y1 + y) / 2),
                            new Vector2Int((x1 + x2 + x + x + x + x) / 6, (y1 + y2 + y + y + y + y) / 6),
                            new Vector2Int((x2 + x) / 2, (y2 + y) / 2),
                            new Vector2Int(x2, y2)
                        };

                        int nrd = 2;
                        for (int t = 0; t < sorted.Count; t++)
                        {
                            if (t == p || t == j)
                                continue;
                            RoadVisualDesc descT = ResolveRoadVisualDesc(descs, sorted[t].RoadType, built);
                            int w3 = Mathf.Max(1, descT.RWidth);
                            if (Math.Abs(w1 - w3) < w1 / 3 || Math.Abs(w2 - w3) < w2 / 3)
                                nrd++;
                        }

                        int sideMode = 0;
                        if (nrd > 2 && Math.Abs(da) > 32)
                        {
                            if (da == rMinDA) sideMode = 1;
                            else if (da == lMinDA) sideMode = 2;
                            else sideMode = 3;
                        }

                        if (nrd <= 2 || sideMode != 0)
                        {
                            if (TryCreateRoadInstance(descJ, anchors, sideMode, out BuiltRoadInstance road))
                            {
                                built.Roads.Add(road);
                                built.Connectors++;
                            }
                        }
                    }
                }
            }

            string typeSummary = string.Join(",", built.TypeUsage.OrderBy(kv => kv.Key).Take(16).Select(kv => $"{kv.Key}:{kv.Value}"));
            info = $"roads={built.Roads.Count} base={built.BaseSegments} connectors={built.Connectors} hiddenNodes={built.HiddenNodes} missingTypeRefs={built.MissingTypeRefs} types={typeSummary}";
            return built;
        }

        private RoadVisualDesc ResolveRoadVisualDesc(List<RoadVisualDesc> descs, int type, BuiltRoadSystem built)
        {
            if (descs == null || descs.Count == 0)
                return null;

            RoadVisualDesc desc = null;
            if (type >= 0 && type < descs.Count)
                desc = descs[type];
            else
            {
                desc = descs[Mathf.Clamp(type, 0, descs.Count - 1)];
                if (built != null)
                    built.MissingTypeRefs++;
            }

            if (built != null)
            {
                if (!built.TypeUsage.ContainsKey(type))
                    built.TypeUsage[type] = 0;
                built.TypeUsage[type]++;
            }

            return desc;
        }

        private bool TryCreateRoadInstance(RoadVisualDesc desc, List<Vector2Int> anchors, int sideMode, out BuiltRoadInstance road)
        {
            road = null;
            if (desc == null || anchors == null || anchors.Count < 2)
                return false;

            List<Vector2Int> curve = InterpolateRoadCurve(anchors);
            if (curve == null || curve.Count < 3)
                return false;

            int usableCount = curve.Count - 1;
            if (usableCount < 2)
                return false;

            road = new BuiltRoadInstance
            {
                TypeId = desc.TypeId,
                RoadName = desc.RoadName,
                Width = Mathf.Max(1, desc.RWidth)
            };

            for (int i = 0; i < usableCount; i++)
            {
                RoadRoadPoint point = BuildRoadPoint(desc, curve, usableCount, i, sideMode);
                road.Points.Add(point);
                UpdateRoadBounds(ref road.XMin, ref road.YMin, ref road.XMax, ref road.YMax, point.X, point.Y);
            }

            road.XMin -= 64;
            road.YMin -= 64;
            road.XMax += 64;
            road.YMax += 64;
            return road.Points.Count >= 2;
        }

        private RoadRoadPoint BuildRoadPoint(RoadVisualDesc desc, List<Vector2Int> curve, int usableCount, int pointIndex, int sideMode)
        {
            Vector2Int p = curve[pointIndex];
            int w = Mathf.Max(1, GetRoadValue(pointIndex * Mathf.Max(1, desc.AlphaFrequency)));
            int aLeft = desc.AFactorMin + (((desc.AFactor - desc.AFactorMin) * w) >> 15);
            int lt = ApproxRoadLighting(p.x, p.y);
            int r = ClampByte((desc.RFactor * lt) / 128);
            int g = ClampByte((desc.GFactor * lt) / 128);
            int b = ClampByte((desc.BFactor * lt) / 128);

            Color32 left = BuildRoadColor(aLeft, r, g, b);

            w = 32767 - w;
            int aRight = desc.AFactorMin + (((desc.AFactor - desc.AFactorMin) * w) >> 15);
            Color32 right = BuildRoadColor(aRight, r, g, b);

            if (sideMode != 0)
            {
                int midA = (desc.AFactorMin + desc.AFactor) / 2;
                int jitter = (GetRoadValue(pointIndex * 97 + desc.TypeId * 131) & 255);
                int baseA = desc.AFactor + ((midA - desc.AFactor) * jitter) / 32768;
                Color32 c = BuildRoadColor(baseA, r, g, b);
                Color32 c1 = BuildRoadColor(baseA >> 2, r >> 1, g >> 1, b >> 1);
                if (sideMode == 1)
                {
                    left = new Color32(0, 0, 0, 0);
                    right = c;
                }
                else if (sideMode == 2)
                {
                    right = new Color32(0, 0, 0, 0);
                    left = c;
                }
                else
                {
                    left = c1;
                    right = c1;
                }
            }

            int fade = 255;
            if (pointIndex < 8)
                fade = Mathf.Min(fade, pointIndex * 32);
            if (pointIndex >= usableCount - 8)
                fade = Mathf.Min(fade, (usableCount - pointIndex - 1) * 32);
            fade = Mathf.Clamp(fade, 0, 255);

            left = MultiplyRoadColor(left, fade);
            right = MultiplyRoadColor(right, fade);

            return new RoadRoadPoint
            {
                X = p.x,
                Y = p.y,
                Left = left,
                Right = right
            };
        }

        private List<Vector2Int> InterpolateRoadCurve(List<Vector2Int> anchors)
        {
            int n = anchors != null ? anchors.Count : 0;
            if (n < 2)
                return null;

            var result = new List<Vector2Int>(128);
            for (int i = 1; i < n; i++)
            {
                Vector2 p0 = anchors[i - 1];
                Vector2 p3 = anchors[i];

                Vector2 v1 = GetBezierVector(anchors, i - 1);
                Vector2 v2 = GetBezierVector(anchors, i);
                int nr = (2 * Mathf.RoundToInt(Vector2.Distance(p0, p3))) / 5;
                v1 = NormalizeRoadVector(v1, nr);
                v2 = NormalizeRoadVector(v2, nr);

                Vector2 p1 = p0 + v1;
                Vector2 p2 = p3 - v2;

                int np = Mathf.RoundToInt(Vector2.Distance(p1, p0)) / 5;
                if (np > 1)
                {
                    np += 2;
                    for (int j = 0; j < np; j++)
                    {
                        float u = j / (float)np;
                        float one = 1.0f - u;
                        float b0 = one * one * one;
                        float b1 = 3.0f * u * one * one;
                        float b2 = 3.0f * u * u * one;
                        float b3 = u * u * u;
                        int x = Mathf.RoundToInt(b0 * p0.x + b1 * p1.x + b2 * p2.x + b3 * p3.x);
                        int y = Mathf.RoundToInt(b0 * p0.y + b1 * p1.y + b2 * p2.y + b3 * p3.y);
                        AddRoadCurvePoint(result, x, y, 8);
                    }
                }
                else
                {
                    AddRoadCurvePoint(result, anchors[i - 1].x, anchors[i - 1].y, 80);
                }

                if (i == n - 1)
                    AddRoadCurvePoint(result, anchors[i].x, anchors[i].y, 80);
            }

            return result;
        }

        private static Vector2 GetBezierVector(List<Vector2Int> points, int i)
        {
            if (i <= 0)
                return 2.0f * ((Vector2)points[1] - (Vector2)points[0]);
            if (i >= points.Count - 1)
                return 2.0f * ((Vector2)points[i] - (Vector2)points[i - 1]);
            return (Vector2)points[i + 1] - (Vector2)points[i - 1];
        }

        private static Vector2 NormalizeRoadVector(Vector2 v, int length)
        {
            float mag = v.magnitude;
            if (mag <= 0.001f || length <= 0)
                return Vector2.zero;
            return v / mag * length;
        }

        private static void AddRoadCurvePoint(List<Vector2Int> dst, int x, int y, int minDist)
        {
            if (dst.Count > 0)
            {
                Vector2Int prev = dst[dst.Count - 1];
                int dx = x - prev.x;
                int dy = y - prev.y;
                if (Mathf.RoundToInt(Mathf.Sqrt(dx * dx + dy * dy)) < minDist)
                    return;
            }

            dst.Add(new Vector2Int(x, y));
        }

        private List<RoadRenderPart> BuildRoadRenderParts(BuiltRoadSystem built, List<RoadVisualDesc> descs, out string info)
        {
            var parts = new List<RoadRenderPart>();
            if (built == null || built.Roads == null || built.Roads.Count == 0)
            {
                info = "reason=no-built-roads";
                return parts;
            }

            var grouped = built.Roads.GroupBy(r => r.TypeId).OrderBy(g => g.Key);
            int totalVerts = 0;
            int totalTris = 0;
            foreach (var group in grouped)
            {
                RoadVisualDesc desc = ResolveRoadVisualDesc(descs, group.Key, null);
                List<RoadMeshRange> meshRanges;
                Mesh mesh = BuildRoadMeshForType(group.ToList(), desc, out string meshInfo, out meshRanges);
                if (mesh == null)
                {
                    Debug.LogWarning($"[C2:ROAD] mesh type={group.Key} skip {meshInfo}");
                    continue;
                }

                totalVerts += mesh.vertexCount;
                totalTris += mesh.triangles != null ? mesh.triangles.Length / 3 : 0;

                var part = new RoadRenderPart
                {
                    TypeId = group.Key,
                    RoadName = desc != null ? desc.RoadName : ("type" + group.Key.ToString(CultureInfo.InvariantCulture)),
                    Mesh = mesh,
                    Texture = desc != null ? desc.Texture : null,
                    TextureKey = desc != null ? NormalizeRoadTextureKey(desc.TexturePath) : "",
                    RoadCount = group.Count(),
                    HasBump = desc != null && desc.BumpTexture != null,
                    BumpTexture = desc != null ? desc.BumpTexture : null,
                    RenderQueue = 3002,
                    B1_Y1 = desc != null ? desc.B1_Y1 : 0,
                    B1_Y2 = desc != null ? desc.B1_Y2 : 0,
                    B2_Y1 = desc != null ? desc.B2_Y1 : 0,
                    B2_Y2 = desc != null ? desc.B2_Y2 : 0
                };
                if (meshRanges != null && meshRanges.Count > 0)
                    part.MeshRanges.AddRange(meshRanges);
                parts.Add(part);
            }

            info = $"partCount={parts.Count} totalVerts={totalVerts} totalTris={totalTris}";
            return parts;
        }

        private Mesh BuildRoadMeshForType(List<BuiltRoadInstance> roads, RoadVisualDesc desc, out string info, out List<RoadMeshRange> meshRanges)
        {
            info = "missing";
            meshRanges = new List<RoadMeshRange>();
            if (roads == null || roads.Count == 0 || desc == null)
            {
                info = "reason=no-roads-or-desc";
                return null;
            }

            var verts = new List<Vector3>(roads.Sum(r => r.Points.Count) * 2);
            var tris = new List<int>(roads.Sum(r => Mathf.Max(0, r.Points.Count - 1)) * 6);
            var uvs = new List<Vector2>(roads.Sum(r => r.Points.Count) * 2);
            var uvs2 = new List<Vector2>(roads.Sum(r => r.Points.Count) * 2);
            var colors = new List<Color32>(roads.Sum(r => r.Points.Count) * 2);

            int roadCount = 0;
            foreach (BuiltRoadInstance road in roads)
            {
                int n = road.Points != null ? road.Points.Count : 0;
                if (n < 2)
                    continue;

                float uPos = 0.0f;
                int baseIndex = verts.Count;
                meshRanges.Add(new RoadMeshRange { StartVertex = baseIndex, PointCount = n });
                float width = Mathf.Max(1.0f, road.Width) * 0.5f;

                for (int i = 0; i < n; i++)
                {
                    RoadRoadPoint cur = road.Points[i];
                    RoadRoadPoint prev = i > 0 ? road.Points[i - 1] : road.Points[i];
                    RoadRoadPoint next = i < n - 1 ? road.Points[i + 1] : road.Points[i];

                    float dx = next.X - prev.X;
                    float dy = next.Y - prev.Y;
                    float px = dy;
                    float py = -dx;
                    float np = Mathf.Sqrt(px * px + py * py);
                    if (np < 0.001f)
                    {
                        px = width;
                        py = 0.0f;
                        np = width;
                    }

                    uPos += Mathf.Sqrt((next.X - cur.X) * (next.X - cur.X) + (next.Y - cur.Y) * (next.Y - cur.Y)) * Mathf.Max(1, desc.RScaleX) / 100.0f;
                    px = px * width / np;
                    py = py * width / np * 1.2f;

                    Vector3 left = RoadCoordToWorld(Mathf.RoundToInt(cur.X + px), Mathf.RoundToInt(cur.Y + py), RoadSurfaceLift);
                    Vector3 right = RoadCoordToWorld(Mathf.RoundToInt(cur.X - px), Mathf.RoundToInt(cur.Y - py), RoadSurfaceLift);

                    verts.Add(left);
                    verts.Add(right);

                    float u = desc.TexSizeX > 0 ? (uPos / desc.TexSizeX) : uPos;
                    float v0 = desc.TexSizeY > 0 ? (desc.ReliefY0 / (float)desc.TexSizeY) : 0.0f;
                    float v1 = desc.TexSizeY > 0 ? (desc.ReliefY1 / (float)desc.TexSizeY) : 1.0f;
                    uvs.Add(new Vector2(u, v0));
                    uvs.Add(new Vector2(u, v1));

                    float px0 = 30.0f;
                    float py0 = 20.0f;
                    if (uPos < 80.0f)
                    {
                        float k = uPos / 80.0f;
                        px0 *= k;
                        py0 *= k;
                    }

                    float u2 = u + px0 / 3000.0f;
                    float v20 = v0 - py0 / 6000.0f;
                    float v21 = v1 - py0 / 6000.0f;
                    uvs2.Add(new Vector2(u2, v20));
                    uvs2.Add(new Vector2(u2, v21));

                    colors.Add(cur.Left);
                    colors.Add(cur.Right);

                    if (i < n - 1)
                    {
                        int bi = baseIndex + i * 2;
                        tris.Add(bi + 0);
                        tris.Add(bi + 1);
                        tris.Add(bi + 3);
                        tris.Add(bi + 0);
                        tris.Add(bi + 3);
                        tris.Add(bi + 2);
                    }
                }

                roadCount++;
            }

            if (verts.Count == 0 || tris.Count == 0)
            {
                info = "reason=no-valid-road-mesh";
                return null;
            }

            var mesh = new Mesh();
            mesh.name = $"{_selectedId}_road_type_{desc.TypeId}";
            if (verts.Count > 65000)
                mesh.indexFormat = IndexFormat.UInt32;
            mesh.SetVertices(verts);
            mesh.SetUVs(0, uvs);
            mesh.SetUVs(1, uvs2);
            mesh.SetColors(colors);
            mesh.SetTriangles(tris, 0, true);
            mesh.RecalculateNormals();
            mesh.RecalculateBounds();
            info = $"roads={roadCount} verts={verts.Count} tris={tris.Count / 3} width={desc.RWidth} tex={desc.TexturePath}";
            return mesh;
        }

        private int ApproxRoadLighting(int x, int y)
        {
            int hL = SampleMapHeightLikeOriginal(x - 32, y);
            int hR = SampleMapHeightLikeOriginal(x + 32, y);
            int hD = SampleMapHeightLikeOriginal(x, y - 32);
            int hU = SampleMapHeightLikeOriginal(x, y + 32);
            Vector3 n = new Vector3(hL - hR, 64.0f, hD - hU).normalized;
            Vector3 l = _light != null ? -_light.transform.forward.normalized : new Vector3(0.35f, 0.82f, 0.45f).normalized;
            float lit = Mathf.Clamp01(Vector3.Dot(n, l) * 0.5f + 0.5f);
            int jitter = (GetRoadValue(x + y * 177) & 31) - 15;
            return ClampByte(Mathf.RoundToInt(72.0f + lit * 128.0f) + jitter);
        }

        private static int GetRoadValue(int x)
        {
            int d = x >> 6;
            int r = x & 63;
            short v1 = s_roadNoise[d & 8191];
            short v2 = s_roadNoise[(d + 1) & 8191];
            return v1 + (((v2 - v1) * r) >> 6);
        }

        private static Color32 BuildRoadColor(int a, int r, int g, int b)
        {
            a = ClampByte(a);
            int rr = ClampByte((r * a) >> 7);
            int gg = ClampByte((g * a) >> 7);
            int bb = ClampByte((b * a) >> 7);
            return new Color32((byte)rr, (byte)gg, (byte)bb, (byte)a);
        }

        private static Color32 MultiplyRoadColor(Color32 c, int factor)
        {
            factor = ClampByte(factor);
            return new Color32(
                (byte)((c.r * factor) >> 8),
                (byte)((c.g * factor) >> 8),
                (byte)((c.b * factor) >> 8),
                (byte)((c.a * factor) >> 8));
        }

        private static int ClampByte(int x)
        {
            if (x < 0) return 0;
            if (x > 255) return 255;
            return x;
        }

        private static int ParseRoadInt(string s, int fallback)
        {
            if (int.TryParse(s, NumberStyles.Integer, CultureInfo.InvariantCulture, out int v))
                return v;
            if (int.TryParse(s, NumberStyles.Integer, CultureInfo.GetCultureInfo("ru-RU"), out v))
                return v;
            return fallback;
        }

        private static int QuantizeRoadAngle(int dx, int dy)
        {
            if (dx == 0 && dy == 0)
                return 0;
            float angle = Mathf.Atan2(dy, dx);
            int q = Mathf.RoundToInt(angle * 128.0f / Mathf.PI);
            return q & 255;
        }

        private static int WrapSignedByte(int x)
        {
            return ((x + 128) & 255) - 128;
        }

        private static void UpdateRoadBounds(ref int xmin, ref int ymin, ref int xmax, ref int ymax, int x, int y)
        {
            if (x < xmin) xmin = x;
            if (y < ymin) ymin = y;
            if (x > xmax) xmax = x;
            if (y > ymax) ymax = y;
        }

        private static string NormalizeRoadTextureKey(string path)
        {
            if (string.IsNullOrWhiteSpace(path))
                return "<none>";
            string s = path.Trim().Replace('\\', '/');
            while (s.Contains("//"))
                s = s.Replace("//", "/");
            return s;
        }


        private void CreateWaterObject(string selectedId, Mesh terrainMesh)
        {
            Debug.Log($"[C2:WATER] create begin map={selectedId} terrainMesh={(terrainMesh != null ? terrainMesh.name : "<null>")} terrainVerts={(terrainMesh != null ? terrainMesh.vertexCount : 0)} terrainTris={(terrainMesh != null && terrainMesh.triangles != null ? terrainMesh.triangles.Length / 3 : 0)}");
            Debug.Log("[C2:WATER] create data " + BuildWaterChunkPresenceSummary());

            if (_map == null || _map.Water == null || !_map.Water.HasRenderableWater)
            {
                Debug.Log("[C2:WATER] render skipped: no renderable water data on this map");
                return;
            }

            Mesh waterMesh = C2WaterBuilder.TryBuildWaterHexMesh(
                selectedId,
                terrainMesh,
                _map.Water,
                SampleMapHeightLikeOriginal,
                WorldZSign,
                out string buildInfo);

            _lastWaterBuildInfo = buildInfo ?? string.Empty;
            if (waterMesh == null)
            {
                Debug.LogWarning("[C2:WATER] render failed: " + _lastWaterBuildInfo);
                return;
            }

            Debug.Log($"[C2:WATER] mesh build result {buildInfo}");

            _waterGo = new GameObject("Water_" + selectedId);
            _waterGo.transform.SetParent(transform, false);
            _waterGo.transform.localPosition = Vector3.zero;

            var mf = _waterGo.AddComponent<MeshFilter>();
            var mr = _waterGo.AddComponent<MeshRenderer>();
            mf.sharedMesh = waterMesh;

            Material mat = TryCreateExternalWaterMaterial(selectedId, out string shaderResolveInfo);
            string shaderPropInfo = string.Empty;
            Shader shader = mat != null ? mat.shader : null;
            if (mat == null)
            {
                shader = ResolveWaterMainShaderSafe(out shaderResolveInfo, out shaderPropInfo);
                if (shader == null)
                {
                    Debug.LogError("[C2:WATER] Water shader resolve failed; aborting water object creation. " + shaderResolveInfo);
                    Destroy(_waterGo);
                    _waterGo = null;
                    return;
                }

                if (!string.IsNullOrWhiteSpace(shaderPropInfo))
                    Debug.LogWarning("[C2:WATER] shaderProps " + shaderPropInfo);

                mat = new Material(shader);
                mat.name = selectedId + "_water_hex_surface_mat";
            }
            else
            {
                Debug.Log("[C2:WATER] " + shaderResolveInfo);
                if (shader == null)
                {
                    Debug.LogError("[C2:WATER] External water material has no shader; aborting water object creation.");
                    Destroy(_waterGo);
                    _waterGo = null;
                    return;
                }

                mat.name = selectedId + "_water_external_water_mat";
            }
            mr.sharedMaterial = mat;
            if (mat.HasProperty("_BaseColor"))
                mat.SetColor("_BaseColor", Color.white);
            if (mat.HasProperty("_Color"))
                mat.SetColor("_Color", Color.white);
            if (mat.HasProperty("_ShallowTint"))
                mat.SetColor("_ShallowTint", new Color32(120, 158, 181, 255));
            if (mat.HasProperty("_DeepTint"))
                mat.SetColor("_DeepTint", new Color32(30, 68, 105, 255));
            if (mat.HasProperty("_WaterColorMod"))
                mat.SetColor("_WaterColorMod", new Color32(128, 128, 128, 255)); // EngSettings.WaterColorModulator = 0xFF808080
            if (mat.HasProperty("_WaterFactorTint"))
                mat.SetColor("_WaterFactorTint", new Color32(96, 128, 112, 255)); // Water2/BumpWater TextureFactor = 0xFF608070
            if (mat.HasProperty("_ReflectionTint"))
                mat.SetColor("_ReflectionTint", new Color32(104, 136, 124, 255));
            if (mat.HasProperty("_ReflectionMix"))
                mat.SetFloat("_ReflectionMix", 0.68f);
            if (mat.HasProperty("_TintStrength"))
                mat.SetFloat("_TintStrength", 0.54f);
            if (mat.HasProperty("_AlphaStrength"))
                mat.SetFloat("_AlphaStrength", 0.94f);
            if (mat.HasProperty("_AlphaCurve"))
                mat.SetFloat("_AlphaCurve", 0.98f);
            if (mat.HasProperty("_DepthTintStrength"))
                mat.SetFloat("_DepthTintStrength", 0.42f);
            if (mat.HasProperty("_FresnelStrength"))
                mat.SetFloat("_FresnelStrength", 0.16f);
            if (mat.HasProperty("_ReflectionStrength"))
                mat.SetFloat("_ReflectionStrength", 0.24f);
            if (mat.HasProperty("_ReflectionSkyBlend"))
                mat.SetFloat("_ReflectionSkyBlend", 0.56f);
            if (mat.HasProperty("_ReflectionRealBlend"))
                mat.SetFloat("_ReflectionRealBlend", 0.78f);
            if (mat.HasProperty("_EdgeResponse"))
                mat.SetFloat("_EdgeResponse", 0.22f);
            if (mat.HasProperty("_WaveAmp"))
                mat.SetFloat("_WaveAmp", 0.018f);
            if (mat.HasProperty("_WaveAmp2"))
                mat.SetFloat("_WaveAmp2", 0.010f);
            if (mat.HasProperty("_WaveFreq1"))
                mat.SetFloat("_WaveFreq1", 0.0018f);
            if (mat.HasProperty("_WaveFreq2"))
                mat.SetFloat("_WaveFreq2", 0.0036f);
            if (mat.HasProperty("_WaveSpeed1"))
                mat.SetFloat("_WaveSpeed1", 0.42f);
            if (mat.HasProperty("_WaveSpeed2"))
                mat.SetFloat("_WaveSpeed2", -0.31f);
            if (mat.HasProperty("_WaveDistort"))
                mat.SetFloat("_WaveDistort", 0.020f);
            if (mat.HasProperty("_WaveNormalStrength"))
                mat.SetFloat("_WaveNormalStrength", 0.42f);
            if (mat.HasProperty("_MinVisibleAlpha"))
                mat.SetFloat("_MinVisibleAlpha", 0.0f);
            if (mat.HasProperty("_StaticFlowFallback"))
                mat.SetFloat("_StaticFlowFallback", 0.20f);
            if (mat.HasProperty("_StaticFlowFreq"))
                mat.SetFloat("_StaticFlowFreq", 0.0021f);
            if (mat.HasProperty("_StaticFlowSpeed"))
                mat.SetFloat("_StaticFlowSpeed", 0.52f);
            if (mat.HasProperty("_StaticFlowDistort"))
                mat.SetFloat("_StaticFlowDistort", 0.016f);
            if (mat.HasProperty("_RiverLineStrength"))
                mat.SetFloat("_RiverLineStrength", 0.34f);
            Debug.Log("[C2:WATER] waveStage=procedural-bump-v1 visualStage=tuning-v1 riverStage=polish-static-fallback-v1 stabilityStage=stage10-hardened-v1 amp1=0.018 amp2=0.010 freq1=0.0018 freq2=0.0036 speed1=0.42 speed2=-0.31 distort=0.020 minAlpha=0.24 staticFlow=0.20 staticFreq=0.0021 staticSpeed=0.52 line=0.34");
            SetupWaterMapDataTextures(selectedId, mat);
            ApplyWaterStabilityProfile(mat);
            SetupWaterReflectionResources(selectedId, mat);
            UpdateWaterReflectionTarget(force: true);
            ApplyWaterReflectionParams(forceLog: true);
            LogWaterReflectionBaseline("post-setup", mat, waterMesh, shader);
            if (mat.HasProperty("_SoftEdge"))
                mat.SetFloat("_SoftEdge", 0.16f);
            if (mat.HasProperty("_Surface"))
                mat.SetFloat("_Surface", 1.0f);
            if (mat.HasProperty("_Blend"))
                mat.SetFloat("_Blend", 0.0f);
            if (mat.HasProperty("_AlphaClip"))
                mat.SetFloat("_AlphaClip", 0.0f);
            if (mat.HasProperty("_ZWrite"))
                mat.SetFloat("_ZWrite", 0.0f);
            mat.renderQueue = 3000;
            _waterMaterial = mat;
            mr.sharedMaterial = mat;
            ApplyWaterRendererVisibilityFromPreset();

            string reflTexName = GetWaterTexDebugName(mat, "_ReflectionTex");
            string reflFallbackName = GetWaterTexDebugName(mat, "_ReflectionFallbackTex");
            Debug.Log($"[C2:WATER] renderPath=waterhex-surface mode=staggered-waterhex shader={shader.name} {buildInfo} materialMode=slot1-cloud-refsky reflectionMode={_lastWaterReflectionMode} reflectionPath=real-camera-or-fallback-copy projectiveActive={_waterReflectionProjectiveActive} waveStage=procedural-bump-v1 visualStage=tuning-v1 riverStage=polish-static-fallback-v1 stabilityStage=stage10-hardened-v1 surfStage=refsurf-terrainlift-v1 {_lastWaterMapDataInfo} reflectionTex={reflTexName} fallback={reflFallbackName} targetState={_lastWaterReflectionTargetState} writer={_lastWaterReflectionWriter} shaderResolve={shaderResolveInfo} shaderProps={shaderPropInfo}");
            Debug.Log($"[C2:WATER] waterPos={_waterGo.transform.position} waterRot={_waterGo.transform.rotation.eulerAngles} waterScale={_waterGo.transform.localScale}");
        }





private static string DescribeWaterReflectionMode(WaterReflectionMode mode)
{
    switch (mode)
    {
        case WaterReflectionMode.RealCameraActive: return "real-camera-active";
        case WaterReflectionMode.FallbackSkyCopy:
        default: return "fallback-sky-copy";
    }
}

private static string GetTextureDebugName(Texture tex)
{
    if (tex == null)
        return "<null>";
    return tex.name + "#" + tex.GetInstanceID();
}

private static string DescribeRenderTextureState(RenderTexture rt)
{
    if (rt == null)
        return "rt=<null>";
    return $"{rt.name}#{rt.GetInstanceID()}[{rt.width}x{rt.height}] created={rt.IsCreated()} format={rt.format}";
}

private string BuildWaterChunkPresenceSummary()
{
    if (_map == null)
        return "map=<null>";
    if (_map.Water == null)
        return "water=<null>";
    return $"map={_selectedId} waterSummary={_map.Water.BuildSummary()}";
}

private void LogWaterReflectionBaseline(string stage, Material mat, Mesh waterMesh, Shader shader)
{
    string waterMeshInfo = waterMesh != null
        ? $"{waterMesh.name} verts={waterMesh.vertexCount} tris={(waterMesh.triangles != null ? waterMesh.triangles.Length / 3 : 0)} bounds={waterMesh.bounds.center}/{waterMesh.bounds.size}"
        : "<null>";
    string shaderInfo = shader != null ? $"{shader.name}|supported={shader.isSupported}|passes={shader.passCount}" : "<null>";
    string assigned = mat != null ? GetWaterTexDebugName(mat, "_ReflectionTex") : "<no-material>";
    string fallback = mat != null ? GetWaterTexDebugName(mat, "_ReflectionFallbackTex") : "<no-material>";
    Debug.Log($"[C2:WATER] baseline stage={stage} {BuildWaterChunkPresenceSummary()} mesh={waterMeshInfo} shader={shaderInfo} reflectionMode={_lastWaterReflectionMode} projectiveActive={_waterReflectionProjectiveActive} targetState={_lastWaterReflectionTargetState} assigned={assigned} fallbackAssigned={fallback} writer={_lastWaterReflectionWriter}");
}

private Shader ResolveWaterMainShaderSafe(out string info, out string propInfo)
{
    const string shaderName = "Cossacks2Bridge/WaterHexMain";
    const string shaderAssetPath = "Assets/Cossacks2Bridge/Shaders/C2WaterDebugOverlay.shader";

    var reports = new List<string>();
    Shader bestNamed = null;
    string bestNamedSource = null;
    Shader bestFallback = null;
    string bestFallbackSource = null;

    void Probe(string source, Shader shader, bool exactNamePreferred, bool fallbackCandidate)
    {
        if (shader == null)
        {
            reports.Add($"{source}=<null>");
            return;
        }

        string props = DescribeWaterShaderProps(shader, out bool hasAllProps);
        reports.Add($"{source}={shader.name}|supported={shader.isSupported}|props={props}");

        if (exactNamePreferred && string.Equals(shader.name, shaderName, StringComparison.Ordinal) && bestNamed == null)
        {
            bestNamed = shader;
            bestNamedSource = source;
        }

        if (fallbackCandidate && shader.isSupported && bestFallback == null)
        {
            bestFallback = shader;
            bestFallbackSource = source;
        }
    }

    Probe("Shader.Find(WaterHexMain)", Shader.Find(shaderName), exactNamePreferred: true, fallbackCandidate: false);
    Probe("Shader.Find(WaterHexSurface)", Shader.Find("Cossacks2Bridge/WaterHexSurface"), exactNamePreferred: false, fallbackCandidate: true);
#if UNITY_EDITOR
    try
    {
        Probe("AssetDatabase(C2WaterDebugOverlay)", AssetDatabase.LoadAssetAtPath<Shader>(shaderAssetPath), exactNamePreferred: true, fallbackCandidate: false);
    }
    catch (Exception ex)
    {
        reports.Add("AssetDatabase(C2WaterDebugOverlay)Ex=" + ex.GetType().Name);
    }
#endif
    try
    {
        var all = Resources.FindObjectsOfTypeAll<Shader>();
        Probe("Resources(WaterHexMain)", all.FirstOrDefault(s => string.Equals(s.name, shaderName, StringComparison.Ordinal)), exactNamePreferred: true, fallbackCandidate: false);
        Probe("Resources(WaterHexSurface)", all.FirstOrDefault(s => string.Equals(s.name, "Cossacks2Bridge/WaterHexSurface", StringComparison.Ordinal)), exactNamePreferred: false, fallbackCandidate: true);
    }
    catch (Exception ex)
    {
        reports.Add("Resources.FindObjectsOfTypeAllEx=" + ex.GetType().Name);
    }

    Probe("Shader.Find(Sprites/Default)", Shader.Find("Sprites/Default"), exactNamePreferred: false, fallbackCandidate: true);
    Probe("Shader.Find(URP/Unlit)", Shader.Find("Universal Render Pipeline/Unlit"), exactNamePreferred: false, fallbackCandidate: true);
    Probe("Shader.Find(Unlit/Color)", Shader.Find("Unlit/Color"), exactNamePreferred: false, fallbackCandidate: true);

    Shader chosen = bestNamed ?? bestFallback;
    string chosenSource = bestNamed != null ? bestNamedSource : bestFallbackSource;

    if (chosen == null)
    {
        info = "resolve=failed " + string.Join(" ; ", reports);
        propInfo = "<none>";
        return null;
    }

    propInfo = DescribeWaterShaderProps(chosen, out bool _);
    info = $"resolve={(bestNamed != null ? "named" : "fallback")}|source={chosenSource}|chosen={chosen.name}|supported={chosen.isSupported}|probes={string.Join(" ; ", reports)}";
    return chosen;
}

private static string DescribeWaterShaderProps(Shader shader, out bool hasAllProps)
{
    if (shader == null)
    {
        hasAllProps = false;
        return "shader=<null>";
    }

    string[] props = { "_ReflectionTex", "_ReflectionFallbackTex", "_ReflectionUvST", "_ReflectionProjectiveActive", "_ReflectionProjRow0", "_ReflectionProjRow1", "_ReflectionProjRow2", "_ReflectionProjRow3", "_ReflectionSkyBlend", "_ReflectionRealBlend" };
    var missing = new List<string>();
    foreach (string prop in props)
    {
        if (shader.FindPropertyIndex(prop) < 0)
            missing.Add(prop);
    }

    hasAllProps = missing.Count == 0;
    return missing.Count == 0 ? "all-required-present" : ("missing=" + string.Join(",", missing));
}

private void SetupWaterReflectionResources(string selectedId, Material mat)
{
    if (mat == null)
        return;

    _lastWaterReflectionMode = DescribeWaterReflectionMode(WaterReflectionMode.FallbackSkyCopy);
    _lastWaterReflectionWriter = "setup-pending";
    _waterReflectionResourcesInitialized = false;

    if (_waterSkyFallback == null)
    {
        _waterSkyFallback = Resources.Load<Texture2D>("textures/oblaka123g1");
        if (_waterSkyFallback == null)
            _waterSkyFallback = Texture2D.whiteTexture;
        Debug.Log($"[C2:WATER] fallbackLoad requested=textures/oblaka123g1 assigned={GetTextureDebugName(_waterSkyFallback)}");
    }
    else
    {
        Debug.Log($"[C2:WATER] fallbackReuse assigned={GetTextureDebugName(_waterSkyFallback)}");
    }

    if (_waterReflectionTarget == null)
    {
        _waterReflectionTarget = new RenderTexture(512, 512, 16, RenderTextureFormat.ARGB32);
        _waterReflectionTarget.name = string.IsNullOrWhiteSpace(selectedId) ? "water_reflection_rt" : (selectedId + "_water_reflection_rt");
        _waterReflectionTarget.wrapMode = TextureWrapMode.Repeat;
        _waterReflectionTarget.filterMode = FilterMode.Bilinear;
        _waterReflectionTarget.useMipMap = false;
        _waterReflectionTarget.autoGenerateMips = false;
        _waterReflectionTarget.Create();
        Debug.Log($"[C2:WATER] reflectionTargetCreate target={DescribeRenderTextureState(_waterReflectionTarget)}");
    }
    else if (!_waterReflectionTarget.IsCreated())
    {
        _waterReflectionTarget.Create();
        Debug.Log($"[C2:WATER] reflectionTargetRecreate target={DescribeRenderTextureState(_waterReflectionTarget)}");
    }
    else
    {
        Debug.Log($"[C2:WATER] reflectionTargetReuse target={DescribeRenderTextureState(_waterReflectionTarget)}");
    }

    if (_waterReflectionCopyMaterial == null)
    {
        var copyShader = Shader.Find("Hidden/C2WaterReflectionCopy");
        if (copyShader != null)
        {
            _waterReflectionCopyMaterial = new Material(copyShader);
            _waterReflectionCopyMaterial.name = "C2WaterReflectionCopyMat";
            Debug.Log($"[C2:WATER] reflectionCopyMaterial shader={copyShader.name} material={_waterReflectionCopyMaterial.name}");
        }
        else
        {
            Debug.LogWarning("[C2:WATER] reflectionCopyMaterial shader=<null>; fallback raw blit will be used");
        }
    }

    EnsureWaterReflectionCamera(selectedId);

    Texture reflectionTex = (_waterReflectionTarget != null && _waterReflectionTarget.IsCreated()) ? (Texture)_waterReflectionTarget : _waterSkyFallback;
    reflectionTex = GetWaterReflectionTextureWithCloudLayer(selectedId, reflectionTex);
    if (mat.HasProperty("_ReflectionTex"))
        mat.SetTexture("_ReflectionTex", reflectionTex);
    if (mat.HasProperty("_PlanarReflectionTex"))
        mat.SetTexture("_PlanarReflectionTex", reflectionTex);
    if (mat.HasProperty("_ReflectionFallbackTex"))
        mat.SetTexture("_ReflectionFallbackTex", _waterSkyFallback);

    ApplyReflectionProjectiveParamsToMaterial(mat, false);
    _waterReflectionResourcesInitialized = _waterReflectionTarget != null && _waterReflectionTarget.IsCreated() && _waterSkyFallback != null;
    _lastWaterReflectionAssignedTex = GetTextureDebugName(reflectionTex);
    _lastWaterReflectionFallbackTex = GetTextureDebugName(_waterSkyFallback);
    _lastWaterReflectionTargetState = DescribeRenderTextureState(_waterReflectionTarget);
    _lastWaterReflectionInfo = $"reflectionMode={_lastWaterReflectionMode} resourcesReady={_waterReflectionResourcesInitialized} targetState={_lastWaterReflectionTargetState} fallback={_lastWaterReflectionFallbackTex} assigned={_lastWaterReflectionAssignedTex}";
}


private void EnsureWaterCloudCompositeResources(string selectedId, Texture sourceTex)
{
    int width = 512;
    int height = 512;

    if (sourceTex is RenderTexture sourceRt)
    {
        width = Mathf.Max(16, sourceRt.width);
        height = Mathf.Max(16, sourceRt.height);
    }
    else if (sourceTex != null)
    {
        width = Mathf.Max(16, sourceTex.width);
        height = Mathf.Max(16, sourceTex.height);
    }

    if (_waterCloudCompositeTarget == null || _waterCloudCompositeTarget.width != width || _waterCloudCompositeTarget.height != height)
    {
        if (_waterCloudCompositeTarget != null)
        {
            _waterCloudCompositeTarget.Release();
            Destroy(_waterCloudCompositeTarget);
            _waterCloudCompositeTarget = null;
        }

        _waterCloudCompositeTarget = new RenderTexture(width, height, 0, RenderTextureFormat.ARGB32);
        _waterCloudCompositeTarget.name = string.IsNullOrWhiteSpace(selectedId) ? "water_cloud_reflection_rt" : (selectedId + "_water_cloud_reflection_rt");
        _waterCloudCompositeTarget.wrapMode = TextureWrapMode.Repeat;
        _waterCloudCompositeTarget.filterMode = FilterMode.Bilinear;
        _waterCloudCompositeTarget.useMipMap = false;
        _waterCloudCompositeTarget.autoGenerateMips = false;
        _waterCloudCompositeTarget.Create();
        Debug.Log($"[C2:WATER] cloudReflectionTargetCreate target={DescribeRenderTextureState(_waterCloudCompositeTarget)}");
    }
    else if (!_waterCloudCompositeTarget.IsCreated())
    {
        _waterCloudCompositeTarget.Create();
        Debug.Log($"[C2:WATER] cloudReflectionTargetRecreate target={DescribeRenderTextureState(_waterCloudCompositeTarget)}");
    }

    if (_waterCloudCompositeMaterial == null)
    {
        Shader shader = Shader.Find("Hidden/C2/WaterCloudComposite");
        if (shader != null)
        {
            _waterCloudCompositeMaterial = new Material(shader);
            _waterCloudCompositeMaterial.name = "C2WaterCloudCompositeMat";
            Debug.Log($"[C2:WATER] cloudReflectionMaterial shader={shader.name} material={_waterCloudCompositeMaterial.name}");
        }
        else
        {
            Debug.LogWarning("[C2:WATER] cloudReflectionMaterial shader=<null>; cloud overlay disabled");
        }
    }
}

private Texture GetWaterReflectionTextureWithCloudLayer(string selectedId, Texture baseReflectionTex)
{
    var p = s_externalWaterPreset;
    if (p == null || !p.EnableCloudReflection || baseReflectionTex == null)
        return baseReflectionTex;

    Texture2D cloudTex = LoadWaterCloudTextureById(p.CloudTextureId);
    if (cloudTex == null)
        return baseReflectionTex;

    EnsureWaterCloudCompositeResources(selectedId, baseReflectionTex);
    if (_waterCloudCompositeTarget == null || _waterCloudCompositeMaterial == null)
        return baseReflectionTex;

    float cloudOpacity = Mathf.Clamp01(p.CloudOpacityPercent / 100.0f);
    if (cloudOpacity <= 0.0001f)
        return baseReflectionTex;

    float rad = p.CloudDirectionDeg * Mathf.Deg2Rad;
    float zSign = WorldZSign < 0.0f ? -1.0f : 1.0f;
    Vector2 dir = new Vector2(Mathf.Cos(rad), Mathf.Sin(rad) * zSign);
    Vector2 scroll = dir * (Time.unscaledTime * p.CloudSpeed);

    _waterCloudCompositeMaterial.SetTexture("_CloudTex", cloudTex);
    _waterCloudCompositeMaterial.SetFloat("_CloudOpacity", cloudOpacity);
    _waterCloudCompositeMaterial.SetFloat("_CloudScale", Mathf.Max(0.05f, p.CloudScale));
    _waterCloudCompositeMaterial.SetFloat("_CloudSpacing", Mathf.Max(0.05f, p.CloudSpacing));
    _waterCloudCompositeMaterial.SetFloat("_CloudContrast", Mathf.Clamp(p.CloudContrast, 0.1f, 4.0f));
    _waterCloudCompositeMaterial.SetVector("_CloudScroll", new Vector4(scroll.x, scroll.y, 0.0f, 0.0f));
    _waterCloudCompositeMaterial.SetColor("_CloudTint", new Color(1.0f, 1.0f, 1.0f, 1.0f));

    Graphics.Blit(baseReflectionTex, _waterCloudCompositeTarget, _waterCloudCompositeMaterial);
    return _waterCloudCompositeTarget;
}

private void UpdateWaterReflectionTarget(bool force)
{
    if (_waterReflectionTarget == null || _waterSkyFallback == null)
    {
        _lastWaterReflectionMode = DescribeWaterReflectionMode(WaterReflectionMode.FallbackSkyCopy);
        _waterReflectionProjectiveActive = false;
        _waterReflectionProjectiveMatrix = Matrix4x4.identity;
        _lastWaterReflectionWriter = "skip-no-target-or-fallback";
        _lastWaterReflectionTargetState = DescribeRenderTextureState(_waterReflectionTarget);
        _lastWaterReflectionAssignedTex = GetTextureDebugName(_waterSkyFallback);
        _lastWaterReflectionFallbackTex = GetTextureDebugName(_waterSkyFallback);
        _lastWaterReflectionInfo = $"reflectionMode={_lastWaterReflectionMode} writer={_lastWaterReflectionWriter} targetState={_lastWaterReflectionTargetState} fallback={_lastWaterReflectionFallbackTex}";
        if (force)
            Debug.LogWarning("[C2:WATER] reflectionUpdate skipped " + _lastWaterReflectionInfo);
        return;
    }

    bool moved = float.IsNaN(_lastWaterReflectionPivot.x) || Vector2.SqrMagnitude(new Vector2(_pivot.x - _lastWaterReflectionPivot.x, _pivot.z - _lastWaterReflectionPivot.z)) > 64.0f;
    bool timed = (Time.unscaledTime - _lastWaterReflectionTime) > 0.08f;
    if (!force && !moved && !timed)
        return;

    _lastWaterReflectionPivot = _pivot;
    _lastWaterReflectionTime = Time.unscaledTime;

    if (TryRenderRealWaterReflection(force, out string realWriter))
    {
        _waterReflectionUvST = new Vector4(1.0f, 1.0f, 0.0f, 0.0f);
        _lastWaterReflectionMode = DescribeWaterReflectionMode(WaterReflectionMode.RealCameraActive);
        _waterReflectionProjectiveActive = true;
        _lastWaterReflectionWriter = realWriter;
        _lastWaterReflectionTargetState = DescribeRenderTextureState(_waterReflectionTarget);
        _lastWaterReflectionAssignedTex = GetTextureDebugName(_waterReflectionTarget);
        _lastWaterReflectionFallbackTex = GetTextureDebugName(_waterSkyFallback);
        _lastWaterReflectionInfo = $"reflectionMode={_lastWaterReflectionMode} writer={realWriter} projectiveActive={_waterReflectionProjectiveActive} targetState={_lastWaterReflectionTargetState} fallback={_lastWaterReflectionFallbackTex} assigned={_lastWaterReflectionAssignedTex} uvST={_waterReflectionUvST} updateTime={_lastWaterReflectionTime:0.000} force={force}";
        if (force)
            Debug.Log("[C2:WATER] reflectionUpdate " + _lastWaterReflectionInfo);
        return;
    }

    float mapW = 16384.0f;
    float mapH = 16384.0f;
    if (_terrainGo != null)
    {
        var mf = _terrainGo.GetComponent<MeshFilter>();
        if (mf != null && mf.sharedMesh != null)
        {
            Vector3 scale = _terrainGo.transform.lossyScale;
            Bounds b = mf.sharedMesh.bounds;
            mapW = Mathf.Max(1.0f, Mathf.Abs(b.size.x * scale.x));
            mapH = Mathf.Max(1.0f, Mathf.Abs(b.size.z * scale.z));
        }
    }

    float dt = Time.unscaledTime / 46.0f;
    float dx = (_pivot.x * 8.0f) / mapW;
    float dy = (_pivot.z * 4.0f) / mapH;
    _waterReflectionUvST = new Vector4(0.85f, 0.85f, dx + dt * 0.015f, dy + dt * 0.011f);
    _waterReflectionProjectiveActive = false;
    _waterReflectionProjectiveMatrix = Matrix4x4.identity;

    string writer;
    _lastWaterReflectionMode = DescribeWaterReflectionMode(WaterReflectionMode.FallbackSkyCopy);
    if (_waterReflectionCopyMaterial != null)
    {
        _waterReflectionCopyMaterial.SetTexture("_MainTex", _waterSkyFallback);
        if (_waterReflectionCopyMaterial.HasProperty("_UvST"))
            _waterReflectionCopyMaterial.SetVector("_UvST", _waterReflectionUvST);
        if (_waterReflectionCopyMaterial.HasProperty("_DiffuseColor"))
            _waterReflectionCopyMaterial.SetColor("_DiffuseColor", new Color32(255,255,255,255));
        Graphics.Blit(_waterSkyFallback, _waterReflectionTarget, _waterReflectionCopyMaterial);
        writer = "fallback-blit(copy-shader)";
    }
    else
    {
        Graphics.Blit(_waterSkyFallback, _waterReflectionTarget);
        writer = "fallback-blit(raw)";
    }

    _lastWaterReflectionWriter = writer;
    _lastWaterReflectionTargetState = DescribeRenderTextureState(_waterReflectionTarget);
    _lastWaterReflectionAssignedTex = GetTextureDebugName(_waterReflectionTarget);
    _lastWaterReflectionFallbackTex = GetTextureDebugName(_waterSkyFallback);
    _lastWaterReflectionInfo = $"reflectionMode={_lastWaterReflectionMode} writer={writer} projectiveActive={_waterReflectionProjectiveActive} targetState={_lastWaterReflectionTargetState} fallback={_lastWaterReflectionFallbackTex} assigned={_lastWaterReflectionAssignedTex} uvST={_waterReflectionUvST} updateTime={_lastWaterReflectionTime:0.000} force={force}";
    if (force)
        Debug.Log("[C2:WATER] reflectionUpdate " + _lastWaterReflectionInfo);
}

private void ApplyWaterReflectionParams(bool forceLog)
{
    if (_waterMaterial == null)
        return;

    Texture reflectionTex = (_waterReflectionTarget != null && _waterReflectionTarget.IsCreated()) ? (Texture)_waterReflectionTarget : _waterSkyFallback;
    reflectionTex = GetWaterReflectionTextureWithCloudLayer(_selectedId, reflectionTex);
    if (_waterMaterial.HasProperty("_ReflectionTex"))
        _waterMaterial.SetTexture("_ReflectionTex", reflectionTex);
    if (_waterMaterial.HasProperty("_PlanarReflectionTex"))
        _waterMaterial.SetTexture("_PlanarReflectionTex", reflectionTex);
    if (_waterMaterial.HasProperty("_ReflectionFallbackTex"))
        _waterMaterial.SetTexture("_ReflectionFallbackTex", _waterSkyFallback);
    if (_waterMaterial.HasProperty("_ReflectionUvST"))
        _waterMaterial.SetVector("_ReflectionUvST", _waterReflectionUvST);

    ApplyReflectionProjectiveParamsToMaterial(_waterMaterial, _waterReflectionProjectiveActive);
    ApplyReflectionDebugParamsToMaterial(_waterMaterial);

    float reflectionStrength = _waterReflectionProjectiveActive ? 0.48f : 0.26f;
    float reflectionMix = _waterReflectionProjectiveActive ? 0.82f : 0.52f;
    float reflectionSkyBlend = _waterReflectionProjectiveActive ? 0.56f : 0.28f;
    float reflectionRealBlend = _waterReflectionProjectiveActive ? 0.58f : 0.00f;
    if (_waterUsesStaticFallbackData)
    {
        reflectionStrength += _waterReflectionProjectiveActive ? 0.08f : 0.04f;
        reflectionMix += _waterReflectionProjectiveActive ? 0.06f : 0.04f;
        reflectionSkyBlend += _waterReflectionProjectiveActive ? 0.10f : 0.08f;
        reflectionRealBlend = _waterReflectionProjectiveActive ? 0.46f : 0.00f;
    }

    if (_waterMaterial.HasProperty("_ReflectionStrength"))
        _waterMaterial.SetFloat("_ReflectionStrength", reflectionStrength);
    if (_waterMaterial.HasProperty("_ReflectionMix"))
        _waterMaterial.SetFloat("_ReflectionMix", reflectionMix);

    if (_waterMaterial.HasProperty("_ReflectionSkyBlend"))
        _waterMaterial.SetFloat("_ReflectionSkyBlend", reflectionSkyBlend);
    if (_waterMaterial.HasProperty("_ReflectionRealBlend"))
        _waterMaterial.SetFloat("_ReflectionRealBlend", reflectionRealBlend);

    _lastWaterReflectionAssignedTex = GetTextureDebugName(reflectionTex);
    _lastWaterReflectionFallbackTex = GetTextureDebugName(_waterSkyFallback);
    _lastWaterReflectionTargetState = DescribeRenderTextureState(_waterReflectionTarget);

    if (forceLog)
        Debug.Log($"[C2:WATER] reflectionApply mode={_lastWaterReflectionMode} projectiveActive={_waterReflectionProjectiveActive} skyLayered={_waterReflectionProjectiveActive} visualStage=tuning-v1 riverStage=polish-static-fallback-v1 stabilityStage=stage10-hardened-v1 staticFallback={_waterUsesStaticFallbackData} targetState={_lastWaterReflectionTargetState} fallback={_lastWaterReflectionFallbackTex} assigned={_lastWaterReflectionAssignedTex} materialAssigned={GetWaterTexDebugName(_waterMaterial, "_ReflectionTex")} writer={_lastWaterReflectionWriter} uvST={_waterReflectionUvST}");
}




private void ApplyReflectionProjectiveParamsToMaterial(Material mat, bool active)
{
    if (mat == null)
        return;

    if (mat.HasProperty("_ReflectionProjectiveActive"))
        mat.SetFloat("_ReflectionProjectiveActive", active ? 1.0f : 0.0f);
    if (mat.HasProperty("_ReflectionProjRow0"))
        mat.SetVector("_ReflectionProjRow0", GetMatrixRow(_waterReflectionProjectiveMatrix, 0));
    if (mat.HasProperty("_ReflectionProjRow1"))
        mat.SetVector("_ReflectionProjRow1", GetMatrixRow(_waterReflectionProjectiveMatrix, 1));
    if (mat.HasProperty("_ReflectionProjRow2"))
        mat.SetVector("_ReflectionProjRow2", GetMatrixRow(_waterReflectionProjectiveMatrix, 2));
    if (mat.HasProperty("_ReflectionProjRow3"))
        mat.SetVector("_ReflectionProjRow3", GetMatrixRow(_waterReflectionProjectiveMatrix, 3));
}

private void ApplyReflectionDebugParamsToMaterial(Material mat)
{
    if (mat == null)
        return;

    EnsureExternalWaterPresetInitialized();
    var p = s_externalWaterPreset;
    if (p == null)
        return;

    if (mat.HasProperty("_ReflectionDebugFallbackRotateDeg"))
        mat.SetFloat("_ReflectionDebugFallbackRotateDeg", p.ReflectionFallbackRotateDeg);
    if (mat.HasProperty("_ReflectionDebugFallbackFlipX"))
        mat.SetFloat("_ReflectionDebugFallbackFlipX", p.ReflectionFallbackFlipX ? 1.0f : 0.0f);
    if (mat.HasProperty("_ReflectionDebugFallbackFlipY"))
        mat.SetFloat("_ReflectionDebugFallbackFlipY", p.ReflectionFallbackFlipY ? 1.0f : 0.0f);
    if (mat.HasProperty("_ReflectionDebugProjectiveRotateDeg"))
        mat.SetFloat("_ReflectionDebugProjectiveRotateDeg", p.ReflectionProjectiveRotateDeg);
    if (mat.HasProperty("_ReflectionDebugProjectiveFlipX"))
        mat.SetFloat("_ReflectionDebugProjectiveFlipX", p.ReflectionProjectiveFlipX ? 1.0f : 0.0f);
    if (mat.HasProperty("_ReflectionDebugProjectiveFlipY"))
        mat.SetFloat("_ReflectionDebugProjectiveFlipY", p.ReflectionProjectiveFlipY ? 1.0f : 0.0f);
}

private static Vector4 GetMatrixRow(Matrix4x4 m, int row)
{
    switch (row)
    {
        case 0: return new Vector4(m.m00, m.m01, m.m02, m.m03);
        case 1: return new Vector4(m.m10, m.m11, m.m12, m.m13);
        case 2: return new Vector4(m.m20, m.m21, m.m22, m.m23);
        default: return new Vector4(m.m30, m.m31, m.m32, m.m33);
    }
}

private void EnsureWaterReflectionCamera(string selectedId)
{
    if (_waterReflectionCamera != null)
        return;

    _waterReflectionCameraGo = new GameObject(string.IsNullOrWhiteSpace(selectedId) ? "C2_WaterReflectionCamera" : (selectedId + "_WaterReflectionCamera"));
    _waterReflectionCameraGo.hideFlags = HideFlags.HideAndDontSave;
    _waterReflectionCameraGo.transform.SetParent(transform, false);
    _waterReflectionCamera = _waterReflectionCameraGo.AddComponent<Camera>();
    _waterReflectionCamera.enabled = false;
    _waterReflectionCamera.allowHDR = false;
    _waterReflectionCamera.allowMSAA = false;
    _waterReflectionCamera.useOcclusionCulling = false;
    _waterReflectionCamera.depthTextureMode = DepthTextureMode.None;
    Debug.Log($"[C2:WATER] reflectionCameraCreate name={_waterReflectionCameraGo.name}");
}

private bool TryRenderRealWaterReflection(bool force, out string writer)
{
    writer = "real-camera-unavailable";
    if (_camera == null || _waterReflectionTarget == null)
        return false;

    EnsureWaterReflectionCamera(_selectedId);
    if (_waterReflectionCamera == null)
        return false;

    float planeY = GetWaterPlaneY();
    Vector3 planePos = new Vector3(0.0f, planeY, 0.0f);
    Vector3 planeNormal = Vector3.up;

    _waterReflectionCamera.CopyFrom(_camera);
    _waterReflectionCamera.enabled = false;
    _waterReflectionCamera.targetTexture = _waterReflectionTarget;
    _waterReflectionCamera.useOcclusionCulling = false;
    _waterReflectionCamera.allowHDR = false;
    _waterReflectionCamera.allowMSAA = false;
    _waterReflectionCamera.cullingMask = _camera.cullingMask;

    Matrix4x4 reflection = Matrix4x4.zero;
    CalculateReflectionMatrix(ref reflection, new Vector4(planeNormal.x, planeNormal.y, planeNormal.z, -Vector3.Dot(planeNormal, planePos) - 0.05f));

    Vector3 oldpos = _camera.transform.position;
    Vector3 newpos = reflection.MultiplyPoint(oldpos);
    _waterReflectionCamera.worldToCameraMatrix = _camera.worldToCameraMatrix * reflection;

    Vector4 clipPlane = CameraSpacePlane(_waterReflectionCamera, planePos, planeNormal, 1.0f, 0.05f);
    Matrix4x4 projection = _camera.CalculateObliqueMatrix(clipPlane);
    _waterReflectionCamera.projectionMatrix = projection;
    Matrix4x4 gpuProjection = GL.GetGPUProjectionMatrix(projection, true);
    _waterReflectionProjectiveMatrix = gpuProjection * _waterReflectionCamera.worldToCameraMatrix;
    _waterReflectionCamera.transform.position = newpos;

    Vector3 euler = _camera.transform.eulerAngles;
    _waterReflectionCamera.transform.eulerAngles = new Vector3(-euler.x, euler.y, euler.z);

    Renderer waterRenderer = _waterGo != null ? _waterGo.GetComponent<Renderer>() : null;
    bool oldWaterEnabled = waterRenderer != null && waterRenderer.enabled;

    bool oldInvert = GL.invertCulling;
    try
    {
        if (waterRenderer != null)
            waterRenderer.enabled = false;
        GL.invertCulling = true;
        _waterReflectionCamera.Render();
        writer = $"real-camera-render planeY={planeY:0.000} cam={_waterReflectionCamera.name} srcCam={_camera.name} rt={DescribeRenderTextureState(_waterReflectionTarget)} proj=projective-vp";
        if (force)
            Debug.Log($"[C2:WATER] reflectionRender {writer}");
        return true;
    }
    catch (Exception ex)
    {
        writer = "real-camera-ex=" + ex.GetType().Name;
        Debug.LogWarning("[C2:WATER] reflectionRender failed " + writer + " msg=" + ex.Message);
        return false;
    }
    finally
    {
        GL.invertCulling = oldInvert;
        if (waterRenderer != null)
            waterRenderer.enabled = oldWaterEnabled;
        _waterReflectionCamera.targetTexture = null;
    }
}

private float GetWaterPlaneY()
{
    if (_waterGo != null)
    {
        var mf = _waterGo.GetComponent<MeshFilter>();
        if (mf != null && mf.sharedMesh != null)
        {
            Bounds b = mf.sharedMesh.bounds;
            return _waterGo.transform.TransformPoint(new Vector3(0.0f, b.center.y, 0.0f)).y;
        }
        return _waterGo.transform.position.y;
    }
    return WaterOverlayYOffset * VerticalScale;
}

private static Vector4 CameraSpacePlane(Camera cam, Vector3 pos, Vector3 normal, float sideSign, float clipPlaneOffset)
{
    Vector3 offsetPos = pos + normal * clipPlaneOffset;
    Matrix4x4 m = cam.worldToCameraMatrix;
    Vector3 cpos = m.MultiplyPoint(offsetPos);
    Vector3 cnormal = m.MultiplyVector(normal).normalized * sideSign;
    return new Vector4(cnormal.x, cnormal.y, cnormal.z, -Vector3.Dot(cpos, cnormal));
}

private static void CalculateReflectionMatrix(ref Matrix4x4 reflectionMat, Vector4 plane)
{
    reflectionMat.m00 = (1F - 2F * plane[0] * plane[0]);
    reflectionMat.m01 = (-2F * plane[0] * plane[1]);
    reflectionMat.m02 = (-2F * plane[0] * plane[2]);
    reflectionMat.m03 = (-2F * plane[3] * plane[0]);

    reflectionMat.m10 = (-2F * plane[1] * plane[0]);
    reflectionMat.m11 = (1F - 2F * plane[1] * plane[1]);
    reflectionMat.m12 = (-2F * plane[1] * plane[2]);
    reflectionMat.m13 = (-2F * plane[3] * plane[1]);

    reflectionMat.m20 = (-2F * plane[2] * plane[0]);
    reflectionMat.m21 = (-2F * plane[2] * plane[1]);
    reflectionMat.m22 = (1F - 2F * plane[2] * plane[2]);
    reflectionMat.m23 = (-2F * plane[3] * plane[2]);

    reflectionMat.m30 = 0F;
    reflectionMat.m31 = 0F;
    reflectionMat.m32 = 0F;
    reflectionMat.m33 = 1F;
}

private static string GetWaterTexDebugName(Material mat, string propName)
{
    if (mat == null || string.IsNullOrEmpty(propName) || !mat.HasProperty(propName)) return "<missing>";
    var t = mat.GetTexture(propName);
    return t != null ? t.name : "<null>";
}

private void SetupWaterMapDataTextures(string selectedId, Material mat)
{
    ReleaseWaterMapDataTextures();
    _lastWaterMapDataInfo = "mapStage=rgbw-riv1-driven-v1 textures=<none>";

    var water = _map != null ? _map.Water : null;
    _waterUsesStaticFallbackData = false;
    if (water == null || mat == null)
    {
        Debug.Log("[C2:WATER] mapStage=rgbw-riv1-driven-v1 skipped reason=no-water-or-mat");
        return;
    }

    _waterSeaDataTex = CreateWaterSeaDataTexture(selectedId, water);
    _waterFlowDataTex = CreateWaterFlowDataTexture(selectedId, water);
    _waterRiverDataTex = CreateWaterRiverDataTexture(selectedId, water);

    if (mat.HasProperty("_SeaDataTex"))
        mat.SetTexture("_SeaDataTex", _waterSeaDataTex != null ? (Texture)_waterSeaDataTex : Texture2D.grayTexture);
    if (mat.HasProperty("_FlowDataTex"))
        mat.SetTexture("_FlowDataTex", _waterFlowDataTex != null ? (Texture)_waterFlowDataTex : Texture2D.grayTexture);
    if (mat.HasProperty("_RiverDataTex"))
        mat.SetTexture("_RiverDataTex", _waterRiverDataTex != null ? (Texture)_waterRiverDataTex : Texture2D.blackTexture);

    if (mat.HasProperty("_MapDataStrength"))
        mat.SetFloat("_MapDataStrength", 0.82f);
    if (mat.HasProperty("_MapFlowStrength"))
        mat.SetFloat("_MapFlowStrength", 0.92f);
    if (mat.HasProperty("_RiverStrength"))
        mat.SetFloat("_RiverStrength", 0.88f);
    if (mat.HasProperty("_LevelStrength"))
        mat.SetFloat("_LevelStrength", 0.40f);
    if (mat.HasProperty("_RefSurfStrength"))
        mat.SetFloat("_RefSurfStrength", 0.36f);
    if (mat.HasProperty("_RefSurfContrast"))
        mat.SetFloat("_RefSurfContrast", 1.25f);
    if (mat.HasProperty("_RefSurfShoreBoost"))
        mat.SetFloat("_RefSurfShoreBoost", 0.46f);
    if (mat.HasProperty("_RefSurfDepthBoost"))
        mat.SetFloat("_RefSurfDepthBoost", 0.18f);
    Debug.Log("[C2:WATER] surfStage=refsurf-terrainlift-v1 visualStage=tuning-v1 strength=0.36 contrast=1.25 shoreBoost=0.46 depthBoost=0.18 mapData=0.82 flow=0.92 river=0.88 level=0.40");

    string seaTex = _waterSeaDataTex != null ? GetTextureDebugName(_waterSeaDataTex) : "<null>";
    string flowTex = _waterFlowDataTex != null ? GetTextureDebugName(_waterFlowDataTex) : "<null>";
    string riverTex = _waterRiverDataTex != null ? GetTextureDebugName(_waterRiverDataTex) : "<null>";
    int flowNz = CountNonZero(water.Vx) + CountNonZero(water.Vy);
    int levelNz = CountNonZero(water.Level);
    _waterUsesStaticFallbackData = flowNz == 0 && levelNz == 0 && water.RivDirNonZeroCount == 0 && water.RivVolNonZeroCount == 0;
    _lastWaterMapDataInfo = $"mapStage=rgbw-riv1-driven-v1 visualStage=tuning-v1 stabilityStage=stage10-hardened-v1 seaTex={seaTex} flowTex={flowTex} riverTex={riverTex} seaNz={water.SeaDeepNonZeroCount}/{water.SeaBrightNonZeroCount} flowNz={flowNz} levelNz={levelNz} riverNz={water.RivDirNonZeroCount}/{water.RivVolNonZeroCount}";
    Debug.Log("[C2:WATER] " + _lastWaterMapDataInfo);
    if (_waterUsesStaticFallbackData)
        Debug.Log("[C2:WATER] riverStage=polish-static-fallback-v1 source=static-fallback reason=rgbw-flow-and-riv1-empty");
}

private void ApplyWaterStabilityProfile(Material mat)
{
    if (mat == null)
        return;

    if (_waterUsesStaticFallbackData)
    {
        if (mat.HasProperty("_MinVisibleAlpha"))
            mat.SetFloat("_MinVisibleAlpha", 0.0f);
        if (mat.HasProperty("_StaticFlowFallback"))
            mat.SetFloat("_StaticFlowFallback", 0.28f);
        if (mat.HasProperty("_StaticFlowFreq"))
            mat.SetFloat("_StaticFlowFreq", 0.0024f);
        if (mat.HasProperty("_StaticFlowSpeed"))
            mat.SetFloat("_StaticFlowSpeed", 0.58f);
        if (mat.HasProperty("_StaticFlowDistort"))
            mat.SetFloat("_StaticFlowDistort", 0.020f);
        if (mat.HasProperty("_RiverStrength"))
            mat.SetFloat("_RiverStrength", 1.04f);
        if (mat.HasProperty("_RiverLineStrength"))
            mat.SetFloat("_RiverLineStrength", 0.46f);
        if (mat.HasProperty("_RefSurfStrength"))
            mat.SetFloat("_RefSurfStrength", 0.24f);
        if (mat.HasProperty("_RefSurfContrast"))
            mat.SetFloat("_RefSurfContrast", 1.10f);
        if (mat.HasProperty("_TintStrength"))
            mat.SetFloat("_TintStrength", 0.60f);
        if (mat.HasProperty("_AlphaStrength"))
            mat.SetFloat("_AlphaStrength", 1.02f);
        Debug.Log("[C2:WATER] stabilityStage=stage10-hardened-v1 profile=static-data-map minAlpha=0.30 staticFlow=0.28 staticFreq=0.0024 staticSpeed=0.58 staticDistort=0.020 river=1.04 line=0.46 refSurf=0.24 tint=0.60 alpha=1.02");
    }
    else
    {
        Debug.Log("[C2:WATER] stabilityStage=stage10-hardened-v1 profile=dynamic-data-map minAlpha=0.24 staticFlow=0.20 refSurf=0.36");
    }
}

private void ReleaseWaterMapDataTextures()
{
    if (_waterSeaDataTex != null)
    {
        Debug.Log($"[C2:WATER] seaDataTexRelease tex={GetTextureDebugName(_waterSeaDataTex)}");
        Destroy(_waterSeaDataTex);
        _waterSeaDataTex = null;
    }
    if (_waterFlowDataTex != null)
    {
        Debug.Log($"[C2:WATER] flowDataTexRelease tex={GetTextureDebugName(_waterFlowDataTex)}");
        Destroy(_waterFlowDataTex);
        _waterFlowDataTex = null;
    }
    if (_waterRiverDataTex != null)
    {
        Debug.Log($"[C2:WATER] riverDataTexRelease tex={GetTextureDebugName(_waterRiverDataTex)}");
        Destroy(_waterRiverDataTex);
        _waterRiverDataTex = null;
    }
}

private static Texture2D CreateWaterSeaDataTexture(string selectedId, C2WaterData water)
{
    if (water == null || water.WaterDeep == null || water.WaterBright == null || water.SeaLx <= 0 || water.SeaLy <= 0)
        return null;

    int width = water.SeaLx;
    int height = water.SeaLy;
    var tex = new Texture2D(width, height, TextureFormat.RGBA32, false, true);
    tex.name = string.IsNullOrWhiteSpace(selectedId) ? "water_sea_data" : (selectedId + "_water_sea_data");
    tex.wrapMode = TextureWrapMode.Clamp;
    tex.filterMode = FilterMode.Bilinear;
    Color32[] pixels = new Color32[width * height];
    for (int i = 0; i < pixels.Length; i++)
    {
        byte deep = i < water.WaterDeep.Length ? water.WaterDeep[i] : (byte)0;
        byte bright = i < water.WaterBright.Length ? water.WaterBright[i] : (byte)0;
        pixels[i] = new Color32(deep, bright, 255, 255);
    }
    tex.SetPixels32(pixels);
    tex.Apply(false, false);
    Debug.Log($"[C2:WATER] seaDataTex tex={GetTextureDebugName(tex)} size={width}x{height} deepNz={water.SeaDeepNonZeroCount} brightNz={water.SeaBrightNonZeroCount}");
    return tex;
}

private static Texture2D CreateWaterFlowDataTexture(string selectedId, C2WaterData water)
{
    if (water == null || water.RgbSize <= 0 || water.Red == null || water.Green == null || water.Blue == null)
        return null;

    int width = Mathf.Max(1, water.RgbSize);
    int height = Mathf.Max(1, water.RgbSize);
    var tex = new Texture2D(width, height, TextureFormat.RGBA32, false, true);
    tex.name = string.IsNullOrWhiteSpace(selectedId) ? "water_flow_data" : (selectedId + "_water_flow_data");
    tex.wrapMode = TextureWrapMode.Clamp;
    tex.filterMode = FilterMode.Bilinear;

    float maxAbsFlow = 1.0f;
    if (water.Vx != null)
        foreach (short v in water.Vx) maxAbsFlow = Mathf.Max(maxAbsFlow, Mathf.Abs(v));
    if (water.Vy != null)
        foreach (short v in water.Vy) maxAbsFlow = Mathf.Max(maxAbsFlow, Mathf.Abs(v));

    short minLevel = 0, maxLevel = 0;
    bool hasLevel = water.Level != null && water.Level.Length > 0;
    if (hasLevel)
    {
        minLevel = short.MaxValue;
        maxLevel = short.MinValue;
        foreach (short v in water.Level)
        {
            if (v < minLevel) minLevel = v;
            if (v > maxLevel) maxLevel = v;
        }
    }

    Color32[] pixels = new Color32[width * height];
    for (int i = 0; i < pixels.Length; i++)
    {
        short vx = (water.Vx != null && i < water.Vx.Length) ? water.Vx[i] : (short)0;
        short vy = (water.Vy != null && i < water.Vy.Length) ? water.Vy[i] : (short)0;
        short lvl = (water.Level != null && i < water.Level.Length) ? water.Level[i] : (short)0;
        float nx = Mathf.Clamp(vx / maxAbsFlow, -1.0f, 1.0f);
        float ny = Mathf.Clamp(vy / maxAbsFlow, -1.0f, 1.0f);
        float mag = Mathf.Clamp01(Mathf.Sqrt(nx * nx + ny * ny));
        float level01 = 0.5f;
        if (hasLevel && maxLevel != minLevel)
            level01 = Mathf.InverseLerp(minLevel, maxLevel, lvl);
        pixels[i] = new Color32((byte)Mathf.RoundToInt((nx * 0.5f + 0.5f) * 255.0f), (byte)Mathf.RoundToInt((ny * 0.5f + 0.5f) * 255.0f), (byte)Mathf.RoundToInt(level01 * 255.0f), (byte)Mathf.RoundToInt(mag * 255.0f));
    }

    tex.SetPixels32(pixels);
    tex.Apply(false, false);
    Debug.Log($"[C2:WATER] flowDataTex tex={GetTextureDebugName(tex)} size={width}x{height} flowNz={CountNonZero(water.Vx) + CountNonZero(water.Vy)} levelNz={CountNonZero(water.Level)} maxAbsFlow={maxAbsFlow:0.###} levelRange={minLevel}..{maxLevel}");
    return tex;
}

private static Texture2D CreateWaterRiverDataTexture(string selectedId, C2WaterData water)
{
    if (water == null || water.RivSize <= 0 || water.RivDir == null || water.RivVol == null)
        return null;

    int width = water.RivSize;
    int height = water.RivSize;
    var tex = new Texture2D(width, height, TextureFormat.RGBA32, false, true);
    tex.name = string.IsNullOrWhiteSpace(selectedId) ? "water_river_data" : (selectedId + "_water_river_data");
    tex.wrapMode = TextureWrapMode.Clamp;
    tex.filterMode = FilterMode.Bilinear;
    Color32[] pixels = new Color32[width * height];
    for (int i = 0; i < pixels.Length; i++)
    {
        byte dir = i < water.RivDir.Length ? water.RivDir[i] : (byte)0;
        byte vol = i < water.RivVol.Length ? water.RivVol[i] : (byte)0;
        byte mask = (byte)Mathf.Clamp(vol > 0 ? Mathf.Max(vol, 24) : 0, 0, 255);
        pixels[i] = new Color32(dir, vol, mask, 255);
    }
    tex.SetPixels32(pixels);
    tex.Apply(false, false);
    Debug.Log($"[C2:WATER] riverDataTex tex={GetTextureDebugName(tex)} size={width}x{height} dirNz={water.RivDirNonZeroCount} volNz={water.RivVolNonZeroCount}");
    return tex;
}

private static int CountNonZero(short[] data)
{
    if (data == null) return 0;
    int nz = 0;
    for (int i = 0; i < data.Length; i++) if (data[i] != 0) nz++;
    return nz;
}

private void OnDestroy()
{
    ReleaseTerrainRuntimeOwnedObjects();
    if (_waterReflectionCameraGo != null)
    {
        Debug.Log($"[C2:WATER] reflectionCameraRelease name={_waterReflectionCameraGo.name}");
        Destroy(_waterReflectionCameraGo);
        _waterReflectionCameraGo = null;
        _waterReflectionCamera = null;
    }

    if (_waterReflectionTarget != null)
    {
        Debug.Log($"[C2:WATER] reflectionTargetRelease target={DescribeRenderTextureState(_waterReflectionTarget)}");
        _waterReflectionTarget.Release();
        Destroy(_waterReflectionTarget);
        _waterReflectionTarget = null;
    }

    if (_waterCloudCompositeTarget != null)
    {
        Debug.Log($"[C2:WATER] cloudReflectionTargetRelease target={DescribeRenderTextureState(_waterCloudCompositeTarget)}");
        _waterCloudCompositeTarget.Release();
        Destroy(_waterCloudCompositeTarget);
        _waterCloudCompositeTarget = null;
    }

    if (_waterCloudCompositeMaterial != null)
    {
        Debug.Log($"[C2:WATER] cloudReflectionMaterialRelease material={_waterCloudCompositeMaterial.name}");
        Destroy(_waterCloudCompositeMaterial);
        _waterCloudCompositeMaterial = null;
    }

    if (_waterReflectionCopyMaterial != null)
    {
        Debug.Log($"[C2:WATER] reflectionCopyMaterialRelease material={_waterReflectionCopyMaterial.name}");
        Destroy(_waterReflectionCopyMaterial);
        _waterReflectionCopyMaterial = null;
    }

    if (_roadOverlayMaterial != null)
    {
        Destroy(_roadOverlayMaterial);
        _roadOverlayMaterial = null;
    }

    ReleaseWaterMapDataTextures();
}

        private int SampleMapHeightLikeOriginal(int worldX, int worldZ)
        {
            if (_map == null || _map.Heights == null || _map.Heights.Length == 0 || _map.IsMeshSurface)
                return 0;

            float invScale = Math.Abs(HorizontalScale) > 0.0001f ? (1.0f / HorizontalScale) : 1.0f;
            float ux = worldX * invScale;
            float uz = worldZ * invScale;

            int baseCol = Mathf.RoundToInt(ux / 32.0f);
            int bestCol = 0;
            int bestRow = 0;
            float bestDist = float.MaxValue;

            for (int dc = -1; dc <= 1; dc++)
            {
                int col = Mathf.Clamp(baseCol + dc, 0, Math.Max(0, _map.VertInLine - 1));
                float rowF = (uz + (((col & 1) != 0) ? 16.0f : 0.0f)) / 32.0f;
                int row0 = Mathf.FloorToInt(rowF);
                int row1 = row0 + 1;
                for (int row = row0; row <= row1; row++)
                {
                    int rr = Mathf.Clamp(row, 0, Math.Max(0, _map.MaxTH - 1));
                    float vx = col * 32.0f;
                    float vz = rr * 32.0f + (((col & 1) != 0) ? -16.0f : 0.0f);
                    float dx = vx - ux;
                    float dz = vz - uz;
                    float d2 = dx * dx + dz * dz;
                    if (d2 < bestDist)
                    {
                        bestDist = d2;
                        bestCol = col;
                        bestRow = rr;
                    }
                }
            }

            return _map.GetVertexHeight(bestCol, bestRow);
        }

        private void RebuildTerrainMaterialForCurrentMode(bool forceLog)
        {
            if (_preparedTerrainMesh == null || string.IsNullOrWhiteSpace(_selectedId))
                return;

            if (_terrainGo != null)
                SafeDestroy(_terrainGo);
            _terrainGo = null;
            CreateTerrainObject(_selectedId, _preparedTerrainMesh);

            if (forceLog)
            {
                if (ForcePlainWhiteGeometryOnly)
                {
                    Debug.Log($"[C2:REN] terrainMode=plain-white-geometry {_lastTerrainBuildInfo}");
                    Debug.Log($"[C2:REN] shaderSupported={_terrainMaterial?.shader?.isSupported ?? false} passCount={_terrainMaterial?.passCount ?? -1} rp={DescribeCurrentRenderPipeline()}");
                    Debug.Log($"[C2:REN] terrainPipeline path=irs-submit-prebuilt-streams; rebuild=1; perDrawMeshRebuild=0; setVertexPtr=stream-switch-only; water=deleted; bounds=deleted; roads=deleted; overlay=deleted");
                    Debug.Log($"[C2:AXIS] worldZSign={WorldZSign:0}; rebuild=1; isMeshSurface={(_map != null && _map.IsMeshSurface ? 1 : 0)}");
                }
                else
                {
                    Debug.Log($"[C2:REN] terrainMode={_terrainDebugMode} ({DescribeTerrainMode(_terrainDebugMode)}) {_lastTerrainBuildInfo}");
                    Debug.Log($"[C2:REN] shaderSupported={_terrainMaterial?.shader?.isSupported ?? false} passCount={_terrainMaterial?.passCount ?? -1} rp={DescribeCurrentRenderPipeline()}");
                    Debug.Log("[C2:REN] terrainPipeline " + BuildTerrainPipelineDiagnostics(_terrainDebugMode, _selectedId, _preparedTerrainMesh));
                    Debug.Log($"[C2:AXIS] worldZSign={WorldZSign:0}; rebuild=1; isMeshSurface={(_map != null && _map.IsMeshSurface ? 1 : 0)}");
                }
            }

            UpdateRuntimeHud(true);
        }


        private static string BuildTerrainDataDiagnostics(ParsedMap map)
        {
            if (map == null)
                return "map=null";

            int tileWidth = Math.Max(1, map.TileWidth > 0 ? map.TileWidth : map.VertInLine);
            int tileHeight = Math.Max(1, map.TileHeight > 0 ? map.TileHeight : map.MaxTH);
            int expectedTiles = tileWidth * tileHeight;
            int expectedHeights = Math.Max(0, (map.MaxTH + 1) * map.MaxTH);
            int heightLen = map.Heights != null ? map.Heights.Length : 0;
            int tileLen = map.TilePrimary != null ? map.TilePrimary.Length : 0;
            int tile2Len = map.TileSecondary != null ? map.TileSecondary.Length : 0;
            int fmapLen = map.FactureMap != null ? map.FactureMap.Length : 0;
            int optionsLen = map.Options != null ? map.Options.Length : 0;

            return
                $"mode={(map.IsMeshSurface ? "HSEM" : "SURF")}; " +
                $"tileGrid={tileWidth}x{tileHeight}; expectedTiles={expectedTiles}; " +
                $"heights={heightLen}/{expectedHeights}; tile={tileLen}/{expectedTiles}; tile2={tile2Len}/{expectedTiles}; fmap={fmapLen}/{expectedTiles}; options={optionsLen}; " +
                $"meshVerts={(map.MeshVertices != null ? map.MeshVertices.Length : 0)}; meshIdx={(map.MeshIndices != null ? map.MeshIndices.Length : 0)}; " +
                $"waterChunks={(map.Water != null ? $"sea2={(map.Water.HasSea2Payload ? 1 : 0)},rgbw={(map.Water.HasRgbwPayload ? 1 : 0)},riv1={(map.Water.HasRiv1Payload ? 1 : 0)}" : "none")}";
        }

        private static string BuildTerrainExpectedDiagnostics(ParsedMap map)
        {
            if (map == null)
                return "map=null";

            int tileWidth = Math.Max(1, map.TileWidth > 0 ? map.TileWidth : map.VertInLine);
            int tileHeight = Math.Max(1, map.TileHeight > 0 ? map.TileHeight : map.MaxTH);
            int step = Math.Max(1, OldSurfaceStep);

            int sampledCols = map.IsMeshSurface ? (map.MeshVertices != null ? map.MeshVertices.Length : 0) : BuildSampledIndices(map.VertInLine, step).Count;
            int sampledRows = map.IsMeshSurface ? 0 : BuildSampledIndices(map.MaxTH, step).Count;
            int expectedVerts = map.IsMeshSurface
                ? (map.MeshVertices != null ? map.MeshVertices.Length : 0)
                : sampledCols * sampledRows;
            int expectedTris = map.IsMeshSurface
                ? ((map.MeshIndices != null ? map.MeshIndices.Length : 0) / 3)
                : Math.Max(0, (sampledCols - 1) * (sampledRows - 1) * 2);

            return
                $"oldSurfaceStep={step}; " +
                $"surfGrid={map.VertInLine}x{map.MaxTH}; tileGrid={tileWidth}x{tileHeight}; " +
                $"sampledGrid={(map.IsMeshSurface ? "mesh-native" : sampledCols + "x" + sampledRows)}; " +
                $"expectedMeshVerts={expectedVerts}; expectedMeshTris={expectedTris}; " +
                $"horizontalScale={HorizontalScale:0.###}; verticalScale={VerticalScale:0.###}";
        }

        private static string BuildTerrainMeshDiagnostics(ParsedMap map, Mesh mesh)
        {
            if (map == null)
                return "map=null";
            if (mesh == null)
                return "mesh=null";

            Bounds b = mesh.bounds;
            int step = Math.Max(1, OldSurfaceStep);
            int sampledCols = map.IsMeshSurface ? -1 : BuildSampledIndices(map.VertInLine, step).Count;
            int sampledRows = map.IsMeshSurface ? -1 : BuildSampledIndices(map.MaxTH, step).Count;
            int fullVerts = (!map.IsMeshSurface && map.VertInLine > 0 && map.MaxTH > 0) ? map.VertInLine * map.MaxTH : 0;
            float density = (fullVerts > 0) ? ((float)mesh.vertexCount / fullVerts) : 1.0f;

            return
                $"path={(map.IsMeshSurface ? "mesh-surface" : "old-surface")}; " +
                $"step={(map.IsMeshSurface ? "n/a" : step.ToString())}; " +
                $"sampledGrid={(map.IsMeshSurface ? "mesh-native" : sampledCols + "x" + sampledRows)}; " +
                $"meshVerts={mesh.vertexCount}; meshTris={(mesh.triangles != null ? mesh.triangles.Length / 3 : 0)}; " +
                $"fullVertRef={(fullVerts > 0 ? fullVerts.ToString() : "n/a")}; density={(map.IsMeshSurface ? "native" : density.ToString("0.###", CultureInfo.InvariantCulture))}; " +
                $"boundsCenter={b.center}; boundsSize={b.size}";
        }

        private string BuildTerrainPipelineDiagnostics(int mode, string selectedId, Mesh terrainMesh)
        {
            mode = Mathf.Clamp(mode, 1, 7);
            string currentPolicy = _experimentalArrayPathEnabled ? "stage3-restart-experimental-toggle" : "preview-distinct-stage2";
            string stageLabel = DescribeTerrainMode(mode);
            GetTerrainModePreviewFlags(mode, out bool includeSecondary, out bool includeFacture, out string currentRenderPath);
            if (_experimentalArrayPathEnabled)
                currentRenderPath = "requested-array-" + currentRenderPath;

            bool tilePrimaryReady = _map != null && _map.TilePrimary != null && _map.TilePrimary.Length > 0;
            bool tileSecondaryReady = _map != null && _map.TileSecondary != null && _map.TileSecondary.Length > 0;
            bool factureReady = _map != null && _map.FactureMap != null && _map.FactureMap.Length > 0;
            bool supportsArray = SystemInfo.supports2DArrayTextures;

            string arrayShaderState;
            Shader arrayShader = Shader.Find("Cossacks2Bridge/TerrainArrayBlendPreview");
            if (arrayShader == null) arrayShaderState = "missing";
            else if (!arrayShader.isSupported) arrayShaderState = "unsupported";
            else arrayShaderState = "ok";

            int tileWidth = (_map != null) ? Math.Max(1, _map.TileWidth > 0 ? _map.TileWidth : _map.VertInLine) : 0;
            int tileHeight = (_map != null) ? Math.Max(1, _map.TileHeight > 0 ? _map.TileHeight : _map.MaxTH) : 0;
            int expectedTiles = tileWidth * tileHeight;
            int tileLen = (_map != null && _map.TilePrimary != null) ? _map.TilePrimary.Length : 0;

            string arrayCandidateReason;
            bool arrayCandidate;
            if (_map == null) { arrayCandidate = false; arrayCandidateReason = "map=null"; }
            else if (!tilePrimaryReady) { arrayCandidate = false; arrayCandidateReason = "tilePrimary-missing"; }
            else if (!supportsArray) { arrayCandidate = false; arrayCandidateReason = "2d-array-unsupported"; }
            else if (arrayShaderState != "ok") { arrayCandidate = false; arrayCandidateReason = "array-shader-" + arrayShaderState; }
            else if (tileLen < expectedTiles) { arrayCandidate = false; arrayCandidateReason = $"tilePrimary-short:{tileLen}/{expectedTiles}"; }
            else { arrayCandidate = true; arrayCandidateReason = _experimentalArrayPathEnabled ? "array-toggle-enabled" : "ready-for-stage3-enable"; }

            return
                $"map={selectedId}; mode={mode}({stageLabel}); policy={currentPolicy}; currentRenderPath={currentRenderPath}; " +
                $"arrayCandidate={(arrayCandidate ? "yes" : "no")}; reason={arrayCandidateReason}; " +
                $"tilePrimaryReady={(tilePrimaryReady ? 1 : 0)}; tileSecondaryReady={(tileSecondaryReady ? 1 : 0)}; factureReady={(factureReady ? 1 : 0)}; " +
                $"expectedTiles={expectedTiles}; tilePrimaryLen={tileLen}; supports2DArray={(supportsArray ? 1 : 0)}; arrayShader={arrayShaderState}; " +
                $"mesh={(terrainMesh != null ? terrainMesh.name : "<null>")}; meshVerts={(terrainMesh != null ? terrainMesh.vertexCount : 0)}; rp={DescribeCurrentRenderPipeline()}";
        }

        private static string DescribeTerrainMode(int mode)
        {
            switch (mode)
            {
                case 1: return "height-gray";
                case 2: return "tile-base";
                case 3: return "tile-plus-second";
                case 4: return "tile-plus-second-plus-facture";
                case 5: return "second-mask";
                case 6: return "facture-mask";
                case 7: return "base-index-falsecolor";
                default: return "unknown";
            }
        }

        private void CreateBoundsObject()
        {
            _boundsGo = new GameObject("MapBounds");
            _boundsGo.transform.SetParent(transform, false);

            var lr = _boundsGo.AddComponent<LineRenderer>();
            lr.positionCount = 5;
            lr.loop = false;
            lr.startWidth = 12.0f * HorizontalScale;
            lr.endWidth = 12.0f * HorizontalScale;
            lr.useWorldSpace = true;
            lr.alignment = LineAlignment.View;
            lr.textureMode = LineTextureMode.Stretch;
            lr.material = new Material(Shader.Find("Sprites/Default"));
            lr.startColor = lr.endColor = new Color32(220, 80, 60, 255);

            var p0 = MapCoordToWorld(_map.MinMapX, _map.MinMapY, 32.0f);
            var p1 = MapCoordToWorld(_map.MaxMapX, _map.MinMapY, 32.0f);
            var p2 = MapCoordToWorld(_map.MaxMapX, _map.MaxMapY, 32.0f);
            var p3 = MapCoordToWorld(_map.MinMapX, _map.MaxMapY, 32.0f);

            lr.SetPosition(0, p0);
            lr.SetPosition(1, p1);
            lr.SetPosition(2, p2);
            lr.SetPosition(3, p3);
            lr.SetPosition(4, p0);
        }

        private void BuildOverlay(string selectedId)
        {
            var go = new GameObject(OverlayCanvasName);
            _overlayCanvas = go.AddComponent<Canvas>();
            _overlayCanvas.renderMode = RenderMode.ScreenSpaceOverlay;
            _overlayCanvas.sortingOrder = 3000;

            var scaler = go.AddComponent<CanvasScaler>();
            scaler.uiScaleMode = CanvasScaler.ScaleMode.ScaleWithScreenSize;
            scaler.referenceResolution = new Vector2(1024.0f, 768.0f);
            scaler.screenMatchMode = CanvasScaler.ScreenMatchMode.MatchWidthOrHeight;
            scaler.matchWidthOrHeight = 0.5f;

            go.AddComponent<GraphicRaycaster>();
            EnsureEventSystem();

            CreateOverlayText(go.transform, "Info",
                $"Карта: {_selectedId}\nФайл: {_mapRelativePath}\nРежим: {(_map.IsMeshSurface ? "HSEM" : "SURF")}\nGrid: {_map.VertInLine} x {_map.MaxTH}\nBounds: {_map.MinMapX}, {_map.MinMapY} .. {_map.MaxMapX}, {_map.MaxMapY}",
                new Vector2(16.0f, -16.0f),
                new Vector2(520.0f, 120.0f),
                TextAnchor.UpperLeft,
                18,
                new Color32(245, 245, 235, 255));

            CreateOverlayText(go.transform, "Hint",
                $"Esc — назад\nКолесо — зум (Shift x10)\nПКМ + мышь — орбита\nСКМ/края/WASD — двигать карту\n1..7 — режимы terrain\nF — facture on/off\nHome — сброс камеры\nStep={Mathf.Max(1, OldSurfaceStep)}",
                new Vector2(16.0f, -140.0f),
                new Vector2(360.0f, 108.0f),
                TextAnchor.UpperLeft,
                16,
                new Color32(220, 220, 210, 255));

            _runtimeHudText = CreateOverlayText(go.transform, "RuntimeHud", "", new Vector2(16.0f, -260.0f), new Vector2(620.0f, 128.0f), TextAnchor.UpperLeft, 16, new Color32(255, 245, 210, 255));
            UpdateRuntimeHud(true);

            CreateOverlayButton(go.transform, "BackButton", "Назад", new Vector2(-16.0f, -16.0f), new Vector2(150.0f, 42.0f), ReturnToBattles);
        }

        private void BuildErrorOverlay(string errorText)
        {
            EnsureEventSystem();

            var go = new GameObject(OverlayCanvasName);
            _overlayCanvas = go.AddComponent<Canvas>();
            _overlayCanvas.renderMode = RenderMode.ScreenSpaceOverlay;
            _overlayCanvas.sortingOrder = 3000;

            var scaler = go.AddComponent<CanvasScaler>();
            scaler.uiScaleMode = CanvasScaler.ScaleMode.ScaleWithScreenSize;
            scaler.referenceResolution = new Vector2(1024.0f, 768.0f);
            scaler.screenMatchMode = CanvasScaler.ScreenMatchMode.MatchWidthOrHeight;
            scaler.matchWidthOrHeight = 0.5f;

            go.AddComponent<GraphicRaycaster>();

            CreateOverlayText(go.transform, "Error", errorText, new Vector2(32.0f, -32.0f), new Vector2(860.0f, 360.0f), TextAnchor.UpperLeft, 22, new Color32(255, 210, 210, 255));
            CreateOverlayButton(go.transform, "BackButton", "Назад", new Vector2(-16.0f, -16.0f), new Vector2(150.0f, 42.0f), ReturnToBattles);
        }


        private void UpdateRuntimeHud(bool force)
        {
            if (_runtimeHudText == null)
                return;

            string signature = BuildRuntimeHudText();
            if (!force && signature == _lastRuntimeHudSignature)
                return;

            _lastRuntimeHudSignature = signature;
            _runtimeHudText.text = signature;
        }

        private string BuildRuntimeHudText()
        {
            string pathMode = _strictRuntimeTerrainEnabled ? "STRICT_RUNTIME(cells)" : (_experimentalArrayPathEnabled ? "ARRAY(runtime)" : "PREVIEW(stable)");
            return
                $"MODE {_terrainDebugMode} — {DescribeTerrainMode(_terrainDebugMode)}\n" +
                $"PATH={pathMode} GT={PreviewGroundTiling:0.#} ST={PreviewSecondTiling:0.#} FT={PreviewFactureTiling:0.#} FW={PreviewFactureStrength:0.###}\n" +
                $"S2x={PreviewSecondWeightScale:0.##} FX={PreviewFactureWeightScale:0.##} SB={PreviewSlopeBlendPower:0.##} F={(_factureEnabled ? "on" : "off")}\n" +
                "1=height 2=base 3=base+second 4=base+second+facture 5=secondMask 6=factureMask 7=baseIndex 0=togglePath";
        }

        private void InitializeFreeCameraFromTerrainBounds()
        {
            if (_terrainGo == null)
                return;

            var mf = _terrainGo.GetComponent<MeshFilter>();
            Bounds localBounds = (mf != null && mf.sharedMesh != null)
                ? mf.sharedMesh.bounds
                : new Bounds(Vector3.zero, new Vector3(1000.0f, 100.0f, 1000.0f));

            Vector3 worldCenter = _terrainGo.transform.TransformPoint(localBounds.center);
            Vector3 scaledExtents = Vector3.Scale(localBounds.extents, new Vector3(Mathf.Abs(_terrainGo.transform.lossyScale.x), Mathf.Abs(_terrainGo.transform.lossyScale.y), Mathf.Abs(_terrainGo.transform.lossyScale.z)));
            _pivot = worldCenter;
            _distance = Mathf.Clamp(Mathf.Max(scaledExtents.x, scaledExtents.z, 1.0f) * CameraDistanceMultiplier, MinCameraDistance, MaxCameraDistance);
            _initialPivot = _pivot;
            _initialDistance = _distance;
            _initialYaw = _yaw;
            _initialPitch = _pitch;
        }

        private void InitializeFreeCameraStateFromTerrainBounds()
        {
            InitializeFreeCameraFromTerrainBounds();
            Quaternion rotation = Quaternion.Euler(_pitch, _yaw, 0.0f);
            _freeCameraYaw = _yaw;
            _freeCameraPitch = Mathf.Clamp(_pitch, -85.0f, 85.0f);
            _freeCameraPosition = _pivot - rotation * Vector3.forward * _distance;
            _freeCameraStateInitialized = true;

            if (_freeCamera != null)
            {
                _freeCamera.transform.position = _freeCameraPosition;
                _freeCamera.transform.rotation = Quaternion.Euler(_freeCameraPitch, _freeCameraYaw, 0.0f);
            }
        }

        private static float GetStrictIsoUnityFovYDegrees()
        {
            float aspect = Mathf.Max(1.0f, Screen.width) / Mathf.Max(1.0f, Screen.height);
            float fovx = StrictIsoBaseFovXDegrees * Mathf.Deg2Rad;
            float fovy = 2.0f * Mathf.Atan(Mathf.Tan(fovx * 0.5f) / Mathf.Max(0.0001f, aspect));
            return Mathf.Clamp(fovy * Mathf.Rad2Deg, 1.0f, 179.0f);
        }

        private static Vector3 MapOriginalDirToUnity(float yawRad, float rollRad)
        {
            float ox = 0.0f;
            float oy = -Mathf.Cos(yawRad);
            float oz = -Mathf.Sin(yawRad);

            if (Mathf.Abs(rollRad) > 0.000001f)
            {
                float cr = Mathf.Cos(rollRad);
                float sr = Mathf.Sin(rollRad);
                float rx = ox * cr - oy * sr;
                float ry = ox * sr + oy * cr;
                ox = rx;
                oy = ry;
            }

            return new Vector3(ox, oz, oy * WorldZSign).normalized;
        }

        private static Quaternion BuildStrictIsoRotationLikeOriginal(Vector3 dir)
        {
            Vector3 up = Vector3.up;
            Vector3 right = Vector3.Cross(up, dir);
            if (right.sqrMagnitude < 0.000001f)
                right = Vector3.right;
            right.Normalize();
            up = Vector3.Cross(dir, right).normalized;

            Matrix4x4 basis = Matrix4x4.identity;
            basis.SetColumn(0, new Vector4(right.x, right.y, right.z, 0.0f));
            basis.SetColumn(1, new Vector4(up.x, up.y, up.z, 0.0f));
            basis.SetColumn(2, new Vector4(dir.x, dir.y, dir.z, 0.0f));
            return basis.rotation;
        }

        private void FrameCamera()
        {
            if (_terrainGo == null || _camera == null) return;

            var mf = _terrainGo.GetComponent<MeshFilter>();
            var mr = _terrainGo.GetComponent<MeshRenderer>();

            Bounds localBounds = (mf != null && mf.sharedMesh != null)
                ? mf.sharedMesh.bounds
                : new Bounds(Vector3.zero, new Vector3(1000.0f, 100.0f, 1000.0f));

            Vector3 terrainScale = _terrainGo != null ? _terrainGo.transform.lossyScale : Vector3.one;
            Vector3 worldCenter = _terrainGo != null ? _terrainGo.transform.TransformPoint(localBounds.center) : localBounds.center;
            Vector3 scaledExtents = Vector3.Scale(localBounds.extents, new Vector3(Mathf.Abs(terrainScale.x), Mathf.Abs(terrainScale.y), Mathf.Abs(terrainScale.z)));
            Bounds worldBounds = new Bounds(worldCenter, Vector3.Scale(localBounds.size, new Vector3(Mathf.Abs(terrainScale.x), Mathf.Abs(terrainScale.y), Mathf.Abs(terrainScale.z))));
            _pivot = worldCenter;

            float radius = Mathf.Max(scaledExtents.x, scaledExtents.z, 1.0f);
            _distance = Mathf.Clamp(radius * CameraDistanceMultiplier, MinCameraDistance, MaxCameraDistance);

            Debug.Log($"[C2:REN] terrainActive={_terrainGo.activeInHierarchy} rendererEnabled={(mr != null && mr.enabled)}");
            Debug.Log($"[C2:REN] meshExists={(mf != null && mf.sharedMesh != null)} localBoundsCenter={localBounds.center} localBoundsSize={localBounds.size}");
            Debug.Log($"[C2:REN] worldBoundsCenter={worldBounds.center} worldBoundsSize={worldBounds.size}");
            Debug.Log($"[C2:REN] pivot={_pivot} radius={radius} distance={_distance}");

            _initialPivot = _pivot;
            _initialDistance = _distance;
            _initialYaw = _yaw;
            _initialPitch = _pitch;

            MaybeLogCameraState(1.0f, true);
        }

        private void UpdateDynamicRippleRuntime()
        {
            // Dynamic/random ripple disabled by request.
        }

        private void Update()
        {
            if (WasEscapePressed())
            {
                ReturnToBattles();
                return;
            }

            if (WasWaterDiagnosticsDumpPressed())
            {
                DumpWaterDiagnostics("enter");
            }

            bool dirty = false;
            bool speedHeld = IsSpeedHeld();

            if (WasFreeCameraTogglePressed())
            {
                ToggleBattleCameraModeLikeOriginal();
                dirty = true;
            }

            if (WasHomePressed())
            {
                if (_freeCameraMode)
                    InitializeFreeCameraStateFromTerrainBounds();
                else
                    ResetStrictIsoCameraStateLikeOriginal();
                dirty = true;
            }

            if (!ForcePlainWhiteGeometryOnly)
            {
                int requestedMode = ReadRequestedTerrainMode();
                if (requestedMode >= 1 && requestedMode <= 7 && requestedMode != _terrainDebugMode)
                {
                    _terrainDebugMode = requestedMode;
                    RebuildTerrainMaterialForCurrentMode(forceLog: true);
                    UpdateRuntimeHud(true);
                }

                if (WasTerrainPathTogglePressed())
                {
                    _experimentalArrayPathEnabled = !_experimentalArrayPathEnabled;
                    Debug.Log($"[C2:REN] terrainPathToggle experimentalArray={(_experimentalArrayPathEnabled ? 1 : 0)}");
                    RebuildTerrainMaterialForCurrentMode(forceLog: true);
                    UpdateRuntimeHud(true);
                }

                if (WasStrictTextureReportPressed())
                {
                    RebuildTerrainMaterialForCurrentMode(forceLog: true);
                }

                if (WasFactureTogglePressed())
                {
                    _factureEnabled = !_factureEnabled;
                    if (_terrainDebugMode >= 4)
                        RebuildTerrainMaterialForCurrentMode(forceLog: true);
                    else
                        ApplyTerrainMaterialRuntimeState(forceLog: true);
                    UpdateRuntimeHud(true);
                }

                if (TryApplyRuntimeTerrainTuning(out string tuningLog))
                {
                    ApplyTerrainMaterialRuntimeState(forceLog: false);
                    UpdateRuntimeHud(true);
                    Debug.Log(tuningLog);
                }
            }

            UpdateDynamicRippleRuntime();

            if (_freeCameraMode)
                dirty |= UpdateFreeCameraInput(speedHeld);
            else
                dirty |= UpdateStrictIsoCameraInputLikeOriginal(speedHeld);

            if (dirty)
                UpdateCameraTransform();

            UpdateRuntimeHud(false);
        }

        private void ReturnToBattles()
        {
            var bootstrap = _bootstrap;
            DestroyUiAndOldMode();
            SafeDestroy(gameObject);
            if (bootstrap != null)
                bootstrap.RenderByScreenId("SingleBattles");
        }

        private void UpdateCameraTransform()
        {
            if (_freeCameraMode)
            {
                ApplyFreeCameraTransform();
                _camera = _freeCamera;
            }
            else
            {
                if (_strictIsoCamera != null)
                    ApplyStrictIsoCameraLikeOriginal();
                _camera = _strictIsoCamera;
            }

            if (_camera == null)
                return;

            UpdateWaterReflectionTarget(force: false);
            ApplyWaterReflectionParams(forceLog: false);

            Vector3 lookTarget = _freeCameraMode ? (_camera.transform.position + _camera.transform.forward * Mathf.Max(_distance, 1.0f)) : _pivot;
            Vector3 toPivot = (lookTarget - _camera.transform.position).normalized;
            float lookDot = Vector3.Dot(_camera.transform.forward.normalized, toPivot);
            MaybeLogCameraState(lookDot, false);
        }

        private void ApplyFreeCameraTransform()
        {
            if (_freeCamera == null)
                return;

            _freeCameraPitch = Mathf.Clamp(_freeCameraPitch, -85.0f, 85.0f);
            Quaternion rotation = Quaternion.Euler(_freeCameraPitch, _freeCameraYaw, 0.0f);
            _freeCamera.transform.SetPositionAndRotation(_freeCameraPosition, rotation);

            _yaw = _freeCameraYaw;
            _pitch = _freeCameraPitch;
            _pivot = _freeCameraPosition + rotation * Vector3.forward * Mathf.Max(_distance, 1.0f);
        }

        private bool UpdateFreeCameraInput(bool speedHeld)
        {
            if (!_freeCameraStateInitialized)
                InitializeFreeCameraStateFromTerrainBounds();

            bool dirty = false;
            float dt = Mathf.Max(Time.unscaledDeltaTime, 0.0001f);
            float moveSpeed = FreeCameraMoveSpeed * (speedHeld ? FreeCameraBoostMultiplier : 1.0f);
            float verticalSpeed = FreeCameraVerticalSpeed * (speedHeld ? FreeCameraBoostMultiplier : 1.0f);

            Vector2 move = ReadKeyboardMove();
            float vertical = 0.0f;
            if (IsPageUpHeldLikeOriginal())
                vertical += 1.0f;
            if (IsPageDownHeldLikeOriginal())
                vertical -= 1.0f;

            Quaternion rotation = Quaternion.Euler(_freeCameraPitch, _freeCameraYaw, 0.0f);
            Vector3 forward = rotation * Vector3.forward;
            Vector3 right = rotation * Vector3.right;
            Vector3 up = Vector3.up;

            Vector3 deltaMove = (forward * move.y + right * move.x) * moveSpeed * dt + up * (vertical * verticalSpeed * dt);
            if (deltaMove.sqrMagnitude > 0.0f)
            {
                _freeCameraPosition += deltaMove;
                dirty = true;
            }

            if (IsOrbitHeld())
            {
                Vector2 delta = ReadPointerDelta();
                if (delta.sqrMagnitude > 0.0f)
                {
                    _freeCameraYaw += delta.x * FreeCameraLookSensitivity;
                    _freeCameraPitch -= delta.y * FreeCameraLookSensitivity;
                    dirty = true;
                }
            }

            float scroll = ReadScrollDelta();
            if (Mathf.Abs(scroll) > 0.001f)
            {
                _freeCameraPosition += forward * (scroll * moveSpeed * 0.15f);
                dirty = true;
            }

            return dirty;
        }

        private void InitializeStrictIsoCameraStateLikeOriginal(bool forceCenter)
        {
            float scale = GetStrictScaleLikeOriginal();
            float viewVol = GetStrictViewVolLikeOriginal(scale);
            float realLy = GetStrictRealLyLikeOriginal(scale);

            if (!_strictCameraStateInitialized || forceCenter)
            {
                float centerMapX;
                float centerMapY;

                if (_map != null)
                {
                    centerMapX = (_map.MinMapX + _map.MaxMapX) * 0.5f;
                    centerMapY = (_map.MinMapY + _map.MaxMapY) * 0.5f;
                }
                else
                {
                    centerMapX = 0.0f;
                    centerMapY = 0.0f;
                }

                _strictMapX = centerMapX - viewVol / (2.0f * 32.0f);
                _strictMapY = centerMapY - realLy / 32.0f;
                _strictZoom = 0.0f;
                _strictYawLikeOriginal = Mathf.PI / 6.0f;
                _strictZoomTargetLikeOriginal = 0.0f;
                _strictZoomModeIndex = 0;
                _strictRollLikeOriginal = 0.0f;
                _strictStepX = 0.0f;
                _strictStepY = 0.0f;
                _strictLastShiftTime = Time.realtimeSinceStartup * 1000.0f;
                _strictDtaLikeOriginal = 0.0f;
                _strictCameraStateInitialized = true;
            }

            ClampStrictIsoMapStateLikeOriginal(viewVol, realLy, scale);
            _strictInitialMapX = _strictMapX;
            _strictInitialMapY = _strictMapY;
            _strictInitialZoom = _strictZoom;
        }

        private void ResetStrictIsoCameraStateLikeOriginal()
        {
            if (!_strictCameraStateInitialized)
                InitializeStrictIsoCameraStateLikeOriginal(forceCenter: true);

            _strictMapX = _strictInitialMapX;
            _strictMapY = _strictInitialMapY;
            _strictZoom = _strictInitialZoom;
            _strictYawLikeOriginal = Mathf.PI / 6.0f;
            _strictZoomTargetLikeOriginal = _strictInitialZoom;
            _strictZoomModeIndex = 0;
            _strictRollLikeOriginal = 0.0f;
            _strictStepX = 0.0f;
            _strictStepY = 0.0f;
            _strictLastShiftTime = Time.realtimeSinceStartup * 1000.0f;
            _strictDtaLikeOriginal = 0.0f;
        }

        private bool UpdateStrictIsoCameraInputLikeOriginal(bool speedHeld)
        {
            if (!_strictCameraStateInitialized)
                InitializeStrictIsoCameraStateLikeOriginal(forceCenter: true);

            bool dirty = false;
            if (WasCameraModeTogglePressed())
            {
                _strictZoomModeIndex = (_strictZoomModeIndex + 1) % 3;
                _strictZoomTargetLikeOriginal = GetStrictZoomHeightByModeLikeOriginal(_strictZoomModeIndex);
                dirty = true;
            }
            float scale = GetStrictScaleLikeOriginal();
            float viewVol = GetStrictViewVolLikeOriginal(scale);
            float realLy = GetStrictRealLyLikeOriginal(scale);

            bool moveX = false;
            bool moveY = false;
            Vector2 pointer = ReadPointerPosition();
            float x = pointer.x;
            float y = pointer.y;
            float yTop = Mathf.Max(0.0f, Screen.height - y);

            Vector2 keyMove = ReadKeyboardMove();
            if (keyMove.x > 0.0f) { _strictStepX = 4.0f; moveX = true; }
            if (keyMove.x < 0.0f) { _strictStepX = -4.0f; moveX = true; }
            if (keyMove.y > 0.0f) { _strictStepY = -4.0f; moveY = true; }
            if (keyMove.y < 0.0f) { _strictStepY = 4.0f; moveY = true; }

            bool pointerInside = Application.isFocused && x >= 0.0f && y >= 0.0f && x < Screen.width && y < Screen.height;
            bool pointerOverUi = EventSystem.current != null && EventSystem.current.IsPointerOverGameObject();
            if (pointerInside && !pointerOverUi)
            {
                if (x < 6.0f)
                {
                    if (_strictStepX > 0.0f) _strictStepX = 0.0f;
                    _strictStepX -= StrictIsoEdgeAccel;
                    if (_strictStepX < -StrictIsoStepClamp) _strictStepX = -StrictIsoStepClamp;
                    moveX = true;
                }
                if (yTop < 6.0f)
                {
                    if (_strictStepY > 0.0f) _strictStepY = 0.0f;
                    _strictStepY -= StrictIsoEdgeAccel;
                    if (_strictStepY < -StrictIsoStepClamp) _strictStepY = -StrictIsoStepClamp;
                    moveY = true;
                }
                if (x > Screen.width - 6.0f)
                {
                    if (_strictStepX < 0.0f) _strictStepX = 0.0f;
                    _strictStepX += StrictIsoEdgeAccel;
                    if (_strictStepX > StrictIsoStepClamp) _strictStepX = StrictIsoStepClamp;
                    moveX = true;
                }
                if (yTop > Screen.height - 6.0f)
                {
                    if (_strictStepY < 0.0f) _strictStepY = 0.0f;
                    _strictStepY += StrictIsoEdgeAccel;
                    if (_strictStepY > StrictIsoStepClamp) _strictStepY = StrictIsoStepClamp;
                    moveY = true;
                }
            }

            // literal-like damping from original mapa.cpp
            if (_strictStepX != 0.0f && !moveX)
            {
                if (_strictStepX > 0.0f) _strictStepX -= StrictIsoEdgeAccel * 2.0f;
                if (_strictStepX < 0.0f) _strictStepX += StrictIsoEdgeAccel * 2.0f;
                if (Mathf.Abs(_strictStepX) < StrictIsoEdgeAccel * 2.0f) _strictStepX = 0.0f;
            }
            if (_strictStepY != 0.0f && !moveY)
            {
                if (_strictStepY > 0.0f) _strictStepY -= 1.0f;
                if (_strictStepY < 0.0f) _strictStepY += 1.0f;
                if (Mathf.Abs(_strictStepY) < 1.0f) _strictStepY = 0.0f;
            }

            float nowMs = Time.realtimeSinceStartup * 1000.0f;
            if (_strictLastShiftTime <= 0.0f)
                _strictLastShiftTime = nowMs;
            float dt = (nowMs - _strictLastShiftTime) * (StrictIsoScrollSpeed + 5.0f) / 8.0f;
            if (dt > 300.0f) dt = 300.0f;
            _strictDtaLikeOriginal = (_strictDtaLikeOriginal * 11.0f + dt) / 12.0f;
            _strictLastShiftTime = nowMs;

            int stepx = (int)_strictStepX;
            int stepy = (int)_strictStepY;
            if (stepx != 0 || stepy != 0)
            {
                float dx = stepx * _strictDtaLikeOriginal / 2.0f / 40.0f;
                float dy = stepy * _strictDtaLikeOriginal / 2.0f / 40.0f;
                if (speedHeld)
                {
                    dx *= 10.0f;
                    dy *= 10.0f;
                }

                // Literal-like mapa.cpp path:
                // CD = ICam->GetDir(); CD.z = 0; CD.normalize(); CD.reverse();
                // ShiftCamera(dx*CD.y + dy*CD.x, dy*CD.y - dx*CD.x)
                Vector3 cdUnity = _strictIsoCamera != null ? _strictIsoCamera.transform.forward : MapOriginalDirToUnity(_strictYawLikeOriginal, _strictRollLikeOriginal);
                cdUnity.y = 0.0f;
                if (cdUnity.sqrMagnitude < 0.000001f)
                    cdUnity = MapOriginalDirToUnity(_strictYawLikeOriginal, _strictRollLikeOriginal);
                cdUnity.y = 0.0f;
                cdUnity.Normalize();
                cdUnity = -cdUnity;

                float cdx = cdUnity.x;
                float cdy = cdUnity.z * WorldZSign;
                _strictMapX += dx * cdy + dy * cdx;
                _strictMapY += dy * cdy - dx * cdx;
                dirty = true;
            }

            // Stepped F7 zoom path for retail-like gameplay:
            // - base angle stays fixed at the original default PI/6
            // - F7 cycles camera height levels using the original zoom amplitude (1100) as one lift unit
            // - no wheel/PageUp/PageDown in strict mode
            float zoomStep = Mathf.Max(1.0f, dt * 3.0f);
            if (!Mathf.Approximately(_strictZoom, _strictZoomTargetLikeOriginal))
            {
                _strictZoom = Mathf.MoveTowards(_strictZoom, _strictZoomTargetLikeOriginal, zoomStep);
                _strictZoom = Mathf.Clamp(_strictZoom, 0.0f, GetStrictZoomHeightByModeLikeOriginal(2));
                dirty = true;
            }
            _strictYawLikeOriginal = Mathf.PI / 6.0f;

            if (dirty)
                ClampStrictIsoMapStateLikeOriginal(viewVol, realLy, scale);

            return dirty;
        }

        private static float GetStrictScaleLikeOriginal()
        {
            return 1.0f;
        }

        private static float GetStrictViewVolLikeOriginal(float scale)
        {
            return Mathf.Max(1.0f, Screen.width) * scale;
        }

        private static float GetStrictRealLyLikeOriginal(float scale)
        {
            return Mathf.Max(1.0f, Screen.height) * scale;
        }

        private void ClampStrictIsoMapStateLikeOriginal(float viewVol, float realLy, float scale)
        {
            if (_map == null)
                return;

            float smaplx = viewVol / 32.0f;
            float smaply = (realLy * scale) / 32.0f;

            float minX = _map.MinMapX;
            float minY = _map.MinMapY;
            float maxX = Mathf.Max(minX + smaplx, _map.MaxMapX);
            float maxY = Mathf.Max(minY + smaply, _map.MaxMapY);

            if (_strictMapX < minX) _strictMapX = minX;
            if (_strictMapY < minY) _strictMapY = minY;
            if (_strictMapX + smaplx > maxX) _strictMapX = maxX - smaplx;
            if (_strictMapY + smaply > maxY) _strictMapY = maxY - smaply;
        }

        private static float GetStrictZoomHeightByModeLikeOriginal(int mode)
        {
            // Base angle is fixed. One F7 lift step uses the original zoom amplitude (1100 units).
            switch (mode)
            {
                case 1:
                    return 1100.0f;
                case 2:
                    return 2200.0f;
                default:
                    return 0.0f;
            }
        }

        private void ApplyStrictIsoCameraLikeOriginal()
        {
            if (_strictIsoCamera == null)
                return;

            if (!_strictCameraStateInitialized)
                InitializeStrictIsoCameraStateLikeOriginal(forceCenter: true);

            float scale = GetStrictScaleLikeOriginal();
            float viewVol = GetStrictViewVolLikeOriginal(scale);
            float realLy = GetStrictRealLyLikeOriginal(scale);
            ClampStrictIsoMapStateLikeOriginal(viewVol, realLy, scale);

            float yawRad = _strictYawLikeOriginal;
            float rollRad = _strictRollLikeOriginal;
            Vector3 dir = MapOriginalDirToUnity(yawRad, rollRad);
            float strictDistance = viewVol * StrictIsoCameraFactor + _strictZoom;
            strictDistance = Mathf.Clamp(strictDistance, MinCameraDistance, MaxCameraDistance);

            float focusWorldX = (_strictMapX * 32.0f + viewVol * 0.5f) * HorizontalScale;
            float focusWorldZ = (_strictMapY * 32.0f + realLy * scale) * HorizontalScale * WorldZSign;
            Vector3 focus = new Vector3(focusWorldX, 0.0f, focusWorldZ);
            Vector3 pos = focus - dir * strictDistance;

            Quaternion rotation = BuildStrictIsoRotationLikeOriginal(dir);
            _strictIsoCamera.transform.SetPositionAndRotation(pos, rotation);
            _strictIsoCamera.orthographic = false;

            const float cos30 = 0.8660254037844386f;
            const float maxMapHeight = 1024.0f;
            float ydist = realLy * scale * cos30 * 2.0f;
            float camZn = strictDistance - ydist - 4.0f * maxMapHeight / cos30;
            if (camZn < 50.0f) camZn = 50.0f;
            const float minZn = 10.0f;
            if (camZn < minZn) camZn = minZn;
            float camZf = strictDistance + ydist * 2.0f;

            _strictIsoCamera.nearClipPlane = camZn;
            _strictIsoCamera.farClipPlane = Mathf.Max(camZf, camZn + 1000.0f);
            ApplyStrictIsoProjectionLikeOriginal(_strictIsoCamera, camZn, _strictIsoCamera.farClipPlane);

            _pivot = focus;
            _distance = strictDistance;
        }

        private static void ApplyStrictIsoProjectionLikeOriginal(Camera cam, float zn, float zf)
        {
            float aspect = Mathf.Max(1.0f, Screen.width) / Mathf.Max(1.0f, Screen.height);
            float fovx = StrictIsoBaseFovXDegrees * Mathf.Deg2Rad;
            float w = 2.0f * zn * Mathf.Tan(fovx * 0.5f);
            float h = w / Mathf.Max(0.0001f, aspect);

            Matrix4x4 m = Matrix4x4.zero;
            m[0,0] = 2.0f * zn / w;
            m[1,1] = 2.0f * zn / h;
            m[2,2] = -(zf + zn) / (zf - zn);
            m[2,3] = -(2.0f * zf * zn) / (zf - zn);
            m[3,2] = -1.0f;
            cam.projectionMatrix = m;
        }

        private Vector3 MapCoordToWorld(int mapX, int mapY, float boundaryLift)
        {
            float x = mapX * 32.0f * HorizontalScale;
            float z = mapY * 32.0f * HorizontalScale * WorldZSign;
            float y = 0.0f;

            if (_map != null && !_map.IsMeshSurface && _map.Heights != null)
            {
                int col = Mathf.Clamp(mapX, 0, Math.Max(0, _map.VertInLine - 1));
                int row = Mathf.Clamp(mapY, 0, Math.Max(0, _map.MaxTH - 1));
                y = _map.GetVertexHeight(col, row) * VerticalScale;
            }
            else if (_map != null && _map.IsMeshSurface && _map.MeshVertices != null && _map.MeshVertices.Length > 0)
            {
                y = _map.MeshVertices[0].y * VerticalScale;
            }

            y += boundaryLift * VerticalScale;
            return new Vector3(x, y, z);
        }

        private Vector3 RoadCoordToWorld(int worldX, int worldY, float lift)
        {
            float x = worldX * HorizontalScale;
            float z = worldY * HorizontalScale * WorldZSign;
            float y = SampleMapHeightLikeOriginal(worldX, worldY) * VerticalScale + lift * VerticalScale;
            return new Vector3(x, y, z);
        }


        private static string DescribeCurrentRenderPipeline()
        {
            var rp = GraphicsSettings.currentRenderPipeline;
            if (rp == null)
                return "builtin";
            string rpName = rp.GetType().Name;
            string assetName = rp.name;
            if (string.IsNullOrWhiteSpace(assetName) || string.Equals(assetName, rpName, StringComparison.Ordinal))
                return rpName;
            return assetName + "/" + rpName;
        }

        private static Shader FindBestTexturedShader()
        {
            string[] names =
            {
                "Universal Render Pipeline/Unlit",
                "Unlit/Texture",
                "Sprites/Default",
                "Legacy Shaders/Diffuse",
                "Universal Render Pipeline/Simple Lit",
                "Universal Render Pipeline/Lit"
            };

            foreach (string n in names)
            {
                var s = Shader.Find(n);
                if (s != null)
                    return s;
            }

            return null;
        }

        private static Shader FindBestColorShader()
        {
            string[] names =
            {
                "Universal Render Pipeline/Unlit",
                "Unlit/Color",
                "Sprites/Default",
                "Legacy Shaders/Diffuse"
            };

            foreach (string n in names)
            {
                var s = Shader.Find(n);
                if (s != null)
                    return s;
            }

            return null;
        }
        private Material CreateTerrainMaterialForCurrentMode(string selectedId, Mesh terrainMesh, int mode, out string info)
        {
            mode = Mathf.Clamp(mode, 1, 7);
            info = "";

            GetTerrainModePreviewFlags(mode, out bool includeSecondary, out bool includeFacture, out string renderPath);

            if (_experimentalArrayPathEnabled)
            {
                Material arrayMat = TryCreateTerrainArrayMaterial(selectedId, terrainMesh, out string arrayInfo, mode);
                if (arrayMat != null)
                {
                    info = $"terrainTextureInfo=renderPath=array-guarded-{renderPath}; " + arrayInfo;
                    return arrayMat;
                }

                Texture2D previewFallback = TryBuildTerrainTextureForMode(selectedId, terrainMesh, mode, includeSecondary, includeFacture, out string previewFallbackInfo);
                Shader fallbackShader = (previewFallback != null) ? FindBestTexturedShader() : FindBestColorShader();
                if (fallbackShader == null)
                    throw new InvalidOperationException("No usable shader found for terrain preview fallback material.");

                var fallbackMat = new Material(fallbackShader);
                if (previewFallback != null)
                {
                    if (fallbackMat.HasProperty("_MainTex"))
                        fallbackMat.mainTexture = previewFallback;
                    if (fallbackMat.HasProperty("_BaseMap"))
                        fallbackMat.SetTexture("_BaseMap", previewFallback);
                    fallbackMat.color = Color.white;
                    info = $"terrainTextureInfo=renderPath=preview-fallback-{renderPath}; arrayFallback={arrayInfo}; " + previewFallbackInfo;
                }
                else
                {
                    fallbackMat.color = new Color(0.72f, 0.74f, 0.70f, 1.0f);
                    info = $"terrainTextureInfo=renderPath=preview-fallback-{renderPath}-failed; arrayFallback={arrayInfo}; " + previewFallbackInfo;
                }

                if (fallbackMat.HasProperty("_Glossiness")) fallbackMat.SetFloat("_Glossiness", 0.0f);
                if (fallbackMat.HasProperty("_Metallic")) fallbackMat.SetFloat("_Metallic", 0.0f);
                return fallbackMat;
            }

            Texture2D preview = TryBuildTerrainTextureForMode(selectedId, terrainMesh, mode, includeSecondary, includeFacture, out string previewInfo);
            Shader shader = (preview != null) ? FindBestTexturedShader() : FindBestColorShader();
            if (shader == null)
                throw new InvalidOperationException("No usable shader found for terrain stage preview material.");

            var mat = new Material(shader);
            if (preview != null)
            {
                if (mat.HasProperty("_MainTex"))
                    mat.mainTexture = preview;
                if (mat.HasProperty("_BaseMap"))
                    mat.SetTexture("_BaseMap", preview);
                mat.color = Color.white;
                info = $"terrainTextureInfo=renderPath={renderPath}; " + previewInfo;
            }
            else
            {
                mat.color = new Color(0.72f, 0.74f, 0.70f, 1.0f);
                info = $"terrainTextureInfo=renderPath={renderPath}-failed; " + previewInfo;
            }

            if (mat.HasProperty("_Glossiness")) mat.SetFloat("_Glossiness", 0.0f);
            if (mat.HasProperty("_Metallic")) mat.SetFloat("_Metallic", 0.0f);
            return mat;
        }

        private Material TryCreateTerrainArrayMaterial(string selectedId, Mesh terrainMesh, out string info, int debugMode)
        {
            string pipelineInfo = DescribeCurrentRenderPipeline();
            info = "";
            if (_map == null)
            {
                info = "map=null";
                return null;
            }

            if (_map.TilePrimary == null || _map.TilePrimary.Length == 0)
            {
                info = "TilePrimary missing";
                return null;
            }

            if (!SystemInfo.supports2DArrayTextures)
            {
                info = "SystemInfo.supports2DArrayTextures=false; rp=" + pipelineInfo;
                return null;
            }

            Shader shader = Shader.Find("Cossacks2Bridge/TerrainArrayBlendPreview");
            if (shader == null)
            {
                info = "shader 'Cossacks2Bridge/TerrainArrayBlendPreview' not found; rp=" + pipelineInfo;
                return null;
            }

            if (!shader.isSupported)
            {
                info = "shader 'Cossacks2Bridge/TerrainArrayBlendPreview' unsupported; rp=" + pipelineInfo;
                return null;
            }

            GroundTextureCatalog catalog = GetOrCreateGroundCatalog(out string catalogInfo);
            if (catalog == null || catalog.ByName.Count == 0)
            {
                info = "catalog empty; " + catalogInfo;
                return null;
            }

            int tileWidth = Math.Max(1, _map.TileWidth > 0 ? _map.TileWidth : _map.VertInLine);
            int tileHeight = Math.Max(1, _map.TileHeight > 0 ? _map.TileHeight : _map.MaxTH);
            int expected = tileWidth * tileHeight;
            if (_map.TilePrimary.Length < expected)
            {
                info = $"tile array too short: len={_map.TilePrimary.Length} expected={expected}; {catalogInfo}";
                return null;
            }

            var groundUsed = new SortedSet<int>();
            var factureUsed = new SortedSet<int>();
            for (int i = 0; i < expected; i++)
            {
                groundUsed.Add(_map.TilePrimary[i]);
                if (_map.TileSecondary != null && i < _map.TileSecondary.Length)
                    groundUsed.Add(_map.TileSecondary[i]);
                if (_map.FactureMap != null && i < _map.FactureMap.Length)
                    factureUsed.Add(_map.FactureMap[i]);
            }

            GroundRuntimeConfig runtimeCfg = GetOrCreateGroundRuntimeConfig(out string runtimeInfo);
            EnsureGroundTextureTable(runtimeCfg, catalog);

            var resolvedGround = new Dictionary<int, Texture2D>();
            foreach (int id in groundUsed)
            {
                Texture2D tex = ResolveTextureForTileId(catalog, runtimeCfg, id);
                if (tex != null)
                    resolvedGround[id] = tex;
            }

            var resolvedFacture = new Dictionary<int, Texture2D>();
            foreach (int id in factureUsed)
            {
                Texture2D tex = ResolveTextureForFactureId(catalog, runtimeCfg, id);
                if (tex != null)
                    resolvedFacture[id] = tex;
            }

            int[] missingGroundIds = groundUsed.Where(id => !resolvedGround.ContainsKey(id)).OrderBy(id => id).ToArray();
            int[] missingFactureIds = factureUsed.Where(id => !resolvedFacture.ContainsKey(id)).OrderBy(id => id).ToArray();

            WriteStrictTextureMappingReport(selectedId, groundUsed, factureUsed, resolvedGround, resolvedFacture, catalog, runtimeCfg);

            Texture2DArray groundArray = BuildTextureArrayFromResolved(
                resolvedGround,
                256,
                new Color(0.72f, 0.74f, 0.70f, 1.0f),
                out Dictionary<int, int> groundLayerById,
                out string groundArrayInfo,
                "ground");

            Texture2DArray factureArray = BuildTextureArrayFromResolved(
                resolvedFacture,
                128,
                Color.white,
                out Dictionary<int, int> factureLayerById,
                out string factureArrayInfo,
                "facture");

            if (groundArray == null)
            {
                info = "groundArray build failed; " + groundArrayInfo;
                return null;
            }

            BuildTerrainControlTextures(
                tileWidth,
                tileHeight,
                groundLayerById,
                factureLayerById,
                runtimeCfg,
                out Texture2D control0,
                out Texture2D control1,
                out Texture2D control2,
                out Texture2D control3,
                out Texture2D control4,
                out string controlInfo);

            if (control0 == null || control1 == null || control2 == null || control3 == null || control4 == null)
            {
                info = "control textures build failed; " + controlInfo;
                return null;
            }

            BuildFactureMetaTextures(
                factureLayerById,
                runtimeCfg,
                out Texture2D factureMeta0,
                out Texture2D factureMeta1,
                out string factureMetaInfo);

            var mat = new Material(shader);
            if (mat == null || mat.shader == null || !mat.shader.isSupported || mat.passCount <= 0)
            {
                int passCount = (mat != null) ? mat.passCount : -1;
                if (mat != null)
                    SafeDestroy(mat);
                info = $"array shader material invalid; passCount={passCount}; rp={pipelineInfo}";
                return null;
            }

            mat.name = selectedId + "_TerrainArrayBlend";
            if (mat.HasProperty("_GroundArray")) mat.SetTexture("_GroundArray", groundArray);
            if (mat.HasProperty("_FactureArray")) mat.SetTexture("_FactureArray", factureArray);
            if (mat.HasProperty("_Control0")) mat.SetTexture("_Control0", control0);
            if (mat.HasProperty("_Control1")) mat.SetTexture("_Control1", control1);
            if (mat.HasProperty("_Control2")) mat.SetTexture("_Control2", control2);
            if (mat.HasProperty("_Control3")) mat.SetTexture("_Control3", control3);
            if (mat.HasProperty("_Control4")) mat.SetTexture("_Control4", control4);
            if (mat.HasProperty("_FactureMeta0")) mat.SetTexture("_FactureMeta0", factureMeta0);
            if (mat.HasProperty("_FactureMeta1")) mat.SetTexture("_FactureMeta1", factureMeta1);
            if (mat.HasProperty("_UseParityPreview")) mat.SetFloat("_UseParityPreview", 0.0f);
            if (mat.HasProperty("_GroundTiling")) mat.SetFloat("_GroundTiling", PreviewGroundTiling);
            if (mat.HasProperty("_SecondaryTiling")) mat.SetFloat("_SecondaryTiling", PreviewSecondTiling);
            if (mat.HasProperty("_FactureTiling")) mat.SetFloat("_FactureTiling", PreviewFactureTiling);
            if (mat.HasProperty("_FactureStrength")) mat.SetFloat("_FactureStrength", PreviewFactureStrength);
            if (mat.HasProperty("_SecondWeightScale")) mat.SetFloat("_SecondWeightScale", PreviewSecondWeightScale);
            if (mat.HasProperty("_FactureWeightScale")) mat.SetFloat("_FactureWeightScale", PreviewFactureWeightScale);
            if (mat.HasProperty("_FactureEnabled")) mat.SetFloat("_FactureEnabled", _factureEnabled ? 1.0f : 0.0f);
            if (mat.HasProperty("_SlopeBlendPower")) mat.SetFloat("_SlopeBlendPower", PreviewSlopeBlendPower);
            if (mat.HasProperty("_SlopeSecondAtten")) mat.SetFloat("_SlopeSecondAtten", PreviewSlopeSecondAtten);
            if (mat.HasProperty("_SlopeFactureAtten")) mat.SetFloat("_SlopeFactureAtten", PreviewSlopeFactureAtten);
            if (mat.HasProperty("_AmbientStrength")) mat.SetFloat("_AmbientStrength", AmbientLightStrength);
            if (mat.HasProperty("_DiffuseStrength")) mat.SetFloat("_DiffuseStrength", DiffuseLightStrength);
            if (mat.HasProperty("_Brightness")) mat.SetFloat("_Brightness", TerrainBrightness);
            if (mat.HasProperty("_FakeLightDir")) mat.SetVector("_FakeLightDir", GetShaderLightDirection());
            if (mat.HasProperty("_DebugMode")) mat.SetFloat("_DebugMode", debugMode);
            mat.color = Color.white;

            info =
                $"mode=array-runtime tile={tileWidth}x{tileHeight} groundUsed={groundUsed.Count} groundResolved={resolvedGround.Count} groundMissing={missingGroundIds.Length} groundMissingIds={FormatIdList(missingGroundIds, 24)} groundLayers={groundArray.depth} " +
                $"factUsed={factureUsed.Count} factResolved={resolvedFacture.Count} factMissing={missingFactureIds.Length} factMissingIds={FormatIdList(missingFactureIds, 24)} factLayers={(factureArray != null ? factureArray.depth : 0)} debugMode={debugMode} factureEnabled={_factureEnabled} " +
                $"groundTiling={PreviewGroundTiling:0.###} secondTiling={PreviewSecondTiling:0.###} factureTiling={PreviewFactureTiling:0.###} factureStrength={PreviewFactureStrength:0.###} secondWeightScale={PreviewSecondWeightScale:0.###} factureWeightScale={PreviewFactureWeightScale:0.###} slopeBlend={PreviewSlopeBlendPower:0.###} slopeSecondAtten={PreviewSlopeSecondAtten:0.###} slopeFactureAtten={PreviewSlopeFactureAtten:0.###} texUvMode=cell-runtime-array optMode=control-texture rawOptionMode=control-texture factureMode=getfactureuvw-control terrainPass=array-runtime texExMode=texmapex-wtexmapex-scal-runtime rp={pipelineInfo} shaderSupported={shader.isSupported} passCount={mat.passCount}; " +
                $"{groundArrayInfo}; {factureArrayInfo}; {controlInfo}; {factureMetaInfo}; {catalogInfo}; {runtimeInfo}; report={_lastStrictTextureReportPath}";
            return mat;
        }

        private void BuildFactureMetaTextures(
            Dictionary<int, int> factureLayerById,
            GroundRuntimeConfig runtimeCfg,
            out Texture2D factMeta0,
            out Texture2D factMeta1,
            out string info)
        {
            factMeta0 = null;
            factMeta1 = null;
            info = "";

            try
            {
                int depth = 1;
                if (factureLayerById != null && factureLayerById.Count > 0)
                    depth = Mathf.Max(1, factureLayerById.Values.Max() + 1);

                var px0 = new Color[depth];
                var px1 = new Color[depth];
                int xmlApplied = 0;
                int xmlMapping0 = 0, xmlMapping1 = 0, xmlMapping2 = 0;

                for (int i = 0; i < depth; i++)
                {
                    px0[i] = new Color(0f, 1f, 1f, 0f);
                    px1[i] = new Color(0f, 0f, 0f, 1f);
                }

                if (factureLayerById != null && runtimeCfg != null && runtimeCfg.Factures != null)
                {
                    foreach (var kv in factureLayerById)
                    {
                        int factId = kv.Key;
                        int layer = kv.Value;
                        if (layer < 0 || layer >= depth)
                            continue;

                        FactureInfoEntry fe = (factId >= 0 && factId < runtimeCfg.Factures.Length) ? runtimeCfg.Factures[factId] : null;
                        float mapping = 0f;
                        float uScale = 1f;
                        float vScale = 1f;
                        float uShift = 0f;
                        float vShift = 0f;
                        if (fe != null)
                        {
                            xmlApplied++;
                            mapping = Mathf.Clamp(fe.Mapping, 0, 2);
                            uScale = Mathf.Approximately(fe.UScale, 0f) ? 1f : fe.UScale;
                            vScale = Mathf.Approximately(fe.VScale, 0f) ? 1f : fe.VScale;
                            uShift = fe.UShift;
                            vShift = fe.VShift;
                            if (fe.Mapping == 0) xmlMapping0++;
                            else if (fe.Mapping == 1) xmlMapping1++;
                            else if (fe.Mapping == 2) xmlMapping2++;
                        }

                        px0[layer] = new Color(mapping / 255f, uScale, vScale, uShift);
                        px1[layer] = new Color(vShift, factId / 255f, 0f, 1f);
                    }
                }

                factMeta0 = new Texture2D(depth, 1, TextureFormat.RGBAHalf, false, true);
                factMeta0.name = "C2_FactureMeta0";
                factMeta0.wrapMode = TextureWrapMode.Clamp;
                factMeta0.filterMode = FilterMode.Point;
                factMeta0.SetPixels(px0);
                factMeta0.Apply(false, false);

                factMeta1 = new Texture2D(depth, 1, TextureFormat.RGBAHalf, false, true);
                factMeta1.name = "C2_FactureMeta1";
                factMeta1.wrapMode = TextureWrapMode.Clamp;
                factMeta1.filterMode = FilterMode.Point;
                factMeta1.SetPixels(px1);
                factMeta1.Apply(false, false);

                info = $"factureMeta={depth} xmlApplied={xmlApplied} mapping0={xmlMapping0} mapping1={xmlMapping1} mapping2={xmlMapping2}";
            }
            catch (Exception ex)
            {
                info = "BuildFactureMetaTextures failed: " + ex.Message;
                if (factMeta0 != null) SafeDestroy(factMeta0);
                if (factMeta1 != null) SafeDestroy(factMeta1);
                factMeta0 = null;
                factMeta1 = null;
            }
        }


        private static void NormalizePrebakedTop2LikeExMap(
            int primaryId,
            int secondaryId,
            byte secondaryWeight,
            out int top1Id,
            out int top2Id,
            out byte top2Weight,
            out bool changed,
            out bool mergedDuplicate,
            out bool swappedOrder)
        {
            top1Id = primaryId;
            top2Id = secondaryId;
            top2Weight = secondaryWeight;
            changed = false;
            mergedDuplicate = false;
            swappedOrder = false;

            int w1 = 255;
            int w2 = 0;

            if (secondaryId != primaryId && secondaryWeight > 0)
            {
                w1 = 255 - secondaryWeight;
                w2 = secondaryWeight;
            }

            if (secondaryId == primaryId)
            {
                mergedDuplicate = secondaryWeight > 0;
                top2Id = primaryId;
                top2Weight = 0;
                changed = mergedDuplicate;
                return;
            }

            if (w2 <= 0 || secondaryId < 0)
            {
                top2Id = primaryId;
                top2Weight = 0;
                changed = secondaryId != primaryId || secondaryWeight != 0;
                return;
            }

            int origPrimary = primaryId;
            int origSecondary = secondaryId;
            byte origWeight = secondaryWeight;

            if (w2 > w1)
            {
                swappedOrder = true;
                int tmpId = primaryId;
                primaryId = secondaryId;
                secondaryId = tmpId;

                int tmpW = w1;
                w1 = w2;
                w2 = tmpW;
            }

            if (secondaryId == primaryId || w2 <= 0)
            {
                mergedDuplicate = secondaryId == primaryId;
                top1Id = primaryId;
                top2Id = primaryId;
                top2Weight = 0;
            }
            else
            {
                int denom = Math.Max(1, w1 + w2);
                int outW = (255 * w2) / denom;
                top1Id = primaryId;
                top2Id = secondaryId;
                top2Weight = (byte)Mathf.Clamp(outW, 0, 255);
            }

            changed = top1Id != origPrimary || top2Id != origSecondary || top2Weight != origWeight || mergedDuplicate;
        }

        private void BuildTerrainControlTextures(
            int tileWidth,
            int tileHeight,
            Dictionary<int, int> groundLayerById,
            Dictionary<int, int> factureLayerById,
            GroundRuntimeConfig runtimeCfg,
            out Texture2D control0,
            out Texture2D control1,
            out Texture2D control2,
            out Texture2D control3,
            out Texture2D control4,
            out string info)
        {
            control0 = null;
            control1 = null;
            control2 = null;
            control3 = null;
            control4 = null;
            info = "";

            try
            {
                int count = Math.Max(1, tileWidth * tileHeight);
                var pixels0 = new Color32[count];
                var pixels1 = new Color32[count];
                var pixels2 = new Color[count];
                var pixels3 = new Color32[count];
                var pixels4 = new Color32[count];
                int crossingApplied = 0;
                int texExActive = 0;
                int texExDominant = 0;
                int factureVariants = 0;
                int exMapChanged = 0;
                int exMapMerged = 0;
                int exMapSwapped = 0;
                var crossingKinds = new SortedSet<int>();

                for (int idx = 0; idx < count; idx++)
                {
                    int rawPrimaryId = (_map.TilePrimary != null && idx < _map.TilePrimary.Length) ? _map.TilePrimary[idx] : 0;
                    int rawSecondaryId = (_map.TileSecondary != null && idx < _map.TileSecondary.Length) ? _map.TileSecondary[idx] : rawPrimaryId;
                    byte rawSecondaryW = (_map.TileSecondaryWeight != null && idx < _map.TileSecondaryWeight.Length) ? _map.TileSecondaryWeight[idx] : (byte)0;
                    int factureId = (_map.FactureMap != null && idx < _map.FactureMap.Length) ? _map.FactureMap[idx] : 0;
                    byte factureW = (_map.FactureWeight != null && idx < _map.FactureWeight.Length) ? _map.FactureWeight[idx] : (byte)0;

                    NormalizePrebakedTop2LikeExMap(
                        rawPrimaryId,
                        rawSecondaryId,
                        rawSecondaryW,
                        out int primaryId,
                        out int secondaryId,
                        out byte secondaryW,
                        out bool top2Changed,
                        out bool top2Merged,
                        out bool top2Swapped);

                    if (top2Changed) exMapChanged++;
                    if (top2Merged) exMapMerged++;
                    if (top2Swapped) exMapSwapped++;

                    int baseLayer = groundLayerById.TryGetValue(primaryId, out int baseHit) ? baseHit : 0;
                    int secondaryLayer = groundLayerById.TryGetValue(secondaryId, out int secHit) ? secHit : baseLayer;
                    int factureLayer = factureLayerById.TryGetValue(factureId, out int factHit) ? factHit : 0;

                    byte crossing = 1;
                    if (runtimeCfg != null && runtimeCfg.TexCrossing != null &&
                        primaryId >= 0 && primaryId < 64 &&
                        secondaryId >= 0 && secondaryId < 64)
                    {
                        crossing = runtimeCfg.TexCrossing[primaryId + secondaryId * 64];
                        if (secondaryW > 0)
                        {
                            crossingApplied++;
                            texExActive++;
                            if (secondaryW > 127)
                                texExDominant++;
                            crossingKinds.Add(crossing);
                        }
                    }

                    byte baseUse = 0;
                    byte secondaryUse = 0;
                    if (runtimeCfg != null && runtimeCfg.GTex != null)
                    {
                        if (primaryId >= 0 && primaryId < runtimeCfg.GTex.Length && runtimeCfg.GTex[primaryId] != null)
                            baseUse = runtimeCfg.GTex[primaryId].Usage;
                        if (secondaryId >= 0 && secondaryId < runtimeCfg.GTex.Length && runtimeCfg.GTex[secondaryId] != null)
                            secondaryUse = runtimeCfg.GTex[secondaryId].Usage;
                    }

                    float rawHeight = (_map.Heights != null && idx < _map.Heights.Length) ? _map.Heights[idx] : 0.0f;
                    float rawOption = (_map.Options != null && idx < _map.Options.Length) ? _map.Options[idx] : 0.0f;
                    byte primaryOpt = (_map.TilePrimaryOpt != null && idx < _map.TilePrimaryOpt.Length) ? _map.TilePrimaryOpt[idx] : (byte)0;
                    byte secondaryOpt = (_map.TileSecondaryOpt != null && idx < _map.TileSecondaryOpt.Length) ? _map.TileSecondaryOpt[idx] : primaryOpt;
                    if (secondaryW == 0 || secondaryId == primaryId)
                        secondaryOpt = primaryOpt;

                    byte factureOpt = 0;
                    byte factureMaxW = 0;
                    byte factureEdgeV = 0;
                    if (_map != null && _map.Heights != null && idx < _map.Heights.Length)
                    {
                        int tIdx = ComputeOriginalFactureTIdx(_map, runtimeCfg, idx, factureId);
                        factureOpt = (byte)Mathf.Clamp(tIdx >> 8, 0, 255);
                        factureMaxW = (byte)Mathf.Clamp(ComputeOriginalFactureMaxWeight(_map, runtimeCfg, idx, tIdx), 0, 255);
                        factureEdgeV = (byte)Mathf.Clamp(Mathf.RoundToInt(ComputeOriginalFactureEdgeV(_map, idx) * 255.0f), 0, 255);
                        if (factureOpt != 0)
                            factureVariants++;
                    }

                    pixels0[idx] = new Color32(
                        (byte)Mathf.Clamp(baseLayer, 0, 255),
                        (byte)Mathf.Clamp(secondaryLayer, 0, 255),
                        (byte)Mathf.Clamp(factureLayer, 0, 255),
                        secondaryW);

                    int dominantTex = (secondaryW > 127 && secondaryId != primaryId) ? secondaryId : primaryId;
                    pixels1[idx] = new Color32(
                        factureW,
                        crossing,
                        (byte)Mathf.Clamp(primaryId, 0, 255),
                        (byte)Mathf.Clamp(dominantTex, 0, 255));

                    pixels2[idx] = new Color(baseUse, secondaryUse, rawHeight, rawOption);
                    pixels3[idx] = new Color32(primaryOpt, secondaryOpt, 0, 255);
                    pixels4[idx] = new Color32(factureOpt, factureMaxW, factureEdgeV, 255);
                }

                control0 = new Texture2D(tileWidth, tileHeight, TextureFormat.RGBA32, false, true);
                control0.name = "C2_TerrainControl0";
                control0.wrapMode = TextureWrapMode.Clamp;
                control0.filterMode = FilterMode.Point;
                control0.SetPixels32(pixels0);
                control0.Apply(false, false);

                control1 = new Texture2D(tileWidth, tileHeight, TextureFormat.RGBA32, false, true);
                control1.name = "C2_TerrainControl1";
                control1.wrapMode = TextureWrapMode.Clamp;
                control1.filterMode = FilterMode.Point;
                control1.SetPixels32(pixels1);
                control1.Apply(false, false);

                control2 = new Texture2D(tileWidth, tileHeight, TextureFormat.RGBAHalf, false, true);
                control2.name = "C2_TerrainControl2";
                control2.wrapMode = TextureWrapMode.Clamp;
                control2.filterMode = FilterMode.Point;
                control2.SetPixels(pixels2);
                control2.Apply(false, false);

                control3 = new Texture2D(tileWidth, tileHeight, TextureFormat.RGBA32, false, true);
                control3.name = "C2_TerrainControl3";
                control3.wrapMode = TextureWrapMode.Clamp;
                control3.filterMode = FilterMode.Point;
                control3.SetPixels32(pixels3);
                control3.Apply(false, false);

                control4 = new Texture2D(tileWidth, tileHeight, TextureFormat.RGBA32, false, true);
                control4.name = "C2_TerrainControl4";
                control4.wrapMode = TextureWrapMode.Clamp;
                control4.filterMode = FilterMode.Point;
                control4.SetPixels32(pixels4);
                control4.Apply(false, false);

                int baseOptNonZero = _map.TilePrimaryOpt != null ? _map.TilePrimaryOpt.Count(v => v != 0) : 0;
                int secOptNonZero = _map.TileSecondaryOpt != null ? _map.TileSecondaryOpt.Count(v => v != 0) : 0;
                info = $"control0={control0.width}x{control0.height} control1={control1.width}x{control1.height} control2={control2.width}x{control2.height} control3={control3.width}x{control3.height} control4={control4.width}x{control4.height} texCrossingApplied={crossingApplied} crossingKinds={FormatIdList(crossingKinds.ToArray(), 16)} texExActive={texExActive} texExDominant={texExDominant} exMapChanged={exMapChanged} exMapMerged={exMapMerged} exMapSwapped={exMapSwapped} baseOptNonZero={baseOptNonZero} secOptNonZero={secOptNonZero} factureVariants={factureVariants}";
            }
            catch (Exception ex)
            {
                info = "BuildTerrainControlTextures failed: " + ex.Message;
                if (control0 != null) SafeDestroy(control0);
                if (control1 != null) SafeDestroy(control1);
                if (control2 != null) SafeDestroy(control2);
                if (control3 != null) SafeDestroy(control3);
                if (control4 != null) SafeDestroy(control4);
                control0 = null;
                control1 = null;
                control2 = null;
                control3 = null;
                control4 = null;
            }
        }

        private Texture2DArray BuildTextureArrayFromResolved(
            Dictionary<int, Texture2D> resolved,
            int targetSize,
            Color placeholderColor,
            out Dictionary<int, int> layerById,
            out string info,
            string tag)
        {
            layerById = new Dictionary<int, int>();
            info = "";

            int actualCount = 1 + (resolved != null ? resolved.Count : 0);
            var array = new Texture2DArray(targetSize, targetSize, actualCount, TextureFormat.RGBA32, true, false);
            array.wrapMode = TextureWrapMode.Repeat;
            array.filterMode = FilterMode.Trilinear;
            array.anisoLevel = 8;

            var solid = new Color[targetSize * targetSize];
            for (int i = 0; i < solid.Length; i++)
                solid[i] = placeholderColor;
            array.SetPixels(solid, 0);

            int copied = 0;
            var failed = new List<string>();
            int layer = 1;

            if (resolved != null)
            {
                foreach (var kv in resolved.OrderBy(x => x.Key))
                {
                    if (TryUploadTextureToArrayLayer(array, layer, kv.Value, targetSize, out string copyInfo))
                    {
                        layerById[kv.Key] = layer;
                        copied++;
                        layer++;
                    }
                    else
                    {
                        failed.Add($"id={kv.Key}:{copyInfo}");
                    }
                }
            }

            array.Apply(true, false);
            info = $"arrayTag={tag} target={targetSize} requested={(resolved != null ? resolved.Count : 0)} copied={copied} failed={failed.Count} failTop={string.Join(" | ", failed.Take(8).ToArray())}";
            return array;
        }

        private static bool TryUploadTextureToArrayLayer(Texture2DArray array, int layer, Texture2D src, int targetSize, out string info)
        {
            info = "";
            if (array == null)
            {
                info = "array=null";
                return false;
            }

            if (src == null)
            {
                info = "src=null";
                return false;
            }

            RenderTexture rt = null;
            Texture2D staging = null;
            RenderTexture prev = RenderTexture.active;

            try
            {
                rt = RenderTexture.GetTemporary(targetSize, targetSize, 0, RenderTextureFormat.ARGB32, RenderTextureReadWrite.Default);
                rt.wrapMode = TextureWrapMode.Repeat;
                rt.filterMode = FilterMode.Bilinear;

                Graphics.Blit(src, rt);
                RenderTexture.active = rt;

                staging = new Texture2D(targetSize, targetSize, TextureFormat.RGBA32, false, false);
                staging.ReadPixels(new Rect(0, 0, targetSize, targetSize), 0, 0, false);
                staging.Apply(false, false);

                array.SetPixels32(staging.GetPixels32(), layer);
                info = $"ok src={src.name} srcSize={src.width}x{src.height}";
                return true;
            }
            catch (Exception ex)
            {
                info = ex.GetType().Name + ": " + ex.Message;
                return false;
            }
            finally
            {
                RenderTexture.active = prev;
                if (rt != null)
                    RenderTexture.ReleaseTemporary(rt);
                if (staging != null)
                {
                    if (Application.isPlaying) UnityEngine.Object.Destroy(staging);
                    else UnityEngine.Object.DestroyImmediate(staging);
                }
            }
        }
        private static void GetTerrainModePreviewFlags(int mode, out bool includeSecondary, out bool includeFacture, out string renderPath)
        {
            includeSecondary = false;
            includeFacture = false;

            switch (Mathf.Clamp(mode, 1, 7))
            {
                case 1:
                    renderPath = "height-gray";
                    return;
                case 2:
                    renderPath = "tile-base";
                    return;
                case 3:
                    includeSecondary = true;
                    renderPath = "tile-plus-second";
                    return;
                case 4:
                    includeSecondary = true;
                    includeFacture = true;
                    renderPath = "tile-plus-second-plus-facture";
                    return;
                case 5:
                    renderPath = "second-mask";
                    return;
                case 6:
                    renderPath = "facture-mask";
                    return;
                case 7:
                    renderPath = "base-index-falsecolor";
                    return;
                default:
                    renderPath = "unknown";
                    return;
            }
        }

        private Texture2D TryBuildTerrainTextureForMode(string selectedId, Mesh terrainMesh, int mode, bool includeSecondary, bool includeFacture, out string info)
        {
            switch (Mathf.Clamp(mode, 1, 7))
            {
                case 1:
                    return TryBuildHeightGrayTexture(selectedId, out info);
                case 2:
                    return TryBuildTerrainPreviewTexture(selectedId, terrainMesh, false, false, out info);
                case 3:
                    return TryBuildTerrainPreviewTexture(selectedId, terrainMesh, true, false, out info);
                case 4:
                    return TryBuildTerrainPreviewTexture(selectedId, terrainMesh, true, true, out info);
                case 5:
                    return TryBuildSecondaryMaskTexture(selectedId, out info);
                case 6:
                    return TryBuildFactureMaskTexture(selectedId, out info);
                case 7:
                    return TryBuildBaseIndexFalseColorTexture(selectedId, includeSecondary, out info);
                default:
                    info = "unsupported-mode";
                    return null;
            }
        }

        private bool TryGetTerrainPreviewRasterSize(out int tileWidth, out int tileHeight, out int cellsX, out int cellsY, out int outW, out int outH, out int expected, out string info)
        {
            tileWidth = tileHeight = cellsX = cellsY = outW = outH = expected = 0;
            info = "";
            if (_map == null)
            {
                info = "map=null";
                return false;
            }

            tileWidth = Math.Max(1, _map.TileWidth > 0 ? _map.TileWidth : _map.VertInLine);
            tileHeight = Math.Max(1, _map.TileHeight > 0 ? _map.TileHeight : _map.MaxTH);
            expected = tileWidth * tileHeight;
            cellsX = Math.Max(1, tileWidth - 1);
            cellsY = Math.Max(1, tileHeight - 1);
            outW = Mathf.Clamp(cellsX * 4, 1024, 4096);
            outH = Mathf.Clamp(cellsY * 4, 1024, 4096);
            return true;
        }

        private static float SampleScalarBilinear(float s00, float s10, float s01, float s11, float fx, float fy)
        {
            return Mathf.Lerp(Mathf.Lerp(s00, s10, fx), Mathf.Lerp(s01, s11, fx), fy);
        }

        private static Color SampleColorBilinear(Color c00, Color c10, Color c01, Color c11, float fx, float fy)
        {
            return Color.Lerp(Color.Lerp(c00, c10, fx), Color.Lerp(c01, c11, fx), fy);
        }

        private static Color32 MakeDebugIdColor(int id)
        {
            uint v = unchecked((uint)(id * 1103515245 + 12345));
            byte r = (byte)(48 + ((v >> 16) & 0xAF));
            byte g = (byte)(48 + ((v >> 8) & 0xAF));
            byte b = (byte)(48 + (v & 0xAF));
            return new Color32(r, g, b, 255);
        }

        private Texture2D TryBuildHeightGrayTexture(string selectedId, out string info)
        {
            info = "";
            if (!TryGetTerrainPreviewRasterSize(out int tileWidth, out int tileHeight, out int cellsX, out int cellsY, out int outW, out int outH, out int expected, out string sizeInfo))
            {
                info = sizeInfo;
                return null;
            }

            if (_map.Heights == null || _map.Heights.Length < expected)
            {
                info = $"Heights missing/short len={(_map.Heights != null ? _map.Heights.Length : 0)} expected={expected}";
                return null;
            }

            short minH = short.MaxValue;
            short maxH = short.MinValue;
            for (int i = 0; i < expected; i++)
            {
                short h = _map.Heights[i];
                if (h < minH) minH = h;
                if (h > maxH) maxH = h;
            }

            float denom = Mathf.Max(1.0f, maxH - minH);
            var pixels = new Color32[outW * outH];
            for (int py = 0; py < outH; py++)
            {
                float gy = ((py + 0.5f) / outH) * cellsY;
                int cy = Mathf.Clamp(Mathf.FloorToInt(gy), 0, cellsY - 1);
                float fy = gy - cy;
                int row = cy * tileWidth;
                int nextRow = (cy + 1) * tileWidth;

                for (int px = 0; px < outW; px++)
                {
                    float gx = ((px + 0.5f) / outW) * cellsX;
                    int cx = Mathf.Clamp(Mathf.FloorToInt(gx), 0, cellsX - 1);
                    float fx = gx - cx;

                    int v00 = row + cx;
                    int v10 = v00 + 1;
                    int v01 = nextRow + cx;
                    int v11 = v01 + 1;

                    float h = SampleScalarBilinear(_map.Heights[v00], _map.Heights[v10], _map.Heights[v01], _map.Heights[v11], fx, fy);
                    byte g = (byte)Mathf.Clamp(Mathf.RoundToInt(((h - minH) / denom) * 255.0f), 0, 255);
                    pixels[py * outW + px] = new Color32(g, g, g, 255);
                }
            }

            var baked = new Texture2D(outW, outH, TextureFormat.RGBA32, false, false);
            baked.name = selectedId + "_terrain_height_gray";
            baked.wrapMode = TextureWrapMode.Clamp;
            baked.filterMode = FilterMode.Bilinear;
            baked.SetPixels32(pixels);
            baked.Apply(false, false);
            info = $"mode=height-gray out={outW}x{outH} heights={expected} minH={minH} maxH={maxH} sampler=bilinear-gray";
            return baked;
        }

        private Texture2D TryBuildSecondaryMaskTexture(string selectedId, out string info)
        {
            info = "";
            if (!TryGetTerrainPreviewRasterSize(out int tileWidth, out int tileHeight, out int cellsX, out int cellsY, out int outW, out int outH, out int expected, out string sizeInfo))
            {
                info = sizeInfo;
                return null;
            }

            if (_map.TileSecondaryWeight == null || _map.TileSecondaryWeight.Length < expected)
            {
                info = $"TileSecondaryWeight missing/short len={(_map.TileSecondaryWeight != null ? _map.TileSecondaryWeight.Length : 0)} expected={expected}";
                return null;
            }

            var pixels = new Color32[outW * outH];
            int nonZero = 0;
            int maxW = 0;
            for (int i = 0; i < expected; i++)
            {
                int w = ScaleSecondaryWeightLikeOriginal(_map.TileSecondaryWeight[i]);
                if (w > 0) nonZero++;
                if (w > maxW) maxW = w;
            }

            for (int py = 0; py < outH; py++)
            {
                float gy = ((py + 0.5f) / outH) * cellsY;
                int cy = Mathf.Clamp(Mathf.FloorToInt(gy), 0, cellsY - 1);
                float fy = gy - cy;
                int row = cy * tileWidth;
                int nextRow = (cy + 1) * tileWidth;

                for (int px = 0; px < outW; px++)
                {
                    float gx = ((px + 0.5f) / outW) * cellsX;
                    int cx = Mathf.Clamp(Mathf.FloorToInt(gx), 0, cellsX - 1);
                    float fx = gx - cx;

                    int v00 = row + cx;
                    int v10 = v00 + 1;
                    int v01 = nextRow + cx;
                    int v11 = v01 + 1;

                    float w = SampleScalarBilinear(
                        ScaleSecondaryWeightLikeOriginal(_map.TileSecondaryWeight[v00]),
                        ScaleSecondaryWeightLikeOriginal(_map.TileSecondaryWeight[v10]),
                        ScaleSecondaryWeightLikeOriginal(_map.TileSecondaryWeight[v01]),
                        ScaleSecondaryWeightLikeOriginal(_map.TileSecondaryWeight[v11]),
                        fx,
                        fy);
                    byte g = (byte)Mathf.Clamp(Mathf.RoundToInt(w), 0, 255);
                    pixels[py * outW + px] = new Color32(g, g, g, 255);
                }
            }

            var baked = new Texture2D(outW, outH, TextureFormat.RGBA32, false, false);
            baked.name = selectedId + "_terrain_second_mask";
            baked.wrapMode = TextureWrapMode.Clamp;
            baked.filterMode = FilterMode.Bilinear;
            baked.SetPixels32(pixels);
            baked.Apply(false, false);
            info = $"mode=second-mask out={outW}x{outH} weights={expected} nonZero={nonZero} maxW={maxW} sampler=bilinear-scal6over5-gray";
            return baked;
        }

        private Texture2D TryBuildFactureMaskTexture(string selectedId, out string info)
        {
            info = "";
            if (!TryGetTerrainPreviewRasterSize(out int tileWidth, out int tileHeight, out int cellsX, out int cellsY, out int outW, out int outH, out int expected, out string sizeInfo))
            {
                info = sizeInfo;
                return null;
            }

            if (_map.FactureWeight == null || _map.FactureWeight.Length < expected)
            {
                info = $"FactureWeight missing/short len={(_map.FactureWeight != null ? _map.FactureWeight.Length : 0)} expected={expected}";
                return null;
            }

            var pixels = new Color32[outW * outH];
            int nonZero = 0;
            int maxW = 0;
            for (int i = 0; i < expected; i++)
            {
                int w = _map.FactureWeight[i] & 0xFF;
                if (w > 0) nonZero++;
                if (w > maxW) maxW = w;
            }

            for (int py = 0; py < outH; py++)
            {
                float gy = ((py + 0.5f) / outH) * cellsY;
                int cy = Mathf.Clamp(Mathf.FloorToInt(gy), 0, cellsY - 1);
                float fy = gy - cy;
                int row = cy * tileWidth;
                int nextRow = (cy + 1) * tileWidth;

                for (int px = 0; px < outW; px++)
                {
                    float gx = ((px + 0.5f) / outW) * cellsX;
                    int cx = Mathf.Clamp(Mathf.FloorToInt(gx), 0, cellsX - 1);
                    float fx = gx - cx;

                    int v00 = row + cx;
                    int v10 = v00 + 1;
                    int v01 = nextRow + cx;
                    int v11 = v01 + 1;

                    float w = SampleScalarBilinear(
                        _map.FactureWeight[v00] & 0xFF,
                        _map.FactureWeight[v10] & 0xFF,
                        _map.FactureWeight[v01] & 0xFF,
                        _map.FactureWeight[v11] & 0xFF,
                        fx,
                        fy);
                    byte g = (byte)Mathf.Clamp(Mathf.RoundToInt(w), 0, 255);
                    pixels[py * outW + px] = new Color32(g, g, g, 255);
                }
            }

            var baked = new Texture2D(outW, outH, TextureFormat.RGBA32, false, false);
            baked.name = selectedId + "_terrain_facture_mask";
            baked.wrapMode = TextureWrapMode.Clamp;
            baked.filterMode = FilterMode.Bilinear;
            baked.SetPixels32(pixels);
            baked.Apply(false, false);
            info = $"mode=facture-mask out={outW}x{outH} weights={expected} nonZero={nonZero} maxW={maxW} sampler=bilinear-gray";
            return baked;
        }

        private Texture2D TryBuildBaseIndexFalseColorTexture(string selectedId, bool includeSecondary, out string info)
        {
            info = "";
            if (!TryGetTerrainPreviewRasterSize(out int tileWidth, out int tileHeight, out int cellsX, out int cellsY, out int outW, out int outH, out int expected, out string sizeInfo))
            {
                info = sizeInfo;
                return null;
            }

            if (_map.TilePrimary == null || _map.TilePrimary.Length < expected)
            {
                info = $"TilePrimary missing/short len={(_map.TilePrimary != null ? _map.TilePrimary.Length : 0)} expected={expected}";
                return null;
            }

            var pixels = new Color32[outW * outH];
            var used = new HashSet<int>();
            for (int i = 0; i < expected; i++)
                used.Add(_map.TilePrimary[i] & 0xFF);

            for (int py = 0; py < outH; py++)
            {
                float gy = ((py + 0.5f) / outH) * cellsY;
                int cy = Mathf.Clamp(Mathf.FloorToInt(gy), 0, cellsY - 1);
                float fy = gy - cy;
                int row = cy * tileWidth;
                int nextRow = (cy + 1) * tileWidth;

                for (int px = 0; px < outW; px++)
                {
                    float gx = ((px + 0.5f) / outW) * cellsX;
                    int cx = Mathf.Clamp(Mathf.FloorToInt(gx), 0, cellsX - 1);
                    float fx = gx - cx;

                    int v00 = row + cx;
                    int v10 = v00 + 1;
                    int v01 = nextRow + cx;
                    int v11 = v01 + 1;

                    Color c = SampleColorBilinear(
                        MakeDebugIdColor(_map.TilePrimary[v00] & 0xFF),
                        MakeDebugIdColor(_map.TilePrimary[v10] & 0xFF),
                        MakeDebugIdColor(_map.TilePrimary[v01] & 0xFF),
                        MakeDebugIdColor(_map.TilePrimary[v11] & 0xFF),
                        fx,
                        fy);

                    if (includeSecondary && _map.TileSecondaryWeight != null && _map.TileSecondaryWeight.Length >= expected)
                    {
                        float w = SampleScalarBilinear(
                            ScaleSecondaryWeightLikeOriginal(_map.TileSecondaryWeight[v00]),
                            ScaleSecondaryWeightLikeOriginal(_map.TileSecondaryWeight[v10]),
                            ScaleSecondaryWeightLikeOriginal(_map.TileSecondaryWeight[v01]),
                            ScaleSecondaryWeightLikeOriginal(_map.TileSecondaryWeight[v11]),
                            fx,
                            fy) / 255.0f;
                        c = Color.Lerp(c, Color.white, Mathf.Clamp01(w * 0.35f));
                    }

                    pixels[py * outW + px] = (Color32)c;
                }
            }

            var baked = new Texture2D(outW, outH, TextureFormat.RGBA32, false, false);
            baked.name = selectedId + "_terrain_base_falsecolor";
            baked.wrapMode = TextureWrapMode.Clamp;
            baked.filterMode = FilterMode.Bilinear;
            baked.SetPixels32(pixels);
            baked.Apply(false, false);
            info = $"mode=base-index-falsecolor out={outW}x{outH} idsUsed={used.Count} secondaryTint={(includeSecondary ? 1 : 0)} sampler=bilinear-falsecolor";
            return baked;
        }

        private Texture2D TryBuildTerrainPreviewTexture(string selectedId, Mesh terrainMesh, bool includeSecondary, bool includeFacture, out string info)
        {
            info = "";
            if (_map == null)
            {
                info = "map=null";
                return null;
            }

            if (_map.TilePrimary == null || _map.TilePrimary.Length == 0)
            {
                info = "TilePrimary missing";
                return null;
            }

            GroundTextureCatalog catalog = GetOrCreateGroundCatalog(out string catalogInfo);
            if (catalog == null || catalog.ByName.Count == 0)
            {
                info = "catalog empty; " + catalogInfo;
                return null;
            }

            GroundRuntimeConfig runtimeCfg = GetOrCreateGroundRuntimeConfig(out string runtimeInfo);
            EnsureGroundTextureTable(runtimeCfg, catalog);
            short[] randoma = GetRandomTableLikeOriginal(runtimeCfg);
            SeedStrictCRandLikeOriginal(1);

            int tileWidth = Math.Max(1, _map.TileWidth > 0 ? _map.TileWidth : _map.VertInLine);
            int tileHeight = Math.Max(1, _map.TileHeight > 0 ? _map.TileHeight : _map.MaxTH);
            int expected = tileWidth * tileHeight;
            if (_map.TilePrimary.Length < expected)
            {
                info = $"tile array too short: len={_map.TilePrimary.Length} expected={expected}; {catalogInfo}";
                return null;
            }

            var groundUsed = new SortedSet<int>();
            var factureUsed = new SortedSet<int>();
            for (int i = 0; i < expected; i++)
            {
                groundUsed.Add(_map.TilePrimary[i] & 0xFF);
                if (includeSecondary && _map.TileSecondary != null && i < _map.TileSecondary.Length)
                    groundUsed.Add(_map.TileSecondary[i] & 0xFF);
                if (includeFacture && _map.FactureMap != null && i < _map.FactureMap.Length)
                    factureUsed.Add(_map.FactureMap[i] & 0xFF);
            }

            var resolvedGround = new Dictionary<int, Texture2D>();
            var missingGround = new List<int>();
            foreach (int id in groundUsed)
            {
                Texture2D tex = ResolveTextureForTileId(catalog, runtimeCfg, id);
                if (tex != null) resolvedGround[id] = tex;
                else missingGround.Add(id);
            }

            var resolvedFacture = new Dictionary<int, Texture2D>();
            var missingFacture = new List<int>();
            if (includeFacture)
            {
                foreach (int id in factureUsed)
                {
                    Texture2D tex = ResolveTextureForFactureId(catalog, runtimeCfg, id);
                    if (tex != null) resolvedFacture[id] = tex;
                    else missingFacture.Add(id);
                }
            }

            int cellsX = Math.Max(1, tileWidth - 1);
            int cellsY = Math.Max(1, tileHeight - 1);
            int outW = Mathf.Clamp(cellsX * 4, 1024, 4096);
            int outH = Mathf.Clamp(cellsY * 4, 1024, 4096);
            var readableCache = new Dictionary<int, Texture2D>();
            var readableStatsPrev = s_activeReadableTextureStats;
            var readableStats = new ReadableTextureBuildStats();
            s_activeReadableTextureStats = readableStats;
            var pixels = new Color32[outW * outH];

            int triOdd = 0;
            int triEven = 0;
            int passSamples = 0;
            int missingSamples = 0;
            int factureSamples = 0;

            for (int py = 0; py < outH; py++)
            {
                float gy = ((py + 0.5f) / outH) * cellsY;
                int cy = Mathf.Clamp(Mathf.FloorToInt(gy), 0, cellsY - 1);
                float fy = gy - cy;

                for (int px = 0; px < outW; px++)
                {
                    float gx = ((px + 0.5f) / outW) * cellsX;
                    int cx = Mathf.Clamp(Mathf.FloorToInt(gx), 0, cellsX - 1);
                    float fx = gx - cx;

                    int v00 = cy * tileWidth + cx;
                    int v10 = v00 + 1;
                    int v01 = v00 + tileWidth;
                    int v11 = v01 + 1;

                    bool odd = (cx & 1) != 0;
                    Vector3 bary;
                    int a, b, c;
                    int triKind;

                    if (odd)
                    {
                        if (fx + fy <= 1.0f)
                        {
                            bary = ComputeBarycentric2D(new Vector2(fx, fy), new Vector2(0f, 0f), new Vector2(1f, 0f), new Vector2(0f, 1f));
                            a = v00; b = v10; c = v01;
                            triKind = 0;
                        }
                        else
                        {
                            bary = ComputeBarycentric2D(new Vector2(fx, fy), new Vector2(0f, 1f), new Vector2(1f, 0f), new Vector2(1f, 1f));
                            a = v01; b = v10; c = v11;
                            triKind = 1;
                        }
                        triOdd++;
                    }
                    else
                    {
                        if (fy <= fx)
                        {
                            bary = ComputeBarycentric2D(new Vector2(fx, fy), new Vector2(0f, 0f), new Vector2(1f, 0f), new Vector2(1f, 1f));
                            a = v00; b = v10; c = v11;
                            triKind = 2;
                        }
                        else
                        {
                            bary = ComputeBarycentric2D(new Vector2(fx, fy), new Vector2(0f, 0f), new Vector2(1f, 1f), new Vector2(0f, 1f));
                            a = v00; b = v11; c = v01;
                            triKind = 3;
                        }
                        triEven++;
                    }

                    int ta = _map.TilePrimary[a] & 0xFF;
                    int tb = _map.TilePrimary[b] & 0xFF;
                    int tc = _map.TilePrimary[c] & 0xFF;

                    int tMin = ta;
                    int tAve = tb;
                    int tMax = tc;
                    Sort3LikeOriginal(ref tMin, ref tAve, ref tMax);

                    Color accum = Color.black;
                    float total = 0.0f;

                    passSamples += AddStage1PassColor(ref accum, ref total, resolvedGround, readableCache, randoma, triKind, 0, tMin, ta, tb, tc, a, b, c, v00, v10, v01, v11, bary);
                    if (tAve != tMin)
                        passSamples += AddStage1PassColor(ref accum, ref total, resolvedGround, readableCache, randoma, triKind, 1, tAve, ta, tb, tc, a, b, c, v00, v10, v01, v11, bary);
                    if (tMax != tMin && tMax != tAve)
                        passSamples += AddStage1PassColor(ref accum, ref total, resolvedGround, readableCache, randoma, triKind, 2, tMax, ta, tb, tc, a, b, c, v00, v10, v01, v11, bary);

                    if (total <= 1e-6f)
                    {
                        missingSamples++;
                        pixels[py * outW + px] = new Color32(128, 128, 128, 255);
                        continue;
                    }

                    Color cOut = accum / Mathf.Max(total, 1e-6f);
                    cOut.a = 1.0f;

                    if (includeSecondary && _map.TileSecondary != null && _map.TileSecondaryWeight != null)
                    {
                        int sa = (a < _map.TileSecondary.Length) ? (_map.TileSecondary[a] & 0xFF) : ta;
                        int sb = (b < _map.TileSecondary.Length) ? (_map.TileSecondary[b] & 0xFF) : tb;
                        int sc = (c < _map.TileSecondary.Length) ? (_map.TileSecondary[c] & 0xFF) : tc;

                        int wa = (a < _map.TileSecondaryWeight.Length) ? ScaleSecondaryWeightLikeOriginal(_map.TileSecondaryWeight[a]) : 0;
                        int wb = (b < _map.TileSecondaryWeight.Length) ? ScaleSecondaryWeightLikeOriginal(_map.TileSecondaryWeight[b]) : 0;
                        int wc = (c < _map.TileSecondaryWeight.Length) ? ScaleSecondaryWeightLikeOriginal(_map.TileSecondaryWeight[c]) : 0;

                        if (wa > 0 || wb > 0 || wc > 0)
                        {
                            int sMin = sa;
                            int sAve = sb;
                            int sMax = sc;
                            Sort3LikeOriginal(ref sMin, ref sAve, ref sMax);

                            passSamples += AddStage2PassColor(ref cOut, resolvedGround, readableCache, randoma, triKind, 0, sMin, sa, sb, sc, wa, wb, wc, a, b, c, v00, v10, v01, v11, bary);
                            if (sAve != sMin)
                                passSamples += AddStage2PassColor(ref cOut, resolvedGround, readableCache, randoma, triKind, 1, sAve, sa, sb, sc, wa, wb, wc, a, b, c, v00, v10, v01, v11, bary);
                            if (sMax != sMin && sMax != sAve)
                                passSamples += AddStage2PassColor(ref cOut, resolvedGround, readableCache, randoma, triKind, 2, sMax, sa, sb, sc, wa, wb, wc, a, b, c, v00, v10, v01, v11, bary);
                        }
                    }

                    if (includeFacture && _map.FactureMap != null && _map.FactureWeight != null)
                    {
                        int fa = (a < _map.FactureMap.Length) ? (_map.FactureMap[a] & 0xFF) : 0;
                        int fb = (b < _map.FactureMap.Length) ? (_map.FactureMap[b] & 0xFF) : 0;
                        int fc = (c < _map.FactureMap.Length) ? (_map.FactureMap[c] & 0xFF) : 0;

                        int fwa = (a < _map.FactureWeight.Length) ? _map.FactureWeight[a] : 0;
                        int fwb = (b < _map.FactureWeight.Length) ? _map.FactureWeight[b] : 0;
                        int fwc = (c < _map.FactureWeight.Length) ? _map.FactureWeight[c] : 0;

                        if (fwa > 0 || fwb > 0 || fwc > 0)
                        {
                            int f1 = ComputeOriginalFactureTIdx(_map, runtimeCfg, a, fa);
                            int f2 = ComputeOriginalFactureTIdx(_map, runtimeCfg, b, fb);
                            int f3 = ComputeOriginalFactureTIdx(_map, runtimeCfg, c, fc);

                            factureSamples += AddFacturePassColor(ref cOut, resolvedFacture, readableCache, runtimeCfg, a, b, c, f1, f1, f2, f3, fwa, fwb, fwc, bary);
                            if (fwb > 0 && f2 != f1)
                                factureSamples += AddFacturePassColor(ref cOut, resolvedFacture, readableCache, runtimeCfg, a, b, c, f2, f1, f2, f3, fwa, fwb, fwc, bary);
                            if (fwc > 0 && f3 != f1 && f3 != f2)
                                factureSamples += AddFacturePassColor(ref cOut, resolvedFacture, readableCache, runtimeCfg, a, b, c, f3, f1, f2, f3, fwa, fwb, fwc, bary);
                        }
                    }

                    pixels[py * outW + px] = (Color32)cOut;
                }
            }

            var baked = new Texture2D(outW, outH, TextureFormat.RGBA32, false, false);
            baked.name = selectedId + (includeFacture ? "_terrain_stage3_preview" : (includeSecondary ? "_terrain_stage2_preview" : "_terrain_stage1_preview"));
            baked.wrapMode = TextureWrapMode.Clamp;
            baked.filterMode = FilterMode.Bilinear;
            baked.SetPixels32(pixels);
            baked.Apply(false, false);

            var missingGroundNames = string.Join(" | ", missingGround.Take(12).Select(BuildTextureCandidateList).ToArray());
            var missingFactureNames = string.Join(" | ", missingFacture.Take(12).Select(id => BuildFactureCandidateList(runtimeCfg, id)).ToArray());
            string modeName = includeFacture ? "factures3d-stage3-facture-parity" : (includeSecondary ? "factures3d-stage2-parity" : "factures3d-stage1-parity");
            string texExMode = includeSecondary ? "texmapex-wtexmapex-scal" : "disabled-stage1";
            string factMode = includeFacture ? "facturemap-factureweight-getfactureuvw" : "disabled";
            info =
                $"mode={modeName} out={outW}x{outH} groundUsed={groundUsed.Count} groundFound={resolvedGround.Count} groundMissing={missingGround.Count} groundMissingTop={missingGroundNames} factUsed={factureUsed.Count} factFound={resolvedFacture.Count} factMissing={missingFacture.Count} factMissingTop={missingFactureNames} " +
                $"triOdd={triOdd} triEven={triEven} passSamples={passSamples} factureSamples={factureSamples} missingSamples={missingSamples} includeSecondary={includeSecondary} includeFacture={includeFacture} texUvMode=getbaseu-getbasev-getvvalue normalize=vertextex-lr lighting=False texExMode={texExMode} secondWeightMode=scal-6over5 factureMode={factMode} {readableStats.ToSummary()}; {catalogInfo}; {runtimeInfo}";
            s_activeReadableTextureStats = readableStatsPrev;
            return baked;
        }
        private static Color SampleGroundColor(Dictionary<int, Texture2D> resolvedGround, Dictionary<int, Texture2D> readableCache, int id, float worldX, float worldY, float worldH)
        {
            Texture2D tex;
            if (resolvedGround == null || !resolvedGround.TryGetValue(id, out tex) || tex == null)
                return new Color(0.72f, 0.74f, 0.70f, 1.0f);

            return SampleTextureColor(tex, readableCache, worldX, worldY, worldH, 256.0f, 256.0f, 1.0f);
        }

        private static Color SampleTextureColor(Texture2D src, Dictionary<int, Texture2D> readableCache, float worldX, float worldY, float worldH, float scaleU, float scaleV, float brightness)
        {
            Texture2D readable = GetReadableTexture(src, readableCache);
            if (readable == null)
                return new Color(0.72f, 0.74f, 0.70f, 1.0f);

            float u = Frac01(worldX / Mathf.Max(1.0f, scaleU));
            float v = Frac01((worldY + worldH) / Mathf.Max(1.0f, scaleV));
            Color c = readable.GetPixelBilinear(u, v);
            c.r = Mathf.Clamp01(c.r * brightness);
            c.g = Mathf.Clamp01(c.g * brightness);
            c.b = Mathf.Clamp01(c.b * brightness);
            c.a = 1.0f;
            return c;
        }

        private static Texture2D GetReadableTexture(Texture2D src, Dictionary<int, Texture2D> cache)
        {
            if (src == null)
                return null;

            int key = src.GetInstanceID();
            Texture2D existing;
            if (cache != null && cache.TryGetValue(key, out existing) && existing != null)
            {
                if (s_activeReadableTextureStats != null)
                    s_activeReadableTextureStats.LocalCacheHits++;
                return existing;
            }

            Texture2D globalExisting;
            if (s_globalReadableTextureCache.TryGetValue(key, out globalExisting) && globalExisting != null)
            {
                if (cache != null)
                    cache[key] = globalExisting;
                if (s_activeReadableTextureStats != null)
                    s_activeReadableTextureStats.GlobalCacheHits++;
                return globalExisting;
            }

            bool isReadable = false;
            try
            {
                isReadable = src.isReadable;
            }
            catch
            {
                isReadable = false;
            }

            if (isReadable)
            {
                if (cache != null)
                    cache[key] = src;
                s_globalReadableTextureCache[key] = src;
                if (s_activeReadableTextureStats != null)
                    s_activeReadableTextureStats.DirectReadableHits++;
                return src;
            }

            Texture2D readable = TryCreateReadableCopyViaRenderTexture(src);
            if (readable != null)
            {
                if (cache != null)
                    cache[key] = readable;
                s_globalReadableTextureCache[key] = readable;
                if (s_activeReadableTextureStats != null)
                {
                    s_activeReadableTextureStats.GpuReadbackCopies++;
                    s_activeReadableTextureStats.GpuCopyNames.Add(src.name);
                }
                if (s_loggedReadableGpuFallback.Add(key))
                    Debug.Log($"[C2:REN] readableTextureFallback tex={src.name} size={src.width}x{src.height} mode=rt-readback stage=4");
                return readable;
            }

            if (s_activeReadableTextureStats != null)
            {
                s_activeReadableTextureStats.Failures++;
                s_activeReadableTextureStats.FailureNames.Add(src.name);
            }
            if (s_loggedReadableFailures.Add(key))
                Debug.LogWarning($"[C2:REN] readableTextureFailed tex={src.name} size={src.width}x{src.height} mode=rt-readback stage=4");
            return null;
        }

        private static Texture2D TryCreateReadableCopyViaRenderTexture(Texture2D src)
        {
            if (src == null)
                return null;

            RenderTexture rt = RenderTexture.GetTemporary(
                Math.Max(4, src.width),
                Math.Max(4, src.height),
                0,
                RenderTextureFormat.ARGB32,
                RenderTextureReadWrite.Default);

            var prev = RenderTexture.active;
            try
            {
                Graphics.Blit(src, rt);
                RenderTexture.active = rt;
                var readable = new Texture2D(rt.width, rt.height, TextureFormat.RGBA32, false, false);
                readable.name = src.name + "_ReadableRT";
                readable.ReadPixels(new Rect(0, 0, rt.width, rt.height), 0, 0, false);
                readable.Apply(false, false);
                readable.wrapMode = TextureWrapMode.Repeat;
                readable.filterMode = FilterMode.Bilinear;
                return readable;
            }
            catch
            {
                return null;
            }
            finally
            {
                RenderTexture.active = prev;
                RenderTexture.ReleaseTemporary(rt);
            }
        }




        private static Vector3 ComputeBarycentric2D(Vector2 p, Vector2 a, Vector2 b, Vector2 c)
        {
            float det = (b.y - c.y) * (a.x - c.x) + (c.x - b.x) * (a.y - c.y);
            if (Mathf.Abs(det) < 1e-8f)
                return new Vector3(1.0f, 0.0f, 0.0f);
            float w1 = ((b.y - c.y) * (p.x - c.x) + (c.x - b.x) * (p.y - c.y)) / det;
            float w2 = ((c.y - a.y) * (p.x - c.x) + (a.x - c.x) * (p.y - c.y)) / det;
            float w3 = 1.0f - w1 - w2;
            if (w1 < 0f) w1 = 0f;
            if (w2 < 0f) w2 = 0f;
            if (w3 < 0f) w3 = 0f;
            float s = w1 + w2 + w3;
            if (s > 1e-8f)
            {
                w1 /= s;
                w2 /= s;
                w3 /= s;
            }
            return new Vector3(w1, w2, w3);
        }

        private static void Sort3LikeOriginal(ref int v1, ref int v2, ref int v3)
        {
            int[] v = { -v1, -v2, -v3 };
            bool c;
            do
            {
                c = false;
                if (v[0] > v[1]) { int t = v[0]; v[0] = v[1]; v[1] = t; c = true; }
                if (v[1] > v[2]) { int t = v[1]; v[1] = v[2]; v[2] = t; c = true; }
            } while (c);
            v1 = -v[0];
            v2 = -v[1];
            v3 = -v[2];
        }

        private static int GetVValueLikeOriginal(short[] randoma, int vertex, int rset)
        {
            if (randoma == null || randoma.Length != 8192)
                return 0;
            int idx = (vertex * rset) & 8191;
            return randoma[idx];
        }

        private static Vector2 BuildStage1SeedSlice(short[] randoma, int vertexU, int rsetU, int vertexV, int rsetV)
        {
            float u0 = (GetVValueLikeOriginal(randoma, vertexU, rsetU) & 31) / 64.0f;
            float v0 = (GetVValueLikeOriginal(randoma, vertexV, rsetV) % 28) / 64.0f;
            return new Vector2(u0, v0);
        }

        private static Vector2 InterpolateTriUV(Vector2 uv0, Vector2 uv1, Vector2 uv2, Vector3 bary)
        {
            return uv0 * bary.x + uv1 * bary.y + uv2 * bary.z;
        }

        private static int ScaleSecondaryWeightLikeOriginal(byte w)
        {
            int x = w;
            x = (x * 6) / 5;
            if (x < 0) x = 0;
            if (x > 255) x = 255;
            return x;
        }

        private static void GetTriPassUvLikeOriginal(int triKind, int passRank, short[] randoma, int v00, int v10, int v01, int v11, out Vector2 uv0, out Vector2 uv1, out Vector2 uv2)
        {
            Vector2 seed;
            switch (triKind)
            {
                case 0: // odd left: V00,V10,V01
                    if (passRank == 0) seed = BuildStage1SeedSlice(randoma, v00, 71, v00, 77);
                    else if (passRank == 1) seed = BuildStage1SeedSlice(randoma, v11, 93, v11, 97);
                    else seed = BuildStage1SeedSlice(randoma, v10, 77, v00, 67);
                    uv0 = seed + new Vector2(0.0f, 0.0f);
                    uv1 = seed + new Vector2(0.5f, 0.25f);
                    uv2 = seed + new Vector2(0.0f, 0.5f);
                    return;
                case 1: // odd right: V01,V10,V11
                    if (passRank == 0) seed = BuildStage1SeedSlice(randoma, v10, 73, v00, 79);
                    else if (passRank == 1) seed = BuildStage1SeedSlice(randoma, v00, 63, v10, 97);
                    else seed = BuildStage1SeedSlice(randoma, v00, 93, v00, 61);
                    uv0 = seed + new Vector2(0.0f, 0.25f);
                    uv1 = seed + new Vector2(0.5f, 0.0f);
                    uv2 = seed + new Vector2(0.5f, 0.5f);
                    return;
                case 2: // even upper-right: V00,V10,V11
                    if (passRank == 0) seed = BuildStage1SeedSlice(randoma, v00, 47, v00, 49);
                    else if (passRank == 1) seed = BuildStage1SeedSlice(randoma, v00, 171, v00, 371);
                    else seed = BuildStage1SeedSlice(randoma, v00, 711, v00, 211);
                    uv0 = seed + new Vector2(0.0f, 0.25f);
                    uv1 = seed + new Vector2(0.5f, 0.0f);
                    uv2 = seed + new Vector2(0.5f, 0.5f);
                    return;
                default: // even lower-left: V00,V11,V01
                    if (passRank == 0) seed = BuildStage1SeedSlice(randoma, v00, 111, v00, 113);
                    else if (passRank == 1) seed = BuildStage1SeedSlice(randoma, v00, 79, v00, 39);
                    else seed = BuildStage1SeedSlice(randoma, v00, 29, v00, 37);
                    uv0 = seed + new Vector2(0.0f, 0.0f);
                    uv1 = seed + new Vector2(0.5f, 0.25f);
                    uv2 = seed + new Vector2(0.0f, 0.5f);
                    return;
            }
        }

        private static int AddStage2PassColor(
            ref Color baseColor,
            Dictionary<int, Texture2D> resolvedGround,
            Dictionary<int, Texture2D> readableCache,
            short[] randoma,
            int triKind,
            int passRank,
            int candidateTex,
            int ta,
            int tb,
            int tc,
            int wa,
            int wb,
            int wc,
            int a,
            int b,
            int c,
            int v00,
            int v10,
            int v01,
            int v11,
            Vector3 bary)
        {
            float alpha = 0.0f;
            if (ta == candidateTex) alpha += bary.x * (wa / 255.0f);
            if (tb == candidateTex) alpha += bary.y * (wb / 255.0f);
            if (tc == candidateTex) alpha += bary.z * (wc / 255.0f);
            alpha = Mathf.Clamp01(alpha);
            if (alpha <= 1e-6f)
                return 0;

            Texture2D tex;
            if (resolvedGround == null || !resolvedGround.TryGetValue(candidateTex, out tex) || tex == null)
                return 0;

            Texture2D readable = GetReadableTexture(tex, readableCache);
            if (readable == null)
                return 0;

            Vector2 uv0;
            Vector2 uv1;
            Vector2 uv2;
            GetTriPassUvLikeOriginal(triKind, passRank, randoma, v00, v10, v01, v11, out uv0, out uv1, out uv2);
            Vector2 uv = InterpolateTriUV(uv0, uv1, uv2, bary);
            Color sample = readable.GetPixelBilinear(Frac01(uv.x), Frac01(uv.y));
            sample.a = 1.0f;
            baseColor = Color.Lerp(baseColor, sample, alpha);
            baseColor.a = 1.0f;
            return 1;
        }

        private int AddFacturePassColor(
            ref Color baseColor,
            Dictionary<int, Texture2D> resolvedFacture,
            Dictionary<int, Texture2D> readableCache,
            GroundRuntimeConfig cfg,
            int a,
            int b,
            int c,
            int candidateTIdx,
            int faIdx,
            int fbIdx,
            int fcIdx,
            int wa,
            int wb,
            int wc,
            Vector3 bary)
        {
            int candidateTex = candidateTIdx & 255;
            Texture2D tex;
            if (resolvedFacture == null || !resolvedFacture.TryGetValue(candidateTex, out tex) || tex == null)
                return 0;

            Texture2D readable = GetReadableTexture(tex, readableCache);
            if (readable == null)
                return 0;

            Vector2 uva, uvb, uvc;
            int maxWa, maxWb, maxWc;
            if (!TryGetFactureUvLikeOriginal(cfg, a, candidateTIdx, out uva, out maxWa))
                return 0;
            if (!TryGetFactureUvLikeOriginal(cfg, b, candidateTIdx, out uvb, out maxWb))
                return 0;
            if (!TryGetFactureUvLikeOriginal(cfg, c, candidateTIdx, out uvc, out maxWc))
                return 0;

            if (faIdx != candidateTIdx) maxWa = 0;
            if (fbIdx != candidateTIdx) maxWb = 0;
            if (fcIdx != candidateTIdx) maxWc = 0;

            if (wa < maxWa) maxWa = wa;
            if (wb < maxWb) maxWb = wb;
            if (wc < maxWc) maxWc = wc;

            float alpha = bary.x * (maxWa / 255.0f) + bary.y * (maxWb / 255.0f) + bary.z * (maxWc / 255.0f);
            alpha = Mathf.Clamp01(alpha);
            if (alpha <= 1e-6f)
                return 0;

            Vector2 uv = InterpolateTriUV(uva, uvb, uvc, bary);
            Color sample = readable.GetPixelBilinear(Frac01(uv.x), Frac01(uv.y));
            sample.a = 1.0f;
            baseColor = Color.Lerp(baseColor, sample, alpha);
            baseColor.a = 1.0f;
            return 1;
        }

        private bool TryGetFactureUvDiffuseLikeOriginal(GroundRuntimeConfig cfg, int vertex, int tIdx, out Vector2 uv, out int maxW, out uint diffuse)
        {
            uv = Vector2.zero;
            maxW = 0;
            diffuse = ((uint)vertex) & 0x00FFFFFFu;
            if (_map == null || _map.VertInLine <= 0)
                return false;

            int idx = tIdx & 255;
            int opt = tIdx >> 8;
            int usage = GetFactureUsageLikeOriginal(cfg, idx);
            int vx = vertex % _map.VertInLine;
            int vy = vertex / _map.VertInLine;

            int tx = (vx << 5) + (usage == 0 ? GetXShiftLikeOriginal(vertex) : 0);
            int ty = (vy << 5) - ((vx & 1) << 4) + (usage == 0 ? GetYShiftLikeOriginal(vertex) : 0);
            int h = GetMapHeightSafe(_map, vertex, vertex);
            float u = 0.0f;
            float v = 0.0f;

            if (usage == 0)
            {
                int adop = (opt >> 6) + 1;
                u = (tx + (opt & 7) * 32) / 256.0f;
                v = (ty + ((opt / 8) & 7) * 32) / 512.0f * adop;
                maxW = idx == 0 ? 0xA0 : 255;
            }
            else
            {
                int hlu, hld, hru, hrd, hu, hd;
                if ((vx & 1) != 0)
                {
                    ty -= 16;
                    if (vy > 0)
                    {
                        hu = GetMapHeightSafe(_map, vertex - _map.VertInLine, vertex);
                        hlu = GetMapHeightSafe(_map, vertex - _map.VertInLine - 1, vertex);
                        hru = GetMapHeightSafe(_map, vertex - _map.VertInLine + 1, vertex);
                    }
                    else
                    {
                        hu = h; hlu = h; hru = h;
                    }
                    hld = GetMapHeightSafe(_map, vertex - 1, vertex);
                    hrd = GetMapHeightSafe(_map, vertex + 1, vertex);
                    hd = GetMapHeightSafe(_map, vertex + _map.VertInLine, vertex);
                }
                else
                {
                    if (vx > 0)
                    {
                        hlu = GetMapHeightSafe(_map, vertex - 1, vertex);
                        hld = GetMapHeightSafe(_map, vertex + _map.VertInLine - 1, vertex);
                    }
                    else
                    {
                        hlu = h; hld = h;
                    }
                    hu = vy > 0 ? GetMapHeightSafe(_map, vertex - _map.VertInLine, vertex) : h;
                    hru = GetMapHeightSafe(_map, vertex + 1, vertex);
                    hrd = GetMapHeightSafe(_map, vertex + _map.VertInLine + 1, vertex);
                    hd = GetMapHeightSafe(_map, vertex + _map.VertInLine, vertex);
                }

                if (usage == 1)
                {
                    v = -h / 180.0f;
                    maxW = 180 * Math.Min(
                        Min3LikeOriginal(MaxD3LikeOriginal(hlu, h, hld), MaxD3LikeOriginal(hlu, hu, h), MaxD3LikeOriginal(hu, h, hru)),
                        Min3LikeOriginal(MaxD3LikeOriginal(hru, hrd, h), MaxD3LikeOriginal(hrd, hd, h), MaxD3LikeOriginal(hd, h, hld))
                    );
                    if (opt == 1) u = tx / 256.0f;
                    else if (opt == 2) u = ty / 256.0f;
                    else if (opt == 3) u = (tx + ty) / 256.0f / 1.4142f;
                    else u = (tx - ty) / 256.0f / 1.4142f;
                    u *= 1.5f;
                    v *= 1.5f;
                    if (maxW > 255) maxW = 255;
                }
                else if (usage == 2)
                {
                    int x = vx << 5;
                    int y = (vy << 5) - ((vx & 1) << 4);
                    Vector3 normal = GetSurfaceNLikeOriginal(_map, x, y);
                    float n = (1.0f - normal.z) * 2.0f;
                    if (n > 1.0f) n = 1.0f;
                    if (n < 0.0f) n = 0.0f;
                    v = n;
                    maxW = 180 * Math.Min(
                        Min3LikeOriginal(MaxD3LikeOriginal(hlu, h, hld), MaxD3LikeOriginal(hlu, hu, h), MaxD3LikeOriginal(hu, h, hru)),
                        Min3LikeOriginal(MaxD3LikeOriginal(hru, hrd, h), MaxD3LikeOriginal(hrd, hd, h), MaxD3LikeOriginal(hd, h, hld))
                    );
                    if (opt == 1) u = tx / 256.0f;
                    else if (opt == 2) u = ty / 256.0f;
                    else if (opt == 3) u = (tx + ty) / 256.0f / 1.4142f;
                    else u = (tx - ty) / 256.0f / 1.4142f;
                    u *= 1.5f;
                    v *= 1.5f;
                    if (maxW > 255) maxW = 255;
                }
                else
                {
                    int adop = (opt >> 6) + 1;
                    u = (tx + (opt & 7) * 32) / 256.0f;
                    v = (ty + ((opt / 8) & 7) * 32) / 512.0f * adop;
                    maxW = idx == 0 ? 0xA0 : 255;
                }
            }

            float du = 0.0f, dv = 0.0f, su = 1.0f, sv = 1.0f;
            if (cfg != null && cfg.Factures != null && idx >= 0 && idx < cfg.Factures.Length && cfg.Factures[idx] != null)
            {
                du = cfg.Factures[idx].UShift;
                dv = cfg.Factures[idx].VShift;
                su = cfg.Factures[idx].UScale;
                sv = cfg.Factures[idx].VScale;
            }
            uv = new Vector2((u + du) * su, (v + dv) * sv);
            if (maxW < 0) maxW = 0;
            if (maxW > 255) maxW = 255;
            return true;
        }

        private static int AddStage1PassColor(
            ref Color accum,
            ref float total,
            Dictionary<int, Texture2D> resolvedGround,
            Dictionary<int, Texture2D> readableCache,
            short[] randoma,
            int triKind,
            int passRank,
            int candidateTex,
            int ta,
            int tb,
            int tc,
            int a,
            int b,
            int c,
            int v00,
            int v10,
            int v01,
            int v11,
            Vector3 bary)
        {
            float alpha = 0.0f;
            if (ta == candidateTex) alpha += bary.x;
            if (tb == candidateTex) alpha += bary.y;
            if (tc == candidateTex) alpha += bary.z;
            if (alpha <= 1e-6f)
                return 0;

            Vector2 uv0;
            Vector2 uv1;
            Vector2 uv2;
            GetTriPassUvLikeOriginal(triKind, passRank, randoma, v00, v10, v01, v11, out uv0, out uv1, out uv2);

            Texture2D tex;
            if (resolvedGround == null || !resolvedGround.TryGetValue(candidateTex, out tex) || tex == null)
                return 0;

            Texture2D readable = GetReadableTexture(tex, readableCache);
            if (readable == null)
                return 0;

            Vector2 uv = InterpolateTriUV(uv0, uv1, uv2, bary);
            Color sample = readable.GetPixelBilinear(Frac01(uv.x), Frac01(uv.y));
            sample.a = 1.0f;
            accum += sample * alpha;
            total += alpha;
            return 1;
        }

        private GroundRuntimeConfig GetOrCreateGroundRuntimeConfig(out string info)
        {
            if (_groundRuntimeConfig != null)
            {
                info = _groundRuntimeConfig.Info;
                return _groundRuntimeConfig;
            }

            var cfg = new GroundRuntimeConfig();
            cfg.GroundUsage = BuildDefaultGroundUsage();
            cfg.TexCrossing = new byte[64 * 64];
            for (int i = 0; i < cfg.TexCrossing.Length; i++)
                cfg.TexCrossing[i] = 1;

            var notes = new List<string>();
            int crossLoaded = 0;

            var fs = _bootstrap != null ? _bootstrap.Fs : null;
            if (fs != null)
            {
                string factPath = fs.Exists("Factures.dat") ? "Factures.dat" : (fs.Exists("factures.dat") ? "factures.dat" : null);
                if (!string.IsNullOrWhiteSpace(factPath))
                {
                    try
                    {
                        byte[] rawBytes = fs.ReadAllBytes(factPath) ?? Array.Empty<byte>();
                        int scanPos = 0;
                        int assigned = 0;
                        int scanned = 0;
                        while (assigned < OriginalStrictGTexCount && assigned < cfg.GroundUsage.Length)
                        {
                            int value;
                            if (!TryReadNextIntLikeGscanf(rawBytes, ref scanPos, out value))
                                break;
                            cfg.GroundUsage[assigned++] = value;
                            scanned++;
                        }
                        notes.Add("facturesDat=" + assigned);
                        notes.Add("facturesDatTokens=" + scanned);
                        notes.Add("facturesDatDefaults=" + Math.Max(0, Math.Min(OriginalStrictGTexCount, cfg.GroundUsage.Length) - assigned));
                    }
                    catch (Exception ex)
                    {
                        notes.Add("facturesDatErr=" + ex.Message);
                    }
                }

                string texListPath = fs.Exists("textures.lst") ? "textures.lst" : null;
                if (!string.IsNullOrWhiteSpace(texListPath))
                {
                    try
                    {
                        string[] lines = fs.ReadAllText(texListPath).Replace("\r", "").Split('\n');
                        foreach (string raw in lines)
                        {
                            string line = raw.Trim();
                            if (string.IsNullOrWhiteSpace(line))
                                continue;

                            if (line.StartsWith("#CROSSX", StringComparison.OrdinalIgnoreCase))
                            {
                                string[] parts = SplitTokens(line);
                                if (parts.Length >= 3)
                                {
                                    int t1, t2;
                                    if (int.TryParse(parts[1], out t1) && int.TryParse(parts[2], out t2) && t1 >= 0 && t1 < 64 && t2 >= 0 && t2 < 4)
                                    {
                                        for (int i = 0; i < 64; i++)
                                        {
                                            cfg.TexCrossing[i + t1 * 64] = (byte)t2;
                                            cfg.TexCrossing[t1 + i * 64] = (byte)t2;
                                        }
                                        crossLoaded++;
                                    }
                                }
                            }
                            else if (line.StartsWith("#CROSS", StringComparison.OrdinalIgnoreCase))
                            {
                                string[] parts = SplitTokens(line);
                                if (parts.Length >= 4)
                                {
                                    int t1, t2, t3;
                                    if (int.TryParse(parts[1], out t1) && int.TryParse(parts[2], out t2) && int.TryParse(parts[3], out t3)
                                        && t1 >= 0 && t1 < 64 && t2 >= 0 && t2 < 64 && t3 >= 0 && t3 < 4)
                                    {
                                        cfg.TexCrossing[t1 + t2 * 64] = (byte)t3;
                                        cfg.TexCrossing[t2 + t1 * 64] = (byte)t3;
                                        crossLoaded++;
                                    }
                                }
                            }
                        }
                    }
                    catch (Exception ex)
                    {
                        notes.Add("texListErr=" + ex.Message);
                    }
                }

                string factureXmlPath = fs.Exists("FacturesList.xml") ? "FacturesList.xml" : (fs.Exists("factureslist.xml") ? "factureslist.xml" : null);
                if (!string.IsNullOrWhiteSpace(factureXmlPath))
                {
                    try
                    {
                        string xml = fs.ReadAllText(factureXmlPath);
                        cfg.Factures = ParseFacturesListXml(xml);
                        notes.Add("factureXml=" + cfg.Factures.Length);
                    }
                    catch (Exception ex)
                    {
                        notes.Add("factureXmlErr=" + ex.Message);
                    }
                }

                string randomPath = fs.Exists("random.lst") ? "random.lst" : (fs.Exists("Data1/random.lst") ? "Data1/random.lst" : null);
                if (!string.IsNullOrWhiteSpace(randomPath))
                {
                    try
                    {
                        byte[] raw = fs.ReadAllBytes(randomPath) ?? Array.Empty<byte>();
                        if (raw.Length >= 16384)
                        {
                            cfg.RandomTable = new short[8192];
                            for (int i = 0; i < 8192; i++)
                                cfg.RandomTable[i] = BitConverter.ToInt16(raw, i * 2);
                            notes.Add("randomLst=8192");
                        }
                        else
                        {
                            notes.Add("randomLstShort=" + raw.Length);
                        }
                    }
                    catch (Exception ex)
                    {
                        notes.Add("randomLstErr=" + ex.Message);
                    }
                }
            }

            cfg.Info = $"strictGTex={OriginalStrictGTexCount} bridgeGTex={cfg.GTex.Length} usageCount={cfg.GroundUsage.Length} crossRules={crossLoaded} factureXml={cfg.Factures.Length} randomTable={(cfg.RandomTable != null ? cfg.RandomTable.Length : 0)} notes={string.Join(",", notes.ToArray())}";
            _groundRuntimeConfig = cfg;
            info = cfg.Info;
            Debug.Log("[C2:REN] groundRuntime " + cfg.Info);
            return cfg;
        }

        private static GroundTextureEntry[] CreateDefaultGroundTextureTable()
        {
            var arr = new GroundTextureEntry[BridgeGroundResolveCount];
            for (int i = 0; i < arr.Length; i++)
            {
                arr[i] = new GroundTextureEntry
                {
                    TextureIndex = i + 1,
                    BumpID = 0,
                    Usage = 0,
                    ExpectedName = BuildGroundExpectedName(i)
                };
            }
            for (int i = 9; i < 19 && i < arr.Length; i++)
                arr[i].Usage = 1;
            if (34 < arr.Length) arr[34].Usage = 1;
            if (35 < arr.Length) arr[35].Usage = 1;
            return arr;
        }

        private static string BuildGroundExpectedName(int zeroBasedId)
        {
            return "TEX" + (zeroBasedId + 1).ToString(CultureInfo.InvariantCulture);
        }

        private static IEnumerable<string> EnumerateGroundLookupKeys(int zeroBasedId)
        {
            string expected = BuildGroundExpectedName(zeroBasedId);
            yield return NormalizeTextureKey(expected);
            yield return NormalizeTexturePathKey("textures/Ground/" + expected);
            yield return NormalizeTexturePathKey("textures/ground/" + expected);
            yield return NormalizeTexturePathKey("textures/" + expected);
        }

        private static bool TryResolveGroundTextureFromCatalog(GroundTextureCatalog catalog, int zeroBasedId, out Texture2D tex, out string sourceFolder)
        {
            tex = null;
            sourceFolder = "";
            if (catalog == null || catalog.ByName == null || catalog.ByName.Count == 0 || zeroBasedId < 0)
                return false;

            foreach (string key in EnumerateGroundLookupKeys(zeroBasedId))
            {
                if (string.IsNullOrWhiteSpace(key))
                    continue;
                if (catalog.ByName.TryGetValue(key, out tex) && tex != null)
                {
                    if (catalog.SourceFolderByKey != null && catalog.SourceFolderByKey.TryGetValue(key, out string src) && !string.IsNullOrWhiteSpace(src))
                        sourceFolder = src;
                    return true;
                }
            }

            return false;
        }

        private static void EnsureGroundTextureTable(GroundRuntimeConfig cfg, GroundTextureCatalog catalog)
        {
            if (cfg == null || cfg.GTex == null || cfg.GTex.Length == 0 || cfg.GTexInitialized || catalog == null)
                return;

            for (int i = 0; i < cfg.GTex.Length; i++)
            {
                GroundTextureEntry e = cfg.GTex[i] ?? new GroundTextureEntry();
                e.TextureIndex = i + 1;
                e.BumpID = 0;
                e.ExpectedName = BuildGroundExpectedName(i);
                if (cfg.GroundUsage != null && i < cfg.GroundUsage.Length)
                    e.Usage = (byte)Mathf.Clamp(cfg.GroundUsage[i], 0, 255);

                if (TryResolveGroundTextureFromCatalog(catalog, i, out Texture2D tex, out string src))
                {
                    e.Texture = tex;
                    e.SourceFolder = src ?? "";
                }

                cfg.GTex[i] = e;
            }
            cfg.GTexInitialized = true;
        }

        private static Texture2D ResolveTextureForTileId(GroundTextureCatalog catalog, GroundRuntimeConfig cfg, int id)
        {
            if (id < 0)
                return null;

            if (cfg != null && cfg.GTex != null && id < cfg.GTex.Length)
            {
                GroundTextureEntry e = cfg.GTex[id];
                if (e != null && e.Texture != null)
                    return e.Texture;
            }

            if (TryResolveGroundTextureFromCatalog(catalog, id, out Texture2D tex, out _))
                return tex;

            return null;
        }

        private static FactureInfoEntry[] ParseFacturesListXml(string xml)
        {
            if (string.IsNullOrWhiteSpace(xml))
                return Array.Empty<FactureInfoEntry>();

            string body = xml.Trim();
            if (body.StartsWith("<>"))
                body = body.Substring(2);
            if (body.EndsWith("</>"))
                body = body.Substring(0, body.Length - 3);

            var doc = XDocument.Parse("<Root>" + body + "</Root>");
            var list = new List<FactureInfoEntry>();
            int idx = 0;
            foreach (var node in doc.Root.Elements("OneFactureInfo"))
            {
                var entry = new FactureInfoEntry();
                entry.Index = idx++;
                entry.SourcePath = ReadXmlValue(node, "FactureID");
                entry.TexturePathKey = NormalizeTexturePathKey(entry.SourcePath);
                entry.TextureNameKey = NormalizeTextureKey(Path.GetFileName(entry.SourcePath ?? ""));
                entry.UseBumpMap = ParseBoolLoose(ReadXmlValue(node, "UseBumpMap"));
                entry.BumpSourcePath = ReadXmlValue(node, "BumpTextureID");
                entry.BumpTexturePathKey = NormalizeTexturePathKey(entry.BumpSourcePath);
                entry.BumpTextureNameKey = NormalizeTextureKey(Path.GetFileName(entry.BumpSourcePath ?? ""));
                entry.BumpDegree = ParseFloatInvariant(ReadXmlValue(node, "BumpDegree"), 1.0f);
                entry.PBumpDegree = entry.BumpDegree;
                entry.BumpContrast = ParseFloatInvariant(ReadXmlValue(node, "BumpContrast"), 0.6f);
                entry.BumpBrightness = ParseFloatInvariant(ReadXmlValue(node, "BumpBrightness"), 1.0f);
                entry.Mapping = ParseFactureMapping(ReadXmlValue(node, "Mapping"));
                entry.UScale = ParseFloatInvariant(ReadXmlValue(node, "UScale"), 1.0f);
                entry.VScale = ParseFloatInvariant(ReadXmlValue(node, "VScale"), 1.0f);
                entry.UShift = ParseFloatInvariant(ReadXmlValue(node, "UShift"), 0.0f);
                entry.VShift = ParseFloatInvariant(ReadXmlValue(node, "VShift"), 0.0f);
                list.Add(entry);
            }
            return list.ToArray();
        }

        private static string ReadXmlValue(XElement node, string name)
        {
            if (node == null)
                return "";
            var el = node.Element(name);
            return el != null ? (el.Value ?? "").Trim() : "";
        }

        private static int ParseFactureMapping(string value)
        {
            if (string.IsNullOrWhiteSpace(value))
                return 0;
            string s = value.Trim();
            if (s.Equals("Planar", StringComparison.OrdinalIgnoreCase)) return 0;
            if (s.Equals("Vertical", StringComparison.OrdinalIgnoreCase)) return 1;
            if (s.Equals("Edges", StringComparison.OrdinalIgnoreCase)) return 2;
            int v;
            return int.TryParse(s, NumberStyles.Integer, CultureInfo.InvariantCulture, out v) ? v : 0;
        }

        private static float ParseFloatInvariant(string value, float fallback)
        {
            if (string.IsNullOrWhiteSpace(value))
                return fallback;
            float f;
            return float.TryParse(value, NumberStyles.Float, CultureInfo.InvariantCulture, out f) ? f : fallback;
        }

        private static bool ParseBoolLoose(string value)
        {
            if (string.IsNullOrWhiteSpace(value))
                return false;
            string s = value.Trim();
            return s.Equals("1", StringComparison.OrdinalIgnoreCase)
                || s.Equals("true", StringComparison.OrdinalIgnoreCase)
                || s.Equals("yes", StringComparison.OrdinalIgnoreCase)
                || s.Equals("on", StringComparison.OrdinalIgnoreCase);
        }

        private static bool TryReadNextIntLikeGscanf(byte[] data, ref int pos, out int value)
        {
            value = 0;
            if (data == null)
                return false;

            int n = data.Length;
            while (pos < n)
            {
                char ch = (char)data[pos];
                if (!char.IsWhiteSpace(ch))
                    break;
                pos++;
            }

            if (pos >= n)
                return false;

            int sign = 1;
            if (data[pos] == (byte)'-')
            {
                sign = -1;
                pos++;
            }
            else if (data[pos] == (byte)'+')
            {
                pos++;
            }

            long acc = 0;
            bool hasDigit = false;
            while (pos < n)
            {
                byte b = data[pos];
                if (b < (byte)'0' || b > (byte)'9')
                    break;
                hasDigit = true;
                acc = (acc * 10L) + (b - (byte)'0');
                pos++;
            }

            if (!hasDigit)
                return false;

            long signed = acc * sign;
            if (signed < int.MinValue) signed = int.MinValue;
            if (signed > int.MaxValue) signed = int.MaxValue;
            value = (int)signed;
            return true;
        }

        private static string[] SplitTokens(string s)
        {
            return s.Split(new[] { ' ', '\t' }, StringSplitOptions.RemoveEmptyEntries);
        }

        private static void ReadPrimaryTiles(BinaryReader br, int payloadLen, int expected, out byte[] ids, out byte[] opts)
        {
            ids = null;
            opts = null;

            if (expected > 0 && payloadLen == expected * 2)
            {
                ids = new byte[expected];
                opts = new byte[expected];
                for (int i = 0; i < expected; i++)
                {
                    ushort packed = br.ReadUInt16();
                    ids[i] = (byte)(packed & 0xFF);
                    opts[i] = (byte)((packed >> 8) & 0xFF);
                }
                return;
            }

            ids = br.ReadBytes(payloadLen);
            if (expected > 0 && ids.Length != expected)
                Array.Resize(ref ids, expected);
            opts = expected > 0 ? new byte[expected] : Array.Empty<byte>();
        }

        private static void ReadSecondaryTiles(BinaryReader br, int payloadLen, int expected, out byte[] ids, out byte[] opts, out byte[] weights)
        {
            ids = null;
            opts = null;
            weights = null;

            if (expected > 0 && payloadLen >= expected * 3)
            {
                ids = new byte[expected];
                opts = new byte[expected];
                for (int i = 0; i < expected; i++)
                {
                    ushort packed = br.ReadUInt16();
                    ids[i] = (byte)(packed & 0xFF);
                    opts[i] = (byte)((packed >> 8) & 0xFF);
                }

                weights = br.ReadBytes(expected);
                int consumed = expected * 3;
                if (payloadLen > consumed)
                    br.ReadBytes(payloadLen - consumed);
                return;
            }

            if (expected > 0 && payloadLen >= expected * 2)
            {
                ids = br.ReadBytes(expected);
                weights = br.ReadBytes(expected);
                opts = new byte[expected];
                if (payloadLen > expected * 2)
                    br.ReadBytes(payloadLen - expected * 2);
                return;
            }

            ids = br.ReadBytes(payloadLen);
            if (expected > 0 && ids.Length != expected)
                Array.Resize(ref ids, expected);
            opts = expected > 0 ? new byte[expected] : Array.Empty<byte>();
            weights = expected > 0 ? new byte[expected] : Array.Empty<byte>();
        }

        private static int[] BuildDefaultGroundUsage()
        {
            int[] usage = new int[64];
            for (int i = 9; i < 19 && i < usage.Length; i++)
                usage[i] = 1;
            if (34 < usage.Length) usage[34] = 1;
            if (35 < usage.Length) usage[35] = 1;
            return usage;
        }

        private static short[] BuildOriginalGroundOptions(ParsedMap map)
        {
            if (map == null || map.Heights == null || map.Heights.Length == 0 || map.VertInLine <= 0 || map.MaxTH <= 0)
                return null;

            short[] options = new short[map.Heights.Length];
            int cols = map.VertInLine;
            int rows = map.MaxTH;
            const int SH = 140;
            for (int iy = 0; iy < rows; iy++)
            {
                for (int ix = 0; ix < cols; ix++)
                {
                    int ofs = ix + iy * cols;
                    int RX = ix << 5;
                    int RY = ConvScrYLikeOriginal(map, RX, iy << 5) << 1;
                    int H = GetInterpolatedHeightLikeOriginal(map, RX, RY);
                    int ZR = GetInterpolatedHeightLikeOriginal(map, RX + 32, RY) + GetInterpolatedHeightLikeOriginal(map, RX + 64, RY) + GetInterpolatedHeightLikeOriginal(map, RX + 96, RY) + GetInterpolatedHeightLikeOriginal(map, RX + 128, RY);
                    int ZL = GetInterpolatedHeightLikeOriginal(map, RX - 32, RY) + GetInterpolatedHeightLikeOriginal(map, RX - 64, RY) + GetInterpolatedHeightLikeOriginal(map, RX - 96, RY) + GetInterpolatedHeightLikeOriginal(map, RX - 128, RY);
                    int ZU = GetInterpolatedHeightLikeOriginal(map, RX, RY - 32) + GetInterpolatedHeightLikeOriginal(map, RX, RY - 64) + GetInterpolatedHeightLikeOriginal(map, RX, RY - 96) + GetInterpolatedHeightLikeOriginal(map, RX, RY - 128);
                    int ZD = GetInterpolatedHeightLikeOriginal(map, RX, RY + 32) + GetInterpolatedHeightLikeOriginal(map, RX, RY + 64) + GetInterpolatedHeightLikeOriginal(map, RX, RY + 96) + GetInterpolatedHeightLikeOriginal(map, RX, RY + 128);

                    float NX = ZR - ZL;
                    float NY = ZU - ZD;
                    float NZ = 64.0f;
                    float planarN = Mathf.Sqrt(NX * NX + NY * NY);
                    if (planarN < 1e-5f)
                    {
                        options[ofs] = 0;
                        continue;
                    }

                    float fullN = Mathf.Sqrt(NX * NX + NY * NY + NZ * NZ);
                    NX /= planarN;
                    NZ /= Mathf.Max(fullN, 1e-5f);
                    options[ofs] = (short)((((H - SH) * NX) / 10.0f) * NZ * 10.0f);
                }
            }
            return options;
        }

        private static int GetTriXLikeOriginal(ParsedMap map, int vertex)
        {
            if (map == null || map.VertInLine <= 0) return 0;
            if (vertex < 0) return 0;
            return (vertex % map.VertInLine) * 32;
        }

        private static int GetTriYLikeOriginal(ParsedMap map, int vertex)
        {
            if (map == null || map.VertInLine <= 0) return 0;
            if (vertex < 0) return 0;
            int vx = vertex % map.VertInLine;
            int vy = vertex / map.VertInLine;
            return (vy << 5) - (((vx & 1) != 0) ? 16 : 0);
        }

        private static int GetInterpolatedHeightLikeOriginal(ParsedMap map, int x, int y)
        {
            if (map == null || map.Heights == null || map.Heights.Length == 0 || map.VertInLine <= 1 || map.MaxTH <= 1)
                return 0;

            int maxX = Mathf.Max(0, (map.VertInLine - 1) * 32);
            int maxY = Mathf.Max(32, (map.MaxTH - 1) * 32 + 32);
            if (x < 0) x = 0;
            if (y < 32) y = 32;
            if (x > maxX) x = maxX;
            if (y > maxY) y = maxY;
            int nx = Mathf.Clamp(x >> 5, 0, map.VertInLine - 1);

            if ((nx & 1) != 0)
            {
                int dd = x & 31;
                int dy = dd >> 1;
                int oy = 15 - dy;
                int y1 = Mathf.Clamp((y + oy) >> 5, 0, map.MaxTH - 2);
                int dy1 = (y + oy) & 31;
                if (dy1 > 32 - dd)
                {
                    int vert2 = Mathf.Clamp(nx + y1 * map.VertInLine + 1, 0, map.Heights.Length - 1);
                    int vert3 = Mathf.Clamp(vert2 + map.VertInLine, 0, map.Heights.Length - 1);
                    int vert1 = Mathf.Clamp(vert3 - 1, 0, map.Heights.Length - 1);
                    int h1 = map.Heights[vert1];
                    int h2 = map.Heights[vert2];
                    int h3 = map.Heights[vert3];
                    int x0 = nx << 5;
                    int y0 = (y1 << 5) + 16;
                    return h1 + (((x - x0) * (((h2 + h3) >> 1) - h1)) >> 5) + (((y - y0) * (h3 - h2)) >> 5);
                }
                else
                {
                    int vert2 = Mathf.Clamp(nx + y1 * map.VertInLine, 0, map.Heights.Length - 1);
                    int vert3 = Mathf.Clamp(vert2 + map.VertInLine, 0, map.Heights.Length - 1);
                    int vert1 = Mathf.Clamp(vert2 + 1, 0, map.Heights.Length - 1);
                    int h1 = map.Heights[vert1];
                    int h2 = map.Heights[vert2];
                    int h3 = map.Heights[vert3];
                    int x0 = (nx << 5) + 32;
                    int y0 = y1 << 5;
                    return h1 - (((x - x0) * (((h2 + h3) >> 1) - h1)) >> 5) + (((y - y0) * (h3 - h2)) >> 5);
                }
            }
            else
            {
                int dd = x & 31;
                int dy = dd >> 1;
                int y1 = Mathf.Clamp((y + dy) >> 5, 0, map.MaxTH - 2);
                int dy1 = (y + dy) & 31;
                if (dy1 < dd)
                {
                    int vert1 = Mathf.Clamp(nx + y1 * map.VertInLine, 0, map.Heights.Length - 1);
                    int vert2 = Mathf.Clamp(vert1 + 1, 0, map.Heights.Length - 1);
                    int vert3 = Mathf.Clamp(vert2 + map.VertInLine, 0, map.Heights.Length - 1);
                    int h1 = map.Heights[vert1];
                    int h2 = map.Heights[vert2];
                    int h3 = map.Heights[vert3];
                    int x0 = nx << 5;
                    int y0 = y1 << 5;
                    return h1 + (((x - x0) * (((h2 + h3) >> 1) - h1)) >> 5) + (((y - y0) * (h3 - h2)) >> 5);
                }
                else
                {
                    int vert2 = Mathf.Clamp(nx + y1 * map.VertInLine, 0, map.Heights.Length - 1);
                    int vert3 = Mathf.Clamp(vert2 + map.VertInLine, 0, map.Heights.Length - 1);
                    int vert1 = Mathf.Clamp(vert3 + 1, 0, map.Heights.Length - 1);
                    int h1 = map.Heights[vert1];
                    int h2 = map.Heights[vert2];
                    int h3 = map.Heights[vert3];
                    int x0 = (nx << 5) + 32;
                    int y0 = (y1 << 5) + 16;
                    return h1 - (((x - x0) * (((h2 + h3) >> 1) - h1)) >> 5) + (((y - y0) * (h3 - h2)) >> 5);
                }
            }
        }

        private static int GetPlyLikeOriginal(ParsedMap map, int vertex)
        {
            return (GetTriYLikeOriginal(map, vertex) * 3) >> 2;
        }

        private static int GetPsyLikeOriginal(ParsedMap map, int vertex)
        {
            int x = GetTriXLikeOriginal(map, vertex);
            int y = GetTriYLikeOriginal(map, vertex);
            int h = GetInterpolatedHeightLikeOriginal(map, x, y);
            if (h < 0) h = 0;
            return ((GetTriYLikeOriginal(map, vertex) * 3) >> 2) - h;
        }

        private static int ConvScrYLikeOriginal(ParsedMap map, int x, int y)
        {
            if (map == null || map.VertInLine <= 0 || map.MaxTH <= 0 || map.Heights == null || map.Heights.Length == 0)
                return y >> 1;

            const int TriUnit = 16;
            int maxPointIndex = map.Heights.Length;
            int uu = Mathf.Clamp(x / (TriUnit + TriUnit), 0, Math.Max(0, map.VertInLine - 1));
            int vertex = uu + map.VertInLine * Math.Max(0, map.MaxTH - 1);
            int v1 = ((y / TriUnit) + 50) * map.VertInLine + uu;
            if (v1 < vertex)
                vertex = v1;
            int yy2 = 0;

            while (vertex >= 0)
            {
                if (vertex < maxPointIndex - 1)
                {
                    int xp1 = GetTriXLikeOriginal(map, vertex);
                    int yp1 = GetPsyLikeOriginal(map, vertex);
                    int xp2 = GetTriXLikeOriginal(map, vertex + 1);
                    int yp2 = GetPsyLikeOriginal(map, vertex + 1);
                    int dx = xp2 - xp1;
                    int yy1 = dx != 0 ? yp1 + ((yp2 - yp1) * (x - xp1)) / dx : yp1;
                    if (yy1 < y)
                    {
                        if (vertex + map.VertInLine < maxPointIndex - 1)
                        {
                            yp1 = GetPlyLikeOriginal(map, vertex);
                            yp2 = GetPlyLikeOriginal(map, vertex + 1);
                            int besty = dx != 0 ? yp1 + ((yp2 - yp1) * (x - xp1)) / dx : yp1;
                            if (yy1 == yy2)
                                return besty;
                            return besty + (TriUnit * (y - yy1)) / (yy2 - yy1);
                        }
                        return -10000;
                    }
                    vertex -= map.VertInLine;
                    yy2 = yy1;
                }
                else return -10000;
            }
            return -10000;
        }

        private static Vector3 GetSurfaceNLikeOriginal(ParsedMap map, float x, float y)
        {
            return ComputeSurfaceNormalLikeOriginal(map, x, y);
        }

        private static Vector3 ComputeSurfaceNormalLikeOriginal(ParsedMap map, float x, float y)
        {
            float dx = GetInterpolatedHeightLikeOriginal(map, Mathf.RoundToInt(x - 64.0f), Mathf.RoundToInt(y)) - GetInterpolatedHeightLikeOriginal(map, Mathf.RoundToInt(x + 64.0f), Mathf.RoundToInt(y));
            float dy = GetInterpolatedHeightLikeOriginal(map, Mathf.RoundToInt(x), Mathf.RoundToInt(y - 64.0f)) - GetInterpolatedHeightLikeOriginal(map, Mathf.RoundToInt(x), Mathf.RoundToInt(y + 64.0f));
            var n = new Vector3(dx, dy, 128.0f);
            return n.sqrMagnitude > 1e-8f ? n.normalized : Vector3.up;
        }

        private static byte GetFactureUsageLikeOriginal(GroundRuntimeConfig cfg, int fid)
        {
            if (cfg != null && cfg.Factures != null && fid >= 0 && fid < cfg.Factures.Length && cfg.Factures[fid] != null)
                return (byte)Mathf.Clamp(cfg.Factures[fid].Mapping, 0, 255);
            return 0;
        }

        private static short[] GetRandomTableLikeOriginal(GroundRuntimeConfig cfg)
        {
            if (cfg != null && cfg.RandomTable != null && cfg.RandomTable.Length == 8192)
                return cfg.RandomTable;

            var arr = new short[8192];
            uint s = 0x12345678u;
            for (int i = 0; i < arr.Length; i++)
            {
                s ^= s << 13;
                s ^= s >> 17;
                s ^= s << 5;
                arr[i] = (short)(s & 0x7FFF);
            }
            return arr;
        }

        private static int ComputeOriginalFactureTIdx(ParsedMap map, GroundRuntimeConfig cfg, int vertex, int fid)
        {
            int tex = fid & 0xFF;
            byte use = GetFactureUsageLikeOriginal(cfg, tex);
            if (use == 2 || use == 1)
            {
                int vx = vertex % map.VertInLine;
                int vy = vertex / map.VertInLine;
                float x = vx << 5;
                float y = (vy << 5) - (((vx & 1) != 0) ? 16.0f : 0.0f);
                Vector3 vn = ComputeSurfaceNormalLikeOriginal(map, x, y);
                float anx = Mathf.Abs(vn.x);
                float any = Mathf.Abs(vn.y);
                if (any > anx * 2.0f) return tex + 256;
                if (anx > any * 2.0f) return tex + 512;
                if (vn.x < 0.0f) return tex + 768;
                return tex + 1024;
            }
            else
            {
                int vx = vertex % map.VertInLine;
                int vy = vertex / map.VertInLine;
                int uu = (vx + vy) / 12;
                int uv = (vx - vy) / 12;
                short[] randoma = GetRandomTableLikeOriginal(cfg);
                int idx = (uu + uv * 17) & 8191;
                return tex + ((randoma[idx] & 63) << 8);
            }
        }

        private static int GetMapHeightSafe(ParsedMap map, int vertex, int fallbackVertex)
        {
            if (map == null || map.Heights == null || map.Heights.Length == 0)
                return 0;
            if (vertex >= 0 && vertex < map.Heights.Length)
                return map.Heights[vertex];
            if (fallbackVertex >= 0 && fallbackVertex < map.Heights.Length)
                return map.Heights[fallbackVertex];
            return 0;
        }

        private static int Max3LikeOriginal(int v1, int v2, int v3)
        {
            return v1 > v2 ? (v3 > v1 ? v3 : v1) : (v3 > v2 ? v3 : v2);
        }

        private static int MaxD3LikeOriginal(int h1, int h2, int h3)
        {
            return Max3LikeOriginal(Math.Abs(h1 - h2), Math.Abs(h1 - h3), Math.Abs(h2 - h3));
        }

        private bool TryGetFactureUvLikeOriginal(GroundRuntimeConfig cfg, int vertex, int tIdx, out Vector2 uv, out int maxW)
        {
            return TryGetFactureUvDiffuseLikeOriginal(cfg, vertex, tIdx, out uv, out maxW, out _);
        }

        private static int Min3LikeOriginal(int a, int b, int c)
        {
            return Math.Min(a, Math.Min(b, c));
        }

        private static int ComputeOriginalFactureMaxWeight(ParsedMap map, GroundRuntimeConfig cfg, int vertex, int tIdx)
        {
            int idx = tIdx & 255;
            int usage = GetFactureUsageLikeOriginal(cfg, idx);
            if (usage == 0)
                return idx == 0 ? 0xA0 : 255;

            int vx = vertex % map.VertInLine;
            int vy = vertex / map.VertInLine;
            int h = GetMapHeightSafe(map, vertex, vertex);
            int hlu, hld, hru, hrd, hu, hd;
            if ((vx & 1) != 0)
            {
                if (vy > 0)
                {
                    hu = GetMapHeightSafe(map, vertex - map.VertInLine, vertex);
                    hlu = GetMapHeightSafe(map, vertex - map.VertInLine - 1, vertex);
                    hru = GetMapHeightSafe(map, vertex - map.VertInLine + 1, vertex);
                }
                else
                {
                    hu = h; hlu = h; hru = h;
                }
                hld = GetMapHeightSafe(map, vertex - 1, vertex);
                hrd = GetMapHeightSafe(map, vertex + 1, vertex);
                hd = GetMapHeightSafe(map, vertex + map.VertInLine, vertex);
            }
            else
            {
                if (vx > 0)
                {
                    hlu = GetMapHeightSafe(map, vertex - 1, vertex);
                    hld = GetMapHeightSafe(map, vertex + map.VertInLine - 1, vertex);
                }
                else
                {
                    hlu = h; hld = h;
                }
                hu = vy > 0 ? GetMapHeightSafe(map, vertex - map.VertInLine, vertex) : h;
                hru = GetMapHeightSafe(map, vertex + 1, vertex);
                hrd = GetMapHeightSafe(map, vertex + map.VertInLine + 1, vertex);
                hd = GetMapHeightSafe(map, vertex + map.VertInLine, vertex);
            }

            int maxW = 180 * Math.Min(
                Min3LikeOriginal(MaxD3LikeOriginal(hlu, h, hld), MaxD3LikeOriginal(hlu, hu, h), MaxD3LikeOriginal(hu, h, hru)),
                Min3LikeOriginal(MaxD3LikeOriginal(hru, hrd, h), MaxD3LikeOriginal(hrd, hd, h), MaxD3LikeOriginal(hd, h, hld))
            );
            return Math.Min(255, Math.Max(0, maxW));
        }

        private static float ComputeOriginalFactureEdgeV(ParsedMap map, int vertex)
        {
            if (map == null || map.VertInLine <= 0) return 0.0f;
            int vx = vertex % map.VertInLine;
            int vy = vertex / map.VertInLine;
            float x = vx << 5;
            float y = (vy << 5) - (((vx & 1) != 0) ? 16.0f : 0.0f);
            Vector3 v = ComputeSurfaceNormalLikeOriginal(map, x, y);
            float n = (1.0f - v.z) * 2.0f;
            if (n > 1.0f) n = 1.0f;
            if (n < 0.0f) n = 0.0f;
            return n;
        }

        
        private static string FormatIdList(IEnumerable<int> ids, int maxCount = 16)
        {
            if (ids == null)
                return "";
            var arr = ids.ToArray();
            if (arr.Length == 0)
                return "";
            if (arr.Length <= maxCount)
                return string.Join(",", arr.Select(v => v.ToString()).ToArray());
            return string.Join(",", arr.Take(maxCount).Select(v => v.ToString()).ToArray()) + $"...(+{arr.Length - maxCount})";
        }

        private void WriteStrictTextureMappingReport(
            string selectedId,
            SortedSet<int> groundUsed,
            SortedSet<int> factureUsed,
            Dictionary<int, Texture2D> resolvedGround,
            Dictionary<int, Texture2D> resolvedFacture,
            GroundTextureCatalog catalog,
            GroundRuntimeConfig cfg)
        {
            try
            {
                string safeName = MakeSafeFileName(string.IsNullOrWhiteSpace(_mapRelativePath) ? selectedId : _mapRelativePath);
                string dir = Application.persistentDataPath;
                Directory.CreateDirectory(dir);
                string reportPath = Path.Combine(dir, $"C2StrictTextureReport_{safeName}.txt");

                var missingGround = groundUsed.Where(id => !resolvedGround.ContainsKey(id)).OrderBy(id => id).ToArray();
                var missingFact = factureUsed.Where(id => !resolvedFacture.ContainsKey(id)).OrderBy(id => id).ToArray();

                var sb = new StringBuilder();
                sb.AppendLine("Cossacks2 terrain strict texture report");
                sb.AppendLine("map=" + _mapRelativePath);
                sb.AppendLine("selectedId=" + selectedId);
                sb.AppendLine("catalog=" + (catalog != null ? catalog.Info : "<null>"));
                sb.AppendLine("runtime=" + (cfg != null ? cfg.Info : "<null>"));
                sb.AppendLine("factureXmlCount=" + (cfg != null && cfg.Factures != null ? cfg.Factures.Length.ToString() : "0"));
                sb.AppendLine($"groundUsed={groundUsed.Count} resolved={resolvedGround.Count} missing={missingGround.Length} ids={FormatIdList(missingGround, 64)}");
                sb.AppendLine($"factureUsed={factureUsed.Count} resolved={resolvedFacture.Count} missing={missingFact.Length} ids={FormatIdList(missingFact, 64)}");
                sb.AppendLine();
                int reportGroundCount = Math.Max(BridgeGroundResolveCount, cfg != null && cfg.GTex != null ? cfg.GTex.Length : 0);
                sb.AppendLine($"GROUND IDS 0..{Math.Max(0, reportGroundCount - 1)}");
                for (int id = 0; id < reportGroundCount; id++)
                {
                    GroundTextureEntry ge = (cfg != null && cfg.GTex != null && id >= 0 && id < cfg.GTex.Length) ? cfg.GTex[id] : null;
                    string expected = ge != null ? ge.ExpectedName : ("TEX" + (id + 1));
                    Texture2D tex = ge != null ? ge.Texture : null;
                    bool found = tex != null;
                    string folder = ge != null && !string.IsNullOrWhiteSpace(ge.SourceFolder) ? ge.SourceFolder : "<none>";
                    int usage = ge != null ? ge.Usage : (cfg != null && cfg.GroundUsage != null && id < cfg.GroundUsage.Length ? cfg.GroundUsage[id] : -1);
                    sb.AppendLine($"GROUND id={id} expected={expected} found={found} tex={(tex != null ? tex.name : "<null>")} folder={folder} usage={usage} bump={(ge != null ? ge.BumpID : -1)}");
                }

                sb.AppendLine();
                sb.AppendLine("USED GROUND IDS");
                foreach (int id in groundUsed)
                {
                    GroundTextureEntry ge = (cfg != null && cfg.GTex != null && id >= 0 && id < cfg.GTex.Length) ? cfg.GTex[id] : null;
                    string expected = ge != null ? ge.ExpectedName : ("TEX" + (id + 1));
                    Texture2D tex = resolvedGround.TryGetValue(id, out Texture2D got) ? got : null;
                    string folder = ge != null && !string.IsNullOrWhiteSpace(ge.SourceFolder) ? ge.SourceFolder : "<none>";
                    sb.AppendLine($"GROUND used id={id} expected={expected} resolved={(tex != null)} tex={(tex != null ? tex.name : "<null>")} folder={folder} usage={(ge != null ? ge.Usage : -1)}");
                }

                sb.AppendLine();
                sb.AppendLine("USED FACTURE IDS");
                foreach (int id in factureUsed)
                {
                    FactureInfoEntry fe = (cfg != null && cfg.Factures != null && id >= 0 && id < cfg.Factures.Length) ? cfg.Factures[id] : null;
                    string expected = fe != null ? fe.SourcePath : "<xml-missing>";
                    string pathKey = fe != null ? fe.TexturePathKey : "";
                    string nameKey = fe != null ? fe.TextureNameKey : "";
                    Texture2D tex = resolvedFacture.TryGetValue(id, out Texture2D got) ? got : null;
                    string folder = "<none>";
                    if (catalog != null && catalog.SourceFolderByKey != null)
                    {
                        if (!string.IsNullOrWhiteSpace(pathKey) && catalog.SourceFolderByKey.TryGetValue(pathKey, out string src1)) folder = src1;
                        else if (!string.IsNullOrWhiteSpace(nameKey) && catalog.SourceFolderByKey.TryGetValue(nameKey, out string src2)) folder = src2;
                    }
                    sb.AppendLine($"FACTURE used id={id} expected={expected} mapping={(fe != null ? fe.Mapping : -1)} resolved={(tex != null)} tex={(tex != null ? tex.name : "<null>")} folder={folder}");
                }

                File.WriteAllText(reportPath, sb.ToString(), Encoding.UTF8);
                _lastStrictTextureReportPath = reportPath;
                _lastStrictTextureReportSummary = $"groundMissing={missingGround.Length} factMissing={missingFact.Length} factIds={FormatIdList(missingFact, 32)}";
                Debug.Log($"[C2:TEXMAP] strictReport path={reportPath} groundMissing={missingGround.Length} factMissing={missingFact.Length} missingFactIds={FormatIdList(missingFact, 32)}");
            }
            catch (Exception ex)
            {
                Debug.LogWarning("[C2:TEXMAP] strictReport failed: " + ex.Message);
            }
        }

        private static string MakeSafeFileName(string s)
        {
            if (string.IsNullOrWhiteSpace(s))
                return "unnamed";
            foreach (char c in Path.GetInvalidFileNameChars())
                s = s.Replace(c, '_');
            s = s.Replace('/', '_').Replace('\\', '_').Replace(':', '_');
            return s;
        }

private GroundTextureCatalog GetOrCreateGroundCatalog(out string info)
        {
            if (_groundCatalog != null)
            {
                info = _groundCatalog.Info;
                return _groundCatalog;
            }

            var byName = new Dictionary<string, Texture2D>(StringComparer.OrdinalIgnoreCase);
            var sourceByKey = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            int total = 0;

            void AddAlias(string key, Texture2D tex, string folder)
            {
                if (string.IsNullOrWhiteSpace(key) || tex == null)
                    return;
                if (!byName.ContainsKey(key))
                    byName[key] = tex;
                if (!sourceByKey.ContainsKey(key))
                    sourceByKey[key] = folder;
            }

            void AddTextures(string folder)
            {
                Texture2D[] arr = Resources.LoadAll<Texture2D>(folder);
                if (arr == null) return;
                foreach (var tex in arr)
                {
                    if (tex == null) continue;
                    total++;

                    string nameKey = NormalizeTextureKey(tex.name);
                    string pathKey = NormalizeTexturePathKey(folder + "/" + tex.name);

                    AddAlias(nameKey, tex, folder);
                    AddAlias(pathKey, tex, folder);

                    if (folder.Equals("textures/Ground", StringComparison.OrdinalIgnoreCase) ||
                        folder.Equals("textures/ground", StringComparison.OrdinalIgnoreCase))
                    {
                        AddAlias(NormalizeTexturePathKey("textures/ground/" + tex.name), tex, folder);
                    }
                }
            }

            AddTextures("textures/Ground");
            AddTextures("textures/ground");
            AddTextures("textures");

            var catalog = new GroundTextureCatalog();
            catalog.ByName = byName;
            catalog.SourceFolderByKey = sourceByKey;
            catalog.Info = $"resourcesLoaded={total} uniqueKeys={byName.Count} searchRoots=textures/Ground,textures";
            _groundCatalog = catalog;
            info = catalog.Info;

            var previewNames = string.Join(", ", byName.Keys.OrderBy(x => x).Take(24).ToArray());
            Debug.Log($"[C2:REN] groundCatalog {catalog.Info} preview={previewNames}");
            return catalog;
        }

        private static string BuildTextureCandidateList(int id)
        {
            return $"id={id}: GTex[{id}] -> {BuildGroundExpectedName(id)}";
        }

        private static string NormalizeTextureKey(string name)
        {
            if (string.IsNullOrWhiteSpace(name))
                return "";
            string s = name.Trim().Replace('\\', '/');
            int slash = s.LastIndexOf('/');
            if (slash >= 0 && slash + 1 < s.Length)
                s = s.Substring(slash + 1);
            if (s.EndsWith(".bmp", StringComparison.OrdinalIgnoreCase))
                s = s.Substring(0, s.Length - 4);
            if (s.EndsWith(".tga", StringComparison.OrdinalIgnoreCase))
                s = s.Substring(0, s.Length - 4);
            return s.ToUpperInvariant();
        }

        private static string NormalizeTexturePathKey(string path)
        {
            if (string.IsNullOrWhiteSpace(path))
                return "";
            string s = path.Trim().Replace('\\', '/');
            while (s.Contains("//"))
                s = s.Replace("//", "/");
            if (s.EndsWith(".bmp", StringComparison.OrdinalIgnoreCase))
                s = s.Substring(0, s.Length - 4);
            if (s.EndsWith(".tga", StringComparison.OrdinalIgnoreCase))
                s = s.Substring(0, s.Length - 4);
            return s.Trim('/').ToUpperInvariant();
        }

        private static Texture2D ResolveTextureByFlexibleKeys(GroundTextureCatalog catalog, params string[] rawKeys)
        {
            if (catalog == null || catalog.ByName == null || catalog.ByName.Count == 0 || rawKeys == null)
                return null;

            var ordered = new List<string>();
            var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            void AddKey(string key)
            {
                if (string.IsNullOrWhiteSpace(key))
                    return;
                string nameKey = NormalizeTextureKey(key);
                string pathKey = NormalizeTexturePathKey(key);
                if (!string.IsNullOrWhiteSpace(pathKey) && seen.Add(pathKey))
                    ordered.Add(pathKey);
                if (!string.IsNullOrWhiteSpace(nameKey) && seen.Add(nameKey))
                    ordered.Add(nameKey);
            }

            foreach (string key in rawKeys)
                AddKey(key);

            foreach (string key in ordered)
            {
                if (catalog.ByName.TryGetValue(key, out Texture2D tex) && tex != null)
                    return tex;
            }

            foreach (string key in ordered)
            {
                string leaf = NormalizeTextureKey(key);
                if (string.IsNullOrWhiteSpace(leaf))
                    continue;
                foreach (var kv in catalog.ByName)
                {
                    if (kv.Value == null)
                        continue;
                    string catKey = kv.Key ?? string.Empty;
                    if (catKey.Equals(leaf, StringComparison.OrdinalIgnoreCase) ||
                        catKey.EndsWith("/" + leaf, StringComparison.OrdinalIgnoreCase) ||
                        catKey.EndsWith(leaf, StringComparison.OrdinalIgnoreCase))
                        return kv.Value;
                }
            }

            return null;
        }

        private static IEnumerable<string> EnumerateBumpLookupKeysLikeOriginal(FactureInfoEntry entry, Texture2D factTex, int id)
        {
            if (entry != null)
            {
                if (!string.IsNullOrWhiteSpace(entry.BumpSourcePath))
                    yield return entry.BumpSourcePath;
                if (!string.IsNullOrWhiteSpace(entry.BumpTexturePathKey))
                    yield return entry.BumpTexturePathKey;
                if (!string.IsNullOrWhiteSpace(entry.BumpTextureNameKey))
                    yield return entry.BumpTextureNameKey;
            }

            string[] roots = { "textures/Ground/", "textures/ground/", "textures/" };
            string[] stems =
            {
                BuildGroundExpectedName(id) + "bump",
                BuildGroundExpectedName(id).ToLowerInvariant() + "bump"
            };
            foreach (string stem in stems)
            {
                yield return stem;
                foreach (string root in roots)
                    yield return root + stem;
            }

            if (factTex != null && !string.IsNullOrWhiteSpace(factTex.name))
            {
                string baseName = NormalizeTextureKey(factTex.name);
                if (!string.IsNullOrWhiteSpace(baseName))
                {
                    string[] factStems =
                    {
                        baseName + "BUMP",
                        baseName + "_BUMP",
                        baseName + "NORMAL",
                        baseName + "_NORMAL"
                    };
                    foreach (string stem in factStems)
                    {
                        yield return stem;
                        foreach (string root in roots)
                            yield return root + stem;
                    }
                }
            }
        }

        private Texture2D ResolveTextureForFactureId(GroundTextureCatalog catalog, GroundRuntimeConfig cfg, int id)
        {
            if (catalog == null || catalog.ByName == null || catalog.ByName.Count == 0)
                return null;
            if (cfg == null || cfg.Factures == null || id < 0 || id >= cfg.Factures.Length)
                return null;

            var entry = cfg.Factures[id];
            return ResolveTextureByFlexibleKeys(catalog, entry != null ? entry.TexturePathKey : null, entry != null ? entry.TextureNameKey : null);
        }

        private Texture2D ResolveBumpTextureForFactureId(GroundTextureCatalog catalog, GroundRuntimeConfig cfg, int id)
        {
            if (catalog == null || catalog.ByName == null || catalog.ByName.Count == 0)
                return null;
            if (cfg == null || cfg.Factures == null || id < 0 || id >= cfg.Factures.Length)
                return null;

            FactureInfoEntry entry = cfg.Factures[id];
            if (entry == null || !entry.UseBumpMap)
                return null;
            if (entry.BumpLookupTried)
                return entry.ResolvedBumpTexture;

            Texture2D factTex = ResolveTextureForFactureId(catalog, cfg, id);
            var fs = _bootstrap != null ? _bootstrap.Fs : null;

            Texture2D Cache(Texture2D tex, string dbg)
            {
                entry.BumpLookupTried = true;
                entry.ResolvedBumpTexture = tex;
                entry.ResolvedBumpDebug = dbg ?? "";
                if (tex != null && tex.name.StartsWith("ext_", StringComparison.OrdinalIgnoreCase) && !_terrainRuntimeOwnedObjects.Contains(tex))
                    _terrainRuntimeOwnedObjects.Add(tex);
                return tex;
            }

            if (!string.IsNullOrWhiteSpace(entry.BumpTexturePathKey) && catalog.ByName.TryGetValue(entry.BumpTexturePathKey, out Texture2D exactPathTex) && exactPathTex != null)
                return Cache(exactPathTex, "catalog:path:" + entry.BumpTexturePathKey);
            if (!string.IsNullOrWhiteSpace(entry.BumpTextureNameKey) && catalog.ByName.TryGetValue(entry.BumpTextureNameKey, out Texture2D exactNameTex) && exactNameTex != null)
                return Cache(exactNameTex, "catalog:name:" + entry.BumpTextureNameKey);

            Texture2D exactResourceTex = TryLoadTextureByExactResourcePathLikeOriginal(entry.BumpSourcePath);
            if (exactResourceTex != null)
                return Cache(exactResourceTex, "resources:exact:" + entry.BumpSourcePath);

            Texture2D exactExternalTex = TryLoadExternalFactureTextureLikeOriginal(fs, entry.BumpSourcePath, entry.BumpSourcePath);
            if (exactExternalTex != null)
                return Cache(exactExternalTex, "external:exact:" + entry.BumpSourcePath);

            string[] keys = EnumerateBumpLookupKeysLikeOriginal(entry, factTex, id).ToArray();
            Texture2D flexibleTex = ResolveTextureByFlexibleKeys(catalog, keys);
            if (flexibleTex != null)
                return Cache(flexibleTex, "catalog:flex:" + NormalizeTextureKey(flexibleTex.name));

            foreach (string key in keys)
            {
                Texture2D resTex = TryLoadTextureByExactResourcePathLikeOriginal(key);
                if (resTex != null)
                    return Cache(resTex, "resources:key:" + key);

                Texture2D extTex = TryLoadExternalFactureTextureLikeOriginal(fs, key, key);
                if (extTex != null)
                    return Cache(extTex, "external:key:" + key);
            }

            if (factTex != null && !string.IsNullOrWhiteSpace(factTex.name))
            {
                string baseName = NormalizeTextureKey(factTex.name);
                if (!string.IsNullOrWhiteSpace(baseName))
                {
                    string directStem = baseName + "BUMP";
                    Texture2D resTex = ResolveTextureByFlexibleKeys(catalog, directStem, "textures/Ground/" + directStem, "textures/" + directStem);
                    if (resTex != null)
                        return Cache(resTex, "catalog:direct:" + directStem);

                    Texture2D extTex = TryLoadExternalFactureTextureLikeOriginal(fs, "textures/Ground/" + directStem, directStem);
                    if (extTex != null)
                        return Cache(extTex, "external:direct:" + directStem);
                }
            }

            return Cache(null, "miss");
        }

        private static Texture2D TryLoadTextureByExactResourcePathLikeOriginal(string rawPath)
        {
            if (string.IsNullOrWhiteSpace(rawPath))
                return null;

            string path = rawPath.Trim().Replace('\\', '/');
            while (path.Contains("//"))
                path = path.Replace("//", "/");
            if (path.EndsWith(".bmp", StringComparison.OrdinalIgnoreCase) || path.EndsWith(".tga", StringComparison.OrdinalIgnoreCase))
                path = path.Substring(0, path.Length - 4);
            path = path.Trim('/');
            if (path.Length == 0)
                return null;

            Texture2D tex = Resources.Load<Texture2D>(path);
            if (tex != null)
                return tex;

            string lower = path.ToLowerInvariant();
            if (!string.Equals(lower, path, StringComparison.Ordinal))
            {
                tex = Resources.Load<Texture2D>(lower);
                if (tex != null)
                    return tex;
            }

            return null;
        }

        private Texture2D TryLoadExternalFactureTextureLikeOriginal(Cossacks2Bridge.Core.CoreFileSystem fs, string gameRelativePath, string displayKey)
        {
            if (fs == null || string.IsNullOrWhiteSpace(gameRelativePath))
                return null;

            foreach (string candidate in EnumerateFactureTextureCandidatesLikeOriginal(fs, gameRelativePath))
            {
                try
                {
                    if (!File.Exists(candidate))
                        continue;

                    byte[] raw = File.ReadAllBytes(candidate);
                    string ext = Path.GetExtension(candidate).ToLowerInvariant();
                    Texture2D tex = DecodeRoadTexture(raw, ext, candidate);
                    if (tex != null)
                    {
                        tex.name = "ext_" + NormalizeTextureKey(string.IsNullOrWhiteSpace(displayKey) ? gameRelativePath : displayKey);
                        tex.wrapMode = TextureWrapMode.Repeat;
                        tex.filterMode = FilterMode.Bilinear;
                        return tex;
                    }
                }
                catch (Exception ex)
                {
                    Debug.LogWarning($"[C2:BUMP] external facture texture load fail path={candidate} err={ex.Message}");
                }
            }

            return null;
        }

        private IEnumerable<string> EnumerateFactureTextureCandidatesLikeOriginal(Cossacks2Bridge.Core.CoreFileSystem fs, string gameRelativePath)
        {
            if (fs == null || string.IsNullOrWhiteSpace(gameRelativePath))
                yield break;

            string normalized = gameRelativePath.Trim().Replace('/', Path.DirectorySeparatorChar).Replace('\\', Path.DirectorySeparatorChar);
            string ext = Path.GetExtension(normalized);
            bool hasExt = !string.IsNullOrWhiteSpace(ext);
            string stem = hasExt ? normalized.Substring(0, normalized.Length - ext.Length) : normalized;
            string leaf = Path.GetFileName(stem);

            var rels = new List<string>();
            void AddRel(string rel)
            {
                if (!string.IsNullOrWhiteSpace(rel) && !rels.Any(x => string.Equals(x, rel, StringComparison.OrdinalIgnoreCase)))
                    rels.Add(rel);
            }

            AddRel(normalized);
            if (!hasExt)
            {
                foreach (string e in new[] { ".bmp", ".tga", ".png", ".jpg", ".jpeg" })
                    AddRel(stem + e);
            }

            string[] roots = { "Textures", "textures", Path.Combine("Textures", "Ground"), Path.Combine("textures", "Ground") };
            foreach (string root in roots)
            {
                AddRel(Path.Combine(root, normalized));
                if (!hasExt)
                {
                    foreach (string e in new[] { ".bmp", ".tga", ".png", ".jpg", ".jpeg" })
                        AddRel(Path.Combine(root, stem + e));
                }
                if (!string.IsNullOrWhiteSpace(leaf))
                {
                    AddRel(Path.Combine(root, leaf));
                    if (!hasExt)
                    {
                        foreach (string e in new[] { ".bmp", ".tga", ".png", ".jpg", ".jpeg" })
                            AddRel(Path.Combine(root, leaf + e));
                    }
                }
            }

            var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (string rel in rels)
            {
                string resolved = fs.ResolvePath(rel);
                if (!string.IsNullOrWhiteSpace(resolved) && seen.Add(resolved))
                    yield return resolved;
            }
        }

        private Texture2D GetFactureBumpRuntime(GroundTextureCatalog catalog, GroundRuntimeConfig cfg, int id, out float contrast, out float bright, out Texture2D factTex)
        {
            contrast = 0.0f;
            bright = 1.0f;
            factTex = ResolveTextureForFactureId(catalog, cfg, id);
            if (cfg == null || cfg.Factures == null || id < 0 || id >= cfg.Factures.Length)
                return null;

            FactureInfoEntry entry = cfg.Factures[id];
            if (entry == null || !entry.UseBumpMap)
                return null;

            Texture2D bumpTex = ResolveBumpTextureForFactureId(catalog, cfg, id);
            if (bumpTex == null)
                return null;

            contrast = entry.BumpContrast;
            bright = entry.BumpBrightness;
            float scaledDegree = entry.BumpDegree * 2.0f;
            string cacheKey = bumpTex.GetInstanceID().ToString(CultureInfo.InvariantCulture) + "|" + scaledDegree.ToString("0.###", CultureInfo.InvariantCulture);
            if (entry.GeneratedNormalTexture != null && string.Equals(entry.GeneratedNormalCacheKey, cacheKey, StringComparison.Ordinal))
                return entry.GeneratedNormalTexture;

            var readableCache = new Dictionary<int, Texture2D>();
            Texture2D readable = GetReadableTexture(bumpTex, readableCache);
            if (readable == null)
                return null;

            Texture2D normalTex = GenerateNormalMapFromHeightLikeOriginal(readable, scaledDegree);
            if (normalTex == null)
                return null;

            normalTex.name = "facture_bump_" + id.ToString(CultureInfo.InvariantCulture);
            _terrainRuntimeOwnedObjects.Add(normalTex);
            entry.GeneratedNormalTexture = normalTex;
            entry.GeneratedNormalCacheKey = cacheKey;
            return normalTex;
        }

        private static Texture2D GenerateNormalMapFromHeightLikeOriginal(Texture2D src, float strength)
        {
            if (src == null)
                return null;

            // Original engine routes this through D3DXComputeNormalMap(..., D3DX_CHANNEL_RED, amplitude).
            int w = Math.Max(1, src.width);
            int h = Math.Max(1, src.height);
            var tex = new Texture2D(w, h, TextureFormat.RGBA32, true, false);
            tex.wrapMode = TextureWrapMode.Repeat;
            tex.filterMode = FilterMode.Point;

            Color[] pixels = new Color[w * h];
            for (int y = 0; y < h; y++)
            {
                for (int x = 0; x < w; x++)
                {
                    float hL = GetHeightSampleRed01LikeOriginal(src, x - 1, y);
                    float hR = GetHeightSampleRed01LikeOriginal(src, x + 1, y);
                    float hD = GetHeightSampleRed01LikeOriginal(src, x, y - 1);
                    float hU = GetHeightSampleRed01LikeOriginal(src, x, y + 1);
                    float dx = (hL - hR) * strength;
                    float dy = (hD - hU) * strength;
                    Vector3 n = new Vector3(dx, dy, 1.0f).normalized;
                    pixels[y * w + x] = new Color(n.x * 0.5f + 0.5f, n.y * 0.5f + 0.5f, n.z * 0.5f + 0.5f, 1.0f);
                }
            }
            tex.SetPixels(pixels);
            tex.Apply(true, false);
            return tex;
        }

        private static float GetHeightSampleRed01LikeOriginal(Texture2D src, int x, int y)
        {
            if (src == null)
                return 0.5f;
            int sx = x % src.width;
            int sy = y % src.height;
            if (sx < 0) sx += src.width;
            if (sy < 0) sy += src.height;
            Color c = src.GetPixel(sx, sy);
            return c.r;
        }

        private string BuildFactureCandidateList(GroundRuntimeConfig cfg, int id)
        {
            if (cfg == null || cfg.Factures == null || id < 0 || id >= cfg.Factures.Length)
                return $"id={id}: XML-MISSING";
            var e = cfg.Factures[id];
            return $"id={id}: XML {e.SourcePath} mapping={e.Mapping} scale=({e.UScale:0.###},{e.VScale:0.###}) shift=({e.UShift:0.###},{e.VShift:0.###})";
        }

        private static float Frac01(float v)
        {
            v = v - Mathf.Floor(v);
            if (v < 0.0f) v += 1.0f;
            return v;
        }

        private Vector3 GetFlatCameraForward()
        {
            Vector3 v = (_camera != null ? _camera.transform.forward : Quaternion.Euler(_pitch, _yaw, 0.0f) * Vector3.forward);
            v.y = 0.0f;
            return v.sqrMagnitude > 0.0001f ? v.normalized : Vector3.forward;
        }

        private Vector3 GetFlatCameraRight()
        {
            Vector3 v = (_camera != null ? _camera.transform.right : Quaternion.Euler(_pitch, _yaw, 0.0f) * Vector3.right);
            v.y = 0.0f;
            return v.sqrMagnitude > 0.0001f ? v.normalized : Vector3.right;
        }

        private static void EnsureEventSystem()
        {
            var es = UnityEngine.Object.FindFirstObjectByType<EventSystem>();
            if (es == null)
            {
                var go = new GameObject("EventSystem");
                es = go.AddComponent<EventSystem>();
            }

#if ENABLE_INPUT_SYSTEM
            if (UnityEngine.Object.FindFirstObjectByType<InputSystemUIInputModule>() == null)
                es.gameObject.AddComponent<InputSystemUIInputModule>();
#else
            if (UnityEngine.Object.FindFirstObjectByType<StandaloneInputModule>() == null)
                es.gameObject.AddComponent<StandaloneInputModule>();
#endif
        }


        private static Font GetBuiltinFont()
        {
            Font f = null;
            try { f = Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf"); } catch { }
            if (f != null) return f;

            try { f = Resources.GetBuiltinResource<Font>("Arial.ttf"); } catch { }
            if (f != null) return f;

            try
            {
                var all = Resources.FindObjectsOfTypeAll<Font>();
                if (all != null)
                {
                    foreach (var font in all)
                    {
                        if (font != null) return font;
                    }
                }
            }
            catch { }

            return Font.CreateDynamicFontFromOSFont("Arial", 16);
        }

        private static Text CreateOverlayText(Transform parent, string name, string text, Vector2 anchoredTopLeft, Vector2 size, TextAnchor anchor, int fontSize, Color color)
        {
            var go = new GameObject(name, typeof(RectTransform), typeof(Text));
            go.transform.SetParent(parent, false);

            var rt = go.GetComponent<RectTransform>();
            rt.anchorMin = rt.anchorMax = new Vector2(0.0f, 1.0f);
            rt.pivot = new Vector2(0.0f, 1.0f);
            rt.anchoredPosition = anchoredTopLeft;
            rt.sizeDelta = size;

            var uiText = go.GetComponent<Text>();
            uiText.font = GetBuiltinFont();
            uiText.text = text;
            uiText.alignment = anchor;
            uiText.fontSize = fontSize;
            uiText.color = color;
            uiText.horizontalOverflow = HorizontalWrapMode.Wrap;
            uiText.verticalOverflow = VerticalWrapMode.Overflow;
            return uiText;
        }

        private static void CreateOverlayButton(Transform parent, string name, string label, Vector2 anchoredTopRight, Vector2 size, Action onClick)
        {
            var go = new GameObject(name, typeof(RectTransform), typeof(Image), typeof(Button));
            go.transform.SetParent(parent, false);

            var rt = go.GetComponent<RectTransform>();
            rt.anchorMin = rt.anchorMax = new Vector2(1.0f, 1.0f);
            rt.pivot = new Vector2(1.0f, 1.0f);
            rt.anchoredPosition = anchoredTopRight;
            rt.sizeDelta = size;

            var img = go.GetComponent<Image>();
            img.color = new Color32(70, 25, 20, 225);

            var btn = go.GetComponent<Button>();
            btn.onClick.AddListener(() => onClick?.Invoke());

            var labelGo = new GameObject("Label", typeof(RectTransform), typeof(Text));
            labelGo.transform.SetParent(go.transform, false);
            var lrt = labelGo.GetComponent<RectTransform>();
            lrt.anchorMin = Vector2.zero;
            lrt.anchorMax = Vector2.one;
            lrt.offsetMin = Vector2.zero;
            lrt.offsetMax = Vector2.zero;

            var lbl = labelGo.GetComponent<Text>();
            lbl.font = GetBuiltinFont();
            lbl.text = label;
            lbl.alignment = TextAnchor.MiddleCenter;
            lbl.fontSize = 18;
            lbl.color = new Color32(245, 235, 210, 255);
            lbl.raycastTarget = false;
        }

        private static Mesh BuildTerrainMesh(ParsedMap map)
        {
            if (map == null) throw new ArgumentNullException(nameof(map));
            return map.IsMeshSurface ? BuildMeshSurface(map) : BuildOldSurface(map);
        }

        private static Mesh BuildOldSurface(ParsedMap map)
        {
            int step = Math.Max(1, OldSurfaceStep);

            List<int> cols = BuildSampledIndices(map.VertInLine, step);
            List<int> rows = BuildSampledIndices(map.MaxTH, step);

            int sampledCols = cols.Count;
            int sampledRows = rows.Count;
            int vertCount = sampledCols * sampledRows;

            var vertices = new Vector3[vertCount];
            var uv = new Vector2[vertCount];

            for (int ry = 0; ry < sampledRows; ry++)
            {
                int row = rows[ry];
                for (int cx = 0; cx < sampledCols; cx++)
                {
                    int col = cols[cx];
                    int src = row * map.VertInLine + col;
                    int dst = ry * sampledCols + cx;

                    float x = col * 32.0f * HorizontalScale;
                    float z = (row * 32.0f + (((col & 1) != 0) ? -16.0f : 0.0f)) * HorizontalScale * WorldZSign;
                    float y = map.Heights[src] * VerticalScale;
                    vertices[dst] = new Vector3(x, y, z);
                    uv[dst] = new Vector2((float)cx / Math.Max(1, sampledCols - 1), (float)ry / Math.Max(1, sampledRows - 1));
                }
            }

            var tris = new List<int>((sampledCols - 1) * (sampledRows - 1) * 6);
            for (int cx = 0; cx < sampledCols - 1; cx++)
            {
                int col = cols[cx];
                for (int ry = 0; ry < sampledRows - 1; ry++)
                {
                    int a = ry * sampledCols + cx;
                    int b = (ry + 1) * sampledCols + cx;
                    int c = ry * sampledCols + (cx + 1);
                    int d = (ry + 1) * sampledCols + (cx + 1);

                    if ((col & 1) == 0)
                    {
                        AddTri(tris, a, d, c);
                        AddTri(tris, a, b, d);
                    }
                    else
                    {
                        AddTri(tris, a, b, c);
                        AddTri(tris, c, b, d);
                    }
                }
            }

            var mesh = new Mesh();
            mesh.name = "C2_OldTerrainMesh";
            mesh.indexFormat = IndexFormat.UInt32;
            mesh.vertices = vertices;
            mesh.triangles = tris.ToArray();
            mesh.uv = uv;
            mesh.RecalculateNormals();
            mesh.RecalculateBounds();
            return mesh;
        }

        private static List<int> BuildSampledIndices(int length, int step)
        {
            var result = new List<int>(Math.Max(2, length / step + 1));
            for (int i = 0; i < length; i += step)
                result.Add(i);
            if (result.Count == 0 || result[result.Count - 1] != length - 1)
                result.Add(length - 1);
            return result;
        }

        private static Mesh BuildMeshSurface(ParsedMap map)
        {
            var vertices = new Vector3[map.MeshVertices.Length];
            var uv = new Vector2[map.MeshVertices.Length];

            float minX = 0.0f, maxX = 1.0f, minZ = 0.0f, maxZ = 1.0f;
            if (map.MeshVertices.Length > 0)
            {
                minX = map.MeshVertices.Min(v => v.x);
                maxX = map.MeshVertices.Max(v => v.x);
                minZ = map.MeshVertices.Min(v => v.z);
                maxZ = map.MeshVertices.Max(v => v.z);
                if (Math.Abs(maxX - minX) < 0.001f) maxX = minX + 1.0f;
                if (Math.Abs(maxZ - minZ) < 0.001f) maxZ = minZ + 1.0f;
            }

            for (int i = 0; i < map.MeshVertices.Length; i++)
            {
                Vector3 v = map.MeshVertices[i];
                vertices[i] = new Vector3(v.x * HorizontalScale, v.y * VerticalScale, v.z * HorizontalScale * WorldZSign);
                uv[i] = new Vector2((v.x - minX) / (maxX - minX), (v.z - minZ) / (maxZ - minZ));
            }

            int[] mirroredIndices = new int[map.MeshIndices.Length];
            for (int i = 0; i + 2 < map.MeshIndices.Length; i += 3)
            {
                mirroredIndices[i + 0] = map.MeshIndices[i + 0];
                mirroredIndices[i + 1] = map.MeshIndices[i + 2];
                mirroredIndices[i + 2] = map.MeshIndices[i + 1];
            }

            var mesh = new Mesh();
            mesh.name = "C2_NewTerrainMesh";
            mesh.indexFormat = IndexFormat.UInt32;
            mesh.vertices = vertices;
            mesh.triangles = mirroredIndices;
            mesh.uv = uv;
            mesh.RecalculateNormals();
            mesh.RecalculateBounds();
            return mesh;
        }

        private static void AddTri(List<int> tris, int a, int b, int c)
        {
            tris.Add(a); tris.Add(c); tris.Add(b);
        }

        private static bool TryParseMap(Cossacks2Bridge.Core.CoreFileSystem fs, string relativePath, out ParsedMap map, out string error)
        {
            map = null;
            error = "";
            string mapId = Path.GetFileNameWithoutExtension(relativePath ?? string.Empty);

            if (fs == null)
            {
                error = "CoreFileSystem == null";
                return false;
            }

            if (string.IsNullOrWhiteSpace(relativePath))
            {
                error = "relativePath is empty";
                return false;
            }

            if (!fs.Exists(relativePath))
            {
                error = "Файл не найден: " + relativePath;
                return false;
            }

            byte[] raw = fs.ReadAllBytes(relativePath);
            if (raw == null || raw.Length == 0)
            {
                error = "Файл пустой: " + relativePath;
                return false;
            }

            byte[] data = MaybeDecompressM3d(raw, out bool wasCompressed, out string decompressError);
            if (data == null || data.Length < 12)
            {
                error = "Не удалось распаковать .m3d: " + decompressError;
                return false;
            }

            using (var ms = new MemoryStream(data))
            using (var br = new BinaryReader(ms))
            {
                string magic = ReadTag(br);
                if (!IsSupportedMapMagic(magic))
                {
                    error = "Неожиданный magic: " + magic + (wasCompressed ? " (после распаковки)" : "");
                    return false;
                }

                int vertInLine = br.ReadInt32();
                int maxTH = br.ReadInt32();

                map = new ParsedMap
                {
                    VertInLine = vertInLine,
                    MaxTH = maxTH,
                    SourcePath = relativePath
                };
                EnsureMapXyShiftLikeOriginal(map);

                var chunkCounts = new Dictionary<string, int>(StringComparer.Ordinal);
                var chunkPayloadBytes = new Dictionary<string, int>(StringComparer.Ordinal);

                while (ms.Position + 8 <= ms.Length)
                {
                    string tag = ReadTag(br);
                    if (string.Equals(tag, "ENDM", StringComparison.Ordinal))
                    {
                        Debug.Log($"[C2:MAP] chunk ENDM at {ms.Position - 4}");
                        break;
                    }

                    int sizeField = br.ReadInt32();
                    int payloadLen = Math.Max(0, sizeField - 4);
                    long payloadStart = ms.Position;
                    long payloadEnd = payloadStart + payloadLen;

                    if (IsTplTag(tag))
                    {
                        if (TryResolveTplChunkPayloadEnd(
                            data,
                            payloadStart,
                            payloadEnd,
                            map.MaxTH,
                            out long fixedPayloadEnd,
                            out int legacyPayloadLen,
                            out bool claimedMatchesLegacy,
                            out bool claimedMatchesActual,
                            out string tplInfo))
                        {
                            payloadEnd = fixedPayloadEnd;
                            payloadLen = checked((int)(payloadEnd - payloadStart));

                            if (claimedMatchesActual)
                            {
                                Debug.Log($"[C2:MAP] {tag} payload verified: {tplInfo}");
                            }
                            else if (claimedMatchesLegacy)
                            {
                                Debug.Log($"[C2:MAP] {tag} legacy sizeField accepted: {tplInfo}");
                            }
                            else
                            {
                                Debug.LogWarning($"[C2:MAP] {tag} size mismatch: claimedPayload={sizeField - 4} legacyPayload={legacyPayloadLen} actualPayload={payloadLen}; {tplInfo}");
                            }
                        }
                        else
                        {
                            Debug.LogWarning($"[C2:MAP] {tag} topology parse failed, using sizeField path");
                        }
                    }

                    Debug.Log($"[C2:MAP] chunk {tag} sizeField={sizeField} payloadLen={payloadLen} pos={ms.Position - 8}");
                    if (chunkCounts.TryGetValue(tag, out int seenCount)) chunkCounts[tag] = seenCount + 1; else chunkCounts[tag] = 1;
                    if (chunkPayloadBytes.TryGetValue(tag, out int seenBytes)) chunkPayloadBytes[tag] = seenBytes + payloadLen; else chunkPayloadBytes[tag] = payloadLen;

                    if (payloadEnd > ms.Length)
                    {
                        error = $"Чанк {tag} выходит за пределы файла ({payloadEnd} > {ms.Length})";
                        return false;
                    }

                    switch (tag)
                    {
                        case "ZSPM":
                            if (payloadLen >= 16)
                            {
                                map.MinMapX = br.ReadInt32();
                                map.MinMapY = br.ReadInt32();
                                map.MaxMapX = br.ReadInt32();
                                map.MaxMapY = br.ReadInt32();
                                map.TileWidth = map.VertInLine;
                                map.TileHeight = map.MaxTH;
                            }
                            break;

                        case "SURF":
                            int shortCount = payloadLen / 2;
                            map.Heights = new short[shortCount];
                            for (int i = 0; i < shortCount; i++)
                                map.Heights[i] = br.ReadInt16();
                            break;

                        case "TILE":
                            {
                                int expected = Math.Max(0, map.VertInLine * map.MaxTH);
                                ReadPrimaryTiles(br, payloadLen, expected, out map.TilePrimary, out map.TilePrimaryOpt);
                                map.TileWidth = map.VertInLine;
                                map.TileHeight = map.MaxTH;
                            }
                            break;

                        case "TIL2":
                            {
                                int expected = Math.Max(0, map.VertInLine * map.MaxTH);
                                ReadSecondaryTiles(br, payloadLen, expected, out map.TileSecondary, out map.TileSecondaryOpt, out map.TileSecondaryWeight);
                            }
                            break;

                        case "FMAP":
                            {
                                int expected = Math.Max(0, map.VertInLine * map.MaxTH);
                                if (expected > 0 && payloadLen >= expected * 2)
                                {
                                    map.FactureMap = br.ReadBytes(expected);
                                    map.FactureWeight = br.ReadBytes(expected);
                                    if (payloadLen > expected * 2)
                                        br.ReadBytes(payloadLen - expected * 2);
                                }
                                else
                                {
                                    map.FactureMap = br.ReadBytes(payloadLen);
                                }
                            }
                            break;

                        case "SEA2":
                            {
                                byte[] seaPayload = br.ReadBytes(payloadLen);
                                map.Water ??= new C2WaterData();
                                C2WaterBuilder.TryParseSea2Payload(seaPayload, map.Water, out string waterInfo);
                                map.Sea2PayloadBytes = payloadLen;
                                map.Sea2NonZeroCount = map.Water.SeaDeepNonZeroCount;
                                Debug.Log($"[C2:WATER] chunk=SEA2 selected={mapId} payload={payloadLen} " + waterInfo);
                            }
                            break;

                        case "RGBW":
                            {
                                byte[] rgbwPayload = br.ReadBytes(payloadLen);
                                map.Water ??= new C2WaterData();
                                C2WaterBuilder.TryParseRgbwPayload(rgbwPayload, map.Water, out string waterInfo);
                                Debug.Log($"[C2:WATER] chunk=RGBW selected={mapId} payload={payloadLen} " + waterInfo);
                            }
                            break;

                        case "RIV1":
                            {
                                byte[] rivPayload = br.ReadBytes(payloadLen);
                                map.Water ??= new C2WaterData();
                                C2WaterBuilder.TryParseRiv1Payload(rivPayload, map.Water, out string waterInfo);
                                Debug.Log($"[C2:WATER] chunk=RIV1 selected={mapId} payload={payloadLen} " + waterInfo);
                            }
                            break;

                        case "TRE2":
                            map.ChunkTRE2 = br.ReadBytes(payloadLen);
                            break;

                        case "UNI3":
                            map.ChunkUNI3 = br.ReadBytes(payloadLen);
                            break;

                        case "GSPR":
                            map.ChunkGSPR = br.ReadBytes(payloadLen);
                            break;

                        case "ZON2":
                            map.ChunkZON2 = br.ReadBytes(payloadLen);
                            break;

                        case "MOPT":
                            map.ChunkMOPT = br.ReadBytes(payloadLen);
                            break;

                        case "RNE2":
                            map.ChunkRNE2 = br.ReadBytes(payloadLen);
                            break;

                        case "FOR2":
                            map.ChunkFOR2 = br.ReadBytes(payloadLen);
                            break;

                        case "LOC2":
                            map.ChunkLOC2 = br.ReadBytes(payloadLen);
                            break;

                        case "0TPL":
                            map.Chunk0TPL = br.ReadBytes(payloadLen);
                            break;

                        case "1TPL":
                            map.Chunk1TPL = br.ReadBytes(payloadLen);
                            break;

                        case "2TPL":
                            map.Chunk2TPL = br.ReadBytes(payloadLen);
                            break;

                        case "HSEM":
                        case "MESH":
                            if (payloadLen >= 8)
                            {
                                int vertexCount = br.ReadInt32();
                                int indexCount = br.ReadInt32();
                                if (vertexCount < 0 || indexCount < 0)
                                {
                                    error = "Некорректные counts в HSEM.";
                                    return false;
                                }

                                map.IsMeshSurface = true;
                                map.MeshVertices = new Vector3[vertexCount];
                                map.MeshIndices = new int[indexCount];
                                map.MeshColors = new Color32[vertexCount];
                                map.MeshShadow = new byte[vertexCount];
                                map.MeshFacture = new byte[vertexCount];
                                map.MeshNormals = new Vector3[vertexCount];

                                for (int i = 0; i < vertexCount; i++)
                                {
                                    short x = br.ReadInt16();
                                    short y = br.ReadInt16();
                                    short z = br.ReadInt16();
                                    uint colorPacked = br.ReadUInt32();
                                    byte shadow = br.ReadByte();
                                    byte facture = br.ReadByte();
                                    sbyte nxRaw = br.ReadSByte();
                                    sbyte nyRaw = br.ReadSByte();
                                    sbyte nzRaw = br.ReadSByte();
                                    br.ReadByte();   // pad

                                    byte cb = (byte)(colorPacked & 0xFF);
                                    byte cg = (byte)((colorPacked >> 8) & 0xFF);
                                    byte cr = (byte)((colorPacked >> 16) & 0xFF);
                                    byte ca = (byte)((colorPacked >> 24) & 0xFF);

                                    map.MeshVertices[i] = new Vector3(x, z, y);
                                    map.MeshColors[i] = new Color32(cr, cg, cb, ca);
                                    map.MeshShadow[i] = shadow;
                                    map.MeshFacture[i] = facture;
                                    map.MeshNormals[i] = new Vector3(nxRaw / 127f, nzRaw / 127f, nyRaw / 127f);
                                }

                                for (int i = 0; i < indexCount; i++)
                                    map.MeshIndices[i] = br.ReadInt32();
                            }
                            break;
                    }

                    ms.Position = payloadEnd;
                }

                if (!map.IsMeshSurface)
                {
                    if (map.Heights == null || map.Heights.Length == 0)
                    {
                        error = "Не найден SURF heightmap.";
                        return false;
                    }

                    int expected = (map.MaxTH + 1) * map.MaxTH;
                    if (expected > 0 && map.Heights.Length < expected)
                    {
                        error = $"SURF слишком короткий: {map.Heights.Length} < {expected}";
                        return false;
                    }
                }
                else
                {
                    if (map.MeshVertices == null || map.MeshVertices.Length == 0 || map.MeshIndices == null || map.MeshIndices.Length == 0)
                    {
                        error = "Чанк HSEM найден, но геометрия пуста.";
                        return false;
                    }
                }

                if (!map.IsMeshSurface && map.Heights != null && map.Heights.Length > 0)
                    map.Options = BuildOriginalGroundOptions(map);

                int tileOptNonZero = map.TilePrimaryOpt != null ? map.TilePrimaryOpt.Count(v => v != 0) : 0;
                int tile2OptNonZero = map.TileSecondaryOpt != null ? map.TileSecondaryOpt.Count(v => v != 0) : 0;
                Debug.Log($"[C2:MAP] parse summary heights={(map.Heights != null ? map.Heights.Length : 0)} tile={(map.TilePrimary != null ? map.TilePrimary.Length : 0)} tileOpt={(map.TilePrimaryOpt != null ? map.TilePrimaryOpt.Length : 0)} tileOptNZ={tileOptNonZero} tile2={(map.TileSecondary != null ? map.TileSecondary.Length : 0)} tile2Opt={(map.TileSecondaryOpt != null ? map.TileSecondaryOpt.Length : 0)} tile2OptNZ={tile2OptNonZero} tile2w={(map.TileSecondaryWeight != null ? map.TileSecondaryWeight.Length : 0)} fmap={(map.FactureMap != null ? map.FactureMap.Length : 0)} fmapw={(map.FactureWeight != null ? map.FactureWeight.Length : 0)} sea2Bytes={map.Sea2PayloadBytes} sea2NonZero={map.Sea2NonZeroCount} meshVerts={(map.MeshVertices != null ? map.MeshVertices.Length : 0)} meshIdx={(map.MeshIndices != null ? map.MeshIndices.Length : 0)} meshColors={(map.MeshColors != null ? map.MeshColors.Length : 0)} meshShadow={(map.MeshShadow != null ? map.MeshShadow.Length : 0)} meshFacture={(map.MeshFacture != null ? map.MeshFacture.Length : 0)} meshNormals={(map.MeshNormals != null ? map.MeshNormals.Length : 0)} options={(map.Options != null ? map.Options.Length : 0)}");
                EnsureMapXyShiftLikeOriginal(map);
                Debug.Log($"[C2:MAP] terrain summary tile={(map.TilePrimary != null && map.TilePrimary.Length > 0 ? "ok" : "missing")} tile2={(map.TileSecondary != null && map.TileSecondary.Length > 0 ? "ok" : "missing")} fmap={(map.FactureMap != null && map.FactureMap.Length > 0 ? "ok" : "missing")} sea2Count={map.Sea2NonZeroCount} modeDefault={Mathf.Clamp(InitialTerrainDebugMode, 1, 7)}");
                Debug.Log($"[C2:MAP] chunk inventory VIE2={GetChunkInventory(chunkCounts, chunkPayloadBytes, "VIE2")} SURF={GetChunkInventory(chunkCounts, chunkPayloadBytes, "SURF")} TILE={GetChunkInventory(chunkCounts, chunkPayloadBytes, "TILE")} TIL2={GetChunkInventory(chunkCounts, chunkPayloadBytes, "TIL2")} FMAP={GetChunkInventory(chunkCounts, chunkPayloadBytes, "FMAP")} SEA2={GetChunkInventory(chunkCounts, chunkPayloadBytes, "SEA2")} RGBW={GetChunkInventory(chunkCounts, chunkPayloadBytes, "RGBW")} RIV1={GetChunkInventory(chunkCounts, chunkPayloadBytes, "RIV1")} TRE2={GetChunkInventory(chunkCounts, chunkPayloadBytes, "TRE2")} UNI3={GetChunkInventory(chunkCounts, chunkPayloadBytes, "UNI3")} GSPR={GetChunkInventory(chunkCounts, chunkPayloadBytes, "GSPR")} ZON2={GetChunkInventory(chunkCounts, chunkPayloadBytes, "ZON2")} MOPT={GetChunkInventory(chunkCounts, chunkPayloadBytes, "MOPT")} RNE2={GetChunkInventory(chunkCounts, chunkPayloadBytes, "RNE2")} 0TPL={GetChunkInventory(chunkCounts, chunkPayloadBytes, "0TPL")} 1TPL={GetChunkInventory(chunkCounts, chunkPayloadBytes, "1TPL")} 2TPL={GetChunkInventory(chunkCounts, chunkPayloadBytes, "2TPL")} HSEM={GetChunkInventory(chunkCounts, chunkPayloadBytes, "HSEM")} MESH={GetChunkInventory(chunkCounts, chunkPayloadBytes, "MESH")} ");
                Debug.Log($"[C2:MAP] tpl detail 0TPL={BuildTplChunkDetail(map.Chunk0TPL, map.MaxTH)} 1TPL={BuildTplChunkDetail(map.Chunk1TPL, map.MaxTH)} 2TPL={BuildTplChunkDetail(map.Chunk2TPL, map.MaxTH)}");
                Debug.Log($"[C2:MAP] adjacent chunks TRE2={BuildChunkProbe(map.ChunkTRE2)} UNI3={BuildChunkProbe(map.ChunkUNI3)} ZON2={BuildChunkProbe(map.ChunkZON2)} RNE2={BuildChunkProbe(map.ChunkRNE2)} MOPT={BuildChunkProbe(map.ChunkMOPT)} LOC2={BuildChunkProbe(map.ChunkLOC2)} GSPR={BuildScalarChunkProbe(map.ChunkGSPR)} FOR2={BuildScalarChunkProbe(map.ChunkFOR2)}");
                Debug.Log($"[C2:MAP] stage6 candidates fields=FOR2+0TPL+1TPL+2TPL trees=TRE2+GSPR units=UNI3 zones=ZON2 routes=RNE2+LOC2 mopt={BuildScalarChunkProbe(map.ChunkMOPT)}");
                Debug.Log($"[C2:MAP] stage7 tpl samples 0TPL={BuildTplAreaSample(map.Chunk0TPL, map.MaxTH)} 1TPL={BuildTplAreaSample(map.Chunk1TPL, map.MaxTH)} 2TPL={BuildTplAreaSample(map.Chunk2TPL, map.MaxTH)}");
                Debug.Log($"[C2:MAP] stage7 count guesses TRE2={BuildCountGuessProbe(map.ChunkTRE2)} UNI3={BuildCountGuessProbe(map.ChunkUNI3)} ZON2={BuildCountGuessProbe(map.ChunkZON2)} RNE2={BuildCountGuessProbe(map.ChunkRNE2)} LOC2={BuildCountGuessProbe(map.ChunkLOC2)}");
                Debug.Log($"[C2:MAP] stage7 viability fields={(IsScalarZeroChunk(map.ChunkFOR2) ? "absent-on-this-map" : "present-or-unknown")} trees={(IsScalarZeroChunk(map.ChunkGSPR) ? "no-gspr-table" : "gspr-present")} tpl={(HasResolvableTplPayload(map.Chunk0TPL, map.MaxTH) && HasResolvableTplPayload(map.Chunk1TPL, map.MaxTH) && HasResolvableTplPayload(map.Chunk2TPL, map.MaxTH) ? "usable" : "partial")}");
                Debug.Log($"[C2:MAP] stage8 topref 0TPL={BuildTplTopRefProbe(map.Chunk0TPL, map.MaxTH)} 1TPL={BuildTplTopRefProbe(map.Chunk1TPL, map.MaxTH)} 2TPL={BuildTplTopRefProbe(map.Chunk2TPL, map.MaxTH)}");
                Debug.Log($"[C2:MAP] stage8 area refs 0TPL={BuildTplAreaRefProbe(map.Chunk0TPL, map.MaxTH)} 1TPL={BuildTplAreaRefProbe(map.Chunk1TPL, map.MaxTH)} 2TPL={BuildTplAreaRefProbe(map.Chunk2TPL, map.MaxTH)}");
                Debug.Log($"[C2:MAP] stage9 normalized topref 0TPL={BuildTplNormalizedTopRefProbe(map.Chunk0TPL, map.MaxTH)} 1TPL={BuildTplNormalizedTopRefProbe(map.Chunk1TPL, map.MaxTH)} 2TPL={BuildTplNormalizedTopRefProbe(map.Chunk2TPL, map.MaxTH)}");
                Debug.Log($"[C2:MAP] stage9 area coverage 0TPL={BuildTplAreaCoverageProbe(map.Chunk0TPL, map.MaxTH)} 1TPL={BuildTplAreaCoverageProbe(map.Chunk1TPL, map.MaxTH)} 2TPL={BuildTplAreaCoverageProbe(map.Chunk2TPL, map.MaxTH)}");
                Debug.Log($"[C2:MAP] stage10 area anchors 0TPL={BuildTplAreaAnchorProbe(map.Chunk0TPL, map.MaxTH)} 1TPL={BuildTplAreaAnchorProbe(map.Chunk1TPL, map.MaxTH)} 2TPL={BuildTplAreaAnchorProbe(map.Chunk2TPL, map.MaxTH)}");
                Debug.Log($"[C2:MAP] stage10 link quads 0TPL={BuildTplLinkQuadProbe(map.Chunk0TPL, map.MaxTH)} 1TPL={BuildTplLinkQuadProbe(map.Chunk1TPL, map.MaxTH)} 2TPL={BuildTplLinkQuadProbe(map.Chunk2TPL, map.MaxTH)}");
                Debug.Log($"[C2:MAP] stage11 normalized graph 0TPL={BuildTplNormalizedGraphProbe(map.Chunk0TPL, map.MaxTH)} 1TPL={BuildTplNormalizedGraphProbe(map.Chunk1TPL, map.MaxTH)} 2TPL={BuildTplNormalizedGraphProbe(map.Chunk2TPL, map.MaxTH)}");
                Debug.Log($"[C2:MAP] stage11 edge samples 0TPL={BuildTplEdgeSampleProbe(map.Chunk0TPL, map.MaxTH)} 1TPL={BuildTplEdgeSampleProbe(map.Chunk1TPL, map.MaxTH)} 2TPL={BuildTplEdgeSampleProbe(map.Chunk2TPL, map.MaxTH)}");
                Debug.Log($"[C2:TOPO] base map={mapId} surface={(map.IsMeshSurface ? "mesh" : "surf")} size={map.VertInLine}x{map.MaxTH} heights={(map.Heights != null ? map.Heights.Length : 0)} tile={(map.TilePrimary != null ? map.TilePrimary.Length : 0)} tile2={(map.TileSecondary != null ? map.TileSecondary.Length : 0)} fmap={(map.FactureMap != null ? map.FactureMap.Length : 0)}");
                Debug.Log($"[C2:TOPO] chunks RNE2={(map.ChunkRNE2 != null ? map.ChunkRNE2.Length : 0)} LOC2={(map.ChunkLOC2 != null ? map.ChunkLOC2.Length : 0)} ZON2={(map.ChunkZON2 != null ? map.ChunkZON2.Length : 0)} MOPT={(map.ChunkMOPT != null ? map.ChunkMOPT.Length : 0)} UNI3={(map.ChunkUNI3 != null ? map.ChunkUNI3.Length : 0)} TRE2={(map.ChunkTRE2 != null ? map.ChunkTRE2.Length : 0)} GSPR={(map.ChunkGSPR != null ? map.ChunkGSPR.Length : 0)} 0TPL={(map.Chunk0TPL != null ? map.Chunk0TPL.Length : 0)} 1TPL={(map.Chunk1TPL != null ? map.Chunk1TPL.Length : 0)} 2TPL={(map.Chunk2TPL != null ? map.Chunk2TPL.Length : 0)}");
                Debug.Log($"[C2:TOPO] hints zoneSpace=road-knots-plus-top-areas tplTarget=q2-candidate-not-final next=decode-rne2");
                if (TryDecodeRne2(map.ChunkRNE2, out var decodedRne2, out string rneSummary, out string rneSamples))
                {
                    map.DecodedRne2 = decodedRne2;
                    Debug.Log($"[C2:RNE2] decoded {rneSummary}");
                    Debug.Log($"[C2:RNE2] samples {rneSamples}");
                    Debug.Log($"[C2:RNE2] integrity {BuildRne2IntegritySummary(decodedRne2)}");
                    Debug.Log($"[C2:RNE2] integrity-samples {BuildRne2IntegritySamples(decodedRne2)}");
                    Debug.Log($"[C2:ZONE] split {BuildZoneSplitSummary(map)}");
                    Debug.Log($"[C2:ZONE] samples {BuildZoneSplitSamples(map)}");
                    Debug.Log($"[C2:TPL] target-space compare 0TPL={BuildTplTargetSpaceCompare(map.Chunk0TPL, map.DecodedRne2 != null ? map.DecodedRne2.NodeCount : 0)} 1TPL={BuildTplTargetSpaceCompare(map.Chunk1TPL, map.DecodedRne2 != null ? map.DecodedRne2.NodeCount : 0)} 2TPL={BuildTplTargetSpaceCompare(map.Chunk2TPL, map.DecodedRne2 != null ? map.DecodedRne2.NodeCount : 0)}");
                    Debug.Log($"[C2:TPL] target-space samples 0TPL={BuildTplTargetSpaceSamples(map.Chunk0TPL, map.DecodedRne2 != null ? map.DecodedRne2.NodeCount : 0)} 1TPL={BuildTplTargetSpaceSamples(map.Chunk1TPL, map.DecodedRne2 != null ? map.DecodedRne2.NodeCount : 0)} 2TPL={BuildTplTargetSpaceSamples(map.Chunk2TPL, map.DecodedRne2 != null ? map.DecodedRne2.NodeCount : 0)}");
                    Debug.Log($"[C2:TPL] semantic compare 0TPL={BuildTplSemanticCompare(map.Chunk0TPL, map.DecodedRne2)} 1TPL={BuildTplSemanticCompare(map.Chunk1TPL, map.DecodedRne2)} 2TPL={BuildTplSemanticCompare(map.Chunk2TPL, map.DecodedRne2)}");
                    Debug.Log($"[C2:TPL] semantic samples 0TPL={BuildTplSemanticSamples(map.Chunk0TPL, map.DecodedRne2)} 1TPL={BuildTplSemanticSamples(map.Chunk1TPL, map.DecodedRne2)} 2TPL={BuildTplSemanticSamples(map.Chunk2TPL, map.DecodedRne2)}");
                    Debug.Log($"[C2:ZON2] params {BuildTextChunkSummary(map.ChunkZON2, "ZON2")}");
                    Debug.Log($"[C2:MOPT] params {BuildTextChunkSummary(map.ChunkMOPT, "MOPT")}");
                    Debug.Log($"[C2:LOC2] decode {BuildLoc2DecodeSummary(map.ChunkLOC2, map.DecodedRne2)}");
                    Debug.Log($"[C2:LOC2] waypoint relation {BuildLoc2WaypointRelation(map.ChunkLOC2, map.DecodedRne2)}");
                    Debug.Log($"[C2:ROAD] graph summary {BuildRoadGraphSummary(map)}");
                    Debug.Log($"[C2:ROAD] overlay {BuildRoadOverlaySummary(map)}");
                }
                else
                {
                    Debug.LogWarning($"[C2:RNE2] decode failed len={(map.ChunkRNE2 != null ? map.ChunkRNE2.Length : 0)}");
                }
                if (map.IsMeshSurface && map.MeshVertices != null && map.MeshVertices.Length > 0)
                {
                    int shadowNonZero = 0;
                    int factureNonZero = 0;
                    int normalNonZero = 0;
                    byte minShadow = 255;
                    byte maxShadow = 0;
                    byte minFacture = 255;
                    byte maxFacture = 0;
                    for (int i = 0; i < map.MeshVertices.Length; i++)
                    {
                        byte shadow = map.MeshShadow != null && i < map.MeshShadow.Length ? map.MeshShadow[i] : (byte)0;
                        byte facture = map.MeshFacture != null && i < map.MeshFacture.Length ? map.MeshFacture[i] : (byte)0;
                        if (shadow != 0) shadowNonZero++;
                        if (facture != 0) factureNonZero++;
                        if (shadow < minShadow) minShadow = shadow;
                        if (shadow > maxShadow) maxShadow = shadow;
                        if (facture < minFacture) minFacture = facture;
                        if (facture > maxFacture) maxFacture = facture;
                        Vector3 n = map.MeshNormals != null && i < map.MeshNormals.Length ? map.MeshNormals[i] : Vector3.zero;
                        if (n.sqrMagnitude > 0.0001f) normalNonZero++;
                    }

                    Color32 c0 = map.MeshColors != null && map.MeshColors.Length > 0 ? map.MeshColors[0] : new Color32(0, 0, 0, 0);
                    Vector3 n0 = map.MeshNormals != null && map.MeshNormals.Length > 0 ? map.MeshNormals[0] : Vector3.zero;
                    Debug.Log($"[C2:MAP] mesh extras colors={(map.MeshColors != null ? map.MeshColors.Length : 0)} firstColor={c0.r},{c0.g},{c0.b},{c0.a} shadowNZ={shadowNonZero} shadowMin={minShadow} shadowMax={maxShadow} factureNZ={factureNonZero} factureMin={minFacture} factureMax={maxFacture} normalNZ={normalNonZero} firstNormal={n0.x:F3},{n0.y:F3},{n0.z:F3}");
                }

                if (map.Water != null)
                {
                    Debug.Log("[C2:WATER] summary " + map.Water.BuildSummary());
                    Debug.Log($"[C2:WATER] chunks selected={mapId} sea2Present={map.Water.HasSea2Payload} rgbwPresent={map.Water.HasRgbwPayload} riv1Present={map.Water.HasRiv1Payload} sea2Bytes={map.Sea2PayloadBytes} rgbwBytes={map.Water.RgbPayloadBytes} riv1Bytes={map.Water.RivPayloadBytes}");
                }
                else
                {
                    Debug.Log($"[C2:WATER] chunks selected={mapId} sea2Present=false rgbwPresent=false riv1Present=false");
                }
                return true;
            }
        }

        private static string ReadTag(BinaryReader br)
        {
            byte[] tag = br.ReadBytes(4);
            if (tag == null || tag.Length < 4) return "";
            return System.Text.Encoding.ASCII.GetString(tag);
        }

        private static bool IsTplTag(string tag)
        {
            return string.Equals(tag, "0TPL", StringComparison.Ordinal)
                || string.Equals(tag, "1TPL", StringComparison.Ordinal)
                || string.Equals(tag, "2TPL", StringComparison.Ordinal)
                || string.Equals(tag, "3TPL", StringComparison.Ordinal);
        }

        private static bool TryResolveTplChunkPayloadEnd(
            byte[] raw,
            long payloadStart,
            long claimedPayloadEnd,
            int maxTH,
            out long actualPayloadEnd,
            out int legacyPayloadLen,
            out bool claimedMatchesLegacy,
            out bool claimedMatchesActual,
            out string info)
        {
            actualPayloadEnd = claimedPayloadEnd;
            legacyPayloadLen = 0;
            claimedMatchesLegacy = false;
            claimedMatchesActual = false;
            info = "";

            if (raw == null)
            {
                info = "raw=null";
                return false;
            }

            if (payloadStart < 0 || payloadStart + 4 > raw.LongLength)
            {
                info = "payloadStart out of range";
                return false;
            }

            int cursor = checked((int)payloadStart);
            int areaCount = ReadInt32LE(raw, cursor);
            cursor += 4;
            if (areaCount < 0)
            {
                info = "negative areaCount";
                return false;
            }

            long sumLinks = 0;
            long actualLinkBytes = 0;
            long legacyLinkBytes = 0;

            for (int i = 0; i < areaCount; i++)
            {
                if (cursor + 6 > raw.Length)
                {
                    info = $"area header overflow at {i}";
                    return false;
                }

                ushort linkCount = ReadUInt16LE(raw, cursor + 4);
                cursor += 6;

                // Original engine writes AR->Link as sizeof(OneLinkInfo) == 8 bytes,
                // but stores sizeField as if every link consumed only 4 bytes.
                long linkBytes = (long)linkCount * 8L;
                long legacyBytes = (long)linkCount * 4L;

                if (cursor + linkBytes > raw.LongLength)
                {
                    info = $"link array overflow at area={i} links={linkCount}";
                    return false;
                }

                cursor += checked((int)linkBytes);
                sumLinks += linkCount;
                actualLinkBytes += linkBytes;
                legacyLinkBytes += legacyBytes;
            }

            int topLx = maxTH > 1 ? (maxTH >> 1) : 0;
            if (topLx <= 0)
            {
                info = "invalid topLx";
                return false;
            }

            long topRefBytes = (long)topLx * (long)topLx * 2L;
            actualPayloadEnd = cursor + topRefBytes;

            long actualPayloadLen64 = 4L + (long)areaCount * 6L + actualLinkBytes + topRefBytes;
            long legacyPayloadLen64 = 4L + (long)areaCount * 6L + legacyLinkBytes + topRefBytes;
            if (actualPayloadLen64 > int.MaxValue || legacyPayloadLen64 > int.MaxValue)
            {
                info = "payload length overflow";
                return false;
            }

            legacyPayloadLen = checked((int)legacyPayloadLen64);
            int claimedPayloadLen = checked((int)(claimedPayloadEnd - payloadStart));
            int actualPayloadLen = checked((int)actualPayloadLen64);

            claimedMatchesLegacy = claimedPayloadLen == legacyPayloadLen;
            claimedMatchesActual = claimedPayloadLen == actualPayloadLen;

            info =
                $"areas={areaCount} sumLinks={sumLinks} topLx={topLx} topRefBytes={topRefBytes} " +
                $"legacyLinkBytes={legacyLinkBytes} actualLinkBytes={actualLinkBytes} " +
                $"claimedPayload={claimedPayloadLen} legacyPayload={legacyPayloadLen} actualPayload={actualPayloadLen}";

            return actualPayloadEnd >= payloadStart && actualPayloadEnd <= raw.LongLength;
        }

        private static ushort ReadUInt16LE(byte[] raw, int offset)
        {
            return (ushort)(raw[offset] | (raw[offset + 1] << 8));
        }

        private static int ReadInt32LE(byte[] raw, int offset)
        {
            return raw[offset]
                | (raw[offset + 1] << 8)
                | (raw[offset + 2] << 16)
                | (raw[offset + 3] << 24);
        }


private const int Rne2MaxLink = 8;

private static bool TryDecodeRne2(byte[] raw, out DecodedRoadNet net, out string summary, out string samples)
{
    net = null;
    summary = "unavailable";
    samples = "none";

    if (raw == null || raw.Length < 8)
    {
        summary = $"len={(raw != null ? raw.Length : 0)}";
        return false;
    }

    int count = ReadInt32LE(raw, 0);
    if (count <= 0 || count > 100000)
    {
        summary = $"badCount={count} len={raw.Length}";
        return false;
    }

    int payload = raw.Length - 4;
    int[] preferredStrides = { 77, 80, 53, 56 };
    int stride = 0;
    foreach (int candidate in preferredStrides)
    {
        if (payload == count * candidate)
        {
            stride = candidate;
            break;
        }
    }

    if (stride == 0 && count > 0 && payload % count == 0)
    {
        int dynamicStride = payload / count;
        if (dynamicStride >= 40 && dynamicStride <= 96)
            stride = dynamicStride;
    }

    if (stride == 0)
    {
        summary = $"count={count} payload={payload} stride=unresolved";
        return false;
    }

    var decoded = new DecodedRoadNet
    {
        NodeCount = count,
        Stride = stride,
        Layout = GetRne2LayoutName(stride)
    };

    int minX = int.MaxValue;
    int maxX = int.MinValue;
    int minY = int.MaxValue;
    int maxY = int.MinValue;
    int minRoadX = int.MaxValue;
    int maxRoadX = int.MinValue;
    int minRoadY = int.MaxValue;
    int maxRoadY = int.MinValue;
    int activeSources = 0;
    int zeroDegree = 0;
    int linkTypeMin = 255;
    int linkTypeMax = 0;
    int roadIdNonZero = 0;
    int waypointNonZero = 0;

    for (int i = 0; i < count; i++)
    {
        int offset = 4 + i * stride;
        if (!TryReadRne2Node(raw, offset, stride, out RoadKnot node))
        {
            summary = $"count={count} stride={stride} badNode={i}";
            return false;
        }

        decoded.Nodes.Add(node);

        minX = Math.Min(minX, node.X);
        maxX = Math.Max(maxX, node.X);
        minY = Math.Min(minY, node.Y);
        maxY = Math.Max(maxY, node.Y);

        if (node.HasOnRoad)
        {
            minRoadX = Math.Min(minRoadX, node.XOnRoad);
            maxRoadX = Math.Max(maxRoadX, node.XOnRoad);
            minRoadY = Math.Min(minRoadY, node.YOnRoad);
            maxRoadY = Math.Max(maxRoadY, node.YOnRoad);
        }

        int degree = Math.Clamp(node.NLinks, 0, Rne2MaxLink);
        decoded.MaxDegree = Math.Max(decoded.MaxDegree, degree);
        if (degree > 0) activeSources++; else zeroDegree++;
        if (node.Hidden != 0) decoded.HiddenCount++;

        for (int q = 0; q < degree; q++)
        {
            ushort target = node.Links[q];
            if (target < count) decoded.ValidLinkRefs++; else decoded.InvalidLinkRefs++;
            if (node.RoadID[q] != 0) roadIdNonZero++;
            if (node.WayPointToPointIndex[q] != 0) waypointNonZero++;
            linkTypeMin = Math.Min(linkTypeMin, node.LinkType[q]);
            linkTypeMax = Math.Max(linkTypeMax, node.LinkType[q]);
        }
    }

    decoded.ActiveSources = activeSources;
    decoded.ZeroDegree = zeroDegree;

    for (int i = 0; i < decoded.Nodes.Count; i++)
    {
        var node = decoded.Nodes[i];
        int degree = Math.Clamp(node.NLinks, 0, Rne2MaxLink);
        for (int q = 0; q < degree; q++)
        {
            int target = node.Links[q];
            if (target < 0 || target >= decoded.Nodes.Count) continue;
            if (HasRne2BackLink(decoded.Nodes[target], i)) decoded.ReciprocalDirected++;
        }
    }

    string linkTypeInfo = linkTypeMin <= linkTypeMax ? $"{linkTypeMin}-{linkTypeMax}" : "n/a";
    string roadInfo = minRoadX <= maxRoadX && minRoadY <= maxRoadY
        ? $"{minRoadX},{minRoadY}-{maxRoadX},{maxRoadY}"
        : "absent";
    summary =
        $"nodes={count} stride={stride} layout={decoded.Layout} active={activeSources} zeroDegree={zeroDegree} hidden={decoded.HiddenCount} " +
        $"validLinks={decoded.ValidLinkRefs} invalidLinks={decoded.InvalidLinkRefs} reciprocalDirected={decoded.ReciprocalDirected} " +
        $"xy={minX},{minY}-{maxX},{maxY} onRoad={roadInfo} roadIdsNonZero={roadIdNonZero} waypointsNonZero={waypointNonZero} linkTypeRange={linkTypeInfo}";

    var sampleParts = new List<string>();
    for (int i = 0; i < decoded.Nodes.Count && sampleParts.Count < 3; i++)
    {
        RoadKnot node = decoded.Nodes[i];
        int degree = Math.Clamp(node.NLinks, 0, Rne2MaxLink);
        if (degree <= 0 && i + 1 < decoded.Nodes.Count) continue;
        string links = degree > 0 ? string.Join(",", node.Links.Take(degree)) : "-";
        string roads = degree > 0 ? string.Join(",", node.RoadID.Take(degree)) : "-";
        string types = degree > 0 ? string.Join(",", node.LinkType.Take(degree)) : "-";
        string way = degree > 0 ? string.Join(",", node.WayPointToPointIndex.Take(degree)) : "-";
        string onRoad = node.HasOnRoad ? $"{node.XOnRoad},{node.YOnRoad}" : "n/a";
        sampleParts.Add($"{i}@{node.X},{node.Y} nl={node.NLinks} hidden={node.Hidden} links={links} road={roads} type={types} wp={way} onRoad={onRoad}");
    }

    if (sampleParts.Count == 0)
        sampleParts.Add("none");

    samples = string.Join(" | ", sampleParts);
    net = decoded;
    return true;
}

private static bool TryReadRne2Node(byte[] raw, int offset, int stride, out RoadKnot node)
{
    node = new RoadKnot
    {
        Links = new ushort[Rne2MaxLink],
        RoadID = new ushort[Rne2MaxLink],
        LinkType = new byte[Rne2MaxLink],
        WayPointToPointIndex = new ushort[Rne2MaxLink]
    };

    if (offset < 0 || offset + stride > raw.Length) return false;
    if (stride < 53) return false;

    node.X = ReadInt32LE(raw, offset + 0);
    node.Y = ReadInt32LE(raw, offset + 4);
    node.NLinks = ReadInt32LE(raw, offset + 8);
    node.Hidden = raw[offset + 12];

    int cursor;
    int xOnRoadOffset = -1;
    int yOnRoadOffset = -1;
    bool hasWaypoints = false;

    switch (stride)
    {
        case 77:
            cursor = offset + 13;
            hasWaypoints = true;
            xOnRoadOffset = offset + 69;
            yOnRoadOffset = offset + 73;
            break;
        case 80:
            cursor = offset + 14;
            hasWaypoints = true;
            xOnRoadOffset = offset + 72;
            yOnRoadOffset = offset + 76;
            break;
        case 53:
            cursor = offset + 13;
            break;
        case 56:
            cursor = offset + 14;
            break;
        default:
            if (stride >= 77)
            {
                cursor = offset + 13;
                hasWaypoints = true;
                xOnRoadOffset = offset + stride - 8;
                yOnRoadOffset = offset + stride - 4;
            }
            else
            {
                cursor = offset + 13;
            }
            break;
    }

    for (int i = 0; i < Rne2MaxLink; i++, cursor += 2)
        node.Links[i] = ReadUInt16LE(raw, cursor);

    for (int i = 0; i < Rne2MaxLink; i++, cursor += 2)
        node.RoadID[i] = ReadUInt16LE(raw, cursor);

    for (int i = 0; i < Rne2MaxLink; i++, cursor++)
        node.LinkType[i] = raw[cursor];

    if (hasWaypoints)
    {
        for (int i = 0; i < Rne2MaxLink; i++, cursor += 2)
            node.WayPointToPointIndex[i] = ReadUInt16LE(raw, cursor);
    }

    if (xOnRoadOffset >= 0 && yOnRoadOffset >= 0 && yOnRoadOffset + 4 <= offset + stride)
    {
        node.XOnRoad = ReadInt32LE(raw, xOnRoadOffset);
        node.YOnRoad = ReadInt32LE(raw, yOnRoadOffset);
        node.HasOnRoad = true;
    }

    return true;
}

private static bool HasRne2BackLink(RoadKnot node, int source)
{
    int degree = Math.Clamp(node.NLinks, 0, Rne2MaxLink);
    for (int i = 0; i < degree; i++)
    {
        if (node.Links[i] == source) return true;
    }
    return false;
}

private static string BuildRne2IntegritySummary(DecodedRoadNet net)
{
    if (net == null || net.Nodes == null || net.Nodes.Count == 0)
        return "missing";

    int nodes = net.Nodes.Count;
    int selfLinks = 0;
    int duplicateTargets = 0;
    int oneWayDirected = 0;
    int hiddenSources = 0;
    int hiddenDirected = 0;
    int isolated = 0;
    int maxDegree = 0;
    int minDegree = int.MaxValue;
    long degreeSum = 0;
    int multiRoadIdDirected = 0;
    int typeNon16Directed = 0;
    int roadDirected = 0;
    int waypointDirected = 0;
    int weakComponents = 0;

    var undirected = new List<int>[nodes];
    for (int i = 0; i < nodes; i++) undirected[i] = new List<int>();

    for (int i = 0; i < nodes; i++)
    {
        var node = net.Nodes[i];
        int degree = Math.Clamp(node.NLinks, 0, Rne2MaxLink);
        if (node.Hidden != 0) hiddenSources++;
        if (degree == 0) isolated++;
        minDegree = Math.Min(minDegree, degree);
        maxDegree = Math.Max(maxDegree, degree);
        degreeSum += degree;

        var seenTargets = new HashSet<int>();
        var roadIdsHere = new HashSet<int>();
        for (int q = 0; q < degree; q++)
        {
            int target = node.Links[q];
            if (target < 0 || target >= nodes) continue;
            if (target == i) selfLinks++;
            if (!seenTargets.Add(target)) duplicateTargets++;
            if (!HasRne2BackLink(net.Nodes[target], i)) oneWayDirected++;
            if (node.Hidden != 0) hiddenDirected++;
            if (node.RoadID[q] != 0)
            {
                roadDirected++;
                roadIdsHere.Add(node.RoadID[q]);
            }
            if (node.WayPointToPointIndex[q] != 0) waypointDirected++;
            if (node.LinkType[q] != 16) typeNon16Directed++;
            if (!undirected[i].Contains(target)) undirected[i].Add(target);
            if (!undirected[target].Contains(i)) undirected[target].Add(i);
        }
        if (roadIdsHere.Count > 1)
            multiRoadIdDirected += degree;
    }

    var visited = new bool[nodes];
    var queue = new Queue<int>();
    for (int i = 0; i < nodes; i++)
    {
        if (visited[i]) continue;
        weakComponents++;
        visited[i] = true;
        queue.Enqueue(i);
        while (queue.Count > 0)
        {
            int cur = queue.Dequeue();
            foreach (int nxt in undirected[cur])
            {
                if ((uint)nxt >= (uint)nodes || visited[nxt]) continue;
                visited[nxt] = true;
                queue.Enqueue(nxt);
            }
        }
    }

    if (minDegree == int.MaxValue) minDegree = 0;
    float avgDegree = nodes > 0 ? (float)degreeSum / nodes : 0f;

    return $"nodes={nodes} weakComponents={weakComponents} isolated={isolated} minDegree={minDegree} maxDegree={maxDegree} avgDegree={avgDegree:0.00} selfLinks={selfLinks} duplicateTargets={duplicateTargets} oneWayDirected={oneWayDirected} hiddenSources={hiddenSources} hiddenDirected={hiddenDirected} roadDirected={roadDirected} waypointDirected={waypointDirected} typeNon16Directed={typeNon16Directed} multiRoadIdDirected={multiRoadIdDirected}";
}

private static string BuildRne2IntegritySamples(DecodedRoadNet net)
{
    if (net == null || net.Nodes == null || net.Nodes.Count == 0)
        return "none";

    var parts = new List<string>();
    for (int i = 0; i < net.Nodes.Count && parts.Count < 3; i++)
    {
        var node = net.Nodes[i];
        int degree = Math.Clamp(node.NLinks, 0, Rne2MaxLink);
        if (degree <= 0) continue;

        int oneWay = 0;
        int dup = 0;
        int self = 0;
        var seenTargets = new HashSet<int>();
        var edgeParts = new List<string>();
        for (int q = 0; q < degree; q++)
        {
            int target = node.Links[q];
            bool back = target >= 0 && target < net.Nodes.Count && HasRne2BackLink(net.Nodes[target], i);
            if (!back) oneWay++;
            if (target == i) self++;
            if (!seenTargets.Add(target)) dup++;
            if (q < 3)
                edgeParts.Add($"{target}/r{node.RoadID[q]}/t{node.LinkType[q]}/w{node.WayPointToPointIndex[q]}/back={(back ? 1 : 0)}");
        }

        if (oneWay > 0 || dup > 0 || self > 0 || i < 3)
            parts.Add($"{i}@{node.X},{node.Y} deg={degree} oneWay={oneWay} dup={dup} self={self} edges={string.Join(",", edgeParts)}");
    }

    if (parts.Count == 0)
    {
        for (int i = 0; i < net.Nodes.Count && parts.Count < 3; i++)
        {
            var node = net.Nodes[i];
            int degree = Math.Clamp(node.NLinks, 0, Rne2MaxLink);
            if (degree <= 0) continue;
            var edgeParts = new List<string>();
            for (int q = 0; q < degree && q < 3; q++)
            {
                int target = node.Links[q];
                bool back = target >= 0 && target < net.Nodes.Count && HasRne2BackLink(net.Nodes[target], i);
                edgeParts.Add($"{target}/r{node.RoadID[q]}/t{node.LinkType[q]}/w{node.WayPointToPointIndex[q]}/back={(back ? 1 : 0)}");
            }
            parts.Add($"{i}@{node.X},{node.Y} deg={degree} edges={string.Join(",", edgeParts)}");
        }
    }

    return parts.Count > 0 ? string.Join(" | ", parts) : "none";
}


private static string BuildZoneSplitSummary(ParsedMap map)
{
    if (map == null) return "missing-map";
    int roadKnots = map.DecodedRne2 != null ? map.DecodedRne2.NodeCount : 0;
    return $"roadKnots={roadKnots} 0TPL={BuildZoneSpaceForTpl(map.Chunk0TPL, map.MaxTH, roadKnots)} 1TPL={BuildZoneSpaceForTpl(map.Chunk1TPL, map.MaxTH, roadKnots)} 2TPL={BuildZoneSpaceForTpl(map.Chunk2TPL, map.MaxTH, roadKnots)}";
}

private static string BuildZoneSplitSamples(ParsedMap map)
{
    if (map == null) return "missing-map";
    int roadKnots = map.DecodedRne2 != null ? map.DecodedRne2.NodeCount : 0;

    var parts = new List<string>();
    if (map.DecodedRne2 != null && map.DecodedRne2.Nodes.Count > 0)
    {
        RoadKnot first = map.DecodedRne2.Nodes[0];
        RoadKnot last = map.DecodedRne2.Nodes[map.DecodedRne2.Nodes.Count - 1];
        parts.Add($"road[0]={first.X},{first.Y}/deg={Math.Clamp(first.NLinks, 0, Rne2MaxLink)}");
        parts.Add($"road[{map.DecodedRne2.Nodes.Count - 1}]={last.X},{last.Y}/deg={Math.Clamp(last.NLinks, 0, Rne2MaxLink)}");
    }

    parts.Add($"0TPL={BuildZoneSampleForTpl(map.Chunk0TPL, roadKnots)}");
    parts.Add($"1TPL={BuildZoneSampleForTpl(map.Chunk1TPL, roadKnots)}");
    parts.Add($"2TPL={BuildZoneSampleForTpl(map.Chunk2TPL, roadKnots)}");
    return string.Join(" ", parts);
}

private static string BuildZoneSpaceForTpl(byte[] payload, int maxTH, int roadKnots)
{
    if (payload == null || payload.Length == 0) return "missing";
    if (!TryReadTplTopRef(payload, maxTH, out int areaCount, out _, out _, out string error))
        return error;

    int topFirst = roadKnots;
    int topLast = areaCount > 0 ? roadKnots + areaCount - 1 : roadKnots - 1;
    int totalSpan = areaCount > 0 ? roadKnots + areaCount : roadKnots;
    return $"areas={areaCount}; roadRange=0-{Math.Max(-1, roadKnots - 1)}; topRange={topFirst}-{topLast}; totalZoneSpan={totalSpan}";
}

private static string BuildZoneSampleForTpl(byte[] payload, int roadKnots)
{
    if (payload == null || payload.Length == 0) return "missing";
    if (!TryReadTplAreaHeaders(payload, out ushort[] ax, out ushort[] ay, out ushort[] linkCounts, out ushort[] firstQ0, out ushort[] firstQ1, out ushort[] firstQ2, out ushort[] firstQ3, out string error))
        return error;

    int areaCount = ax != null ? ax.Length : 0;
    if (areaCount <= 0) return "areas=0";

    int areaA = 0;
    int areaB = Math.Max(0, areaCount - 1);
    int areaTop = 0;
    int bestLinks = -1;
    for (int i = 0; i < areaCount; i++)
    {
        int lc = linkCounts[i];
        if (lc > bestLinks)
        {
            bestLinks = lc;
            areaTop = i;
        }
    }

    string fmt(int area)
    {
        int zone = roadKnots + area;
        return $"z{zone}=a{area}@{ax[area]},{ay[area]}/lc={linkCounts[area]}/q={firstQ0[area]},{firstQ1[area]},{firstQ2[area]},{firstQ3[area]}";
    }

    if (areaTop == areaA || areaTop == areaB)
        return $"{fmt(areaA)} | {fmt(areaB)}";
    return $"{fmt(areaA)} | {fmt(areaTop)} | {fmt(areaB)}";
}


private static string BuildTplTargetSpaceCompare(byte[] payload, int roadKnots)
{
    if (payload == null || payload.Length == 0) return "missing";
    if (!TryReadTplAreaLinks(payload, out ushort[] ax, out _, out _, out ushort[][] q0, out ushort[][] q1, out ushort[][] q2, out ushort[][] q3, out string error))
        return error;

    int areaCount = ax != null ? ax.Length : 0;
    int topStart = roadKnots;
    int topEndExclusive = roadKnots + areaCount;

    string f0 = BuildTplFieldSpaceSummary(q0, roadKnots, topStart, topEndExclusive, areaCount);
    string f1 = BuildTplFieldSpaceSummary(q1, roadKnots, topStart, topEndExclusive, areaCount);
    string f2 = BuildTplFieldSpaceSummary(q2, roadKnots, topStart, topEndExclusive, areaCount);
    string f3 = BuildTplFieldSpaceSummary(q3, roadKnots, topStart, topEndExclusive, areaCount);
    return $"areas={areaCount}; roadKnots={roadKnots}; q0={f0} q1={f1} q2={f2} q3={f3}";
}

private static string BuildTplFieldSpaceSummary(ushort[][] fields, int roadKnots, int topStart, int topEndExclusive, int areaCount)
{
    long total = 0;
    long sentinel = 0;
    long zero = 0;
    long roadDirect = 0;
    long topOffset = 0;
    long areaZeroBased = 0;
    int max = 0;

    if (fields != null)
    {
        foreach (ushort[] arr in fields)
        {
            if (arr == null) continue;
            foreach (ushort v in arr)
            {
                total++;
                if (v == 0xFFFF) { sentinel++; continue; }
                if (v == 0) zero++;
                if (v < roadKnots) roadDirect++;
                if (v >= topStart && v < topEndExclusive) topOffset++;
                if (v < areaCount) areaZeroBased++;
                if (v > max) max = v;
            }
        }
    }

    long nonSent = total - sentinel;
    string guess = GuessTplFieldTargetMode(nonSent, zero, roadDirect, topOffset, areaZeroBased, max);
    return $"tot={total},sent={sentinel},zero={zero},road={roadDirect},topOfs={topOffset},area0={areaZeroBased},max={max},guess={guess}";
}

private static string GuessTplFieldTargetMode(long nonSent, long zero, long roadDirect, long topOffset, long areaZeroBased, int max)
{
    if (nonSent <= 0) return "empty";
    if (zero == nonSent) return "all-zero";

    long best = Math.Max(roadDirect, Math.Max(topOffset, areaZeroBased));
    bool decisive = best * 4 >= nonSent * 3;

    if (decisive)
    {
        if (best == topOffset) return "top-offset";
        if (best == roadDirect) return "road-direct";
        if (best == areaZeroBased) return "area-zero-based";
    }

    if (max <= 32) return "small-enum-or-type";
    if (max <= 256) return "small-id-space";
    if (roadDirect > 0 && topOffset == 0 && areaZeroBased == 0) return "road-direct-weak";
    if (topOffset > 0 && roadDirect == 0) return "top-offset-weak";
    if (areaZeroBased > 0 && roadDirect == 0 && topOffset == 0) return "area-zero-based-weak";
    return "mixed";
}

private static string BuildTplTargetSpaceSamples(byte[] payload, int roadKnots)
{
    if (payload == null || payload.Length == 0) return "missing";
    if (!TryReadTplAreaLinks(payload, out ushort[] ax, out ushort[] ay, out ushort[] linkCounts, out ushort[][] q0, out ushort[][] q1, out ushort[][] q2, out ushort[][] q3, out string error))
        return error;

    int areaCount = ax != null ? ax.Length : 0;
    if (areaCount <= 0) return "areas=0";

    var areas = Enumerable.Range(0, areaCount)
        .Where(i => linkCounts[i] > 0)
        .OrderByDescending(i => linkCounts[i])
        .ThenBy(i => i)
        .Take(3)
        .ToArray();

    if (areas.Length == 0) return $"areas={areaCount}; samples=<none>";

    int topStart = roadKnots;
    int topEndExclusive = roadKnots + areaCount;
    string FormatVal(int value)
    {
        if (value == 0xFFFF) return "empty";
        if (value >= 0 && value < roadKnots) return $"road:{value}";
        if (value >= topStart && value < topEndExclusive) return $"top:{value - roadKnots}";
        if (value >= 0 && value < areaCount) return $"area0:{value}";
        return value.ToString();
    }

    var parts = new List<string>();
    foreach (int area in areas)
    {
        int idx = q0[area] != null && q0[area].Length > 0 ? 0 : -1;
        if (idx < 0)
        {
            parts.Add($"a{area}@{ax[area]},{ay[area]} lc={linkCounts[area]} <no-links>");
            continue;
        }

        parts.Add($"a{area}@{ax[area]},{ay[area]} lc={linkCounts[area]} q0={q0[area][idx]}[{FormatVal(q0[area][idx])}] q1={q1[area][idx]}[{FormatVal(q1[area][idx])}] q2={q2[area][idx]}[{FormatVal(q2[area][idx])}] q3={q3[area][idx]}[{FormatVal(q3[area][idx])}]");
    }

    return $"areas={areaCount}; roadKnots={roadKnots}; samples={string.Join(" | ", parts)}";
}

private static string GetRne2LayoutName(int stride)
{
    return stride switch
    {
        77 => "packed77",
        80 => "padded80",
        53 => "packed53-old",
        56 => "padded56-old",
        _ => $"stride{stride}"
    };
}

        private static byte[] MaybeDecompressM3d(byte[] raw, out bool wasCompressed, out string error)
        {
            wasCompressed = false;
            error = "";

            if (raw == null || raw.Length == 0)
            {
                error = "raw is empty";
                return null;
            }

            if (IsSupportedMapMagic(ReadMagic4(raw)))
                return raw;

            if (!TryReadFCompressorHeader(raw, out byte compType, out int inLen, out int outLen))
            {
                error = "Неизвестный контейнер карты (ожидался FCompressor/3DMP/4DMP/5DMP).";
                return null;
            }

            int packedLen = Math.Min(raw.Length, 9 + inLen);
            byte[] fcompBlock = SliceBytes(raw, 0, packedLen);
            byte[] payload = SliceBytes(raw, 9, inLen);

            Debug.Log($"[C2:MAP] FCOMP type={compType} inLen={inLen} outLen={outLen} rawLen={raw.Length} blockLen={fcompBlock.Length} payloadLen={payload.Length}");
            Debug.Log($"[C2:MAP] FCOMP rawHead={ToHexHead(raw, 16)} payloadMagic={ReadMagic4(payload)} payloadHead={ToHexHead(payload, 16)}");

            // Map .m3d must not go through Melinoja/G2D decode path.
            // Original map stream uses FCompressor container + map-specific payload decode here.
            Debug.Log("[C2:MAP] Melinoja decode path skipped for .m3d; using map-native FCOMP handling.");

            switch (compType)
            {
                case 0:
                {
                    wasCompressed = true;
                    byte[] stored = NormalizeDecodedMapPayload(payload, out string storedInfo);
                    if (stored != null)
                    {
                        Debug.Log($"[C2:MAP] FCOMP STORE normalized ({storedInfo}) len={stored.Length} magic={ReadMagic4(stored)} head={ToHexHead(stored, 16)}");
                        return stored;
                    }

                    error = "FCOMP STORE payload is not a supported map stream: " + ReadMagic4(payload) + " head=" + ToHexHead(payload, 16);
                    return null;
                }

                case 1:
                {
                    if (!TryDecodeBzipPayload(payload, outLen, out byte[] decoded, out string bzInfo))
                    {
                        error = "BZip2 decode failed: " + bzInfo;
                        return null;
                    }

                    wasCompressed = true;
                    Debug.Log($"[C2:MAP] Raw BZip fallback ok via {bzInfo}, len={decoded.Length}, magic={ReadMagic4(decoded)}, head={ToHexHead(decoded, 16)}, sameAsPayload={ByteArraysEqual(decoded, payload)}");

                    byte[] normalizedBz = NormalizeDecodedMapPayload(decoded, out string bzNormalizeInfo);
                    if (normalizedBz != null)
                    {
                        Debug.Log($"[C2:MAP] Normalized payload ({bzNormalizeInfo}) len={normalizedBz.Length} magic={ReadMagic4(normalizedBz)} head={ToHexHead(normalizedBz, 16)}");
                        return normalizedBz;
                    }

                    error = "Неожиданный magic после FCompressor+BZip2: " + ReadMagic4(decoded) + " head=" + ToHexHead(decoded, 16);
                    return null;
                }

                default:
                    error = "Unsupported FCompressor type: " + compType + ". Supported now: STORE(type=0), BZ2(type=1). Original engine also knows LZO/FLZ.";
                    return null;
            }
        }

        private static string ReadMagic4(byte[] raw)
        {
            if (raw == null || raw.Length < 4) return "<short>";
            return System.Text.Encoding.ASCII.GetString(raw, 0, 4);
        }

        private static bool StartsWithTag(byte[] raw, string tag)
        {
            if (raw == null || raw.Length < 4 || string.IsNullOrEmpty(tag) || tag.Length != 4)
                return false;
            return raw[0] == (byte)tag[0] && raw[1] == (byte)tag[1] && raw[2] == (byte)tag[2] && raw[3] == (byte)tag[3];
        }

        private static bool StartsWithBzipMagic(byte[] raw)
        {
            if (raw == null || raw.Length < 4)
                return false;

            return raw[0] == (byte)'B'
                && raw[1] == (byte)'Z'
                && raw[2] == (byte)'h'
                && raw[3] >= (byte)'1'
                && raw[3] <= (byte)'9';
        }

        private static bool IsSupportedMapMagic(string magic)
        {
            return string.Equals(magic, "3DMP", StringComparison.Ordinal)
                || string.Equals(magic, "4DMP", StringComparison.Ordinal)
                || string.Equals(magic, "5DMP", StringComparison.Ordinal)
                || string.Equals(magic, "PMD3", StringComparison.Ordinal)
                || string.Equals(magic, "PMD4", StringComparison.Ordinal)
                || string.Equals(magic, "PMD5", StringComparison.Ordinal);
        }

        private static byte[] SliceBytes(byte[] src, int offset, int count)
        {
            if (src == null || count <= 0 || offset < 0 || offset >= src.Length)
                return new byte[0];

            int safeCount = Math.Min(count, src.Length - offset);
            byte[] dst = new byte[safeCount];
            Buffer.BlockCopy(src, offset, dst, 0, safeCount);
            return dst;
        }

        private static byte[] NormalizeDecodedMapPayload(byte[] decoded, out string info)
        {
            info = "";

            if (decoded == null || decoded.Length == 0)
            {
                info = "decoded empty";
                return null;
            }

            byte[] current = decoded;
            for (int pass = 0; pass < 3; pass++)
            {
                string magic = ReadMagic4(current);
                Debug.Log($"[C2:MAP] Normalize pass={pass} len={current.Length} magic={magic} head={ToHexHead(current, 16)}");

                if (IsSupportedMapMagic(magic))
                {
                    info = pass == 0 ? "map stream" : ("nested BZip pass=" + pass);
                    return current;
                }

                if (!StartsWithBzipMagic(current))
                {
                    info = "magic=" + magic + " head=" + ToHexHead(current, 16);
                    return null;
                }

                if (!TryDecodeBzipPayload(current, 0, out current, out string nestedInfo))
                {
                    info = "nested BZip failed: " + nestedInfo;
                    return null;
                }
            }

            info = "nested BZip depth exceeded, magic=" + ReadMagic4(current) + " head=" + ToHexHead(current, 16);
            return null;
        }

        private static bool TryDecodeBzipPayload(byte[] payload, int expectedLen, out byte[] decoded, out string info)
        {
            decoded = null;
            info = "";

            if (payload == null || payload.Length == 0)
            {
                info = "payload empty";
                return false;
            }

            try
            {
                decoded = SharpBZip2Compat.Decompress(payload);
                if (decoded != null && decoded.Length > 0)
                {
                    info = $"CompatSharpBZip len={decoded.Length} magic={ReadMagic4(decoded)} expectedLen={expectedLen} sameAsPayload={ByteArraysEqual(decoded, payload)}";
                    if (expectedLen > 0 && decoded.Length != expectedLen)
                        Debug.LogWarning($"[C2:MAP] CompatSharpBZip len mismatch: expected={expectedLen} actual={decoded.Length}");
                    return true;
                }

                info = "CompatSharpBZip returned empty payload";
            }
            catch (Exception ex)
            {
                info = "CompatSharpBZip " + ex.GetType().Name + ": " + ex.Message;
            }

            Type bzipType = FindBzip2InputStreamType();
            if (bzipType == null)
            {
                info += " | Ionic.BZip2.BZip2InputStream type not found";
                return false;
            }

            int capacity = expectedLen > 0
                ? Math.Max(1024, expectedLen + 16)
                : Math.Max(1024, payload.Length * 8 + 1024);

            string firstSuspicious = null;

            foreach (bool? boolArg in new bool?[] { null, false, true })
            {
                try
                {
                    using (var src = new MemoryStream(payload, false))
                    {
                        string ctorInfo;
                        using (var bz = CreateBzipStream(bzipType, src, boolArg, out ctorInfo))
                        using (var dst = new MemoryStream(capacity))
                        {
                            bz.CopyTo(dst);
                            byte[] candidate = dst.ToArray();
                            string candidateMagic = ReadMagic4(candidate);
                            bool passthrough = ByteArraysEqual(candidate, payload);

                            if (candidate.Length > 0 && !passthrough)
                            {
                                decoded = candidate;
                                info += " | " + bzipType.Assembly.GetName().Name + " " + ctorInfo + " len=" + candidate.Length + " magic=" + candidateMagic;
                                return true;
                            }

                            if (candidate.Length > 0 && firstSuspicious == null)
                                firstSuspicious = bzipType.Assembly.GetName().Name + " " + ctorInfo + " suspicious passthrough len=" + candidate.Length + " magic=" + candidateMagic;
                        }
                    }
                }
                catch (Exception ex)
                {
                    if (firstSuspicious == null)
                        firstSuspicious = (boolArg.HasValue ? ("ctor(Stream," + boolArg.Value + ")") : "ctor(Stream)") + " -> " + ex.GetType().Name + ": " + ex.Message;
                }
            }

            if (!string.IsNullOrEmpty(firstSuspicious))
                info += " | " + firstSuspicious;
            return false;
        }

        private static bool TryReadFCompressorHeader(byte[] raw, out byte type, out int inLen, out int outLen)
        {
            type = 0;
            inLen = 0;
            outLen = 0;

            if (raw == null || raw.Length < 9)
                return false;

            type = raw[0];
            inLen = BitConverter.ToInt32(raw, 1);
            outLen = BitConverter.ToInt32(raw, 5);

            if (type > 4)
                return false;
            if (inLen <= 0 || outLen <= 0)
                return false;
            if (9 + inLen > raw.Length)
                return false;

            return true;
        }

        private static bool TryInvokeManagedDecompress(byte[] fcompBlock, byte[] payload, int expectedOutLen, out byte[] decoded, out string info)
        {
            decoded = null;
            info = "";

            if (fcompBlock == null || fcompBlock.Length == 0)
            {
                info = "input empty";
                return false;
            }

            try
            {
                Assembly asm = typeof(CodecFacade).Assembly;
                if (asm == null)
                {
                    info = "Melinoja assembly not found";
                    return false;
                }

                Type t = asm.GetType("G2DLib.G2DCodec", false);
                if (t == null)
                {
                    info = "G2DLib.G2DCodec not found in " + asm.GetName().Name;
                    return false;
                }

                MethodInfo mi = t.GetMethod(
                    "DecompressBlock",
                    BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Static,
                    null,
                    new[] { typeof(byte[]), typeof(uint), typeof(byte[]).MakeByRefType() },
                    null);

                if (mi == null)
                {
                    info = "G2DCodec.DecompressBlock(byte[],uint,out byte[]) not found. methods=" + DescribeMethods(t, "Decompress");
                    return false;
                }

                if (TryInvokeExactManagedDecompress(mi, fcompBlock, out decoded, out string exactInfo))
                {
                    info = exactInfo;
                    return true;
                }

                if (payload != null && payload.Length > 0 && TryInvokeExactManagedDecompress(mi, payload, out decoded, out string payloadInfo))
                {
                    info = payloadInfo + " [payload-only]";
                    return true;
                }

                info = "G2DCodec.DecompressBlock failed for both block and payload";
                return false;
            }
            catch (Exception ex)
            {
                info = ex.GetType().Name + ": " + ex.Message;
                return false;
            }
        }

        private static bool TryInvokeExactManagedDecompress(MethodInfo mi, byte[] input, out byte[] decoded, out string info)
        {
            decoded = null;
            info = "";

            if (mi == null)
            {
                info = "method == null";
                return false;
            }

            if (input == null || input.Length == 0)
            {
                info = "input empty";
                return false;
            }

            try
            {
                object[] args = { input, (uint)input.Length, null };
                object ret = mi.Invoke(null, args);
                bool ok = ret is bool b && b;
                decoded = args[2] as byte[];

                info = (mi.DeclaringType != null ? (mi.DeclaringType.FullName + ".") : "")
                    + mi.Name
                    + $"(len={input.Length}) ret={ret} outLen={(decoded != null ? decoded.Length : 0)} outMagic={ReadMagic4(decoded)} outHead={ToHexHead(decoded, 16)} sameAsInput={ByteArraysEqual(decoded, input)}";

                return ok && decoded != null && decoded.Length > 0;
            }
            catch (Exception ex)
            {
                info = ex.GetType().Name + ": " + ex.Message;
                return false;
            }
        }

        private static string DescribeMethods(Type t, string nameContains)
        {
            if (t == null) return "<null type>";
            const BindingFlags flags = BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Static | BindingFlags.Instance;
            var parts = new List<string>();
            foreach (MethodInfo mi in t.GetMethods(flags))
            {
                if (mi == null) continue;
                if (!string.IsNullOrEmpty(nameContains) && mi.Name.IndexOf(nameContains, StringComparison.OrdinalIgnoreCase) < 0)
                    continue;

                string paramSig = string.Join(", ", mi.GetParameters().Select(p =>
                {
                    string pt = p.ParameterType != null ? p.ParameterType.Name : "?";
                    return pt + " " + p.Name;
                }));

                parts.Add(mi.Name + "(" + paramSig + ")");
            }

            return parts.Count > 0 ? string.Join(" | ", parts) : "<no matching methods>";
        }

        private static Type FindBzip2InputStreamType()
        {
            try
            {
                Assembly melinojaAsm = typeof(CodecFacade).Assembly;
                if (melinojaAsm != null)
                {
                    Type exact = melinojaAsm.GetType("Ionic.BZip2.BZip2InputStream", false);
                    if (exact != null)
                    {
                        Debug.Log("[C2:MAP] Using Melinoja BZip type from assembly: " + melinojaAsm.GetName().Name);
                        return exact;
                    }
                }
            }
            catch (Exception ex)
            {
                Debug.LogWarning("[C2:MAP] Melinoja BZip lookup failed: " + ex.Message);
            }

            Type direct = Type.GetType("Ionic.BZip2.BZip2InputStream, Melinoja", false);
            if (direct != null)
            {
                Debug.Log("[C2:MAP] Using direct BZip type: " + direct.Assembly.GetName().Name);
                return direct;
            }

            foreach (Assembly asm in AppDomain.CurrentDomain.GetAssemblies())
            {
                if (asm == null) continue;
                Type t = asm.GetType("Ionic.BZip2.BZip2InputStream", false);
                if (t != null)
                {
                    Debug.LogWarning("[C2:MAP] Falling back to foreign BZip type from assembly: " + asm.GetName().Name);
                    return t;
                }
            }

            return null;
        }

        private static Stream CreateBzipStream(Type bzipType, Stream src, bool? boolArg, out string ctorInfo)
        {
            if (bzipType == null) throw new ArgumentNullException(nameof(bzipType));
            if (src == null) throw new ArgumentNullException(nameof(src));

            const BindingFlags flags = BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic;

            if (!boolArg.HasValue)
            {
                ConstructorInfo ctor1 = bzipType.GetConstructor(flags, null, new[] { typeof(Stream) }, null);
                if (ctor1 != null)
                {
                    ctorInfo = ".ctor(Stream)";
                    return (Stream)ctor1.Invoke(new object[] { src });
                }
            }

            ConstructorInfo ctor2 = bzipType.GetConstructor(flags, null, new[] { typeof(Stream), typeof(bool) }, null);
            if (ctor2 != null)
            {
                bool flag = boolArg ?? false;
                ctorInfo = ".ctor(Stream, bool=" + flag + ")";
                return (Stream)ctor2.Invoke(new object[] { src, flag });
            }

            ctorInfo = "<missing ctor>";
            throw new MissingMethodException(bzipType.FullName, ".ctor(Stream) / .ctor(Stream, bool)");
        }

        private static bool ByteArraysEqual(byte[] a, byte[] b)
        {
            if (ReferenceEquals(a, b)) return true;
            if (a == null || b == null || a.Length != b.Length) return false;
            for (int i = 0; i < a.Length; i++)
                if (a[i] != b[i])
                    return false;
            return true;
        }

        private static string ToHexHead(byte[] raw, int count)
        {
            if (raw == null || raw.Length == 0) return "<empty>";
            int take = Math.Min(Math.Max(count, 0), raw.Length);
            char[] chars = new char[take * 3 - 1];
            const string hex = "0123456789ABCDEF";
            int p = 0;
            for (int i = 0; i < take; i++)
            {
                byte b = raw[i];
                chars[p++] = hex[b >> 4];
                chars[p++] = hex[b & 15];
                if (i + 1 < take) chars[p++] = ' ';
            }
            return new string(chars);
        }

        private void ApplyTerrainMaterialRuntimeState(bool forceLog)
        {
            if (_terrainMaterial == null)
                return;

            if (_terrainMaterial.HasProperty("_FactureEnabled"))
                _terrainMaterial.SetFloat("_FactureEnabled", _factureEnabled ? 1.0f : 0.0f);
            if (_terrainMaterial.HasProperty("_FactureStrength"))
                _terrainMaterial.SetFloat("_FactureStrength", PreviewFactureStrength);
            if (_terrainMaterial.HasProperty("_SecondWeightScale"))
                _terrainMaterial.SetFloat("_SecondWeightScale", PreviewSecondWeightScale);
            if (_terrainMaterial.HasProperty("_FactureWeightScale"))
                _terrainMaterial.SetFloat("_FactureWeightScale", PreviewFactureWeightScale);
            if (_terrainMaterial.HasProperty("_GroundTiling"))
                _terrainMaterial.SetFloat("_GroundTiling", PreviewGroundTiling);
            if (_terrainMaterial.HasProperty("_SecondaryTiling"))
                _terrainMaterial.SetFloat("_SecondaryTiling", PreviewSecondTiling);
            if (_terrainMaterial.HasProperty("_FactureTiling"))
                _terrainMaterial.SetFloat("_FactureTiling", PreviewFactureTiling);
            if (_terrainMaterial.HasProperty("_SlopeBlendPower"))
                _terrainMaterial.SetFloat("_SlopeBlendPower", PreviewSlopeBlendPower);
            if (_terrainMaterial.HasProperty("_SlopeSecondAtten"))
                _terrainMaterial.SetFloat("_SlopeSecondAtten", PreviewSlopeSecondAtten);
            if (_terrainMaterial.HasProperty("_SlopeFactureAtten"))
                _terrainMaterial.SetFloat("_SlopeFactureAtten", PreviewSlopeFactureAtten);
            if (_terrainMaterial.HasProperty("_AmbientStrength"))
                _terrainMaterial.SetFloat("_AmbientStrength", AmbientLightStrength);
            if (_terrainMaterial.HasProperty("_DiffuseStrength"))
                _terrainMaterial.SetFloat("_DiffuseStrength", DiffuseLightStrength);
            if (_terrainMaterial.HasProperty("_Brightness"))
                _terrainMaterial.SetFloat("_Brightness", TerrainBrightness);
            if (_terrainMaterial.HasProperty("_FakeLightDir"))
                _terrainMaterial.SetVector("_FakeLightDir", GetShaderLightDirection());
            if (_terrainMaterial.HasProperty("_DebugMode"))
                _terrainMaterial.SetFloat("_DebugMode", _terrainDebugMode);

            if (forceLog)
                Debug.Log($"[C2:REN] runtimeState mode={_terrainDebugMode} ({DescribeTerrainMode(_terrainDebugMode)}) factureEnabled={_factureEnabled} factureStrength={PreviewFactureStrength:0.###} secondWeightScale={PreviewSecondWeightScale:0.###} factureWeightScale={PreviewFactureWeightScale:0.###} groundTiling={PreviewGroundTiling:0.###} secondTiling={PreviewSecondTiling:0.###} factureTiling={PreviewFactureTiling:0.###} slopeBlend={PreviewSlopeBlendPower:0.###} slopeSecondAtten={PreviewSlopeSecondAtten:0.###} slopeFactureAtten={PreviewSlopeFactureAtten:0.###} ambient={AmbientLightStrength:0.###} diffuse={DiffuseLightStrength:0.###} brightness={TerrainBrightness:0.###}");
        }

        private Vector4 GetShaderLightDirection()
        {
            Vector3 dir = (_light != null) ? (-_light.transform.forward.normalized) : new Vector3(0.45f, 0.85f, 0.35f).normalized;
            return new Vector4(dir.x, dir.y, dir.z, 0.0f);
        }

        private string GetMaterialTextureDebugName(Material mat)
        {
            if (mat == null)
                return "<none>";

            if (mat.HasProperty("_MainTex"))
            {
                var tex = mat.GetTexture("_MainTex");
                if (tex != null) return tex.name;
            }

            if (mat.HasProperty("_BaseMap"))
            {
                var tex = mat.GetTexture("_BaseMap");
                if (tex != null) return tex.name;
            }

            if (mat.HasProperty("_Control0"))
            {
                var tex = mat.GetTexture("_Control0");
                if (tex != null) return tex.name;
            }

            return "<none>";
        }

        private string BuildMaterialTextureAssignmentLog(Material mat, string phase)
        {
            Texture mainTex = (mat != null && mat.HasProperty("_MainTex")) ? mat.GetTexture("_MainTex") : null;
            Texture baseMap = (mat != null && mat.HasProperty("_BaseMap")) ? mat.GetTexture("_BaseMap") : null;
            return $"phase={phase} shader={mat?.shader?.name ?? "<null>"} mainTex={DescribeTextureObject(mainTex)} baseMap={DescribeTextureObject(baseMap)} sameObject={ReferenceEquals(mainTex, baseMap)}";
        }

        private static string DescribeTextureObject(Texture tex)
        {
            if (tex == null)
                return "<null>";

            int w = tex.width;
            int h = tex.height;
            return $"{tex.name}#{tex.GetInstanceID()}[{w}x{h}]";
        }

        private bool WasWaterDiagnosticsDumpPressed()
        {
#if ENABLE_INPUT_SYSTEM
            if (Keyboard.current == null)
                return false;
            bool enter = Keyboard.current.enterKey != null && Keyboard.current.enterKey.wasPressedThisFrame;
            bool keypad = Keyboard.current.numpadEnterKey != null && Keyboard.current.numpadEnterKey.wasPressedThisFrame;
            return enter || keypad;
#else
            return Input.GetKeyDown(KeyCode.Return) || Input.GetKeyDown(KeyCode.KeypadEnter);
#endif
        }
        private void DumpWaterDiagnostics(string trigger)
        {
            try
            {
                string report = BuildWaterDiagnosticsReport(trigger);
                foreach (string line in report.Split('\n'))
                {
                    if (!string.IsNullOrWhiteSpace(line))
                        Debug.Log(line.TrimEnd('\r'));
                }

                try
                {
                    string path = Path.Combine(Application.persistentDataPath, "C2WaterDebugLast.txt");
                    File.WriteAllText(path, report, Encoding.UTF8);
                    Debug.Log($"[C2:WATERDBG] file={path}");
                }
                catch (Exception ex)
                {
                    Debug.LogWarning("[C2:WATERDBG] saveFailed " + ex.Message);
                }
            }
            catch (Exception ex)
            {
                Debug.LogWarning("[C2:WATERDBG] dumpFailed " + ex.GetType().Name + " " + ex.Message);
            }
        }

        private string BuildWaterDiagnosticsReport(string trigger)
        {
            var sb = new StringBuilder(4096);
            EnsureExternalWaterPresetInitialized();
            var p = s_externalWaterPreset;
            sb.AppendLine($"[C2:WATERDBG] ===== begin trigger={trigger} time={Time.unscaledTime:0.000} map={_selectedId} =====");
            sb.AppendLine($"[C2:WATERDBG] runtime pivot={_pivot} dist={_distance:0.###} yaw={_yaw:0.###} pitch={_pitch:0.###} initialPivot={_initialPivot} initialDist={_initialDistance:0.###} initialYaw={_initialYaw:0.###} initialPitch={_initialPitch:0.###}");

            if (_camera != null)
            {
                Vector3 toPivot = (_pivot - _camera.transform.position).normalized;
                float lookDot = Vector3.Dot(_camera.transform.forward.normalized, toPivot);
                sb.AppendLine($"[C2:WATERDBG] cam pos={_camera.transform.position} rot={_camera.transform.eulerAngles} forward={_camera.transform.forward} up={_camera.transform.up} lookDot={lookDot:0.######} fov={_camera.fieldOfView:0.###} near={_camera.nearClipPlane:0.###} far={_camera.farClipPlane:0.###} aspect={_camera.aspect:0.######}");
                sb.AppendLine($"[C2:WATERDBG] cam worldToCamera={FormatMatrix(_camera.worldToCameraMatrix)}");
                sb.AppendLine($"[C2:WATERDBG] cam projection={FormatMatrix(_camera.projectionMatrix)}");
            }
            else
            {
                sb.AppendLine("[C2:WATERDBG] cam <null>");
            }

            sb.AppendLine($"[C2:WATERDBG] water mode={_lastWaterReflectionMode} writer={_lastWaterReflectionWriter} projectiveActive={_waterReflectionProjectiveActive} uvST={_waterReflectionUvST} targetState={_lastWaterReflectionTargetState} assigned={_lastWaterReflectionAssignedTex} fallback={_lastWaterReflectionFallbackTex} mapInfo={_lastWaterMapDataInfo}");
            sb.AppendLine($"[C2:WATERDBG] water projectiveMatrix={FormatMatrix(_waterReflectionProjectiveMatrix)}");
            sb.AppendLine($"[C2:WATERDBG] water planeY={GetWaterPlaneY():0.###} worldZSign={WorldZSign:0.###} usesStaticFallback={_waterUsesStaticFallbackData}");

            if (p != null)
            {
                sb.AppendLine($"[C2:WATERDBG] debugPreset normalAngle={p.NormalDirectionDeg:0.###} fallbackRot={p.ReflectionFallbackRotateDeg:0.###} fallbackFlipX={(p.ReflectionFallbackFlipX?1:0)} fallbackFlipY={(p.ReflectionFallbackFlipY?1:0)} projRot={p.ReflectionProjectiveRotateDeg:0.###} projFlipX={(p.ReflectionProjectiveFlipX?1:0)} projFlipY={(p.ReflectionProjectiveFlipY?1:0)} cloud={(p.EnableCloudReflection?1:0)} opacity={p.OpacityPercent:0.###} shoreOpacity={p.ShorelineOpacityPercent:0.###} shoreWidth={p.ShorelineWidthPercent:0.###}");
            }

            if (_waterReflectionCamera != null)
            {
                sb.AppendLine($"[C2:WATERDBG] reflCam pos={_waterReflectionCamera.transform.position} rot={_waterReflectionCamera.transform.eulerAngles} forward={_waterReflectionCamera.transform.forward} near={_waterReflectionCamera.nearClipPlane:0.###} far={_waterReflectionCamera.farClipPlane:0.###} aspect={_waterReflectionCamera.aspect:0.######}");
                sb.AppendLine($"[C2:WATERDBG] reflCam worldToCamera={FormatMatrix(_waterReflectionCamera.worldToCameraMatrix)}");
                sb.AppendLine($"[C2:WATERDBG] reflCam projection={FormatMatrix(_waterReflectionCamera.projectionMatrix)}");
            }
            else
            {
                sb.AppendLine("[C2:WATERDBG] reflCam <null>");
            }

            if (_waterMaterial != null)
            {
                sb.AppendLine($"[C2:WATERDBG] material shader={(_waterMaterial.shader != null ? _waterMaterial.shader.name : "<null>")} reflTex={GetWaterTexDebugName(_waterMaterial, "_ReflectionTex")} fallbackTex={GetWaterTexDebugName(_waterMaterial, "_ReflectionFallbackTex")} seaTex={GetWaterTexDebugName(_waterMaterial, "_SeaDataTex")} flowTex={GetWaterTexDebugName(_waterMaterial, "_FlowDataTex")} riverTex={GetWaterTexDebugName(_waterMaterial, "_RiverDataTex")}");
                sb.AppendLine($"[C2:WATERDBG] material alphaStrength={ReadMatFloat(_waterMaterial, "_AlphaStrength"):0.######} alphaCurve={ReadMatFloat(_waterMaterial, "_AlphaCurve"):0.######} reflectionStrength={ReadMatFloat(_waterMaterial, "_ReflectionStrength"):0.######} reflectionMix={ReadMatFloat(_waterMaterial, "_ReflectionMix"):0.######} skyBlend={ReadMatFloat(_waterMaterial, "_ReflectionSkyBlend"):0.######} realBlend={ReadMatFloat(_waterMaterial, "_ReflectionRealBlend"):0.######} minVisibleAlpha={ReadMatFloat(_waterMaterial, "_MinVisibleAlpha"):0.######}");
            }
            else
            {
                sb.AppendLine("[C2:WATERDBG] material <null>");
            }

            AppendWaterProjectionCoverage(sb, p);
            sb.AppendLine("[C2:WATERDBG] ===== end =====");
            return sb.ToString();
        }

        private void AppendWaterProjectionCoverage(StringBuilder sb, ExternalWaterPreset preset)
        {
            var mf = _waterGo != null ? _waterGo.GetComponent<MeshFilter>() : null;
            var mesh = mf != null ? mf.sharedMesh : null;
            if (mesh == null)
            {
                sb.AppendLine("[C2:WATERDBG] coverage mesh=<null>");
                return;
            }

            Vector3[] verts = mesh.vertices;
            if (verts == null || verts.Length == 0)
            {
                sb.AppendLine("[C2:WATERDBG] coverage verts=0");
                return;
            }

            int step = Mathf.Max(1, verts.Length / 256);
            Matrix4x4 l2w = _waterGo.transform.localToWorldMatrix;
            int total = 0;
            int positiveW = 0;
            int rawInside = 0;
            int debugInside = 0;
            float minRawX = float.PositiveInfinity, minRawY = float.PositiveInfinity, maxRawX = float.NegativeInfinity, maxRawY = float.NegativeInfinity;
            float minDbgX = float.PositiveInfinity, minDbgY = float.PositiveInfinity, maxDbgX = float.NegativeInfinity, maxDbgY = float.NegativeInfinity;
            Vector2 sampleRaw = Vector2.zero;
            Vector2 sampleDbg = Vector2.zero;
            float sampleW = 0.0f;
            Vector3 sampleWorld = Vector3.zero;
            bool sampleTaken = false;

            for (int i = 0; i < verts.Length; i += step)
            {
                Vector3 wp = l2w.MultiplyPoint3x4(verts[i]);
                Vector4 rp = _waterReflectionProjectiveMatrix * new Vector4(wp.x, wp.y, wp.z, 1.0f);
                total++;
                if (rp.w > 1e-5f)
                    positiveW++;

                if (Mathf.Abs(rp.w) > 1e-5f)
                {
                    Vector2 uvRaw = new Vector2(rp.x / rp.w, rp.y / rp.w) * 0.5f + Vector2.one * 0.5f;
                    Vector2 uvDbg = ApplyDebugUvTransformCpu(uvRaw,
                        preset != null ? preset.ReflectionProjectiveRotateDeg : 0.0f,
                        preset != null && preset.ReflectionProjectiveFlipX,
                        preset != null && preset.ReflectionProjectiveFlipY);

                    minRawX = Mathf.Min(minRawX, uvRaw.x); minRawY = Mathf.Min(minRawY, uvRaw.y);
                    maxRawX = Mathf.Max(maxRawX, uvRaw.x); maxRawY = Mathf.Max(maxRawY, uvRaw.y);
                    minDbgX = Mathf.Min(minDbgX, uvDbg.x); minDbgY = Mathf.Min(minDbgY, uvDbg.y);
                    maxDbgX = Mathf.Max(maxDbgX, uvDbg.x); maxDbgY = Mathf.Max(maxDbgY, uvDbg.y);

                    bool rawOk = rp.w > 1e-5f && uvRaw.x >= 0.0f && uvRaw.x <= 1.0f && uvRaw.y >= 0.0f && uvRaw.y <= 1.0f;
                    bool dbgOk = rp.w > 1e-5f && uvDbg.x >= 0.0f && uvDbg.x <= 1.0f && uvDbg.y >= 0.0f && uvDbg.y <= 1.0f;
                    if (rawOk) rawInside++;
                    if (dbgOk) debugInside++;
                    if (!sampleTaken)
                    {
                        sampleTaken = true;
                        sampleRaw = uvRaw;
                        sampleDbg = uvDbg;
                        sampleW = rp.w;
                        sampleWorld = wp;
                    }
                }
            }

            sb.AppendLine($"[C2:WATERDBG] coverage sampledVerts={total} positiveW={positiveW} rawInside01={rawInside} debugInside01={debugInside} rawUvMin=({minRawX:0.######},{minRawY:0.######}) rawUvMax=({maxRawX:0.######},{maxRawY:0.######}) dbgUvMin=({minDbgX:0.######},{minDbgY:0.######}) dbgUvMax=({maxDbgX:0.######},{maxDbgY:0.######})");
            if (sampleTaken)
                sb.AppendLine($"[C2:WATERDBG] coverage sampleWorld={sampleWorld} sampleW={sampleW:0.######} sampleRawUv={sampleRaw} sampleDbgUv={sampleDbg}");
        }

        private static Vector2 ApplyDebugUvTransformCpu(Vector2 uv, float rotateDeg, bool flipX, bool flipY)
        {
            Vector2 p = uv - Vector2.one * 0.5f;
            if (flipX)
                p.x = -p.x;
            if (flipY)
                p.y = -p.y;
            if (Mathf.Abs(rotateDeg) > 0.0001f)
            {
                float rad = rotateDeg * Mathf.Deg2Rad;
                float s = Mathf.Sin(rad);
                float c = Mathf.Cos(rad);
                p = new Vector2(p.x * c - p.y * s, p.x * s + p.y * c);
            }
            return p + Vector2.one * 0.5f;
        }

        private static string FormatMatrix(Matrix4x4 m)
        {
            return $"[{m.m00:0.######},{m.m01:0.######},{m.m02:0.######},{m.m03:0.######}; {m.m10:0.######},{m.m11:0.######},{m.m12:0.######},{m.m13:0.######}; {m.m20:0.######},{m.m21:0.######},{m.m22:0.######},{m.m23:0.######}; {m.m30:0.######},{m.m31:0.######},{m.m32:0.######},{m.m33:0.######}]";
        }

        private static float ReadMatFloat(Material mat, string prop)
        {
            return mat != null && mat.HasProperty(prop) ? mat.GetFloat(prop) : float.NaN;
        }

        private void MaybeLogCameraState(float lookDot, bool force)
        {
            if (_camera == null)
                return;

            string sig = _freeCameraMode
                ? $"{Mathf.RoundToInt(_pivot.x)},{Mathf.RoundToInt(_pivot.y)},{Mathf.RoundToInt(_pivot.z)}|{Mathf.RoundToInt(_distance)}|{Mathf.RoundToInt(_yaw * 10.0f)}|{Mathf.RoundToInt(_pitch * 10.0f)}"
                : $"strict|{_strictMapX:0.###}|{_strictMapY:0.###}|{_strictZoom:0.###}|{Mathf.RoundToInt(_distance)}";
            float now = Time.unscaledTime;
            if (!force)
            {
                if (sig == _lastCameraLogSignature && now < _nextCameraLogTime)
                    return;
                if (now < _nextCameraLogTime)
                    return;
            }

            _lastCameraLogSignature = sig;
            _nextCameraLogTime = now + 1.50f;
            if (_freeCameraMode)
                Debug.Log($"[C2:CAM] pivot={_pivot} dist={_distance} camPos={_camera.transform.position} camForward={_camera.transform.forward} lookDot={lookDot}");
            else
                Debug.Log($"[C2:CAM] strictMap=({_strictMapX:0.###},{_strictMapY:0.###}) zoom={_strictZoom:0.###} focus={_pivot} dist={_distance:0.###} camPos={_camera.transform.position} camForward={_camera.transform.forward} lookDot={lookDot:0.###}");
        }

        private bool TryApplyRuntimeTerrainTuning(out string logLine)
        {
            logLine = null;
            if (_terrainMaterial == null)
                return false;

            const float tilingStep = 16.0f;
            const float strengthStep = 0.02f;
            const float slopeStep = 0.25f;

            bool changed = false;
            string label = "";

            if (WasBaseTilingDownPressed())
            {
                PreviewGroundTiling = Mathf.Max(32.0f, PreviewGroundTiling - tilingStep);
                changed = true;
                label = "groundTiling--";
            }
            else if (WasBaseTilingUpPressed())
            {
                PreviewGroundTiling = Mathf.Min(1024.0f, PreviewGroundTiling + tilingStep);
                changed = true;
                label = "groundTiling++";
            }
            else if (WasSecondaryTilingDownPressed())
            {
                PreviewSecondTiling = Mathf.Max(32.0f, PreviewSecondTiling - tilingStep);
                changed = true;
                label = "secondTiling--";
            }
            else if (WasSecondaryTilingUpPressed())
            {
                PreviewSecondTiling = Mathf.Min(1024.0f, PreviewSecondTiling + tilingStep);
                changed = true;
                label = "secondTiling++";
            }
            else if (WasFactureStrengthDownPressed())
            {
                PreviewFactureStrength = Mathf.Clamp01(PreviewFactureStrength - strengthStep);
                changed = true;
                label = "factureStrength--";
            }
            else if (WasFactureStrengthUpPressed())
            {
                PreviewFactureStrength = Mathf.Clamp01(PreviewFactureStrength + strengthStep);
                changed = true;
                label = "factureStrength++";
            }
            else if (WasSlopeBlendDownPressed())
            {
                PreviewSlopeBlendPower = Mathf.Clamp(PreviewSlopeBlendPower - slopeStep, 1.0f, 8.0f);
                changed = true;
                label = "slopeBlend--";
            }
            else if (WasSlopeBlendUpPressed())
            {
                PreviewSlopeBlendPower = Mathf.Clamp(PreviewSlopeBlendPower + slopeStep, 1.0f, 8.0f);
                changed = true;
                label = "slopeBlend++";
            }

            if (!changed)
                return false;

            logLine = $"[C2:REN] terrainTune {label} groundTiling={PreviewGroundTiling:0.###} secondTiling={PreviewSecondTiling:0.###} factureTiling={PreviewFactureTiling:0.###} factureStrength={PreviewFactureStrength:0.###} slopeBlend={PreviewSlopeBlendPower:0.###} slopeSecondAtten={PreviewSlopeSecondAtten:0.###} slopeFactureAtten={PreviewSlopeFactureAtten:0.###}";
            return true;
        }

        private bool WasBaseTilingDownPressed()
        {
