        private static void AddGroundTriangleToStageLikeOriginal(GroundVertexStageLikeOriginal groundStageLikeOriginal, int groundId, VertexTnL2LikeOriginal v0, VertexTnL2LikeOriginal v1, VertexTnL2LikeOriginal v2)
        {
            if (groundStageLikeOriginal == null)
                return;

            int bucketId = Mathf.Clamp(groundId, 0, 255);
            groundStageLikeOriginal.AddTriangleLikeOriginal(bucketId, v0, v1, v2);
        }

        private static void AddSTriangTriangleLikeOriginal(STriangDirectBufferLikeOriginal stTriangBufferLikeOriginal, VertexTnL2LikeOriginal v0, VertexTnL2LikeOriginal v1, VertexTnL2LikeOriginal v2)
        {
            if (stTriangBufferLikeOriginal == null)
                return;

            stTriangBufferLikeOriginal.AddTriangleLikeOriginal(v0, v1, v2);
        }

        private bool BuildGroundGArrayFromStageLikeOriginal(
            string selectedId,
            Shader surfaceShader,
            Texture flatWhiteTex,
            GroundVertexStageLikeOriginal groundStageLikeOriginal,
            VertexStreamLikeOriginal[] gArrayLikeOriginal,
            int[] nInGarrLikeOriginal,
            int[] maxInGarrLikeOriginal)
        {
            if (groundStageLikeOriginal == null || gArrayLikeOriginal == null || nInGarrLikeOriginal == null || maxInGarrLikeOriginal == null)
                return false;

            var groundById = new GArrayBufferLikeOriginal[256];
            for (int tri = 0; tri < groundStageLikeOriginal.TriangleCountLikeOriginal; tri++)
            {
                int bucketId = groundStageLikeOriginal.GetBucketIdLikeOriginal(tri);
                if (bucketId < 0 || bucketId >= groundById.Length)
                    continue;

                GArrayBufferLikeOriginal buffer = groundById[bucketId];
                if (buffer == null)
                {
                    buffer = new GArrayBufferLikeOriginal();
                    groundById[bucketId] = buffer;
                }

                groundStageLikeOriginal.CopyTriangleToLikeOriginal(tri, buffer);
            }

            bool hasAny = false;
            for (int groundId = 0; groundId < groundById.Length && groundId < gArrayLikeOriginal.Length; groundId++)
            {
                GArrayBufferLikeOriginal buffer = groundById[groundId];
                if (buffer == null || buffer.VertexCountLikeOriginal <= 0)
                    continue;

                VertexStreamLikeOriginal stream = CreateFactureVertexStreamLikeOriginal(
                    selectedId + "_strict_ground_" + groundId.ToString(),
                    buffer,
                    surfaceShader,
                    flatWhiteTex,
                    null,
                    2000,
                    1.0f,
                    0.0f,
                    null);
                if (stream == null)
                    continue;

                if (stream.Material != null)
                {
                    if (stream.Material.HasProperty("_Color"))
                        stream.Material.SetColor("_Color", new Color(0.74f, 0.74f, 0.74f, 1.0f));
                    if (stream.Material.HasProperty("_BaseColor"))
                        stream.Material.SetColor("_BaseColor", new Color(0.74f, 0.74f, 0.74f, 1.0f));
                }

                stream.FactureIdLikeOriginal = groundId;
                stream.Dot3LikeOriginal = false;
                gArrayLikeOriginal[groundId] = stream;
                nInGarrLikeOriginal[groundId] = stream.VertexCountLikeOriginal;
                maxInGarrLikeOriginal[groundId] = stream.VertexCountLikeOriginal;
                hasAny = true;
            }

            return hasAny;
        }

        private Mesh CreateRuntimeMeshFromVertexPtrLikeOriginal(string name, VertexTnL2LikeOriginal[] vertices, int vertexCount)
        {
            if (vertices == null || vertexCount <= 0)
                return null;

            Mesh mesh = new Mesh();
            mesh.name = string.IsNullOrEmpty(name) ? "BaseMeshLikeOriginal_runtime" : name;
            mesh.MarkDynamic();
            UploadRuntimeMeshDataLikeOriginal(mesh, vertices, vertexCount);
            _terrainRuntimeOwnedObjects.Add(mesh);
            return mesh;
        }

        private bool ConfigureGroundMeshSharedRuntimeLikeOriginal(BaseMeshLikeOriginal groundMeshLikeOriginal, string name)
        {
            if (groundMeshLikeOriginal == null || groundMeshLikeOriginal.GArrayLikeOriginal == null)
                return false;

            var combinedVertices = new List<VertexTnL2LikeOriginal>(4096);
            var subMeshRanges = new List<SubMeshSubmitRangeLikeOriginal>();
            bool hasAnyStream = false;

            for (int factureId = 0; factureId < groundMeshLikeOriginal.GArrayLikeOriginal.Length; factureId++)
            {
                VertexStreamLikeOriginal stream = groundMeshLikeOriginal.GArrayLikeOriginal[factureId];
                if (stream == null || stream.VertexPtrLikeOriginal == null || stream.VertexCountLikeOriginal <= 0 || stream.Material == null)
                    continue;

                int sourceCount = Mathf.Min(stream.VertexCountLikeOriginal, stream.VertexPtrLikeOriginal.Length);
                if (sourceCount <= 0)
                    continue;

                int firstVertex = combinedVertices.Count;
                var indices = new int[sourceCount];
                for (int i = 0; i < sourceCount; i++)
                {
                    combinedVertices.Add(stream.VertexPtrLikeOriginal[i]);
                    indices[i] = firstVertex + i;
                }

                stream.SubmitFirstVertexLikeOriginal = firstVertex;
                stream.SubmitVertexCountLikeOriginal = sourceCount;
                stream.SubmitSubMeshIndexLikeOriginal = subMeshRanges.Count;
                subMeshRanges.Add(new SubMeshSubmitRangeLikeOriginal
                {
                    FirstVertexLikeOriginal = firstVertex,
                    VertexCountLikeOriginal = sourceCount,
                    IndicesLikeOriginal = indices
                });
                hasAnyStream = true;
            }

            if (!hasAnyStream || combinedVertices.Count <= 0 || subMeshRanges.Count <= 0)
                return false;

            VertexTnL2LikeOriginal[] sharedVertexPtr = combinedVertices.ToArray();
            Mesh sharedMesh = new Mesh();
            sharedMesh.name = string.IsNullOrEmpty(name) ? "GroundMeshLikeOriginal_runtime" : name;
            sharedMesh.MarkDynamic();
            UploadRuntimeMeshDataWithSubMeshesLikeOriginal(sharedMesh, sharedVertexPtr, sharedVertexPtr.Length, subMeshRanges);
            _terrainRuntimeOwnedObjects.Add(sharedMesh);

            for (int factureId = 0; factureId < groundMeshLikeOriginal.GArrayLikeOriginal.Length; factureId++)
            {
                VertexStreamLikeOriginal stream = groundMeshLikeOriginal.GArrayLikeOriginal[factureId];
                if (stream == null || stream.SubmitSubMeshIndexLikeOriginal < 0)
                    continue;
                stream.VertexPtrLikeOriginal = sharedVertexPtr;
            }

            groundMeshLikeOriginal.SharedRuntimeMeshLikeOriginal = sharedMesh;
            groundMeshLikeOriginal.SharedVertexPtrLikeOriginal = sharedVertexPtr;
            groundMeshLikeOriginal.SharedSubmitRangesLikeOriginal = subMeshRanges;
            groundMeshLikeOriginal.RuntimeMeshLikeOriginal = sharedMesh;
            return true;
        }

        private VertexStreamLikeOriginal CreatePlainWhiteGeometryVertexStreamLikeOriginal(string name, Mesh sourceMesh, Material sharedMaterial)
        {
            if (sourceMesh == null || sharedMaterial == null)
                return null;

            VertexTnL2LikeOriginal[] vertexPtr = BuildVertexPtrFromUnityMeshLikeOriginal(sourceMesh, new Color32(255, 255, 255, 255));
            int vertexCount = vertexPtr != null ? vertexPtr.Length : 0;
            if (vertexCount <= 0)
                return null;

            Mesh runtimeMesh = CreateRuntimeMeshFromVertexPtrLikeOriginal(name + "_runtime", vertexPtr, vertexCount);
            if (runtimeMesh == null)
                return null;

            return new VertexStreamLikeOriginal
            {
                Material = sharedMaterial,
                RuntimeMeshLikeOriginal = runtimeMesh,
                VertexPtrLikeOriginal = vertexPtr,
                VertexCountLikeOriginal = vertexCount,
                SubmitFirstVertexLikeOriginal = 0,
                SubmitVertexCountLikeOriginal = vertexCount,
                FactureIdLikeOriginal = 0,
                Dot3LikeOriginal = false
            };
        }

        [StructLayout(LayoutKind.Sequential)]
        private struct RuntimeSubmitVertexLikeOriginal
        {
            public Vector3 Position;
            public Color32 Color;
            public Vector2 Uv0;
            public Vector4 Uv2;

            public RuntimeSubmitVertexLikeOriginal(VertexTnL2LikeOriginal v)
            {
                Position = new Vector3(v.X, v.Y, v.Z);
                Color = VertexTnL2LikeOriginal.UnpackDiffuseLikeOriginal(v.Diffuse);
                Uv0 = new Vector2(v.U, v.V);
                Uv2 = new Vector4(v.W, v.U2, v.V2, 0.0f);
            }

            public RuntimeSubmitVertexLikeOriginal(Vector3 position, Color32 color)
            {
                Position = position;
                Color = color;
                Uv0 = Vector2.zero;
                Uv2 = Vector4.zero;
            }
        }

        


        private static VertexTnL2LikeOriginal[] BuildVertexPtrFromUnityMeshLikeOriginal(Mesh sourceMesh, Color32 diffuse)
        {
            if (sourceMesh == null)
                return null;

            Vector3[] positions = sourceMesh.vertices;
            int[] triangles = sourceMesh.triangles;
            Vector2[] uv0 = sourceMesh.uv;
            if (positions == null || triangles == null || triangles.Length == 0)
                return null;

            uint packedDiffuse = VertexTnL2LikeOriginal.PackDiffuseLikeOriginal(diffuse);
            var vertexPtr = new VertexTnL2LikeOriginal[triangles.Length];

            for (int i = 0; i < triangles.Length; i++)
            {
                int srcIndex = triangles[i];
                if (srcIndex < 0 || srcIndex >= positions.Length)
                    srcIndex = 0;

                Vector3 p = positions[srcIndex];
                Vector2 uv = (uv0 != null && srcIndex >= 0 && srcIndex < uv0.Length) ? uv0[srcIndex] : Vector2.zero;

                vertexPtr[i] = new VertexTnL2LikeOriginal(
                    p.x,
                    p.y,
                    p.z,
                    1.0f,
                    packedDiffuse,
                    uv.x,
                    uv.y,
                    0.0f,
                    0.0f);
            }

            return vertexPtr;
        }

        private static void UploadRuntimeMeshDataLikeOriginal(Mesh mesh, VertexTnL2LikeOriginal[] vertices, int vertexCount)
        {
            if (mesh == null)
                return;
            vertexCount = Mathf.Min(vertexCount, vertices != null ? vertices.Length : 0);
            if (vertexCount <= 0)
            {
                mesh.Clear();
                return;
            }

            var singleRange = new List<SubMeshSubmitRangeLikeOriginal>(1)
            {
                new SubMeshSubmitRangeLikeOriginal
                {
                    FirstVertexLikeOriginal = 0,
                    VertexCountLikeOriginal = vertexCount,
                    IndicesLikeOriginal = BuildSequentialIndicesLikeOriginal(vertexCount)
                }
            };

            UploadRuntimeMeshDataWithSubMeshesLikeOriginal(mesh, vertices, vertexCount, singleRange);
        }

        private static int[] BuildSequentialIndicesLikeOriginal(int vertexCount)
        {
            var indices = new int[Mathf.Max(0, vertexCount)];
            for (int i = 0; i < indices.Length; i++)
                indices[i] = i;
            return indices;
        }

        private static void UploadRuntimeMeshDataWithSubMeshesLikeOriginal(Mesh mesh, VertexTnL2LikeOriginal[] vertices, int vertexCount, List<SubMeshSubmitRangeLikeOriginal> subMeshRanges)
        {
            if (mesh == null)
                return;
            vertexCount = Mathf.Min(vertexCount, vertices != null ? vertices.Length : 0);
            if (vertexCount <= 0 || subMeshRanges == null || subMeshRanges.Count == 0)
            {
                mesh.Clear();
                return;
            }

            var vertexLayout = new[]
            {
                new VertexAttributeDescriptor(VertexAttribute.Position, VertexAttributeFormat.Float32, 3),
                new VertexAttributeDescriptor(VertexAttribute.Color, VertexAttributeFormat.UNorm8, 4),
                new VertexAttributeDescriptor(VertexAttribute.TexCoord0, VertexAttributeFormat.Float32, 2),
                new VertexAttributeDescriptor(VertexAttribute.TexCoord2, VertexAttributeFormat.Float32, 4)
            };

            int totalIndexCount = 0;
            for (int i = 0; i < subMeshRanges.Count; i++)
            {
                SubMeshSubmitRangeLikeOriginal range = subMeshRanges[i];
                if (range != null && range.IndicesLikeOriginal != null)
                    totalIndexCount += range.IndicesLikeOriginal.Length;
            }

            Mesh.MeshDataArray meshDataArray = Mesh.AllocateWritableMeshData(1);
            try
            {
                Mesh.MeshData meshData = meshDataArray[0];
                meshData.subMeshCount = subMeshRanges.Count;
                meshData.SetVertexBufferParams(vertexCount, vertexLayout);
                var dstVertices = meshData.GetVertexData<RuntimeSubmitVertexLikeOriginal>();
                for (int i = 0; i < vertexCount; i++)
                    dstVertices[i] = new RuntimeSubmitVertexLikeOriginal(vertices[i]);

                IndexFormat indexFormat = vertexCount > 65535 ? IndexFormat.UInt32 : IndexFormat.UInt16;
                meshData.SetIndexBufferParams(totalIndexCount, indexFormat);
                if (indexFormat == IndexFormat.UInt32)
                {
                    var dstIndices = meshData.GetIndexData<uint>();
                    int cursor = 0;
                    for (int i = 0; i < subMeshRanges.Count; i++)
                    {
                        SubMeshSubmitRangeLikeOriginal range = subMeshRanges[i];
                        int[] src = range != null ? range.IndicesLikeOriginal : null;
                        int count = src != null ? src.Length : 0;
                        for (int k = 0; k < count; k++)
                            dstIndices[cursor + k] = (uint)Mathf.Max(0, src[k]);
                        var desc = new SubMeshDescriptor(cursor, count, MeshTopology.Triangles)
                        {
                            firstVertex = range != null ? Mathf.Max(0, range.FirstVertexLikeOriginal) : 0,
                            vertexCount = range != null ? Mathf.Clamp(range.VertexCountLikeOriginal, 0, vertexCount - Mathf.Max(0, range.FirstVertexLikeOriginal)) : 0,
                            bounds = new Bounds(Vector3.zero, new Vector3(1000000.0f, 1000000.0f, 1000000.0f))
                        };
                        meshData.SetSubMesh(i, desc, MeshUpdateFlags.DontRecalculateBounds | MeshUpdateFlags.DontValidateIndices | MeshUpdateFlags.DontNotifyMeshUsers);
                        cursor += count;
                    }
                }
                else
                {
                    var dstIndices = meshData.GetIndexData<ushort>();
                    int cursor = 0;
                    for (int i = 0; i < subMeshRanges.Count; i++)
                    {
                        SubMeshSubmitRangeLikeOriginal range = subMeshRanges[i];
                        int[] src = range != null ? range.IndicesLikeOriginal : null;
                        int count = src != null ? src.Length : 0;
                        for (int k = 0; k < count; k++)
                            dstIndices[cursor + k] = (ushort)Mathf.Clamp(src[k], 0, 65535);
                        var desc = new SubMeshDescriptor(cursor, count, MeshTopology.Triangles)
                        {
                            firstVertex = range != null ? Mathf.Max(0, range.FirstVertexLikeOriginal) : 0,
                            vertexCount = range != null ? Mathf.Clamp(range.VertexCountLikeOriginal, 0, vertexCount - Mathf.Max(0, range.FirstVertexLikeOriginal)) : 0,
                            bounds = new Bounds(Vector3.zero, new Vector3(1000000.0f, 1000000.0f, 1000000.0f))
                        };
                        meshData.SetSubMesh(i, desc, MeshUpdateFlags.DontRecalculateBounds | MeshUpdateFlags.DontValidateIndices | MeshUpdateFlags.DontNotifyMeshUsers);
                        cursor += count;
                    }
                }

                mesh.Clear();
                Mesh.ApplyAndDisposeWritableMeshData(meshDataArray, mesh, MeshUpdateFlags.DontRecalculateBounds | MeshUpdateFlags.DontValidateIndices | MeshUpdateFlags.DontNotifyMeshUsers);
                mesh.bounds = new Bounds(Vector3.zero, new Vector3(1000000.0f, 1000000.0f, 1000000.0f));
                mesh.UploadMeshData(false);
            }
            catch
            {
                meshDataArray.Dispose();
                throw;
            }
        }



private sealed class IRSLikeOriginalRenderer : MonoBehaviour
        {
            private static readonly int C2ViewportId = Shader.PropertyToID("_C2Viewport");
            private static readonly int DiffuseColorId = Shader.PropertyToID("_DiffuseColor");
            private static readonly int MainUvRectId = Shader.PropertyToID("_MainUvRect");
            private static readonly int StoneUvRectId = Shader.PropertyToID("_StoneUvRect");
            private static readonly int C2RhwId = Shader.PropertyToID("_C2Rhw");

            public BaseMeshLikeOriginal STriangLikeOriginal;
            public BaseMeshLikeOriginal GroundMeshLikeOriginal;
            public Mesh StoneQuadMeshLikeOriginal;
            public Material StoneMaterialLikeOriginal;
            public Vector4 StoneViewportLikeOriginal;
            public Camera ExpectedCameraLikeOriginal;
            public List<StoneSpriteRecordLikeOriginal> StoneSpritesLikeOriginal;

            private MaterialPropertyBlock _stonePropsLikeOriginal;

            private void OnRenderObject()
            {
                Camera cam = Camera.current;
                if (cam == null)
                    return;
                if (ExpectedCameraLikeOriginal != null && cam != ExpectedCameraLikeOriginal)
                    return;

                if (STriangLikeOriginal != null)
                    DrawLikeOriginal(STriangLikeOriginal, cam);

                if (GroundMeshLikeOriginal == null || GroundMeshLikeOriginal.GArrayLikeOriginal == null)
                    return;

                int maxFactures = GroundMeshLikeOriginal.GArrayLikeOriginal.Length;
                for (int fid = 0; fid < maxFactures; fid++)
                {
                    if (!GroundMeshLikeOriginal.SetVertexPtrFromGArrayLikeOriginal(fid))
                        continue;
                    if (GroundMeshLikeOriginal.VertexPtrLikeOriginal == null || GroundMeshLikeOriginal.NVertLikeOriginal <= 0)
                        continue;
                    DrawLikeOriginal(GroundMeshLikeOriginal, cam);
                }
            }

            private void DrawStoneMeshLikeOriginal(Camera cam)
            {
                // Stone path is deleted in the strict-runtime geometry-only build.
            }

            private static void DrawLikeOriginal(BaseMeshLikeOriginal meshLikeOriginal, Camera cam)
            {
                if (meshLikeOriginal == null || meshLikeOriginal.RuntimeMaterialLikeOriginal == null || meshLikeOriginal.RuntimeMeshLikeOriginal == null || meshLikeOriginal.VertexPtrLikeOriginal == null || meshLikeOriginal.NVertLikeOriginal <= 0)
                    return;

                int subMeshIndex = meshLikeOriginal.ResolveActiveSubMeshFromRangeLikeOriginal();
                if (subMeshIndex < 0)
                    subMeshIndex = meshLikeOriginal.ActiveSubMeshIndexLikeOriginal >= 0 ? meshLikeOriginal.ActiveSubMeshIndexLikeOriginal : 0;
                if (subMeshIndex < 0 || subMeshIndex >= meshLikeOriginal.RuntimeMeshLikeOriginal.subMeshCount)
                    return;

                if (meshLikeOriginal.SharedSubmitRangesLikeOriginal != null && subMeshIndex < meshLikeOriginal.SharedSubmitRangesLikeOriginal.Count)
                {
                    SubMeshSubmitRangeLikeOriginal activeRange = meshLikeOriginal.SharedSubmitRangesLikeOriginal[subMeshIndex];
                    if (activeRange == null)
                        return;

                    int expectedFirst = Mathf.Max(0, meshLikeOriginal.ActiveSubmitFirstVertexLikeOriginal);
                    int expectedCount = Mathf.Max(0, meshLikeOriginal.ActiveSubmitVertexCountLikeOriginal);
                    if (activeRange.FirstVertexLikeOriginal != expectedFirst || activeRange.VertexCountLikeOriginal != expectedCount)
                        return;

                    SubMeshDescriptor desc = meshLikeOriginal.RuntimeMeshLikeOriginal.GetSubMesh(subMeshIndex);
                    if (desc.firstVertex != activeRange.FirstVertexLikeOriginal || desc.vertexCount != activeRange.VertexCountLikeOriginal)
                        return;
                }

                Graphics.DrawMesh(meshLikeOriginal.RuntimeMeshLikeOriginal, Matrix4x4.identity, meshLikeOriginal.RuntimeMaterialLikeOriginal, 0, cam, subMeshIndex, null,
                    ShadowCastingMode.Off, false, null, false);
            }
        }

