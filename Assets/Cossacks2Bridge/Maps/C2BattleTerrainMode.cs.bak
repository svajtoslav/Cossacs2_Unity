private static short[] BuildRoadNoiseTable()
{
    var arr = new short[8192];
    uint seed = 0x13579BDFu;
    for (int i = 0; i < arr.Length; i++)
    {
        seed = 1664525u * seed + 1013904223u;
        arr[i] = (short)((seed >> 17) & 0x7FFF);
    }
    return arr;
}


