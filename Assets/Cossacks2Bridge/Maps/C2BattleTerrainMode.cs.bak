        private static Texture2D s_externalWaterCaustics;
        private static Texture2D s_externalWaterDynamicRippleNormal;
        private static Texture2D s_externalWaterDynamicRippleCaustics;
        private static float s_externalWaterDynamicRippleLastUpdateTime = -999.0f;
        private static bool s_externalWaterDynamicRippleDirty = true;
        private static int s_externalWaterDynamicRippleRevision = 0;
        private const int kExternalWaterDynamicRippleSize = 128;
        private const float kExternalWaterMinShoreAlpha = 0.001f;

        public sealed class ExternalWaterPreset
        {
            public bool EnableFoam = true;
            public bool EnableRefraction = true;
            public bool EnableWaves = true;
            public bool UseSoftFoamTexture = true;
            public bool UseSecondaryNormalMap = true;
            public Color ShallowColor = new Color(0.26272696f, 0.4528302f, 0.42330298f, 0.2784314f);
            public Color DeepColor = new Color(0.083659664f, 0.3773585f, 0.35439774f, 1.0f);
            public Color FoamColor = Color.white;
            public float Smoothness = 0.5f;
            public float Metallic = 0.28f;
            public float TextureScale = 33.53f;
            public float NormalStrength = 1.0f;
            public float NormalDirectionDeg = 0.0f;
            public float Depth = 70.0f;
            public float OpacityPercent = 100.0f;
            public float ShorelineOpacityPercent = 10.0f;
            public float ShorelineWidthPercent = 28.0f;
            public float RefractionPower = 1.35f;
            public float RefractionStrength = 0.1f;
            public float WaveSpeed = 0.01f;
            public float WavesHeight = 1.0f;
            public float WavesLength = 0.2f;
            public float WaveAmplitude = 0.1f;
            public float FoamAmount = 0.7f;
            public float FoamDepth = 2.39f;
            public float FoamCutoff = 36.76f;
            public float FoamSpeed = 0.01f;
            public float CausticsStrength = 1.98f;
            public float CausticsSpeed = 1.0f;
            public float CausticsAlpha = 0.18f;
            public float CellDensity = 95.0f;
            public float PatternScale = 420.0f;
            public float HighFrequency = 0.35f;
            public float RippleAreaPercent = 100.0f;
            public float RippleStabilityPercent = 100.0f;
            public bool EnableRandomRippleZones = false;
            public bool EnableRippleTimeDrift = false;
            public bool EnableCloudReflection = false;
            public string CloudTextureId = "oblaka123g1";
            public float CloudOpacityPercent = 18.0f;
            public float CloudSpeed = 0.015f;
            public float CloudDirectionDeg = 35.0f;
            public float CloudScale = 1.0f;
            public float CloudSpacing = 1.0f;
            public float CloudContrast = 1.0f;
            public float RimStrength = 31.8f;
            public float WaterMovementSpeed = 7.0f;
            public float ReflectionFallbackRotateDeg = 0.0f;
            public bool ReflectionFallbackFlipX = false;
            public bool ReflectionFallbackFlipY = false;
            public float ReflectionProjectiveRotateDeg = 0.0f;
            public bool ReflectionProjectiveFlipX = false;
            public bool ReflectionProjectiveFlipY = false;
