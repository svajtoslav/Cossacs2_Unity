        private static readonly string[] s_waterCloudTextureChoices = new[]
        {
            "oblaka123g1",
            "oblaka123g2",
            "oblaka123g",
            "oblaka123",
            "oblaka1",
            "oblaka2",
            "oblaka3",
            "oblaka4",
            "oblaka5"
        };

        public static string[] GetWaterCloudTextureChoices()
        {
            return s_waterCloudTextureChoices;
        }

        private static string NormalizeWaterCloudTextureId(string id)
        {
            string s = string.IsNullOrWhiteSpace(id) ? "oblaka123g1" : id.Trim();
            s = s.Replace('\\', '/');
            int slash = s.LastIndexOf('/');
            if (slash >= 0 && slash + 1 < s.Length)
                s = s.Substring(slash + 1);
            if (s.EndsWith(".tga", StringComparison.OrdinalIgnoreCase))
                s = s.Substring(0, s.Length - 4);
            if (s.EndsWith(".bmp", StringComparison.OrdinalIgnoreCase))
                s = s.Substring(0, s.Length - 4);

            for (int i = 0; i < s_waterCloudTextureChoices.Length; i++)
            {
                if (string.Equals(s_waterCloudTextureChoices[i], s, StringComparison.OrdinalIgnoreCase))
                    return s_waterCloudTextureChoices[i];
            }

            return "oblaka123g1";
        }

        private static Texture2D LoadWaterCloudTextureById(string id)
        {
            string normalized = NormalizeWaterCloudTextureId(id);
            Texture2D tex = Resources.Load<Texture2D>("textures/" + normalized);
            if (tex == null && !string.Equals(normalized, "oblaka123g1", StringComparison.OrdinalIgnoreCase))
                tex = Resources.Load<Texture2D>("textures/oblaka123g1");
            return tex;
        }

        public static void EnsureExternalWaterPresetInitialized()
        {
            if (s_externalWaterPresetInitialized)
                return;

            Material template = Resources.Load<Material>("water");
            if (template != null)
                ReadExternalWaterPresetFromMaterial(template, s_externalWaterPreset);

            TryLoadExternalWaterPresetFromIni(s_externalWaterPreset);
            s_externalWaterPresetInitialized = true;
        }

        public void DebugApplyExternalWaterPresetNow()
        {
            ApplyExternalWaterPresetToMaterial(_waterMaterial);
            ApplyWaterRendererVisibilityFromPreset();
            ApplyWaterReflectionParams(true);
        }

        private void ApplyWaterRendererVisibilityFromPreset()
        {
            if (_waterGo == null)
                return;

            var mr = _waterGo.GetComponent<MeshRenderer>();
            if (mr == null)
                return;

            bool visible = s_externalWaterPreset == null || s_externalWaterPreset.OpacityPercent > 0.0f;
            if (mr.enabled != visible)
            {
                mr.enabled = visible;
                Debug.Log($"[C2:WATER] visibilityGate renderer={(visible ? "enabled" : "disabled")} opacity={s_externalWaterPreset?.OpacityPercent ?? -1.0f:0.###}");
            }
        }

        public static void ApplyExternalWaterPresetToAllActiveWater()
        {
            var modes = FindObjectsByType<C2BattleTerrainMode>(FindObjectsInactive.Include, FindObjectsSortMode.None);
            MarkExternalWaterDynamicRippleDirty();

            for (int i = 0; i < modes.Length; i++)
            {
                if (modes[i] != null)
                    modes[i].DebugApplyExternalWaterPresetNow();
            }

            SaveExternalWaterPresetToIni();
        }

        private static void ReadExternalWaterPresetFromMaterial(Material mat, ExternalWaterPreset preset)
        {
            if (mat == null || preset == null)
                return;

            preset.EnableFoam = ReadKeywordOrFloat(mat, "_ENABLE_FOAM", true);
            preset.EnableRefraction = ReadKeywordOrFloat(mat, "_ENABLE_REFRACTION", true);
            preset.EnableWaves = ReadKeywordOrFloat(mat, "_ENABLE_WAVES", true);
            if (mat.HasProperty("_shallow_water_color")) preset.ShallowColor = mat.GetColor("_shallow_water_color");
            if (mat.HasProperty("_deep_water_color")) preset.DeepColor = mat.GetColor("_deep_water_color");
            if (mat.HasProperty("_foam_color")) preset.FoamColor = mat.GetColor("_foam_color");
            preset.UseSoftFoamTexture = true;
            preset.UseSecondaryNormalMap = true;
            preset.Smoothness = ReadFloat(mat, "_Smoothness", preset.Smoothness);
            preset.Metallic = ReadFloat(mat, "_Metallic", preset.Metallic);
            preset.TextureScale = ReadFloat(mat, "_Texture_scale", preset.TextureScale);
            preset.NormalStrength = ReadFloatEither(mat, new string[]{"_normal_strenght", "_Normal_strenght"}, preset.NormalStrength);
            preset.Depth = ReadFloat(mat, "_Depth", preset.Depth);
            preset.OpacityPercent = Mathf.Clamp(ReadColorAlpha(mat, "_deep_water_color", 1.0f) * 100.0f, 0.0f, 100.0f);
            preset.ShorelineOpacityPercent = Mathf.Clamp(ReadColorAlpha(mat, "_shallow_water_color", Mathf.Clamp01(preset.ShorelineOpacityPercent / 100.0f)) * 100.0f, 0.0f, 100.0f);
            preset.ShorelineWidthPercent = 28.0f;
            preset.RefractionPower = ReadFloat(mat, "_Refraction_Power", preset.RefractionPower);
            preset.RefractionStrength = ReadFloat(mat, "_refraction_strenght", preset.RefractionStrength);
            preset.WaveSpeed = ReadFloat(mat, "_WaveSpeed", preset.WaveSpeed);
            preset.WavesHeight = ReadFloat(mat, "_Waves_height", preset.WavesHeight);
            preset.WavesLength = ReadFloat(mat, "_Waves_Length", preset.WavesLength);
            preset.WaveAmplitude = ReadFloatEither(mat, new string[]{"_Wave_ampllitude", "_Waveampllitude"}, preset.WaveAmplitude);
            preset.FoamAmount = ReadFloat(mat, "_foam_amaont", preset.FoamAmount);
            preset.FoamDepth = ReadFloat(mat, "_Foam_depth", preset.FoamDepth);
            preset.FoamCutoff = ReadFloat(mat, "_foam_cutoff", preset.FoamCutoff);
            preset.FoamSpeed = ReadFloat(mat, "_foam_speed", preset.FoamSpeed);
            preset.CausticsStrength = ReadFloat(mat, "_caustics_Strenght", preset.CausticsStrength);
            preset.CausticsSpeed = ReadFloat(mat, "_caustics_Speed", preset.CausticsSpeed);
            preset.CausticsAlpha = Mathf.Min(ReadFloat(mat, "_caustics_Alpha", preset.CausticsAlpha), 0.18f);
            preset.CellDensity = Mathf.Min(ReadFloat(mat, "_cell_density", preset.CellDensity), 95.0f);
            preset.PatternScale = Mathf.Max(ReadFloat(mat, "_scale", preset.PatternScale), 420.0f);
            preset.HighFrequency = Mathf.Min(ReadFloat(mat, "_highFrequeny", preset.HighFrequency), 0.35f);
            preset.RippleAreaPercent = 100.0f;
            preset.RippleStabilityPercent = 100.0f;
            preset.EnableRandomRippleZones = false;
            preset.EnableRippleTimeDrift = false;
            preset.EnableCloudReflection = false;
            preset.CloudTextureId = "oblaka123g1";
            preset.CloudOpacityPercent = 18.0f;
            preset.CloudSpeed = 0.015f;
            preset.CloudDirectionDeg = 35.0f;
            preset.CloudScale = 1.0f;
            preset.CloudSpacing = 1.0f;
            preset.CloudContrast = 1.0f;
            preset.RimStrength = ReadFloat(mat, "_Rim_strenght", preset.RimStrength);
            preset.WaterMovementSpeed = ReadFloat(mat, "_water_movement_speed", preset.WaterMovementSpeed);
        }

        private static Material TryCreateExternalWaterMaterial(string selectedId, out string info)
        {
            EnsureExternalWaterPresetInitialized();
            Material template = Resources.Load<Material>("water");
            if (template == null)
            {
                info = "externalMaterial=missing resource=Resources/water.mat fallback=bridge-shader";
                return null;
            }

            var clone = new Material(template);
            clone.name = string.IsNullOrWhiteSpace(selectedId) ? "water_external_runtime" : (selectedId + "_water_external_runtime");
            ApplyExternalWaterPresetToMaterial(clone);
            info = $"externalMaterial=ok resource=Resources/water.mat template={template.name} shader={(template.shader != null ? template.shader.name : "<null>")}";
            return clone;
        }

        public static void ApplyExternalWaterPresetToMaterial(Material mat)
        {
            EnsureExternalWaterPresetInitialized();
            if (mat == null)
                return;

            var p = s_externalWaterPreset;
            float opacity01Raw = Mathf.Clamp01(p.OpacityPercent / 100.0f);
            float shorelineOpacity01Raw = Mathf.Clamp01(p.ShorelineOpacityPercent / 100.0f);
            float shorelineWidth01Raw = Mathf.Clamp01(p.ShorelineWidthPercent / 100.0f);

            // Perceptual remap: low percentages must die much faster than the current linear mapping,
            // otherwise 0.5% still looks like visible jelly. 0 stays 0, 100 stays 1.
            float deepAlpha = opacity01Raw <= 0.0f ? 0.0f : Mathf.Pow(opacity01Raw, 2.35f);
            float shorelineOpacityAlpha = shorelineOpacity01Raw <= 0.0f ? 0.0f : Mathf.Pow(shorelineOpacity01Raw, 2.10f);
            float shorelineWidth01 = shorelineWidth01Raw <= 0.0f ? 0.0f : Mathf.Pow(shorelineWidth01Raw, 0.60f);
            bool hasShorelineZone = shorelineWidth01Raw > 0.0001f;
            float shorelineBlend = hasShorelineZone ? Mathf.SmoothStep(0.0f, 1.0f, shorelineWidth01) : 0.0f;

            float shallowAlpha = hasShorelineZone ? (deepAlpha * shorelineOpacityAlpha) : deepAlpha;
            shallowAlpha = Mathf.Clamp(shallowAlpha, 0.0f, deepAlpha);

            // Make the shallow/shore band more aggressive: when Shore zone % grows, keep the shallow depth
            // much lower so the fade from the banks is broader and softer.
            float minDepth = Mathf.Max(0.02f, p.Depth * 0.004f);
            float maxDepth = Mathf.Max(minDepth + 0.05f, p.Depth * 2.5f);
            float effectiveDepth = hasShorelineZone ? Mathf.Lerp(minDepth, maxDepth, shorelineBlend) : maxDepth;

            // Global material visibility: when Opacity % = 0 the whole material must disappear,
            // not only the fill. Shore opacity/width only affect the shoreline band.
            float globalFeatureScale = deepAlpha;
            float shorelineFeatureScale = hasShorelineZone ? shorelineOpacityAlpha : 1.0f;
            float combinedFeatureScale = Mathf.Clamp01(globalFeatureScale);
            float shorelineOnlyFeatureScale = Mathf.Clamp01(globalFeatureScale * shorelineFeatureScale);

            bool enableFoam = p.EnableFoam && combinedFeatureScale > 0.0001f;
            bool enableRefraction = p.EnableRefraction && combinedFeatureScale > 0.0001f;
            bool enableWaves = p.EnableWaves && combinedFeatureScale > 0.0001f;

            ApplyKeywordState(mat, "_ENABLE_FOAM", enableFoam);
            ApplyKeywordState(mat, "_ENABLE_REFRACTION", enableRefraction);
            ApplyKeywordState(mat, "_ENABLE_WAVES", enableWaves);
            SetFloatIf(mat, "_ENABLE_FOAM", enableFoam ? 1.0f : 0.0f);
            SetFloatIf(mat, "_ENABLE_REFRACTION", enableRefraction ? 1.0f : 0.0f);
            SetFloatIf(mat, "_ENABLE_WAVES", enableWaves ? 1.0f : 0.0f);

            Color shallowColor = p.ShallowColor;
            Color deepColor = p.DeepColor;
            shallowColor.a = shallowAlpha;
            deepColor.a = deepAlpha;

            if (mat.HasProperty("_Surface"))
                mat.SetFloat("_Surface", 1.0f);
            if (mat.HasProperty("_Blend"))
                mat.SetFloat("_Blend", 0.0f);
            if (mat.HasProperty("_SrcBlend"))
                mat.SetFloat("_SrcBlend", (float)UnityEngine.Rendering.BlendMode.SrcAlpha);
            if (mat.HasProperty("_DstBlend"))
                mat.SetFloat("_DstBlend", (float)UnityEngine.Rendering.BlendMode.OneMinusSrcAlpha);
            if (mat.HasProperty("_SrcBlendAlpha"))
                mat.SetFloat("_SrcBlendAlpha", (float)UnityEngine.Rendering.BlendMode.One);
            if (mat.HasProperty("_DstBlendAlpha"))
                mat.SetFloat("_DstBlendAlpha", (float)UnityEngine.Rendering.BlendMode.OneMinusSrcAlpha);
            if (mat.HasProperty("_AlphaClip"))
                mat.SetFloat("_AlphaClip", 0.0f);
            if (mat.HasProperty("_ZWrite"))
                mat.SetFloat("_ZWrite", 0.0f);
            mat.SetOverrideTag("RenderType", "Transparent");
            mat.EnableKeyword("_SURFACE_TYPE_TRANSPARENT");
            mat.renderQueue = 3000;

            Color foamColor = p.FoamColor;
            foamColor.a *= combinedFeatureScale;
            SetColorIf(mat, "_shallow_water_color", shallowColor);
            SetColorIf(mat, "_deep_water_color", deepColor);
            SetColorIf(mat, "_foam_color", foamColor);

            // Some shaders expose a master/base color alpha. Drive it too so the whole material can disappear.
            if (mat.HasProperty("_BaseColor"))
            {
                Color baseColor = mat.GetColor("_BaseColor");
                baseColor.a = combinedFeatureScale;
                mat.SetColor("_BaseColor", baseColor);
            }
            if (mat.HasProperty("_Color"))
            {
                Color color = mat.GetColor("_Color");
                color.a = combinedFeatureScale;
                mat.SetColor("_Color", color);
            }

            SetFloatIf(mat, "_Smoothness", p.Smoothness * combinedFeatureScale);
            SetFloatIf(mat, "_Metallic", p.Metallic * Mathf.Lerp(0.35f, 1.0f, combinedFeatureScale));
            SetFloatIf(mat, "_Texture_scale", p.TextureScale);
            SetFloatIf(mat, "_normal_strenght", p.NormalStrength * combinedFeatureScale);
            SetFloatIf(mat, "_Normal_strenght", p.NormalStrength * combinedFeatureScale);
            SetFloatIf(mat, "_Depth", effectiveDepth);
            SetFloatIf(mat, "_Refraction_Power", p.RefractionPower * combinedFeatureScale);
            SetFloatIf(mat, "_refraction_strenght", p.RefractionStrength * combinedFeatureScale);
            SetFloatIf(mat, "_WaveSpeed", p.WaveSpeed * combinedFeatureScale);
            SetFloatIf(mat, "_Waves_height", p.WavesHeight * combinedFeatureScale);
            SetFloatIf(mat, "_Waves_Length", p.WavesLength);
            SetFloatIf(mat, "_Wave_ampllitude", p.WaveAmplitude * combinedFeatureScale);
            SetFloatIf(mat, "_Waveampllitude", Mathf.Max(0.0f, p.WaveAmplitude * 20.0f * combinedFeatureScale));
            SetFloatIf(mat, "_foam_amaont", p.FoamAmount * combinedFeatureScale);
            SetFloatIf(mat, "_Foam_depth", Mathf.Lerp(0.0f, p.FoamDepth, combinedFeatureScale));
            SetFloatIf(mat, "_foam_cutoff", p.FoamCutoff);
            SetFloatIf(mat, "_foam_speed", p.FoamSpeed * combinedFeatureScale);
            SetFloatIf(mat, "_caustics_Strenght", p.CausticsStrength * combinedFeatureScale);
            SetFloatIf(mat, "_caustics_Speed", p.CausticsSpeed * combinedFeatureScale);
            SetFloatIf(mat, "_caustics_Alpha", p.CausticsAlpha * combinedFeatureScale);
            SetFloatIf(mat, "_cell_density", p.CellDensity);
            SetFloatIf(mat, "_scale", p.PatternScale);
            SetFloatIf(mat, "_highFrequeny", p.HighFrequency * combinedFeatureScale);
            SetFloatIf(mat, "_Rim_strenght", p.RimStrength * combinedFeatureScale);
            SetFloatIf(mat, "_water_movement_speed", p.WaterMovementSpeed * Mathf.Lerp(0.25f, 1.0f, combinedFeatureScale));
            // Force full disappearance of the remaining glass/jelly contribution when opacity goes low.
            SetFloatIf(mat, "_AlphaStrength", combinedFeatureScale);
            SetFloatIf(mat, "_AlphaCurve", Mathf.Lerp(0.0f, 0.98f, combinedFeatureScale));
            SetFloatIf(mat, "_DepthTintStrength", 0.42f * combinedFeatureScale);
            SetFloatIf(mat, "_FresnelStrength", 0.16f * combinedFeatureScale);
            SetFloatIf(mat, "_ReflectionStrength", 0.24f * combinedFeatureScale);
            SetFloatIf(mat, "_ReflectionSkyBlend", 0.56f * combinedFeatureScale);
            SetFloatIf(mat, "_ReflectionRealBlend", 0.78f * combinedFeatureScale);
            SetFloatIf(mat, "_EdgeResponse", 0.22f * combinedFeatureScale);
            SetFloatIf(mat, "_WaveAmp", 0.018f * combinedFeatureScale);
            SetFloatIf(mat, "_WaveAmp2", 0.010f * combinedFeatureScale);
            SetFloatIf(mat, "_WaveFreq1", 0.0018f);
            SetFloatIf(mat, "_WaveFreq2", 0.0036f);
            SetFloatIf(mat, "_WaveSpeed1", 0.42f * combinedFeatureScale);
            SetFloatIf(mat, "_WaveSpeed2", -0.31f * combinedFeatureScale);
            SetFloatIf(mat, "_WaveDistort", 0.020f * combinedFeatureScale);
            SetFloatIf(mat, "_WaveNormalStrength", 0.42f * combinedFeatureScale);
            SetFloatIf(mat, "_MinVisibleAlpha", 0.0f);
            SetFloatIf(mat, "_StaticFlowFallback", 0.20f * combinedFeatureScale);
            SetFloatIf(mat, "_StaticFlowFreq", 0.0021f);
            SetFloatIf(mat, "_StaticFlowSpeed", 0.52f * combinedFeatureScale);
            SetFloatIf(mat, "_StaticFlowDistort", 0.016f * combinedFeatureScale);
            SetFloatIf(mat, "_RiverLineStrength", 0.34f * combinedFeatureScale);
            SetFloatIf(mat, "_RiverStrength", 1.0f * combinedFeatureScale);
            SetFloatIf(mat, "_LevelStrength", 0.40f * shorelineOnlyFeatureScale);
            SetFloatIf(mat, "_RefSurfStrength", 0.36f * combinedFeatureScale);
            SetFloatIf(mat, "_RefSurfContrast", Mathf.Lerp(1.0f, 1.25f, combinedFeatureScale));
            SetFloatIf(mat, "_RefSurfShoreBoost", 0.46f * shorelineOnlyFeatureScale);
            SetFloatIf(mat, "_RefSurfDepthBoost", 0.18f * combinedFeatureScale);
            SetFloatIf(mat, "_SoftEdge", 0.16f * shorelineOnlyFeatureScale);
            ApplyExternalWaterAxisParityAndDirection(mat, p);
            UpdateExternalWaterDynamicRippleTexturesIfNeeded(p, force: s_externalWaterDynamicRippleDirty);
            ApplyExternalWaterReferenceTextures(mat, p);
        }

        private static readonly Vector4 kExternalWaterBaseWaveDirection = new Vector4(0.5f, 0.1f, 0.0f, 0.0f);
        private static readonly Vector4 kExternalWaterBaseWavesDirection = new Vector4(1.0f, 1.0f, 1.0f, 0.0f);
        private static readonly Vector4 kExternalWaterBaseVector3 = new Vector4(-0.46f, -0.05f, -1.06f, 0.0f);

        private static Vector2 RotateExternalWaterDir2(Vector2 v, float deg)
        {
            if (Mathf.Abs(deg) < 0.0001f)
                return v;

            float rad = deg * Mathf.Deg2Rad;
            float c = Mathf.Cos(rad);
            float s = Mathf.Sin(rad);
            return new Vector2(v.x * c - v.y * s, v.x * s + v.y * c);
        }

        private static Vector4 RotateExternalWaterVector3XZ(Vector4 v, float deg)
        {
            if (Mathf.Abs(deg) < 0.0001f)
                return v;

            float rad = deg * Mathf.Deg2Rad;
            float c = Mathf.Cos(rad);
            float s = Mathf.Sin(rad);
            float x = v.x * c - v.z * s;
            float z = v.x * s + v.z * c;
            v.x = x;
            v.z = z;
            return v;
        }

        private static void ApplyExternalWaterAxisParityAndDirection(Material mat, ExternalWaterPreset preset)
        {
            if (mat == null)
                return;

            float zSign = WorldZSign < 0.0f ? -1.0f : 1.0f;
            float angleDeg = preset != null ? preset.NormalDirectionDeg : 0.0f;

            if (mat.HasProperty("_Wave_Direction"))
            {
                Vector2 waveDir2 = new Vector2(kExternalWaterBaseWaveDirection.x, kExternalWaterBaseWaveDirection.y);
                if (zSign < 0.0f)
                    waveDir2.y = -waveDir2.y;
                waveDir2 = RotateExternalWaterDir2(waveDir2, angleDeg);
                mat.SetVector("_Wave_Direction", new Vector4(waveDir2.x, waveDir2.y, kExternalWaterBaseWaveDirection.z, kExternalWaterBaseWaveDirection.w));
            }

            if (mat.HasProperty("_Waves_direction"))
            {
                Vector2 wavesDir2 = new Vector2(kExternalWaterBaseWavesDirection.x, kExternalWaterBaseWavesDirection.y);
                if (zSign < 0.0f)
                    wavesDir2.y = -wavesDir2.y;
                wavesDir2 = RotateExternalWaterDir2(wavesDir2, angleDeg);
                mat.SetVector("_Waves_direction", new Vector4(wavesDir2.x, wavesDir2.y, kExternalWaterBaseWavesDirection.z, kExternalWaterBaseWavesDirection.w));
            }

            if (mat.HasProperty("_Vector3"))
            {
                Vector4 v = kExternalWaterBaseVector3;
                if (zSign < 0.0f)
                    v.z = -v.z;
                v = RotateExternalWaterVector3XZ(v, angleDeg);
                mat.SetVector("_Vector3", v);
            }

            Debug.Log($"[C2:WATER] externalAxisParity worldZSign={zSign:0} normalAngle={angleDeg:0.###} waveDir={ReadVectorSafe(mat, "_Wave_Direction")} wavesDir={ReadVectorSafe(mat, "_Waves_direction")} vec3={ReadVectorSafe(mat, "_Vector3")}");
        }

        private static void ApplyKeywordState(Material mat, string keyword, bool enabled)
        {
            if (mat == null || string.IsNullOrEmpty(keyword))
                return;

            if (enabled)
                mat.EnableKeyword(keyword);
            else
                mat.DisableKeyword(keyword);
        }

        private static bool ReadKeywordOrFloat(Material mat, string keyword, bool fallback)
        {
            if (mat == null || string.IsNullOrEmpty(keyword))
                return fallback;
            if (mat.IsKeywordEnabled(keyword))
                return true;
            if (mat.HasProperty(keyword))
                return mat.GetFloat(keyword) > 0.5f;
            return fallback;
        }

        private static float ReadFloat(Material mat, string property, float fallback)
        {
            if (mat == null || string.IsNullOrEmpty(property) || !mat.HasProperty(property))
                return fallback;
            return mat.GetFloat(property);
        }

        private static float ReadFloatEither(Material mat, string[] properties, float fallback)
        {
            if (properties == null)
                return fallback;
            for (int i = 0; i < properties.Length; i++)
            {
                string property = properties[i];
                if (!string.IsNullOrEmpty(property) && mat != null && mat.HasProperty(property))
                    return mat.GetFloat(property);
            }
            return fallback;
        }

        private static string ReadVectorSafe(Material mat, string property)
        {
            if (mat == null || string.IsNullOrEmpty(property) || !mat.HasProperty(property))
                return "<none>";
            Vector4 v = mat.GetVector(property);
            return $"({v.x:0.###},{v.y:0.###},{v.z:0.###},{v.w:0.###})";
        }
        private static float ReadColorAlpha(Material mat, string property, float fallback)
        {
            if (mat == null || string.IsNullOrEmpty(property) || !mat.HasProperty(property))
                return fallback;
            return mat.GetColor(property).a;
        }

        private static void EnsureExternalWaterReferenceTexturesLoaded()
        {
            if (s_externalWaterTexturesInitialized)
                return;

            s_externalWaterNormalA = Resources.Load<Texture2D>("normal mal 01");
            s_externalWaterNormalB = Resources.Load<Texture2D>("normal map 02");
            s_externalWaterFoamSoft = Resources.Load<Texture2D>("foam3");
            s_externalWaterFoamBlob = Resources.Load<Texture2D>("foam43");
            s_externalWaterCaustics = Resources.Load<Texture2D>("caustics");
            s_externalWaterTexturesInitialized = true;
        }

        private static void ApplyExternalWaterReferenceTextures(Material mat, ExternalWaterPreset preset)
        {
            if (mat == null || preset == null)
                return;

            EnsureExternalWaterReferenceTexturesLoaded();

            if (mat.HasProperty("_normal_Texture1") && s_externalWaterNormalA != null)
                mat.SetTexture("_normal_Texture1", s_externalWaterNormalA);

            if (mat.HasProperty("_normal_texture_2"))
            {
                Texture normalTex = preset.UseSecondaryNormalMap && s_externalWaterNormalB != null
                    ? (Texture)s_externalWaterNormalB
                    : (Texture)s_externalWaterNormalA;
                if (normalTex != null)
                    mat.SetTexture("_normal_texture_2", normalTex);
            }

            if (mat.HasProperty("_foam_Texture"))
            {
                Texture2D foamTex = preset.UseSoftFoamTexture && s_externalWaterFoamSoft != null ? s_externalWaterFoamSoft : s_externalWaterFoamBlob;
                if (foamTex != null)
                    mat.SetTexture("_foam_Texture", foamTex);
            }

            if (mat.HasProperty("_caustics_Texture") && s_externalWaterCaustics != null)
                mat.SetTexture("_caustics_Texture", s_externalWaterCaustics);
        }

        private static void MarkExternalWaterDynamicRippleDirty()
        {
            s_externalWaterDynamicRippleDirty = false;
            s_externalWaterDynamicRippleLastUpdateTime = -999.0f;
        }

        private static void UpdateExternalWaterDynamicRippleTexturesIfNeeded(ExternalWaterPreset preset, bool force)
        {
            // Dynamic/random ripple disabled by request.
        }

        private static void EnsureExternalWaterDynamicRippleTexturesCreated()
        {
            if (s_externalWaterDynamicRippleNormal == null)
            {
                s_externalWaterDynamicRippleNormal = new Texture2D(kExternalWaterDynamicRippleSize, kExternalWaterDynamicRippleSize, TextureFormat.RGBA32, false, true);
                s_externalWaterDynamicRippleNormal.name = "C2WaterDynamicRippleNormal";
                s_externalWaterDynamicRippleNormal.wrapMode = TextureWrapMode.Repeat;
                s_externalWaterDynamicRippleNormal.filterMode = FilterMode.Bilinear;
            }

            if (s_externalWaterDynamicRippleCaustics == null)
            {
                s_externalWaterDynamicRippleCaustics = new Texture2D(kExternalWaterDynamicRippleSize, kExternalWaterDynamicRippleSize, TextureFormat.RGBA32, false, true);
                s_externalWaterDynamicRippleCaustics.name = "C2WaterDynamicRippleCaustics";
                s_externalWaterDynamicRippleCaustics.wrapMode = TextureWrapMode.Repeat;
                s_externalWaterDynamicRippleCaustics.filterMode = FilterMode.Bilinear;
            }
        }

        private static void BuildExternalWaterDynamicRippleTextures(ExternalWaterPreset preset, float now)
        {
            int size = kExternalWaterDynamicRippleSize;
            bool randomZones = preset.EnableRandomRippleZones;
            bool timeDrift = preset.EnableRippleTimeDrift;
            float area01 = randomZones ? Mathf.Clamp01(preset.RippleAreaPercent / 100.0f) : 1.0f;
            float stability01 = timeDrift ? Mathf.Clamp01(preset.RippleStabilityPercent / 100.0f) : 1.0f;
            float drift01 = timeDrift ? (1.0f - stability01) : 0.0f;

            var heights = new float[size * size];
            int blobCount = randomZones
                ? Mathf.Clamp(Mathf.RoundToInt(Mathf.Lerp(2.0f, 22.0f, Mathf.Sqrt(Mathf.Max(0.001f, area01)))), 2, 28)
                : 1;
            float minRadius = randomZones ? Mathf.Lerp(0.06f, 0.12f, area01) : 1.25f;
            float maxRadius = randomZones ? Mathf.Lerp(0.14f, 0.32f, area01) : 1.45f;
            float moveSpeed = Mathf.Lerp(0.18f, 2.8f, drift01);
            float timeFactor = timeDrift ? now : 0.0f;
            float revisionSeed = timeDrift ? s_externalWaterDynamicRippleRevision * 0.37f : 0.0f;

            for (int i = 0; i < blobCount; i++)
            {
                float id = i + 1 + revisionSeed;
                float seedX = randomZones ? Frac(Mathf.Sin(id * 12.9898f + 78.233f) * 43758.5453f) : 0.5f;
                float seedY = randomZones ? Frac(Mathf.Sin(id * 19.7531f + 11.135f) * 12741.371f) : 0.5f;
                float phase = id * 1.913f;
                float pulse = timeDrift
                    ? Mathf.Clamp01(0.22f + 0.78f * (0.5f + 0.5f * Mathf.Sin(timeFactor * (0.35f + Frac(id * 0.179f) * 1.85f) + phase)))
                    : 1.0f;
                float radius = Mathf.Lerp(minRadius, maxRadius, randomZones ? Frac(id * 0.6180339f) : 0.5f);
                float x = seedX + Mathf.Sin(timeFactor * (moveSpeed * (0.8f + Frac(id * 0.131f))) + phase) * (0.32f * drift01);
                float y = seedY + Mathf.Cos(timeFactor * (moveSpeed * (0.63f + Frac(id * 0.097f))) + phase * 1.37f) * (0.32f * drift01);
                x = Frac(x);
                y = Frac(y);

                int minX = Mathf.Max(0, Mathf.FloorToInt((x - radius - 0.02f) * size));
                int maxX = Mathf.Min(size - 1, Mathf.CeilToInt((x + radius + 0.02f) * size));
                int minY = Mathf.Max(0, Mathf.FloorToInt((y - radius - 0.02f) * size));
                int maxY = Mathf.Min(size - 1, Mathf.CeilToInt((y + radius + 0.02f) * size));

                for (int py = minY; py <= maxY; py++)
                {
                    float v = (py + 0.5f) / size;
                    for (int px = minX; px <= maxX; px++)
                    {
                        float u = (px + 0.5f) / size;
                        float dx = Mathf.Abs(u - x);
                        float dy = Mathf.Abs(v - y);
                        dx = Mathf.Min(dx, 1.0f - dx);
                        dy = Mathf.Min(dy, 1.0f - dy);
                        float d = Mathf.Sqrt(dx * dx + dy * dy);
                        float t = Mathf.Clamp01(1.0f - d / Mathf.Max(0.0001f, radius));
                        t = t * t * (3.0f - 2.0f * t);
                        float contribution = t * pulse;
                        int index = py * size + px;
                        heights[index] = Mathf.Max(heights[index], contribution);
                    }
                }
            }

            float areaCut = randomZones ? Mathf.Lerp(0.78f, 0.08f, area01) : 0.02f;
            float freq = Mathf.Lerp(0.6f, 3.5f, Mathf.Clamp01(preset.HighFrequency));
            var normalPixels = new Color32[size * size];
            var causticsPixels = new Color32[size * size];

            for (int y = 0; y < size; y++)
            {
                int yPrev = (y - 1 + size) % size;
                int yNext = (y + 1) % size;
                for (int x = 0; x < size; x++)
                {
                    int xPrev = (x - 1 + size) % size;
                    int xNext = (x + 1) % size;
                    int index = y * size + x;

                    float field = heights[index];
                    float n = randomZones
                        ? Mathf.PerlinNoise((x / (float)size) * freq + timeFactor * 0.031f, (y / (float)size) * freq + timeFactor * 0.027f)
                        : 1.0f;
                    float coverage = randomZones
                        ? Mathf.SmoothStep(areaCut - 0.18f, areaCut + 0.18f, field * 0.82f + n * 0.18f)
                        : 1.0f;
                    float shaped = Mathf.SmoothStep(0.08f, 0.96f, coverage);

                    float left = heights[y * size + xPrev];
                    float right = heights[y * size + xNext];
                    float down = heights[yPrev * size + x];
                    float up = heights[yNext * size + x];
                    float ddx = (right - left) * (0.8f + preset.WaveAmplitude * 2.0f) * shaped;
                    float ddy = (up - down) * (0.8f + preset.WaveAmplitude * 2.0f) * shaped;
                    Vector3 normal = new Vector3(-ddx * 2.0f, -ddy * 2.0f, 1.0f).normalized;

                    byte nr = (byte)Mathf.Clamp(Mathf.RoundToInt((normal.x * 0.5f + 0.5f) * 255.0f), 0, 255);
                    byte ng = (byte)Mathf.Clamp(Mathf.RoundToInt((normal.y * 0.5f + 0.5f) * 255.0f), 0, 255);
                    byte nb = (byte)Mathf.Clamp(Mathf.RoundToInt((normal.z * 0.5f + 0.5f) * 255.0f), 0, 255);
                    byte na = (byte)Mathf.Clamp(Mathf.RoundToInt(shaped * 255.0f), 0, 255);
                    normalPixels[index] = new Color32(nr, ng, nb, na);

                    float edge = Mathf.Clamp01(Mathf.Abs(ddx) + Mathf.Abs(ddy));
                    float caustic = randomZones ? Mathf.Clamp01(shaped * 0.65f + edge * 0.85f) : Mathf.Clamp01(0.35f + edge * 0.85f);
                    byte c = (byte)Mathf.Clamp(Mathf.RoundToInt(caustic * 255.0f), 0, 255);
                    causticsPixels[index] = new Color32(c, c, c, c);
                }
            }

            s_externalWaterDynamicRippleNormal.SetPixels32(normalPixels);
            s_externalWaterDynamicRippleNormal.Apply(false, false);
            s_externalWaterDynamicRippleCaustics.SetPixels32(causticsPixels);
            s_externalWaterDynamicRippleCaustics.Apply(false, false);
        }

        private static float Frac(float value)
        {
            return value - Mathf.Floor(value);
        }

        public static string GetExternalWaterPresetIniPath()
        {
            try
            {
                string root = Path.GetFullPath(Path.Combine(Application.dataPath, ".."));
                string dir = Path.Combine(root, "UserSettings");
                Directory.CreateDirectory(dir);
                return Path.Combine(dir, "C2WaterPreset.ini");
            }
            catch
            {
                return Path.Combine(Application.persistentDataPath, "C2WaterPreset.ini");
            }
        }

        public static void SaveExternalWaterPresetToIni()
        {
            EnsureExternalWaterPresetInitialized();
            try
            {
                string path = GetExternalWaterPresetIniPath();
                using (var writer = new StreamWriter(path, false, Encoding.UTF8))
                {
                    var p = s_externalWaterPreset;
                    writer.WriteLine("[C2Water]");
                    WriteIni(writer, "EnableFoam", p.EnableFoam);
                    WriteIni(writer, "EnableRefraction", p.EnableRefraction);
                    WriteIni(writer, "EnableWaves", p.EnableWaves);
                    WriteIni(writer, "UseSoftFoamTexture", p.UseSoftFoamTexture);
                    WriteIni(writer, "UseSecondaryNormalMap", p.UseSecondaryNormalMap);
                    WriteIni(writer, "ShallowColor", p.ShallowColor);
                    WriteIni(writer, "DeepColor", p.DeepColor);
                    WriteIni(writer, "FoamColor", p.FoamColor);
                    WriteIni(writer, "Smoothness", p.Smoothness);
                    WriteIni(writer, "Metallic", p.Metallic);
                    WriteIni(writer, "TextureScale", p.TextureScale);
                    WriteIni(writer, "NormalStrength", p.NormalStrength);
                    WriteIni(writer, "NormalDirectionDeg", p.NormalDirectionDeg);
                    WriteIni(writer, "Depth", p.Depth);
                    WriteIni(writer, "OpacityPercent", p.OpacityPercent);
                    WriteIni(writer, "ShorelineOpacityPercent", p.ShorelineOpacityPercent);
                    WriteIni(writer, "ShorelineWidthPercent", p.ShorelineWidthPercent);
                    WriteIni(writer, "RefractionPower", p.RefractionPower);
                    WriteIni(writer, "RefractionStrength", p.RefractionStrength);
                    WriteIni(writer, "WaveSpeed", p.WaveSpeed);
                    WriteIni(writer, "WavesHeight", p.WavesHeight);
                    WriteIni(writer, "WavesLength", p.WavesLength);
                    WriteIni(writer, "WaveAmplitude", p.WaveAmplitude);
                    WriteIni(writer, "FoamAmount", p.FoamAmount);
                    WriteIni(writer, "FoamDepth", p.FoamDepth);
                    WriteIni(writer, "FoamCutoff", p.FoamCutoff);
                    WriteIni(writer, "FoamSpeed", p.FoamSpeed);
                    WriteIni(writer, "CausticsStrength", p.CausticsStrength);
                    WriteIni(writer, "CausticsSpeed", p.CausticsSpeed);
                    WriteIni(writer, "CausticsAlpha", p.CausticsAlpha);
                    WriteIni(writer, "CellDensity", p.CellDensity);
                    WriteIni(writer, "PatternScale", p.PatternScale);
                    WriteIni(writer, "HighFrequency", p.HighFrequency);
                    WriteIni(writer, "EnableCloudReflection", p.EnableCloudReflection);
                    WriteIni(writer, "CloudTextureId", NormalizeWaterCloudTextureId(p.CloudTextureId));
                    WriteIni(writer, "CloudOpacityPercent", p.CloudOpacityPercent);
                    WriteIni(writer, "CloudSpeed", p.CloudSpeed);
                    WriteIni(writer, "CloudDirectionDeg", p.CloudDirectionDeg);
                    WriteIni(writer, "CloudScale", p.CloudScale);
                    WriteIni(writer, "CloudSpacing", p.CloudSpacing);
                    WriteIni(writer, "CloudContrast", p.CloudContrast);
                    WriteIni(writer, "RimStrength", p.RimStrength);
                    WriteIni(writer, "WaterMovementSpeed", p.WaterMovementSpeed);
                    WriteIni(writer, "ReflectionFallbackRotateDeg", p.ReflectionFallbackRotateDeg);
                    WriteIni(writer, "ReflectionFallbackFlipX", p.ReflectionFallbackFlipX);
                    WriteIni(writer, "ReflectionFallbackFlipY", p.ReflectionFallbackFlipY);
                    WriteIni(writer, "ReflectionProjectiveRotateDeg", p.ReflectionProjectiveRotateDeg);
                    WriteIni(writer, "ReflectionProjectiveFlipX", p.ReflectionProjectiveFlipX);
                    WriteIni(writer, "ReflectionProjectiveFlipY", p.ReflectionProjectiveFlipY);
                }
            }
            catch (Exception ex)
            {
                Debug.LogWarning($"[C2:WATER] presetIniSaveFailed path={GetExternalWaterPresetIniPath()} err={ex.Message}");
            }
        }

        private static void TryLoadExternalWaterPresetFromIni(ExternalWaterPreset preset)
        {
            if (preset == null)
                return;

            try
            {
                string path = GetExternalWaterPresetIniPath();
                if (!File.Exists(path))
                    return;

                var map = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
                foreach (string rawLine in File.ReadAllLines(path, Encoding.UTF8))
                {
                    string line = rawLine;
                    int commentIndex = line.IndexOf(';');
                    if (commentIndex >= 0)
                        line = line.Substring(0, commentIndex);
                    line = line.Trim();
                    if (string.IsNullOrEmpty(line) || line.StartsWith("["))
                        continue;
                    int eq = line.IndexOf('=');
                    if (eq <= 0)
                        continue;
                    map[line.Substring(0, eq).Trim()] = line.Substring(eq + 1).Trim();
                }

                preset.EnableFoam = ReadIniBool(map, "EnableFoam", preset.EnableFoam);
                preset.EnableRefraction = ReadIniBool(map, "EnableRefraction", preset.EnableRefraction);
                preset.EnableWaves = ReadIniBool(map, "EnableWaves", preset.EnableWaves);
                preset.UseSoftFoamTexture = ReadIniBool(map, "UseSoftFoamTexture", preset.UseSoftFoamTexture);
                preset.UseSecondaryNormalMap = ReadIniBool(map, "UseSecondaryNormalMap", preset.UseSecondaryNormalMap);
                preset.ShallowColor = ReadIniColor(map, "ShallowColor", preset.ShallowColor);
                preset.DeepColor = ReadIniColor(map, "DeepColor", preset.DeepColor);
                preset.FoamColor = ReadIniColor(map, "FoamColor", preset.FoamColor);
                preset.Smoothness = ReadIniFloat(map, "Smoothness", preset.Smoothness);
                preset.Metallic = ReadIniFloat(map, "Metallic", preset.Metallic);
                preset.TextureScale = ReadIniFloat(map, "TextureScale", preset.TextureScale);
                preset.NormalStrength = ReadIniFloat(map, "NormalStrength", preset.NormalStrength);
                preset.NormalDirectionDeg = ReadIniFloat(map, "NormalDirectionDeg", preset.NormalDirectionDeg);
                preset.Depth = ReadIniFloat(map, "Depth", preset.Depth);
                preset.OpacityPercent = Mathf.Clamp(ReadIniFloat(map, "OpacityPercent", preset.OpacityPercent), 0.0f, 100.0f);
                preset.ShorelineOpacityPercent = Mathf.Clamp(ReadIniFloat(map, "ShorelineOpacityPercent", preset.ShorelineOpacityPercent), 0.0f, 100.0f);
                preset.ShorelineWidthPercent = Mathf.Clamp(ReadIniFloat(map, "ShorelineWidthPercent", preset.ShorelineWidthPercent), 0.0f, 100.0f);
                preset.RefractionPower = ReadIniFloat(map, "RefractionPower", preset.RefractionPower);
                preset.RefractionStrength = ReadIniFloat(map, "RefractionStrength", preset.RefractionStrength);
                preset.WaveSpeed = ReadIniFloat(map, "WaveSpeed", preset.WaveSpeed);
                preset.WavesHeight = ReadIniFloat(map, "WavesHeight", preset.WavesHeight);
                preset.WavesLength = ReadIniFloat(map, "WavesLength", preset.WavesLength);
                preset.WaveAmplitude = ReadIniFloat(map, "WaveAmplitude", preset.WaveAmplitude);
                preset.FoamAmount = ReadIniFloat(map, "FoamAmount", preset.FoamAmount);
                preset.FoamDepth = ReadIniFloat(map, "FoamDepth", preset.FoamDepth);
                preset.FoamCutoff = ReadIniFloat(map, "FoamCutoff", preset.FoamCutoff);
                preset.FoamSpeed = ReadIniFloat(map, "FoamSpeed", preset.FoamSpeed);
                preset.CausticsStrength = ReadIniFloat(map, "CausticsStrength", preset.CausticsStrength);
                preset.CausticsSpeed = ReadIniFloat(map, "CausticsSpeed", preset.CausticsSpeed);
                preset.CausticsAlpha = ReadIniFloat(map, "CausticsAlpha", preset.CausticsAlpha);
                preset.CellDensity = ReadIniFloat(map, "CellDensity", preset.CellDensity);
                preset.PatternScale = ReadIniFloat(map, "PatternScale", preset.PatternScale);
                preset.HighFrequency = ReadIniFloat(map, "HighFrequency", preset.HighFrequency);
                preset.EnableCloudReflection = ReadIniBool(map, "EnableCloudReflection", preset.EnableCloudReflection);
                preset.CloudTextureId = NormalizeWaterCloudTextureId(ReadIniString(map, "CloudTextureId", preset.CloudTextureId));
                preset.CloudOpacityPercent = Mathf.Clamp(ReadIniFloat(map, "CloudOpacityPercent", preset.CloudOpacityPercent), 0.0f, 100.0f);
                preset.CloudSpeed = Mathf.Clamp(ReadIniFloat(map, "CloudSpeed", preset.CloudSpeed), 0.0f, 1.0f);
                preset.CloudDirectionDeg = ReadIniFloat(map, "CloudDirectionDeg", preset.CloudDirectionDeg);
                preset.CloudScale = Mathf.Clamp(ReadIniFloat(map, "CloudScale", preset.CloudScale), 0.05f, 16.0f);
                preset.CloudSpacing = Mathf.Clamp(ReadIniFloat(map, "CloudSpacing", preset.CloudSpacing), 0.05f, 16.0f);
                preset.CloudContrast = Mathf.Clamp(ReadIniFloat(map, "CloudContrast", preset.CloudContrast), 0.1f, 4.0f);
                preset.RimStrength = ReadIniFloat(map, "RimStrength", preset.RimStrength);
                preset.WaterMovementSpeed = ReadIniFloat(map, "WaterMovementSpeed", preset.WaterMovementSpeed);
                preset.ReflectionFallbackRotateDeg = ReadIniFloat(map, "ReflectionFallbackRotateDeg", preset.ReflectionFallbackRotateDeg);
                preset.ReflectionFallbackFlipX = ReadIniBool(map, "ReflectionFallbackFlipX", preset.ReflectionFallbackFlipX);
                preset.ReflectionFallbackFlipY = ReadIniBool(map, "ReflectionFallbackFlipY", preset.ReflectionFallbackFlipY);
                preset.ReflectionProjectiveRotateDeg = ReadIniFloat(map, "ReflectionProjectiveRotateDeg", preset.ReflectionProjectiveRotateDeg);
                preset.ReflectionProjectiveFlipX = ReadIniBool(map, "ReflectionProjectiveFlipX", preset.ReflectionProjectiveFlipX);
                preset.ReflectionProjectiveFlipY = ReadIniBool(map, "ReflectionProjectiveFlipY", preset.ReflectionProjectiveFlipY);
            }
            catch (Exception ex)
            {
                Debug.LogWarning($"[C2:WATER] presetIniLoadFailed path={GetExternalWaterPresetIniPath()} err={ex.Message}");
            }
        }

        private static void WriteIni(StreamWriter writer, string key, bool value)
        {
            writer.WriteLine(key + "=" + (value ? "1" : "0"));
        }

        private static void WriteIni(StreamWriter writer, string key, float value)
        {
            writer.WriteLine(key + "=" + value.ToString(CultureInfo.InvariantCulture));
        }


        private static void WriteIni(StreamWriter writer, string key, string value)
        {
            writer.WriteLine(key + "=" + (value ?? ""));
        }

        private static void WriteIni(StreamWriter writer, string key, Color value)
        {
            writer.WriteLine(key + "=" + value.r.ToString(CultureInfo.InvariantCulture) + "," + value.g.ToString(CultureInfo.InvariantCulture) + "," + value.b.ToString(CultureInfo.InvariantCulture) + "," + value.a.ToString(CultureInfo.InvariantCulture));
        }

        private static bool ReadIniBool(Dictionary<string, string> map, string key, bool fallback)
        {
            if (map == null || string.IsNullOrEmpty(key) || !map.TryGetValue(key, out string value))
                return fallback;
            if (value == "1") return true;
            if (value == "0") return false;
            if (bool.TryParse(value, out bool result)) return result;
            return fallback;
        }

        private static float ReadIniFloat(Dictionary<string, string> map, string key, float fallback)
        {
            if (map == null || string.IsNullOrEmpty(key) || !map.TryGetValue(key, out string value))
                return fallback;
            if (float.TryParse(value, NumberStyles.Float, CultureInfo.InvariantCulture, out float result))
                return result;
            return fallback;
        }


        private static string ReadIniString(Dictionary<string, string> map, string key, string fallback)
        {
            if (map == null || string.IsNullOrEmpty(key))
                return fallback;
            if (!map.TryGetValue(key, out string raw) || string.IsNullOrWhiteSpace(raw))
                return fallback;
            return raw.Trim();
        }

        private static Color ReadIniColor(Dictionary<string, string> map, string key, Color fallback)
        {
            if (map == null || string.IsNullOrEmpty(key) || !map.TryGetValue(key, out string value))
                return fallback;
            string[] parts = value.Split(',');
            if (parts.Length < 3)
                return fallback;
            float r = fallback.r;
            float g = fallback.g;
            float b = fallback.b;
            float a = fallback.a;
            float.TryParse(parts[0], NumberStyles.Float, CultureInfo.InvariantCulture, out r);
            float.TryParse(parts[1], NumberStyles.Float, CultureInfo.InvariantCulture, out g);
            float.TryParse(parts[2], NumberStyles.Float, CultureInfo.InvariantCulture, out b);
            if (parts.Length >= 4)
                float.TryParse(parts[3], NumberStyles.Float, CultureInfo.InvariantCulture, out a);
            return new Color(r, g, b, a);
        }

        private static void SetFloatIf(Material mat, string property, float value)
        {
            if (mat != null && !string.IsNullOrEmpty(property) && mat.HasProperty(property))
                mat.SetFloat(property, value);
        }

        private static void SetColorIf(Material mat, string property, Color value)
        {
            if (mat != null && !string.IsNullOrEmpty(property) && mat.HasProperty(property))
                mat.SetColor(property, value);
        }

        private sealed class GroundTextureCatalog
        {
            public Dictionary<string, Texture2D> ByName = new Dictionary<string, Texture2D>(StringComparer.OrdinalIgnoreCase);
            public Dictionary<string, string> SourceFolderByKey = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            public string Info = "";
        }

