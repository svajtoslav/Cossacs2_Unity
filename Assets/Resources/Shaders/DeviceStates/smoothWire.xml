				<AddressV>Wrap</AddressV>
			</TextureStageState>
			<TextureStageState Stage="1">
				<ColorOp>Disable</ColorOp>
				<AlphaOp>Disable</AlphaOp>
				<MinFilter>None</MinFilter>
				<MagFilter>None</MagFilter>
			</TextureStageState>
</smoothWire>